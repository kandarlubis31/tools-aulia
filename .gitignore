/dist/

# generated types
.astro/

docs\CONTEXT.md

# dependencies (root-only — public/editor/node_modules/ TIDAK di-ignore,
# itu closure runtime OmniClip yang WAJIB ke-commit biar /editor jalan di produksi)
/node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# environment variables
.env
.env.production
.env.local
.env.*
!.env.example

# Vercel (PENTING: Jangan di-upload ke GitHub)
.vercel/

# macOS-specific files
.DS_Store

# Windows-specific files (Biar aman kalau ganti laptop/kolab)
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE / Editor
# NOTE: pola `dir/` + `!dir/file` TIDAK re-include (parent di-exclude dulu).
# Pakai `dir/*` supaya negasi settings.json benar-benar bekerja.
.idea/
.vscode/*
!.vscode/settings.json   # shared formatter/tailwind settings — tracked
*.swp
*.swo

# Agent workspace lokal (plan/opencode session) — tidak untuk repo
.opencode/

# TypeScript
*.tsbuildinfo

# === Added for deploy cleanup ===

# PWA dev output (auto-generated by @vite-pwa/astro)
dev-dist/

# Test coverage (vitest)
coverage/

# Windows garbage file (artifact from cmd redirection)
nul

# Redundant lock files (project uses pnpm — pnpm-lock.yaml is the source of truth)
package-lock.json
bun.lock

# Temp PWA icons (leftover dari pipeline generate-assets)
public/favicon-temp-*.png

# OmniClip vendored source — build artifacts (regenerable via npm ci + build)
omniclip/node_modules/
omniclip/x/
omniclip/dev-dist/
omniclip/*.tmp
omniclip/package-lock.json   # project pakai pnpm; lock npm-nya omniclip tidak di-track

# Catatan: scripts/ sengaja TIDAK di-ignore — dev tooling (generate-assets,
# migrate-headers, new-tool) ikut di-version-control biar tidak hilang.
test-logo.png
