---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="Hash Compare" description="Bandingkan hash 2 file atau teks untuk verifikasi integritas. 100% client-side WebCrypto.">
  <ToolPageHeader title="Hash Compare" desc="Bandingkan hash SHA-256 2 file atau teks" icon='<line x1="12" y1="2" x2="12" y2="22"/><polyline points="16 7 12 3 8 7"/><polyline points="8 17 12 21 16 17"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="text1" class="block text-sm text-matte-500 mb-1 font-medium" data-i18n="sec.hc.input1">File / Teks 1</label>
        <textarea id="text1" class="input-field w-full h-32 font-mono text-sm" placeholder="Paste teks atau hash di sini..." data-i18n-attr="placeholder" data-i18n="ph.hc_paste"></textarea>
        <p class="text-xs text-matte-400 mt-1" data-i18n="sec.hc.or">atau</p>
        <input type="file" id="file1" class="input-field text-sm w-full" aria-label="File 1">
        <p class="text-xs font-mono text-matte-400 mt-1 break-all" id="hash1"></p>
      </div>
      <div>
        <label for="text2" class="block text-sm text-matte-500 mb-1 font-medium" data-i18n="sec.hc.input2">File / Teks 2</label>
        <textarea id="text2" class="input-field w-full h-32 font-mono text-sm" placeholder="Paste teks atau hash di sini..." data-i18n-attr="placeholder" data-i18n="ph.hc_paste"></textarea>
        <p class="text-xs text-matte-400 mt-1" data-i18n="sec.hc.or">atau</p>
        <input type="file" id="file2" class="input-field text-sm w-full" aria-label="File 2">
        <p class="text-xs font-mono text-matte-400 mt-1 break-all" id="hash2"></p>
      </div>
    </div>

    <div class="flex gap-2">
      <button id="compare-btn" class="btn-primary flex-1" data-i18n="btn.compare">🔍 Bandingkan</button>
      <label class="sr-only" for="algo" data-i18n="sec.hc.algo">Algoritma</label>
      <select id="algo" class="input-field text-sm w-32">
        <option value="SHA-256" selected>SHA-256</option>
        <option value="SHA-1">SHA-1</option>
        <option value="SHA-512">SHA-512</option>
      </select>
    </div>

    <div id="result" class="hidden card-base p-4 text-center text-lg font-bold"></div>
  </div>
</BaseLayout>

<script>
import { t } from '../../i18n/translations';

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  async function hashContent(input: HTMLTextAreaElement, fileInput: HTMLInputElement): Promise<string | null> {
    const text = input.value.trim();
    const file = fileInput.files?.[0];
    let data: ArrayBuffer | Uint8Array;
    if (file) data = await file.arrayBuffer();
    else if (text) data = new TextEncoder().encode(text);
    else return null;
    const algo = (document.getElementById('algo') as HTMLSelectElement).value;
    const hashBuf = await crypto.subtle.digest(algo, data as ArrayBuffer);
    return Array.from(new Uint8Array(hashBuf)).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  document.getElementById('compare-btn')!.addEventListener('click', async () => {
    try {
      const h1 = await hashContent(document.getElementById('text1') as HTMLTextAreaElement, document.getElementById('file1') as HTMLInputElement);
      const h2 = await hashContent(document.getElementById('text2') as HTMLTextAreaElement, document.getElementById('file2') as HTMLInputElement);
      if (!h1 && !h2) { toast('Masukkan input', 'error'); return; }
      (document.getElementById('hash1') as HTMLElement).textContent = h1 ? t('sec.hc.hash1', 'Hash 1: {h}').replace('{h}', h1) : '';
      (document.getElementById('hash2') as HTMLElement).textContent = h2 ? t('sec.hc.hash2', 'Hash 2: {h}').replace('{h}', h2) : '';
      const result = document.getElementById('result')!;
      result.classList.remove('hidden');
      const same = h1 && h2 && h1 === h2;
      result.textContent = same
        ? '✅ ' + t('sec.hc.match', 'Cocok! (Hash identik)')
        : (h1 && h2 ? '❌ ' + t('sec.hc.mismatch', 'Tidak Cocok! (Hash berbeda)') : '⚠️ ' + t('sec.hc.need_both', 'Isi kedua input'));
      result.className = 'card-base p-4 text-center text-lg font-bold ' + (same ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300');
    } catch {
      toast('Gagal menghitung hash', 'error');
    }
  });

  // live hash as user types
  async function liveHash(textId: string, fileId: string, hashId: string) {
    try {
      const h = await hashContent(document.getElementById(textId) as HTMLTextAreaElement, document.getElementById(fileId) as HTMLInputElement);
      (document.getElementById(hashId) as HTMLElement).textContent = h ? t('sec.hc.hash_label', 'Hash: {h}').replace('{h}', h) : '';
    } catch { /* biarkan hash lama tampil */ }
  }
  ['text1', 'text2'].forEach((id, i) => {
    document.getElementById(id)!.addEventListener('input', () => liveHash(id, 'file' + (i + 1), 'hash' + (i + 1)));
    document.getElementById('file' + (i + 1))!.addEventListener('change', () => liveHash('text' + (i + 1), 'file' + (i + 1), 'hash' + (i + 1)));
  });

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __securityHashComparePage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __securityHashComparePage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
