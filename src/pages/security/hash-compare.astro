---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="Hash Compare — Bandingkan File dengan SHA-256 | ToolsAulia" description="Bandingkan hash 2 file atau teks untuk verifikasi integritas. 100% client-side WebCrypto." category="Security" toolHref="/security/hash-compare">
  <ToolPageHeader title="Hash Compare" description="Bandingkan hash SHA-256 2 file atau teks" icon='<line x1="12" y1="2" x2="12" y2="22"/><polyline points="16 7 12 3 8 7"/><polyline points="8 17 12 21 16 17"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-matte-500 mb-1 font-medium">File / Teks 1</label>
        <textarea id="text1" class="input-field w-full h-32 font-mono text-sm" placeholder="Paste teks atau hash di sini..."></textarea>
        <p class="text-xs text-matte-400 mt-1">atau</p>
        <input type="file" id="file1" class="input-field text-sm w-full">
        <p class="text-xs font-mono text-matte-400 mt-1 break-all" id="hash1"></p>
      </div>
      <div>
        <label class="block text-sm text-matte-500 mb-1 font-medium">File / Teks 2</label>
        <textarea id="text2" class="input-field w-full h-32 font-mono text-sm" placeholder="Paste teks atau hash di sini..."></textarea>
        <p class="text-xs text-matte-400 mt-1">atau</p>
        <input type="file" id="file2" class="input-field text-sm w-full">
        <p class="text-xs font-mono text-matte-400 mt-1 break-all" id="hash2"></p>
      </div>
    </div>

    <div class="flex gap-2">
      <button id="compare-btn" class="btn-primary flex-1">Bandingkan</button>
      <select id="algo" class="input-field text-sm w-32">
        <option value="SHA-256" selected>SHA-256</option>
        <option value="SHA-1">SHA-1</option>
        <option value="SHA-512">SHA-512</option>
      </select>
    </div>

    <div id="result" class="hidden card-base p-4 text-center text-lg font-bold"></div>
  </div>
</BaseLayout>

<script>
  async function hashContent(input, fileInput) {
    const text = input.value.trim();
    const file = fileInput.files[0];
    let data;
    if (file) data = await file.arrayBuffer();
    else if (text) data = new TextEncoder().encode(text);
    else return null;
    const algo = document.getElementById('algo').value;
    const hashBuf = await crypto.subtle.digest(algo, data);
    return Array.from(new Uint8Array(hashBuf)).map(b => b.toString(16).padStart(2,'0')).join('');
  }

  document.getElementById('compare-btn').addEventListener('click', async () => {
    const h1 = await hashContent(document.getElementById('text1'), document.getElementById('file1'));
    const h2 = await hashContent(document.getElementById('text2'), document.getElementById('file2'));
    if (!h1 && !h2) { showToast?.(_tToast?.('Masukkan input', 'Provide input'), 'error'); return; }
    document.getElementById('hash1').textContent = h1 ? 'Hash 1: ' + h1 : '';
    document.getElementById('hash2').textContent = h2 ? 'Hash 2: ' + h2 : '';
    const result = document.getElementById('result');
    result.classList.remove('hidden');
    const same = h1 && h2 && h1 === h2;
    result.textContent = same ? '✅ Cocok! (Hash identik)' : (h1 && h2 ? '❌ Tidak Cocok! (Hash berbeda)' : '⚠️ Isi kedua input');
    result.className = 'card-base p-4 text-center text-lg font-bold ' + (same ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300' : 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300');
  });

  // live hash as user types
  async function liveHash(textId, fileId, hashId) {
    const h = await hashContent(document.getElementById(textId), document.getElementById(fileId));
    document.getElementById(hashId).textContent = h ? 'Hash: ' + h : '';
  }
  ['text1','text2'].forEach((id,i) => {
    document.getElementById(id).addEventListener('input', () => liveHash(id, 'file'+(i+1), 'hash'+(i+1)));
    document.getElementById('file'+(i+1)).addEventListener('change', () => liveHash('text'+(i+1), 'file'+(i+1), 'hash'+(i+1)));
  });
</script>
