---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Hash Generator (MD5, SHA)">
  <script is:inline src="/vendor/crypto-js/crypto-js.min.js" async></script>

  <div class="max-w-4xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Hash Generator"
      titleKey="header.hash"
      desc="Enkripsi teks menggunakan algoritma hashing standar (MD5, SHA-1, SHA-256, SHA-512)."
      descKey="header.hash_desc"
      icon='<line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/>'
      gradient="from-rose-500 to-orange-500"
    />

    <div class="card-base p-6 mb-8 animate-fade-in">
        <label class="section-title mb-2" data-i18n="label.hash_input">Input Text</label>
        <textarea id="hash-input" class="w-full p-4 font-mono text-sm bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-accent-blue transition-colors resize-none h-32" placeholder="Ketik teks yang ingin di-hash..." data-i18n-attr="placeholder" data-i18n="ph.type_hash"></textarea>
        <p class="text-xs text-matte-400 mt-2" data-i18n="tip.auto_update">Hash diperbarui otomatis saat kamu mengetik.</p>
    </div>

    <div class="space-y-4 animate-fade-in" style="animation-delay: 0.1s;">

        <div class="card-base p-4 flex flex-col md:flex-row md:items-center gap-4">
            <div class="w-24 font-bold text-matte-400" data-i18n="label.md5">MD5</div>
            <input type="text" id="out-md5" readonly class="flex-1 p-2 bg-transparent font-mono text-sm text-matte-800 dark:text-white outline-none truncate" placeholder="..." />
            <button class="copy-btn text-xs font-bold px-3 py-1.5 bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300 rounded hover:bg-matte-200 dark:hover:bg-surface-hover transition" data-target="out-md5" data-i18n="btn.copy">Copy</button>
        </div>

        <div class="card-base p-4 flex flex-col md:flex-row md:items-center gap-4">
            <div class="w-24 font-bold text-matte-400" data-i18n="label.sha1">SHA-1</div>
            <input type="text" id="out-sha1" readonly class="flex-1 p-2 bg-transparent font-mono text-sm text-matte-800 dark:text-white outline-none truncate" placeholder="..." />
            <button class="copy-btn text-xs font-bold px-3 py-1.5 bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300 rounded hover:bg-matte-200 dark:hover:bg-surface-hover transition" data-target="out-sha1" data-i18n="btn.copy">Copy</button>
        </div>

        <div class="bg-white dark:bg-matte-800 p-4 rounded-xl border border-matte-200 dark:border-matte-700 shadow-sm flex flex-col md:flex-row md:items-center gap-4 border-l-4 border-l-blue-500">
            <div class="w-24 font-bold text-matte-700 dark:text-white" data-i18n="label.sha256">SHA-256</div>
            <input type="text" id="out-sha256" readonly class="flex-1 p-2 bg-transparent font-mono text-sm text-matte-800 dark:text-white outline-none truncate" placeholder="..." />
            <button class="copy-btn text-xs font-bold px-3 py-1.5 bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300 rounded hover:bg-matte-200 dark:hover:bg-surface-hover transition" data-target="out-sha256" data-i18n="btn.copy">Copy</button>
        </div>

        <div class="card-base p-4 flex flex-col md:flex-row md:items-center gap-4">
            <div class="w-24 font-bold text-matte-400" data-i18n="label.sha512">SHA-512</div>
            <input type="text" id="out-sha512" readonly class="flex-1 p-2 bg-transparent font-mono text-sm text-matte-800 dark:text-white outline-none truncate" placeholder="..." />
            <button class="copy-btn text-xs font-bold px-3 py-1.5 bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300 rounded hover:bg-matte-200 dark:hover:bg-surface-hover transition" data-target="out-sha512" data-i18n="btn.copy">Copy</button>
        </div>

    </div>
  </div>
</BaseLayout>

<script>
const __securityHashPage = (location.pathname.replace(/\/+$/, '') || '/');

document.addEventListener('astro:page-load', () => {
  if ((location.pathname.replace(/\/+$/, '') || '/') !== __securityHashPage) return;
  const anchor = document.querySelector('main button, main input, main select, main textarea');
  if (!anchor || anchor.dataset.autoBound === 'true') return;
  anchor.dataset.autoBound = 'true';

  const input = document.getElementById('hash-input') as HTMLTextAreaElement;
  const outs = ['out-md5', 'out-sha1', 'out-sha256', 'out-sha512']
    .map(id => document.getElementById(id) as HTMLInputElement);

  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  function updateHash() {
    const val = input.value;
    if (!val) { outs.forEach(el => { el.value = ''; }); return; }
    if (typeof CryptoJS === 'undefined') return;
    outs[0].value = CryptoJS.MD5(val).toString();
    outs[1].value = CryptoJS.SHA1(val).toString();
    outs[2].value = CryptoJS.SHA256(val).toString();
    outs[3].value = CryptoJS.SHA512(val).toString();
  }

  // Poll CryptoJS sampai siap — maksimal 50x, gak bocor selamanya setelah SPA nav
  let tries = 0;
  const poll = setInterval(() => {
    if (typeof CryptoJS !== 'undefined') { clearInterval(poll); updateHash(); }
    else if (++tries >= 50) { clearInterval(poll); toast('Library crypto gagal dimuat', 'error'); }
  }, 100);

  input.addEventListener('input', updateHash);

  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const targetId = (btn as HTMLElement).dataset.target || '';
      const target = document.getElementById(targetId) as HTMLInputElement | null;
      if (!target) return;
      if (!target.value) { toast('Input kosong!', 'info'); return; }
      try {
        await navigator.clipboard.writeText(target.value);
        toast('Hash disalin!');
      } catch {
        toast('Gagal menyalin', 'error');
      }
    });
  });
});
</script>
