---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Token Generator — Random Token">
  <div class="max-w-3xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Token Generator"
      titleKey="header.token_gen"
      desc="Generate random token hex/base64 berbagai panjang."
      descKey="header.token_gen_desc"
      icon='<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>'
      gradient="from-violet-500 to-purple-600"
    />

    <div class="card-base p-6 animate-fade-in">
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label class="section-title mb-2 block" for="token-length" data-i18n="token.length">Panjang</label>
          <input id="token-length" type="number" min="8" max="128" value="32" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-violet-500 transition-colors text-sm" />
        </div>
        <div>
          <label class="section-title mb-2 block" for="token-format" data-i18n="token.format">Format</label>
          <select id="token-format" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-violet-500 transition-colors text-sm">
            <option value="hex">Hex</option>
            <option value="base64">Base64</option>
            <option value="alphanumeric">Alphanumeric</option>
          </select>
        </div>
      </div>

      <label class="section-title mb-2 block" for="token-count" data-i18n="token.count">Jumlah Token</label>
      <input id="token-count" type="number" min="1" max="20" value="5" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-violet-500 transition-colors text-sm" />

      <button id="generate-btn" class="mt-4 w-full gradient-brand py-3 rounded-xl font-bold text-sm" data-i18n="token.generate">Generate</button>

      <div id="result" class="hidden mt-6">
        <div class="flex items-center justify-between mb-2">
          <span class="section-title" data-i18n="token.result">Token</span>
          <button id="copy-all" class="text-xs font-bold px-3 py-1.5 bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300 rounded-lg hover:bg-matte-200 dark:hover:bg-surface-hover transition" data-i18n="token.copy_all">Copy All</button>
        </div>
        <div id="tokens-list" class="space-y-2"></div>
      </div>
    </div>
  </div>

  <script>
  import { t } from '../../i18n/translations';

  const toast = (msg, type = 'success') => window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  function generateToken(length, format) {
    // Panjang token = N karakter konsisten utk semua format
    // (hex: N chars butuh ceil(N/2) bytes; base64url: N chars butuh ceil(N*3/4) bytes)
    let bytes;
    if (format === 'hex') bytes = Math.ceil(length / 2);
    else if (format === 'base64') bytes = Math.ceil(length * 3 / 4);
    else bytes = length;
    const array = new Uint8Array(Math.max(1, bytes));
    crypto.getRandomValues(array);

    switch (format) {
      case 'base64':
        return btoa(String.fromCharCode.apply(null, array)).replace(/\+/g, '-').replace(/\//g, '_').substring(0, length);
      case 'alphanumeric': {
        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
        return Array.from(array).map(b => chars[b % chars.length]).join('').substring(0, length);
      }
      default:
        return Array.from(array).map(b => b.toString(16).padStart(2, '0')).join('').substring(0, length);
    }
  }

  document.getElementById('generate-btn').addEventListener('click', () => {
    const length = Math.min(128, Math.max(8, parseInt(document.getElementById('token-length').value, 10) || 32));
    const format = document.getElementById('token-format').value;
    const count = Math.min(20, Math.max(1, parseInt(document.getElementById('token-count').value, 10) || 5));

    const tokens = [];
    for (let i = 0; i < count; i++) tokens.push(generateToken(length, format));

    const listEl = document.getElementById('tokens-list');
    listEl.textContent = '';
    tokens.forEach((token, i) => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-2 p-3 bg-matte-50 dark:bg-matte-900 rounded-xl border border-matte-200 dark:border-surface-border';

      const num = document.createElement('span');
      num.className = 'text-xs text-matte-400 w-6';
      num.textContent = (i + 1) + '.';

      const code = document.createElement('code');
      code.className = 'flex-1 text-xs font-mono text-violet-600 dark:text-violet-400 break-all';
      code.textContent = token;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-token text-xs font-bold px-2 py-1 bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300 rounded hover:bg-matte-200 dark:hover:bg-surface-hover transition';
      btn.textContent = t('common.copy', 'Copy');
      btn.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(token); toast('Token disalin!'); }
        catch { toast('Gagal menyalin', 'error'); }
      });

      row.append(num, code, btn);
      listEl.appendChild(row);
    });

    document.getElementById('result').classList.remove('hidden');
    toast('Token digenerate!');
  });

  document.getElementById('copy-all').addEventListener('click', async () => {
    const tokens = Array.from(document.querySelectorAll('#tokens-list code')).map(c => c.textContent || '');
    if (!tokens.length) { toast('Input kosong!', 'error'); return; }
    try { await navigator.clipboard.writeText(tokens.join('\n')); toast('Semua token disalin!'); }
    catch { toast('Gagal menyalin', 'error'); }
  });
  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __securityTokenPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __securityTokenPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });
  </script>
</BaseLayout>
