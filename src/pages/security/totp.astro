---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="TOTP Generator — Kode Authenticator">
  <div class="max-w-3xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="TOTP Generator"
      titleKey="header.totp_generator"
      desc="Generate kode TOTP (Time-based One-Time Password) untuk authenticator."
      descKey="header.totp_generator_desc"
      icon='<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 8v4"/><path d="M12 16h.01"/>'
      gradient="from-blue-500 to-indigo-600"
    />

    <div class="card-base p-6 animate-fade-in">
      <!-- Secret key input -->
      <label class="section-title mb-2 block" for="totp-secret" data-i18n="totp.secret">Secret Key (Base32)</label>
      <input id="totp-secret" type="text" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-blue-500 transition-colors text-sm font-mono" placeholder="JBSWY3DPEHPK3PXP" autocomplete="off" />

      <button id="generate-btn" class="mt-4 w-full gradient-brand py-3 rounded-xl font-bold text-sm" data-i18n="totp.generate">Generate Kode</button>

      <!-- TOTP code display -->
      <div id="totp-display" class="hidden mt-6 text-center">
        <p class="text-2xs text-matte-400 mb-2" data-i18n="totp.code">Kode TOTP</p>
        <div class="flex items-center justify-center gap-2">
          <span id="totp-code" class="text-4xl font-mono font-bold text-blue-600 dark:text-blue-400 tracking-widest">000000</span>
          <button id="copy-code" class="text-xs font-bold px-3 py-1.5 bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300 rounded-lg hover:bg-matte-200 dark:hover:bg-surface-hover transition" data-i18n="totp.copy">Salin kode</button>
        </div>
        <div class="mt-4">
          <div class="flex items-center justify-between mb-1">
            <span class="text-2xs text-matte-400" data-i18n="totp.countdown">Detik tersisa</span>
            <span id="countdown" class="text-2xs font-bold text-blue-600 dark:text-blue-400">30</span>
          </div>
          <div class="w-full h-2 bg-matte-200 dark:bg-surface-hover rounded-full overflow-hidden">
            <div id="countdown-bar" class="h-full bg-blue-500 transition-all duration-1000"></div>
          </div>
        </div>
      </div>

      <!-- Error -->
      <div id="totp-error" class="hidden mt-4 p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl text-xs text-red-600 dark:text-red-400"></div>

      <!-- Note -->
      <p class="text-2xs text-matte-400 mt-4" data-i18n="totp.note">Masukkan secret key Base32, dapatkan kode 6 digit yang berubah setiap 30 detik.</p>
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      const toast = (msg: string, type?: string) => (window as any).showToast?.((window as any)._tToast ? (window as any)._tToast(msg) : msg, type);
      let intervalId: ReturnType<typeof setInterval> | null = null;

      // Base32 decode
      function base32Decode(str: string): Uint8Array {
        const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
        str = str.replace(/=+$/, '').toUpperCase();
        let bits = '';
        for (const char of str) {
          const val = alphabet.indexOf(char);
          if (val === -1) throw new Error('Invalid Base32 character: ' + char);
          bits += val.toString(2).padStart(5, '0');
        }
        const bytes = new Uint8Array(Math.floor(bits.length / 8));
        for (let i = 0; i < bytes.length; i++) {
          bytes[i] = parseInt(bits.slice(i * 8, i * 8 + 8), 2);
        }
        return bytes;
      }

      // HMAC-SHA1
      async function hmacSha1(key: Uint8Array, message: Uint8Array): Promise<ArrayBuffer> {
        const cryptoKey = await crypto.subtle.importKey(
          'raw', key, { name: 'HMAC', hash: 'SHA-1' }, false, ['sign']
        );
        return crypto.subtle.sign('HMAC', cryptoKey, message);
      }

      // Generate TOTP
      async function generateTOTP(secret: string, timeStep = 30): Promise<string> {
        const key = base32Decode(secret);
        const time = Math.floor(Date.now() / 1000 / timeStep);
        
        // Convert time to 8-byte big-endian
        const timeBytes = new ArrayBuffer(8);
        const view = new DataView(timeBytes);
        view.setUint32(4, time, false);

        const hmac = await hmacSha1(key, new Uint8Array(timeBytes));
        const hmacArray = new Uint8Array(hmac);
        
        // Dynamic truncation
        const offset = hmacArray[19] & 0x0f;
        const code = (
          ((hmacArray[offset] & 0x7f) << 24) |
          ((hmacArray[offset + 1] & 0xff) << 16) |
          ((hmacArray[offset + 2] & 0xff) << 8) |
          (hmacArray[offset + 3] & 0xff)
        ) % 1000000;

        return code.toString().padStart(6, '0');
      }

      // Update display
      async function updateDisplay() {
        const secret = (document.getElementById('totp-secret') as HTMLInputElement)?.value?.trim();
        if (!secret) return;

        try {
          const code = await generateTOTP(secret);
          const codeEl = document.getElementById('totp-code');
          if (codeEl) codeEl.textContent = code;

          // Update countdown
          const now = Math.floor(Date.now() / 1000);
          const remaining = 30 - (now % 30);
          const countdownEl = document.getElementById('countdown');
          const barEl = document.getElementById('countdown-bar');
          if (countdownEl) countdownEl.textContent = remaining.toString();
          if (barEl) barEl.style.width = `${(remaining / 30) * 100}%`;
        } catch (e: any) {
          const errorEl = document.getElementById('totp-error');
          if (errorEl) { errorEl.textContent = e.message; errorEl.classList.remove('hidden'); }
        }
      }

      // Generate button
      document.getElementById('generate-btn')?.addEventListener('click', () => {
        const secret = (document.getElementById('totp-secret') as HTMLInputElement)?.value?.trim();
        const errorEl = document.getElementById('totp-error');
        const displayEl = document.getElementById('totp-display');

        if (!secret) {
          if (errorEl) { errorEl.textContent = 'Masukkan secret key!'; errorEl.classList.remove('hidden'); }
          return;
        }

        // Validate Base32
        if (!/^[A-Z2-7]+=*$/i.test(secret)) {
          if (errorEl) { errorEl.textContent = 'Secret key harus Base32 (A-Z, 2-7)!'; errorEl.classList.remove('hidden'); }
          return;
        }

        if (errorEl) errorEl.classList.add('hidden');
        if (displayEl) displayEl.classList.remove('hidden');

        // Start auto-update
        if (intervalId) clearInterval(intervalId);
        updateDisplay();
        intervalId = setInterval(updateDisplay, 1000);
        toast('TOTP aktif!', 'success');
      });

      // Copy code
      document.getElementById('copy-code')?.addEventListener('click', () => {
        const code = document.getElementById('totp-code')?.textContent;
        if (code) {
          navigator.clipboard.writeText(code);
          toast('Kode disalin!', 'success');
        }
      });

      // Cleanup
      document.addEventListener('astro:before-swap', () => {
      document.addEventListener("astro:visibility-change", () => {
        if (document.hidden && intervalId) { clearInterval(intervalId); intervalId = null; }
      });
        if (intervalId) clearInterval(intervalId);
      });
    });
  </script>
</BaseLayout>
