---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="Two-Factor Code" description="Generate & validasi kode 2FA TOTP (RFC 6238). 100% client-side WebCrypto.">
  <ToolPageHeader title="Two-Factor Code" desc="Generate & verifikasi kode TOTP 6-digit" icon='<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>' />

  <div class="card-base p-5 space-y-4">
    <div>
      <label for="secret" class="block text-sm text-matte-500 mb-1 font-medium" data-i18n="totp.secret_label">Secret (Base32)</label>
      <div class="flex gap-2">
        <input id="secret" type="text" class="input-field flex-1 font-mono text-sm" placeholder="JBSWY3DPEHPK3PXP">
        <button id="gen-key" class="btn-secondary text-sm" data-i18n="totp.gen_key">Generate Key</button>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div class="card-base p-4 text-center bg-gradient-to-br from-accent-blue/5 to-transparent">
        <p class="text-xs text-matte-400" data-i18n="totp.current">Kode Saat Ini</p>
        <p class="text-4xl font-mono font-bold text-accent-blue tracking-widest" id="code">------</p>
      </div>
      <div class="card-base p-4 text-center bg-gradient-to-br from-accent-amber/5 to-transparent">
        <p class="text-xs text-matte-400" data-i18n="totp.valid_until">Berlaku Sampai</p>
        <p class="text-xl font-bold text-accent-amber" id="remaining">--</p>
        <div class="h-1 bg-matte-200 dark:bg-matte-700 rounded-full mt-2 overflow-hidden">
          <div id="timer-bar" class="h-full bg-accent-amber rounded-full transition-all" style="width:100%"></div>
        </div>
      </div>
    </div>

    <div>
      <label for="verify-code" class="block text-sm text-matte-500 mb-1 font-medium" data-i18n="totp.verify_label">Verifikasi Kode</label>
      <div class="flex gap-2">
        <input id="verify-code" type="text" class="input-field w-32 text-center font-mono text-lg tracking-widest" maxlength="6" placeholder="000000">
        <button id="verify-btn" class="btn-primary" data-i18n="totp.verify_btn">Verifikasi</button>
      </div>
      <p id="verify-result" class="text-sm mt-1"></p>
    </div>
  </div>
</BaseLayout>

<script>
  import { t } from '../../i18n/translations';
  const toast = (msg, type = 'success') => window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const ALPHA = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';

  function base32Decode(str) {
    str = str.toUpperCase().replace(/[^A-Z2-7]/g, '');
    let bits = 0, value = 0, result = [];
    for (let i=0; i<str.length; i++) {
      value = (value << 5) | ALPHA.indexOf(str[i]);
      bits += 5;
      if (bits >= 8) { result.push((value >>> (bits-8)) & 0xFF); bits -= 8; }
    }
    return new Uint8Array(result);
  }

  async function generateTOTP(secret) {
    const key = base32Decode(secret);
    const counter = Math.floor((Date.now()/1000 - 0) / 30);
    const buf = new ArrayBuffer(8); const dv = new DataView(buf); dv.setBigUint64(0, BigInt(counter), false);
    const hmacKey = await crypto.subtle.importKey('raw', key, { name: 'HMAC', hash: 'SHA-1' }, false, ['sign']);
    const sig = new Uint8Array(await crypto.subtle.sign('HMAC', hmacKey, buf));
    const offset = sig[sig.length-1] & 0x0F;
    const otp = ((sig[offset] & 0x7F) << 24 | sig[offset+1] << 16 | sig[offset+2] << 8 | sig[offset+3]) % 1000000;
    return String(otp).padStart(6, '0');
  }

  function generateKey() {
    const bytes = crypto.getRandomValues(new Uint8Array(10));
    let s = '';
    for (let i=0; i<10; i++) s += ALPHA[(bytes[i] & 0x1F)];
    return s;
  }

  document.getElementById('gen-key').addEventListener('click', () => {
    document.getElementById('secret').value = generateKey();
  });
  if (!document.getElementById('secret').value) document.getElementById('secret').value = generateKey();

  async function update() {
    const codeEl = document.getElementById('code');
    const secretEl = document.getElementById('secret');
    // Null-guard: setelah SPA nav elemen lama hilang tapi interval masih jalan.
    if (!codeEl || !secretEl) return;
    const secret = secretEl.value.trim().replace(/\s+/g, '');
    if (!secret) { codeEl.textContent = '------'; return; }
    try {
      const code = await generateTOTP(secret);
      codeEl.textContent = code;
      const sec = 30 - (Math.floor(Date.now()/1000) % 30);
      document.getElementById('remaining').textContent = sec + ' ' + t('totp.sec', 'detik');
      document.getElementById('timer-bar').style.width = (sec/30*100) + '%';
    } catch {
      // Dulu `catch {}` kosong → secret salah format gagal senyap tanpa penjelasan.
      codeEl.textContent = '------';
      toast(t('totp.err_secret', 'Secret tidak valid — harus Base32 (A-Z, 2-7).'), 'error');
    }
  }

  document.getElementById('secret').addEventListener('input', update);
  // Interval disimpan supaya bisa dibersihkan — dulu `setInterval` tanpa clear
  // terus berjalan tiap detik setelah SPA nav (bocor, elemen sudah null).
  __totpTimer = setInterval(update, 1000);
  update();

  // Toleransi ±1 langkah waktu (30 detik ke belakang) — sesuai perilaku authenticator
  // standar & RFC 6238 §5.2, jadi kode yang telanjur kadaluarsa masih diterima.
  async function verifyAgainst(secret, code, stepOffset) {
    try {
      const key = base32Decode(secret);
      const counter = Math.floor(Date.now()/1000/30) + stepOffset;
      const buf = new ArrayBuffer(8); const dv = new DataView(buf); dv.setBigUint64(0, BigInt(counter), false);
      const hmacKey = await crypto.subtle.importKey('raw', key, { name: 'HMAC', hash: 'SHA-1' }, false, ['sign']);
      const sig = new Uint8Array(await crypto.subtle.sign('HMAC', hmacKey, buf));
      const offset = sig[sig.length-1] & 0x0F;
      const otp = ((sig[offset] & 0x7F) << 24 | sig[offset+1] << 16 | sig[offset+2] << 8 | sig[offset+3]) % 1000000;
      return String(otp).padStart(6, '0') === code;
    } catch { return false; }
  }

  document.getElementById('verify-btn').addEventListener('click', async () => {
    const res = document.getElementById('verify-result');
    const code = document.getElementById('verify-code').value.trim();
    const secret = document.getElementById('secret').value.trim().replace(/\s+/g, '');
    if (!secret) { toast(t('totp.need_secret', 'Isi secret dulu.'), 'info'); return; }
    if (!/^\d{6}$/.test(code)) {
      res.textContent = t('totp.err_format', '❌ Masukkan 6 digit angka.');
      res.className = 'text-sm mt-1 text-red-500';
      return;
    }
    let ok = false;
    for (const off of [0, -1, 1]) {
      if (await verifyAgainst(secret, code, off)) { ok = true; break; }
    }
    res.textContent = ok ? t('totp.match', '✅ Kode cocok!') : t('totp.no_match', '❌ Kode tidak cocok!');
    res.className = ok ? 'text-sm mt-1 text-green-500' : 'text-sm mt-1 text-red-500';
    toast(ok ? t('totp.toast_match', 'Kode cocok!') : t('totp.toast_no_match', 'Kode tidak cocok.'), ok ? 'success' : 'error');
  });

  }

  // Cleanup lintas-navigasi: hentikan interval TOTP (module scope, CONTEXT #14).
  let __totpTimer = null;
  document.addEventListener('astro:before-swap', () => {
    if (__totpTimer) { clearInterval(__totpTimer); __totpTimer = null; }
  });

  // SPA boot (#14): guard path + guard dobel-bind
  const __securityTotpPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __securityTotpPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
