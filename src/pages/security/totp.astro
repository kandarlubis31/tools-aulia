---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="2FA Code Generator — Generate & Validasi TOTP | ToolsAulia" description="Generate & validasi kode 2FA TOTP (RFC 6238). 100% client-side WebCrypto." category="Security" toolHref="/security/totp">
  <ToolPageHeader title="Two-Factor Code" description="Generate & verifikasi kode TOTP 6-digit" icon='<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>' />

  <div class="card-base p-5 space-y-4">
    <div>
      <label class="block text-sm text-matte-500 mb-1 font-medium">Secret (Base32)</label>
      <div class="flex gap-2">
        <input id="secret" type="text" class="input-field flex-1 font-mono text-sm" placeholder="JBSWY3DPEHPK3PXP">
        <button id="gen-key" class="btn-secondary text-sm">Generate Key</button>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div class="card-base p-4 text-center bg-gradient-to-br from-accent-blue/5 to-transparent">
        <p class="text-xs text-matte-400">Kode Saat Ini</p>
        <p class="text-4xl font-mono font-bold text-accent-blue tracking-widest" id="code">------</p>
      </div>
      <div class="card-base p-4 text-center bg-gradient-to-br from-accent-amber/5 to-transparent">
        <p class="text-xs text-matte-400">Berlaku Sampai</p>
        <p class="text-xl font-bold text-accent-amber" id="remaining">--</p>
        <div class="h-1 bg-matte-200 dark:bg-matte-700 rounded-full mt-2 overflow-hidden">
          <div id="timer-bar" class="h-full bg-accent-amber rounded-full transition-all" style="width:100%"></div>
        </div>
      </div>
    </div>

    <div>
      <label class="block text-sm text-matte-500 mb-1 font-medium">Verifikasi Kode</label>
      <div class="flex gap-2">
        <input id="verify-code" type="text" class="input-field w-32 text-center font-mono text-lg tracking-widest" maxlength="6" placeholder="000000">
        <button id="verify-btn" class="btn-primary">Verifikasi</button>
      </div>
      <p id="verify-result" class="text-sm mt-1"></p>
    </div>
  </div>
</BaseLayout>

<script>
  const { showToast, _tToast } = window as any;
  const ALPHA = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';

  function base32Decode(str) {
    str = str.toUpperCase().replace(/[^A-Z2-7]/g, '');
    let bits = 0, value = 0, result = [];
    for (let i=0; i<str.length; i++) {
      value = (value << 5) | ALPHA.indexOf(str[i]);
      bits += 5;
      if (bits >= 8) { result.push((value >>> (bits-8)) & 0xFF); bits -= 8; }
    }
    return new Uint8Array(result);
  }

  async function generateTOTP(secret) {
    const key = base32Decode(secret);
    const counter = Math.floor((Date.now()/1000 - 0) / 30);
    const buf = new ArrayBuffer(8); const dv = new DataView(buf); dv.setBigUint64(0, BigInt(counter), false);
    const hmacKey = await crypto.subtle.importKey('raw', key, { name: 'HMAC', hash: 'SHA-1' }, false, ['sign']);
    const sig = new Uint8Array(await crypto.subtle.sign('HMAC', hmacKey, buf));
    const offset = sig[sig.length-1] & 0x0F;
    const otp = ((sig[offset] & 0x7F) << 24 | sig[offset+1] << 16 | sig[offset+2] << 8 | sig[offset+3]) % 1000000;
    return String(otp).padStart(6, '0');
  }

  function generateKey() {
    const bytes = crypto.getRandomValues(new Uint8Array(10));
    let s = '';
    for (let i=0; i<10; i++) s += ALPHA[(bytes[i] & 0x1F)];
    return s;
  }

  document.getElementById('gen-key').addEventListener('click', () => {
    document.getElementById('secret').value = generateKey();
  });
  if (!document.getElementById('secret').value) document.getElementById('secret').value = generateKey();

  async function update() {
    const secret = document.getElementById('secret').value.trim();
    if (!secret) { document.getElementById('code').textContent = '------'; return; }
    try {
      const code = await generateTOTP(secret);
      document.getElementById('code').textContent = code;
      const sec = 30 - (Math.floor(Date.now()/1000) % 30);
      document.getElementById('remaining').textContent = sec + ' detik';
      document.getElementById('timer-bar').style.width = (sec/30*100) + '%';
    } catch {}
  }

  document.getElementById('secret').addEventListener('input', update);
  setInterval(update, 1000);
  update();

  document.getElementById('verify-btn').addEventListener('click', async () => {
    const code = document.getElementById('verify-code').value.trim();
    const current = await generateTOTP(document.getElementById('secret').value.trim()).catch(() => '');
    const res = document.getElementById('verify-result');
    if (code === current) { res.textContent = '✅ Kode cocok!'; res.className = 'text-sm mt-1 text-green-500'; }
    else { res.textContent = '❌ Kode tidak cocok!'; res.className = 'text-sm mt-1 text-red-500'; }
  });
</script>
