---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Base64 Image Encoder — Encode Gambar ke Base64 Online">
  <div class="max-w-2xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader title="Base64 Image Encoder" titleKey="header.base64_image"
      desc="Encode gambar ke base64 data URI. Copy langsung untuk embed di HTML/CSS."
      descKey="header.base64_image_desc"
      icon='<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>'
      gradient="from-violet-500 to-purple-600" />

    <div class="card-base p-6 text-center animate-fade-in">
      <div class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-8 hover:border-violet-400 transition-colors cursor-pointer mb-4" id="drop-zone">
        <input type="file" id="file-input" accept="image/*" class="hidden" />
        <p class="text-sm font-bold text-matte-500 dark:text-matte-300" data-i18n="label.upload_image">Upload gambar</p>
        <p class="text-2xs text-matte-400 mt-1" id="file-info">—</p>
      </div>

      <div id="result-area" class="hidden">
        <img id="preview-img" alt="" class="max-w-full max-h-48 mx-auto rounded-lg mb-3" />
        <div class="grid grid-cols-2 gap-3 text-center mb-3">
          <div class="p-2 rounded bg-matte-50 dark:bg-surface-elevated"><span class="text-2xs text-matte-400 block" data-i18n="label.original">Original</span><span id="orig-size" class="text-xs font-bold">—</span></div>
          <div class="p-2 rounded bg-violet-50 dark:bg-violet-900/20"><span class="text-2xs text-violet-500 block">Base64</span><span id="b64-size" class="text-xs font-bold text-violet-600 dark:text-violet-300">—</span></div>
          <div class="p-2 rounded bg-matte-50 dark:bg-surface-elevated"><span class="text-2xs text-matte-400 block" data-i18n="label.dimensions">Dimensi</span><span id="img-dim" class="text-xs font-bold">—</span></div>
          <div class="p-2 rounded bg-violet-50 dark:bg-violet-900/20"><span class="text-2xs text-violet-500 block" data-i18n="label.mime_type">Tipe MIME</span><span id="img-mime" class="text-xs font-bold text-violet-600 dark:text-violet-300">—</span></div>
        </div>
        <div class="relative"><textarea id="b64-output" rows="4" readonly class="w-full px-3 py-2 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-xs font-mono outline-none resize-y"></textarea>
          <button id="copy-btn" class="absolute top-2 right-2 px-3 py-1.5 rounded-lg text-2xs font-bold bg-violet-100 dark:bg-violet-900/40 text-violet-700 dark:text-violet-300 hover:bg-violet-200 transition-all" data-i18n="btn.copy_emoji">📋 Copy</button></div>
      </div>

      <p class="text-center text-xs text-matte-400 mt-4" data-i18n="text.privacy_local">Gambar diproses 100% di browser, tidak diupload.</p>
    </div>
  </div>
</BaseLayout>

<script>
  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
    const dropZone = document.getElementById('drop-zone')!;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const fileInfo = document.getElementById('file-info')!;
    const resultArea = document.getElementById('result-area')!;
    const previewImg = document.getElementById('preview-img') as HTMLImageElement;
    const origSize = document.getElementById('orig-size')!;
    const b64Size = document.getElementById('b64-size')!;
    const imgDim = document.getElementById('img-dim')!;
    const imgMime = document.getElementById('img-mime')!;
    const b64Output = document.getElementById('b64-output') as HTMLTextAreaElement;
    const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
      window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

    function fmt(b: number): string {
      return b < 1024 ? b + ' B' : (b / 1024).toFixed(1) + ' KB';
    }

    function processFile(file: File) {
      if (!file.type.startsWith('image/')) { toast('File bukan gambar!', 'error'); return; }
      if (file.size > 10 * 1024 * 1000) { toast('Gambar terlalu besar (maks ~10 MB)', 'error'); return; }
      fileInfo.textContent = file.name + ' (' + fmt(file.size) + ')';
      origSize.textContent = fmt(file.size);
      imgMime.textContent = file.type || '—';
      const reader = new FileReader();
      reader.onerror = () => toast('Gagal membaca file', 'error');
      reader.onload = () => {
        const b64 = reader.result as string;
        previewImg.onload = () => {
          imgDim.textContent = previewImg.naturalWidth + '×' + previewImg.naturalHeight;
        };
        previewImg.src = b64;
        b64Output.value = b64;
        b64Size.textContent = fmt(b64.length);
        resultArea.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    }

    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      const f = (e as DragEvent).dataTransfer?.files?.[0];
      if (f) processFile(f);
    });
    fileInput.addEventListener('change', () => {
      const f = fileInput.files?.[0];
      if (f) processFile(f);
    });

    document.getElementById('copy-btn')!.addEventListener('click', async () => {
      try {
        if (!b64Output.value) { toast('Belum ada hasil untuk disalin.', 'info'); return; }
        await navigator.clipboard.writeText(b64Output.value);
        toast('Base64 tersalin!');
      } catch { toast('Gagal menyalin', 'error'); }
    });
  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __securityBase64ImagePage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __securityBase64ImagePage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });
</script>
