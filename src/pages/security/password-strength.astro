---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Password Strength Checker — Cek Kekuatan Password">
  <div class="max-w-3xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Password Strength Checker"
      titleKey="header.password_strength"
      desc="Analisis kekuatan password: entropy, waktu crack, saran perbaikan."
      descKey="header.password_strength_desc"
      icon='<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 8v4"/><path d="M12 16h.01"/>'
      gradient="from-emerald-500 to-teal-600"
    />

    <div class="card-base p-6 animate-fade-in">
      <label class="section-title mb-2 block" for="password-input">Password</label>
      <div class="relative">
        <input id="password-input" type="password" class="w-full px-4 py-4 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-emerald-500 transition-colors text-sm pr-12" placeholder="Masukkan password..." autocomplete="off" />
        <button id="toggle-visibility" class="absolute right-3 top-1/2 -translate-y-1/2 text-matte-400 hover:text-matte-600 dark:hover:text-matte-300">
          <svg id="eye-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        </button>
      </div>

      <!-- Strength meter -->
      <div id="strength-meter" class="mt-4">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm text-matte-500" data-i18n="pw.strength">Kekuatan</span>
          <span id="strength-label" class="text-sm font-bold"></span>
        </div>
        <div class="w-full h-3 bg-matte-200 dark:bg-surface-hover rounded-full overflow-hidden">
          <div id="strength-bar" class="h-full transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>

      <!-- Stats -->
      <div id="stats" class="grid grid-cols-2 gap-3 mt-6">
        <div class="p-3 bg-matte-50 dark:bg-matte-900 rounded-xl border border-matte-200 dark:border-surface-border">
          <p class="text-2xs text-matte-400" data-i18n="pw.entropy">Entropy</p>
          <p id="entropy" class="text-lg font-bold text-emerald-600 dark:text-emerald-400">0 bits</p>
        </div>
        <div class="p-3 bg-matte-50 dark:bg-matte-900 rounded-xl border border-matte-200 dark:border-surface-border">
          <p class="text-2xs text-matte-400" data-i18n="pw.crack_time">Waktu crack</p>
          <p id="crack-time" class="text-lg font-bold text-emerald-600 dark:text-emerald-400">-</p>
        </div>
        <div class="p-3 bg-matte-50 dark:bg-matte-900 rounded-xl border border-matte-200 dark:border-surface-border">
          <p class="text-2xs text-matte-400">Panjang</p>
          <p id="length" class="text-lg font-bold text-emerald-600 dark:text-emerald-400">0</p>
        </div>
        <div class="p-3 bg-matte-50 dark:bg-matte-900 rounded-xl border border-matte-200 dark:border-surface-border">
          <p class="text-2xs text-matte-400">Karakter unik</p>
          <p id="unique" class="text-lg font-bold text-emerald-600 dark:text-emerald-400">0</p>
        </div>
      </div>

      <!-- Suggestions -->
      <div id="suggestions" class="mt-4 space-y-2"></div>
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      const input = document.getElementById('password-input') as HTMLInputElement;
      const toggleBtn = document.getElementById('toggle-visibility');
      const eyeIcon = document.getElementById('eye-icon');

      toggleBtn?.addEventListener('click', () => {
        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        if (eyeIcon) {
          eyeIcon.innerHTML = isPassword 
            ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>'
            : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>';
        }
      });

      function analyzePassword(password: string) {
        if (!password) return;

        // Calculate charset size
        let charsetSize = 0;
        if (/[a-z]/.test(password)) charsetSize += 26;
        if (/[A-Z]/.test(password)) charsetSize += 26;
        if (/[0-9]/.test(password)) charsetSize += 10;
        if (/[^a-zA-Z0-9]/.test(password)) charsetSize += 33;

        // Entropy
        const entropy = password.length * Math.log2(charsetSize || 1);
        
        // Strength score
        let score = 0;
        if (password.length >= 8) score++;
        if (password.length >= 12) score++;
        if (password.length >= 16) score++;
        if (/[a-z]/.test(password) && /[A-Z]/.test(password)) score++;
        if (/[0-9]/.test(password)) score++;
        if (/[^a-zA-Z0-9]/.test(password)) score++;
        if (!/(.)\1{2,}/.test(password)) score++;

        // Crack time (assuming 10 billion guesses/sec)
        const combinations = Math.pow(charsetSize, password.length);
        const seconds = combinations / 10e9;
        
        let crackTime: string;
        if (seconds < 1) crackTime = 'Instan';
        else if (seconds < 60) crackTime = `${Math.round(seconds)} detik`;
        else if (seconds < 3600) crackTime = `${Math.round(seconds / 60)} menit`;
        else if (seconds < 86400) crackTime = `${Math.round(seconds / 3600)} jam`;
        else if (seconds < 31536000) crackTime = `${Math.round(seconds / 86400)} hari`;
        else if (seconds < 31536000 * 1000) crackTime = `${Math.round(seconds / 31536000)} tahun`;
        else if (seconds < 31536000 * 1e6) crackTime = `${Math.round(seconds / 31536000 / 1000)} ribu tahun`;
        else crackTime = 'Tidak bisa di-crack';

        // Update UI
        const strengthBar = document.getElementById('strength-bar');
        const strengthLabel = document.getElementById('strength-label');
        
        let strength: string;
        let color: string;
        let width: string;

        if (score <= 2) { strength = 'Lemah'; color = 'bg-red-500'; width = '25%'; }
        else if (score <= 4) { strength = 'Cukup'; color = 'bg-yellow-500'; width = '50%'; }
        else if (score <= 5) { strength = 'Kuat'; color = 'bg-blue-500'; width = '75%'; }
        else { strength = 'Sangat Kuat'; color = 'bg-green-500'; width = '100%'; }

        if (strengthBar) { strengthBar.className = `h-full transition-all duration-300 ${color}`; strengthBar.style.width = width; }
        if (strengthLabel) { strengthLabel.textContent = strength; strengthLabel.className = `text-sm font-bold ${color.replace('bg-', 'text-')}`; }

        document.getElementById('entropy')!.textContent = `${Math.round(entropy)} bits`;
        document.getElementById('crack-time')!.textContent = crackTime;
        document.getElementById('length')!.textContent = password.length.toString();
        document.getElementById('unique')!.textContent = new Set(password).size.toString();

        // Suggestions
        const suggestions: string[] = [];
        if (password.length < 8) suggestions.push('Gunakan minimal 8 karakter');
        if (!/[a-z]/.test(password)) suggestions.push('Tambah huruf kecil');
        if (!/[A-Z]/.test(password)) suggestions.push('Tambah huruf besar');
        if (!/[0-9]/.test(password)) suggestions.push('Tambah angka');
        if (!/[^a-zA-Z0-9]/.test(password)) suggestions.push('Tambah simbol (!@#$%)');
        if (/(.)\1{2,}/.test(password)) suggestions.push('Hindari karakter berulang');

        const sugEl = document.getElementById('suggestions');
        if (sugEl) {
          sugEl.innerHTML = suggestions.map(s => `
            <div class="flex items-center gap-2 p-2 bg-amber-50 dark:bg-amber-900/20 rounded-lg">
              <span class="text-amber-500">⚠️</span>
              <span class="text-sm text-amber-700 dark:text-amber-300">${s}</span>
            </div>
          `).join('');
        }
      }

      input?.addEventListener('input', () => analyzePassword(input.value));
    });
  </script>
</BaseLayout>
