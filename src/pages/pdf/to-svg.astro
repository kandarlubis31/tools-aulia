---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="PDF to SVG — Render Halaman PDF ke SVG | ToolsAulia" description="Render halaman PDF sebagai SVG vector. 100% client-side." category="PDF" toolHref="/pdf/to-svg">
  <ToolPageHeader title="PDF to SVG" description="Render halaman PDF ke SVG — vector scalable" icon='<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>' />

  <div class="card-base p-5 space-y-4">
    <div id="drop-zone" class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-8 text-center cursor-pointer hover:border-accent-blue transition-colors">
      <span>📄 Drop PDF di sini</span>
      <input type="file" id="file-input" class="hidden" accept=".pdf">
    </div>

    <div id="controls" class="hidden space-y-3">
      <div class="flex gap-3 items-center">
        <span class="text-sm text-matte-500" id="filename"></span>
        <input id="page-num" type="number" min="1" value="1" class="input-field w-20 text-sm">
        <button id="render-btn" class="btn-primary text-sm">Render</button>
        <button id="download-svg" class="btn-secondary text-sm">⬇️ SVG</button>
        <button id="copy-svg" class="btn-secondary text-sm">📋 Copy SVG</button>
      </div>

      <div class="bg-white rounded-lg shadow p-2 flex justify-center overflow-auto" id="svg-container"></div>

      <div id="progress-area" class="hidden">
        <div class="h-2 bg-matte-200 dark:bg-matte-700 rounded-full overflow-hidden">
          <div id="progress-bar" class="h-full bg-accent-blue rounded-full" style="width:0%"></div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  let pdfDoc, pageCount;

  document.getElementById('file-input').addEventListener('change', handler);
  const dz = document.getElementById('drop-zone');
  dz.addEventListener('click', () => document.getElementById('file-input').click());
  dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('border-accent-blue'); });
  dz.addEventListener('dragleave', () => dz.classList.remove('border-accent-blue'));
  dz.addEventListener('drop', e => { e.preventDefault(); dz.classList.remove('border-accent-blue'); handler({ target: { files: e.dataTransfer.files } }); });

  async function handler(e) {
    const f = e.target.files[0]; if (!f) return;
    const pdfjsLib = await import('../../composables/useCdnLib').then(m => m.waitForCdnLib('pdfjs'));
    pdfDoc = await pdfjsLib.getDocument({ data: new Uint8Array(await f.arrayBuffer()) }).promise;
    pageCount = pdfDoc.numPages;
    document.getElementById('page-num').max = pageCount;
    document.getElementById('filename').textContent = f.name + ' (' + pageCount + ' hlm)';
    document.getElementById('controls').classList.remove('hidden');
    dz.classList.add('hidden');
    renderPage();
  }

  async function renderPage() {
    const pageNum = parseInt(document.getElementById('page-num').value) || 1;
    const page = await pdfDoc.getPage(Math.min(pageNum, pageCount));
    const vp = page.getViewport({ scale: 2 });
    const canvas = document.createElement('canvas'); canvas.width = vp.width; canvas.height = vp.height;
    const ctx = canvas.getContext('2d');
    await page.render({ canvasContext: ctx, viewport: vp }).promise;

    // Convert canvas to SVG via data URI
    const dataUrl = canvas.toDataURL('image/png');
    const svg = '<svg xmlns="http://www.w3.org/2000/svg" width="'+vp.width+'" height="'+vp.height+'" viewBox="0 0 '+vp.width+' '+vp.height+'">\n  <image href="'+dataUrl+'" width="'+vp.width+'" height="'+vp.height+'"/>\n</svg>';
    document.getElementById('svg-container').innerHTML = '<div class="text-xs text-matte-400">SVG generated ('+vp.width+'×'+vp.height+')</div>';

    document.getElementById('download-svg').onclick = () => {
      const blob = new Blob([svg], { type: 'image/svg+xml' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'page-'+pageNum+'.svg'; a.click();
    };
    document.getElementById('copy-svg').onclick = () => {
      navigator.clipboard.writeText(svg).then(() => showToast?.(_tToast?.('SVG disalin!','SVG copied!'),'success'));
    };
  }

  document.getElementById('page-num').addEventListener('change', renderPage);
  document.getElementById('render-btn').addEventListener('click', renderPage);
</script>
