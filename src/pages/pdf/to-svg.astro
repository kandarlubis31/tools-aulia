---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="PDF to SVG" description="Render halaman PDF sebagai SVG vector. 100% client-side.">
  <ToolPageHeader title="PDF to SVG" desc="Render halaman PDF ke SVG — vector scalable" icon='<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>' />

  <div class="card-base p-5 space-y-4">
    <div id="drop-zone" class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-8 text-center cursor-pointer hover:border-accent-blue transition-colors">
      <span data-i18n="pdfsvg.drop">📄 Drop PDF di sini</span>
      <input type="file" id="file-input" class="hidden" accept=".pdf">
    </div>

    <div id="controls" class="hidden space-y-3">
      <div class="flex flex-wrap gap-3 items-center">
        <span class="text-sm text-matte-500" id="filename"></span>
        <label for="page-num" class="text-sm text-matte-500" data-i18n="pdfsvg.page">Halaman</label>
        <input id="page-num" type="number" min="1" value="1" class="input-field w-20 text-sm">
        <button id="render-btn" class="btn-primary text-sm" data-i18n="pdfsvg.render">Render</button>
        <button id="download-svg" class="btn-secondary text-sm" data-i18n="pdfsvg.download">⬇️ SVG</button>
        <button id="copy-svg" class="btn-secondary text-sm" data-i18n="pdfsvg.copy">📋 Copy SVG</button>
      </div>

      <div class="bg-white rounded-lg shadow p-2 flex justify-center overflow-auto" id="svg-container"></div>

      <div id="progress-area" class="hidden">
        <div class="h-2 bg-matte-200 dark:bg-matte-700 rounded-full overflow-hidden">
          <div id="progress-bar" class="h-full bg-accent-blue rounded-full" style="width:0%"></div>
        </div>
        <p id="status-text" class="text-sm text-matte-500 mt-2 text-center"></p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { t } from '../../i18n/translations';
  const toast = (msg, type = 'success') => window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  async function init() {
  let pdfDoc, pageCount, baseName = 'page';

  document.getElementById('file-input').addEventListener('change', handler);
  const dz = document.getElementById('drop-zone');
  dz.addEventListener('click', () => document.getElementById('file-input').click());
  dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('border-accent-blue'); });
  dz.addEventListener('dragleave', () => dz.classList.remove('border-accent-blue'));
  dz.addEventListener('drop', e => { e.preventDefault(); dz.classList.remove('border-accent-blue'); handler({ target: { files: e.dataTransfer.files } }); });

  // Load pdf.js lokal dari /vendor/pdfjs/ (offline-first). Kalau belum ada,
  // inject script dinamis — sama seperti repair/text-search/to-excel.
  async function loadPdfJs() {
    if ((window as any).pdfjsLib) return (window as any).pdfjsLib;
    return new Promise((resolve) => {
      const s = document.createElement('script');
      s.src = '/vendor/pdfjs/pdf.min.js';
      s.onload = () => resolve((window as any).pdfjsLib);
      s.onerror = () => resolve(null);
      document.head.appendChild(s);
    });
  }

  async function handler(e) {
    const f = e.target.files[0]; if (!f) return;
    if (!/\.pdf$/i.test(f.name) && f.type !== 'application/pdf') { toast(t('pdfsvg.err_type', 'Hanya file PDF yang didukung.'), 'error'); return; }
    document.getElementById('controls').classList.remove('hidden');
    document.getElementById('progress-area').classList.remove('hidden');
    document.getElementById('status-text').textContent = t('pdfsvg.loading', 'Memuat PDF...');
    try {
      const pdfjsLib = await loadPdfJs();
      if (!pdfjsLib) { toast(t('pdfsvg.err_lib', 'Library PDF gagal dimuat — cek koneksi internet.'), 'error'); return; }
      pdfjsLib.GlobalWorkerOptions.workerSrc = '/vendor/pdfjs/pdf.worker.min.js';
      pdfDoc = await pdfjsLib.getDocument({ data: new Uint8Array(await f.arrayBuffer()) }).promise;
    } catch {
      document.getElementById('progress-area').classList.add('hidden');
      toast(t('pdfsvg.err_load', 'Gagal memuat PDF.'), 'error');
      return;
    }
    pageCount = pdfDoc.numPages;
    baseName = f.name.replace(/\.pdf$/i, '') || 'page';
    document.getElementById('page-num').max = pageCount;
    document.getElementById('filename').textContent = f.name + ' (' + pageCount + ' ' + t('pdfsvg.pages', 'hlm') + ')';
    document.getElementById('progress-area').classList.add('hidden');
    dz.classList.add('hidden');
    renderPage();
  }

  async function renderPage() {
    if (!pdfDoc) return;
    let pageNum = parseInt(document.getElementById('page-num').value, 10) || 1;
    // Validasi rentang: nomor di luar 1..pageCount dulu diam-diam di-clamp tanpa penjelasan.
    if (pageNum < 1 || pageNum > pageCount) {
      toast(t('pdfsvg.invalid_page', 'Halaman tidak valid.'), 'error');
      pageNum = Math.max(1, Math.min(pageNum, pageCount));
      document.getElementById('page-num').value = pageNum;
    }
    document.getElementById('progress-area').classList.remove('hidden');
    document.getElementById('status-text').textContent = t('pdfsvg.rendering', 'Merender...');
    try {
      const page = await pdfDoc.getPage(pageNum);
      const vp = page.getViewport({ scale: 2 });
      const canvas = document.createElement('canvas'); canvas.width = vp.width; canvas.height = vp.height;
      const ctx = canvas.getContext('2d');
      await page.render({ canvasContext: ctx, viewport: vp }).promise;

      // Convert canvas to SVG via embedded raster image
      const dataUrl = canvas.toDataURL('image/png');
      const svg = '<svg xmlns="http://www.w3.org/2000/svg" width="'+vp.width+'" height="'+vp.height+'" viewBox="0 0 '+vp.width+' '+vp.height+'">\n  <image href="'+dataUrl+'" width="'+vp.width+'" height="'+vp.height+'"/>\n</svg>';
      document.getElementById('svg-container').innerHTML = '<div class="text-xs text-matte-400">SVG ' + t('pdfsvg.generated', 'dibuat') + ' ('+vp.width+'×'+vp.height+')</div>';

      document.getElementById('download-svg').onclick = () => {
        try {
          const blob = new Blob([svg], { type: 'image/svg+xml' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a'); a.href = url; a.download = baseName + '-page-' + pageNum + '.svg'; a.click();
          setTimeout(() => URL.revokeObjectURL(url), 1000);
          toast(t('pdfsvg.downloaded', 'SVG di-download!'));
        } catch { toast(t('pdfsvg.err_download', 'Gagal mengunduh SVG.'), 'error'); }
      };
      document.getElementById('copy-svg').onclick = async () => {
        try { await navigator.clipboard.writeText(svg); toast(t('pdfsvg.copied', 'SVG disalin!')); }
        catch { toast(t('pdfsvg.copy_fail', 'Gagal menyalin.'), 'error'); }
      };
    } catch {
      toast(t('pdfsvg.err_render', 'Gagal merender halaman.'), 'error');
    } finally {
      document.getElementById('progress-area').classList.add('hidden');
    }
  }

  document.getElementById('page-num').addEventListener('change', renderPage);
  document.getElementById('render-btn').addEventListener('click', renderPage);

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __pdfToSvgPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __pdfToSvgPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
