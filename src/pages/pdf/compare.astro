---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="PDF Compare" pdfJs={true}>
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh] py-10">
    <ToolPageHeader title="PDF Compare" titleKey="header.pdf_compare" desc="Bandingkan 2 file PDF side-by-side untuk melihat perbedaan." descKey="header.pdf_compare_desc" icon='<rect x="2" y="3" width="8" height="18" rx="2"/><rect x="14" y="3" width="8" height="18" rx="2"/><line x1="12" y1="7" x2="12" y2="17"/>' gradient="from-indigo-500 to-violet-600" />
    <div class="grid gap-6 animate-fade-in">
      <div class="grid grid-cols-2 gap-4">
        <div id="drop-a" class="border-2 border-dashed border-indigo-300 dark:border-indigo-700 rounded-2xl p-8 text-center cursor-pointer hover:border-indigo-400 transition-colors"><input type="file" id="file-a" accept=".pdf,application/pdf" class="hidden" /><p class="text-matte-500 font-bold" data-i18n="pdf.cmp.pdf_a">📄 PDF A</p><p class="text-xs text-matte-400 mt-1" id="name-a" data-i18n="pdf.cmp.drop">Drop atau klik</p></div>
        <div id="drop-b" class="border-2 border-dashed border-indigo-300 dark:border-indigo-700 rounded-2xl p-8 text-center cursor-pointer hover:border-indigo-400 transition-colors"><input type="file" id="file-b" accept=".pdf,application/pdf" class="hidden" /><p class="text-matte-500 font-bold" data-i18n="pdf.cmp.pdf_b">📄 PDF B</p><p class="text-xs text-matte-400 mt-1" id="name-b" data-i18n="pdf.cmp.drop">Drop atau klik</p></div>
      </div>
      <div class="flex gap-4">
        <button id="compare" class="flex-1 py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 transition-colors" data-i18n="btn.compare">🔍 Bandingkan</button>
        <label class="sr-only" for="view" data-i18n="pdf.cmp.mode">Mode tampilan</label>
        <select id="view" class="p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold"><option value="side" data-i18n="pdf.cmp.side">Side by Side</option><option value="overlay" data-i18n="pdf.cmp.overlay">Overlay</option></select>
      </div>
      <div id="result" class="hidden"><div id="canvas-container" class="flex gap-2 overflow-x-auto p-2 bg-matte-100 dark:bg-surface-hover rounded-xl"></div><div id="stats" class="mt-4 p-4 bg-matte-50 dark:bg-surface-hover rounded-xl border border-matte-200 dark:border-surface-border"></div></div>
    </div>
  </div>
</BaseLayout>
<script>
import { t } from '../../i18n/translations';

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  let pdfA: any = null, pdfB: any = null;
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  function setupDrop(id: string) {
    const drop = document.getElementById('drop-' + id) as HTMLElement;
    const input = document.getElementById('file-' + id) as HTMLInputElement;
    drop.addEventListener('click', () => input.click());
    drop.addEventListener('dragover', e => { e.preventDefault(); drop.classList.add('border-indigo-500'); });
    drop.addEventListener('dragleave', () => drop.classList.remove('border-indigo-500'));
    drop.addEventListener('drop', e => { e.preventDefault(); drop.classList.remove('border-indigo-500'); handleFile((e as DragEvent).dataTransfer?.files[0], id); });
    input.addEventListener('change', () => handleFile(input.files?.[0], id));
  }

  async function handleFile(file: File | undefined, id: string) {
    if (!file) return;
    if (file.type !== 'application/pdf') { toast('File harus PDF!', 'error'); return; }
    (document.getElementById('name-' + id) as HTMLElement).textContent = file.name;
    try {
      let pdfjsLib: any = null;
      for (let i = 0; i < 50 && !pdfjsLib; i++) { pdfjsLib = (window as any).pdfjsLib; if (!pdfjsLib) await new Promise(r => setTimeout(r, 100)); }
      if (!pdfjsLib) throw new Error('pdf.js belum siap');
      const pdf = await pdfjsLib.getDocument({ data: await file.arrayBuffer() }).promise;
      if (id === 'a') pdfA = pdf; else pdfB = pdf;
      toast('PDF ' + id.toUpperCase() + ': ' + pdf.numPages + ' halaman');
    } catch {
      if (id === 'a') pdfA = null; else pdfB = null;
      toast('PDF gagal dimuat — file mungkin korup', 'error');
    }
  }

  async function renderPage(pdf: any, pageNum: number, canvas: HTMLCanvasElement) {
    const page = await pdf.getPage(pageNum);
    const vp = page.getViewport({ scale: 1.5 });
    canvas.width = vp.width;
    canvas.height = vp.height;
    await page.render({ canvasContext: canvas.getContext('2d')!, viewport: vp }).promise;
  }

  document.getElementById('compare')!.addEventListener('click', async () => {
    if (!pdfA || !pdfB) { toast('Upload kedua PDF dulu!', 'error'); return; }
    const container = document.getElementById('canvas-container') as HTMLElement;
    const stats = document.getElementById('stats') as HTMLElement;
    const overlay = (document.getElementById('view') as HTMLSelectElement).value === 'overlay';
    container.innerHTML = '';
    const maxPages = Math.max(pdfA.numPages, pdfB.numPages);
    const shown = Math.min(maxPages, 10);
    for (let i = 1; i <= shown; i++) {
      const wrap = document.createElement('div');
      wrap.className = 'flex-shrink-0';
      const label = document.createElement('p');
      label.className = 'text-xs text-center text-matte-500 mb-1 font-bold';
      label.textContent = t('pdf.cmp.hal', 'Hal {n}').replace('{n}', String(i));
      wrap.appendChild(label);
      if (overlay) {
        // Overlay: dua canvas ditumpuk absolute, B semi-transparan merah di atas A
        const box = document.createElement('div');
        box.className = 'relative border rounded-lg bg-white dark:bg-matte-800';
        const cA = document.createElement('canvas');
        const cB = document.createElement('canvas');
        cB.className = 'absolute inset-0 opacity-50 mix-blend-multiply';
        box.append(cA, cB);
        wrap.appendChild(box);
        const jobs: Promise<void>[] = [];
        if (i <= pdfA.numPages) jobs.push(renderPage(pdfA, i, cA));
        if (i <= pdfB.numPages) jobs.push(renderPage(pdfB, i, cB).then(() => { cA.width = cB.width; cA.height = cB.height; }));
        await Promise.all(jobs).catch(() => {});
        if (i > pdfA.numPages) cA.remove();
        if (i > pdfB.numPages) cB.remove();
      } else {
        if (i <= pdfA.numPages) { const c = document.createElement('canvas'); c.className = 'border rounded-lg'; wrap.appendChild(c); renderPage(pdfA, i, c).catch(() => {}); }
        if (i <= pdfB.numPages) { const c = document.createElement('canvas'); c.className = 'border rounded-lg'; wrap.appendChild(c); renderPage(pdfB, i, c).catch(() => {}); }
      }
      container.appendChild(wrap);
    }
    stats.textContent = t('pdf.cmp.stats', 'PDF A: {a} halaman | PDF B: {b} halaman | Ditampilkan: {s} halaman')
      .replace('{a}', String(pdfA.numPages)).replace('{b}', String(pdfB.numPages)).replace('{s}', String(shown));
    document.getElementById('result')!.classList.remove('hidden');
  });

  setupDrop('a'); setupDrop('b');

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __pdfComparePage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __pdfComparePage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
