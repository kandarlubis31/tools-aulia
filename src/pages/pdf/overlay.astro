---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="PDF Overlay — Tumpuk PDF dengan Opacity | ToolsAulia" description="Tumpuk satu PDF di atas PDF lain dengan opacity. 100% client-side." category="PDF" toolHref="/pdf/overlay">
  <ToolPageHeader title="PDF Overlay" description="Tumpuk 2 PDF jadi satu dengan opacity & posisi" icon='<rect x="3" y="3" width="18" height="18" rx="2"/><rect x="9" y="9" width="13" height="13" rx="2"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div id="zone-bg" class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-6 text-center cursor-pointer hover:border-accent-blue transition-colors">
        <span id="bg-placeholder">📄 Background PDF</span>
        <span id="bg-name" class="hidden text-sm text-matte-500 font-medium"></span>
        <input type="file" id="bg-input" class="hidden" accept=".pdf">
      </div>
      <div id="zone-ov" class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-6 text-center cursor-pointer hover:border-accent-cyan transition-colors">
        <span id="ov-placeholder">📄 Overlay PDF</span>
        <span id="ov-name" class="hidden text-sm text-matte-500 font-medium"></span>
        <input type="file" id="ov-input" class="hidden" accept=".pdf">
      </div>
    </div>

    <div class="flex flex-wrap gap-3 items-end">
      <div>
        <label class="block text-xs text-matte-500 mb-1">Opacity Overlay (%)</label>
        <input id="opacity" type="range" min="10" max="100" value="50" class="w-32">
        <span id="opacity-val" class="text-sm text-matte-500 ml-1">50%</span>
      </div>
      <div>
        <label class="block text-xs text-matte-500 mb-1">Posisi X (pt)</label>
        <input id="pos-x" type="number" value="0" class="input-field w-20 text-sm">
      </div>
      <div>
        <label class="block text-xs text-matte-500 mb-1">Posisi Y (pt)</label>
        <input id="pos-y" type="number" value="0" class="input-field w-20 text-sm">
      </div>
    </div>

    <div id="progress-area" class="hidden">
      <div class="h-2 bg-matte-200 dark:bg-matte-700 rounded-full overflow-hidden">
        <div id="progress-bar" class="h-full bg-gradient-to-r from-accent-blue to-accent-cyan rounded-full transition-all" style="width:0%"></div>
      </div>
      <p id="status-text" class="text-sm text-matte-500 mt-2 text-center"></p>
    </div>

    <button id="apply-btn" class="btn-primary w-full" disabled>Terapkan Overlay & Download PDF</button>
  </div>
</BaseLayout>

<script>
  let bgBytes, ovBytes;

  function setupZone(zoneId, inputId, nameId, placeholderId, setter) {
    const zone = document.getElementById(zoneId);
    const input = document.getElementById(inputId);
    const nameEl = document.getElementById(nameId);
    const placeholder = document.getElementById(placeholderId);
    zone.addEventListener('click', () => input.click());
    zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('border-accent-blue'); });
    zone.addEventListener('dragleave', () => zone.classList.remove('border-accent-blue'));
    zone.addEventListener('drop', e => {
      e.preventDefault(); zone.classList.remove('border-accent-blue');
      const f = e.dataTransfer.files[0]; if (f) load(f);
    });
    input.addEventListener('change', () => { const f = input.files[0]; if (f) load(f); });
    async function load(file) {
      setter(new Uint8Array(await file.arrayBuffer()));
      placeholder.classList.add('hidden'); nameEl.textContent = file.name; nameEl.classList.remove('hidden');
      if (bgBytes && ovBytes) document.getElementById('apply-btn').disabled = false;
    }
  }

  setupZone('zone-bg', 'bg-input', 'bg-name', 'bg-placeholder', b => bgBytes = b);
  setupZone('zone-ov', 'ov-input', 'ov-name', 'ov-placeholder', b => ovBytes = b);

  document.getElementById('opacity').addEventListener('input', function() {
    document.getElementById('opacity-val').textContent = this.value + '%';
  });

  document.getElementById('apply-btn').addEventListener('click', async () => {
    const progress = document.getElementById('progress-area');
    const bar = document.getElementById('progress-bar');
    const st = document.getElementById('status-text');
    progress.classList.remove('hidden');

    st.textContent = _tToast?.('Memproses...', 'Processing...') || 'Processing...';
    bar.style.width = '30%';
    const mod = await import('../../composables/useCdnLib').then(m => m.waitForCdnLib('pdf-lib'));
    const { PDFDocument } = mod;

    const bgDoc = await PDFDocument.load(bgBytes);
    const ovDoc = await PDFDocument.load(ovBytes);
    bar.style.width = '60%';

    const op = parseInt(document.getElementById('opacity').value) / 100;
    const ox = parseInt(document.getElementById('pos-x').value) || 0;
    const oy = parseInt(document.getElementById('pos-y').value) || 0;

    const bgPages = bgDoc.getPages();
    for (let i = 0; i < bgPages.length; i++) {
      try {
        const ovPage = await bgDoc.embedPage(ovDoc.getPages()[Math.min(i, ovDoc.getPageCount()-1)]);
        bgPages[i].drawPage(ovPage, { x: ox, y: oy, opacity: op });
      } catch {}
      bar.style.width = (30 + 60 * (i+1)/bgPages.length) + '%';
      await new Promise(r => setTimeout(r, 5));
    }

    const out = await bgDoc.save();
    const blob = new Blob([out], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = 'overlay-result.pdf';
    a.click(); URL.revokeObjectURL(url);

    st.textContent = _tToast?.('PDF overlay berhasil!', 'PDF overlay complete!') || 'Done!';
    showToast?.(_tToast?.('Download dimulai!', 'Download started!'), 'success');
    setTimeout(() => progress.classList.add('hidden'), 2000);
  });
</script>
