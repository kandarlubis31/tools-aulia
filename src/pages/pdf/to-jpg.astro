---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="PDF to Image Converter">
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" async></script>
  <script is:inline async>
    (function waitForPdfjs() {
      if (window.pdfjsLib) {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      } else {
        setTimeout(waitForPdfjs, 50);
      }
    })();
  </script>

  <div class="flex flex-col items-center justify-center min-h-[60vh]">
    <div class="max-w-4xl w-full bg-white dark:bg-matte-800 p-8 rounded-2xl border border-matte-200 dark:border-matte-700 shadow-xl text-center">
      <h1 class="text-3xl font-bold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-orange-500" data-i18n="header.pdf_to_image">
        PDF to Image Converter
      </h1>
      <p class="text-matte-600 dark:text-matte-400 mb-6" data-i18n="header.pdf_to_image_desc">Ubah halaman PDF menjadi gambar JPG atau PNG. Pilih format sesuai kebutuhan.</p>

      <!-- Format Selector -->
      <div class="flex items-center justify-center gap-2 mb-6">
        <span class="text-sm font-semibold text-matte-600 dark:text-matte-400 mr-2" data-i18n="label.output_format">Format Output</span>
        <div class="inline-flex bg-matte-100 dark:bg-matte-700 rounded-lg p-1 border border-matte-200 dark:border-matte-600">
          <button id="fmt-jpg" class="px-4 py-2 rounded-md text-sm font-bold transition-all bg-red-500 text-white shadow">JPG</button>
          <button id="fmt-png" class="px-4 py-2 rounded-md text-sm font-bold transition-all text-matte-500 dark:text-matte-400 hover:text-matte-700 dark:hover:text-matte-200">PNG</button>
        </div>
      </div>

      <div 
        id="drop-zone"
        class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-10 cursor-pointer hover:border-red-500 hover:bg-matte-50 dark:hover:bg-matte-700/50 transition-all mt-4"
      >
        <div class="flex flex-col items-center gap-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-matte-400"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><circle cx="12" cy="14" r="3"/></svg>
          <span class="text-matte-500 dark:text-matte-300 font-medium" data-i18n="text.choose_pdf_file">Pilih file PDF Anda</span>
          <input type="file" id="file-input" accept="application/pdf" class="hidden" />
        </div>
      </div>

      <div id="results" class="hidden mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        </div>
      
      <div id="loading" class="hidden mt-8 text-red-500 font-bold animate-pulse" data-i18n="text.processing_pdf_pages">
        Memproses halaman PDF...
      </div>

      <button id="reset-btn" class="hidden mt-8 mx-auto text-matte-500 hover:text-red-500" data-i18n="btn.reset_reupload">Reset / Upload Ulang</button>
    </div>
  </div>
</BaseLayout>

<script>
  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input');
  const resultsDiv = document.getElementById('results');
  const loadingDiv = document.getElementById('loading');
  const resetBtn = document.getElementById('reset-btn');
  const fmtJpg = document.getElementById('fmt-jpg');
  const fmtPng = document.getElementById('fmt-png');

  // State: 'jpg' or 'png'
  let outputFormat = 'jpg';

  // Format toggle
  function setFormat(fmt) {
    outputFormat = fmt;
    if (fmt === 'jpg') {
      fmtJpg.className = 'px-4 py-2 rounded-md text-sm font-bold transition-all bg-red-500 text-white shadow';
      fmtPng.className = 'px-4 py-2 rounded-md text-sm font-bold transition-all text-matte-500 dark:text-matte-400 hover:text-matte-700 dark:hover:text-matte-200';
    } else {
      fmtPng.className = 'px-4 py-2 rounded-md text-sm font-bold transition-all bg-red-500 text-white shadow';
      fmtJpg.className = 'px-4 py-2 rounded-md text-sm font-bold transition-all text-matte-500 dark:text-matte-400 hover:text-matte-700 dark:hover:text-matte-200';
    }
  }

  fmtJpg?.addEventListener('click', () => setFormat('jpg'));
  fmtPng?.addEventListener('click', () => setFormat('png'));

  // Trigger Input
  dropZone?.addEventListener('click', () => fileInput.click());

  // Drag & Drop handlers
  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-red-500', 'bg-red-50', 'dark:bg-red-700/30');
  });
  dropZone?.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-red-500', 'bg-red-50', 'dark:bg-red-700/30');
  });
  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-red-500', 'bg-red-50', 'dark:bg-red-700/30');
    const file = e.dataTransfer?.files?.[0];
    if (file && file.type === 'application/pdf') {
      processPDF(file);
    } else {
      window.showToast?.(window._tToast ? window._tToast("Harap upload file PDF!") : "Harap upload file PDF!", 'error');
    }
  });

  fileInput?.addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (file && file.type === 'application/pdf') {
      await processPDF(file);
    } else {
      window.showToast?.(window._tToast ? window._tToast("Harap upload file PDF!") : "Harap upload file PDF!", 'error');
    }
  });

  async function processPDF(file) {
    dropZone.classList.add('hidden');
    loadingDiv.classList.remove('hidden');
    resultsDiv.innerHTML = '';
    
    try {
      const arrayBuffer = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument(arrayBuffer).promise;
      
      loadingDiv.classList.add('hidden');
      resultsDiv.classList.remove('hidden');
      resetBtn.classList.remove('hidden');

      // Loop setiap halaman
      for (let i = 1; i <= pdf.numPages; i++) {
        const page = await pdf.getPage(i);
        const viewport = page.getViewport({ scale: 1.5 }); // Scale 1.5 biar tajem
        
        // Buat Canvas
        const canvas = document.createElement('canvas');
        const context = canvas.getContext('2d');
        if (!context) continue;
        canvas.height = viewport.height;
        canvas.width = viewport.width;

        // Isi background putih hanya untuk JPG (PNG biarkan transparan)
        if (outputFormat === 'jpg') {
          context.fillStyle = '#FFFFFF';
          context.fillRect(0, 0, canvas.width, canvas.height);
        }

        // Render Page ke Canvas
        await page.render({ canvasContext: context, viewport: viewport }).promise;

        // Convert Canvas ke Image (JPG dengan kompresi, PNG lossless + transparansi)
        const mimeType = outputFormat === 'png' ? 'image/png' : 'image/jpeg';
        const imgUrl = outputFormat === 'png' ? canvas.toDataURL('image/png') : canvas.toDataURL('image/jpeg', 0.8);
        
        // Buat Card Tampilan
        const ext = outputFormat === 'png' ? 'png' : 'jpg';
        const labelKey = outputFormat === 'png' ? 'btn.download_png' : 'btn.download_jpg';
        const downloadLabel = outputFormat === 'png' ? 'Download PNG' : 'Download JPG';
        
        const card = document.createElement('div');
        card.className = "bg-matte-50 dark:bg-matte-700 p-3 rounded-xl border border-matte-200 dark:border-matte-600 shadow-sm flex flex-col gap-3";
        card.innerHTML = `
          <div class="relative overflow-hidden rounded-lg border border-matte-200" style="${outputFormat === 'png' ? 'background-image: repeating-conic-gradient(#e5e7eb 0% 25%, transparent 0% 50%) 50% / 20px 20px;' : ''}">
            <img src="${imgUrl}" class="w-full h-auto" alt="Converted PDF page" />
            <span class="absolute top-2 left-2 bg-black/50 text-white text-xs px-2 py-1 rounded"><span data-i18n="text.page_x">Halaman</span> ${i}</span>
          </div>
          <a href="${imgUrl}" download="page-${i}.${ext}" class="w-full bg-red-500 hover:bg-red-600 text-white text-sm font-bold py-2 rounded-lg text-center transition-colors" data-i18n="${labelKey}">
            ${downloadLabel}
          </a>
        `;
        resultsDiv.appendChild(card);
      }

    } catch (err) {
      window.showToast?.(window._tToast ? window._tToast("Gagal memproses PDF. File mungkin rusak atau terpassword.") : "Gagal memproses PDF. File mungkin rusak atau terpassword.", 'error');
      loadingDiv.classList.add('hidden');
      dropZone.classList.remove('hidden');
    }
  }

  resetBtn?.addEventListener('click', () => {
    fileInput.value = '';
    resultsDiv.classList.add('hidden');
    resultsDiv.innerHTML = '';
    resetBtn.classList.add('hidden');
    dropZone.classList.remove('hidden');
  });
</script>