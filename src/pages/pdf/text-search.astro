---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="PDF Text Search — Cari Teks di PDF Online">
  <div class="max-w-2xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader title="PDF Text Search" titleKey="header.pdf_text_search"
      desc="Cari teks/keyword di dalam PDF. Lihat halaman mana yang mengandung kata kunci."
      descKey="header.pdf_text_search_desc"
      icon='<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/>'
      gradient="from-cyan-500 to-blue-600" />

    <div class="card-base p-6 text-center animate-fade-in">
      <div class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-8 hover:border-cyan-400 transition-colors cursor-pointer mb-4" id="drop-zone">
        <input type="file" id="file-input" accept=".pdf" class="hidden" />
        <p class="text-sm font-bold text-matte-500 dark:text-matte-300">Upload PDF</p>
        <p class="text-2xs text-matte-400 mt-1" id="file-name">—</p>
      </div>

      <div class="flex gap-2 mb-4">
        <input id="search-input" type="text" placeholder="Kata kunci…" class="flex-1 px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm outline-none focus:ring-2 focus:ring-cyan-500/40" />
        <button id="search-btn" class="gradient-brand px-6 py-2.5 rounded-lg text-sm font-bold">🔍 Search</button>
      </div>

      <div id="results-area" class="text-left">
        <p class="text-xs text-matte-400 text-center py-4">Upload PDF & cari kata kunci.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load',()=>{
    const dropZone=document.getElementById('drop-zone')!,fileInput=document.getElementById('file-input') as HTMLInputElement;
    const fileName=document.getElementById('file-name')!,searchInput=document.getElementById('search-input') as HTMLInputElement;
    const searchBtn=document.getElementById('search-btn') as HTMLButtonElement;
    const resultsArea=document.getElementById('results-area')!;
    let pdfDoc:any=null;

    async function loadPdfJs(){if((window as any).pdfjsLib)return(window as any).pdfjsLib;return new Promise(r=>{const s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';s.onload=()=>r((window as any).pdfjsLib);document.head.appendChild(s);})}

    async function processFile(file:File){
      fileName.textContent=file.name;resultsArea.innerHTML='<p class=\"text-xs text-matte-400 text-center py-4\">Loading PDF…</p>';
      const pdfjsLib=await loadPdfJs();pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      pdfDoc=await pdfjsLib.getDocument({data:await file.arrayBuffer()}).promise;
      resultsArea.innerHTML=`<p class=\"text-xs text-matte-400 text-center py-4\">✅ ${pdfDoc.numPages} halaman siap. Cari kata kunci.</p>`;
    }

    dropZone.addEventListener('click',()=>fileInput.click());
    dropZone.addEventListener('dragover',e=>{e.preventDefault();});
    dropZone.addEventListener('drop',e=>{e.preventDefault();const f=e.dataTransfer?.files?.[0];if(f)processFile(f);});
    fileInput.addEventListener('change',()=>{const f=fileInput.files?.[0];if(f)processFile(f);});

    searchBtn.addEventListener('click',async()=>{
      const q=searchInput.value.trim().toLowerCase();if(!q||!pdfDoc){showToast('Upload PDF & masukkan kata kunci','error');return;}
      searchBtn.disabled=true;searchBtn.innerHTML='⏳…';const results:{page:number,text:string}[]=[];
      for(let p=1;p<=pdfDoc.numPages;p++){
        const page=await pdfDoc.getPage(p);const tc=await page.getTextContent();
        const text=tc.items.map((i:any)=>i.str).join(' ');
        if(text.toLowerCase().includes(q)){const idx=text.toLowerCase().indexOf(q);const ctx=text.slice(Math.max(0,idx-40),idx+q.length+40);results.push({page:p,text:'…'+ctx+'…'});}
      }
      resultsArea.innerHTML=results.length
        ?`<div class=\"space-y-2\"><span class=\"text-xs text-matte-400\">Ditemukan di ${results.length} halaman:</span>`+results.map(r=>`<div class=\"p-2 rounded bg-matte-50 dark:bg-surface-elevated\"><span class=\"text-xs font-bold text-cyan-600 dark:text-cyan-400\">Hal. ${r.page}</span><p class=\"text-xs text-matte-600 dark:text-matte-300 font-mono mt-0.5\">${escHtml(r.text)}</p></div>`).join('')+'</div>'
        :'<p class=\"text-xs text-matte-400 text-center py-4\">Tidak ditemukan.</p>';
      searchBtn.disabled=false;searchBtn.innerHTML='🔍 Search';
    });

    function escHtml(s:string):string{return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
  });
</script>
