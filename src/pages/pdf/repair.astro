---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="PDF Repair — Perbaiki & Recover File PDF Online">
  <div class="max-w-2xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="PDF Repair"
      titleKey="header.pdf_repair"
      desc="Perbaiki PDF rusak/corrupt: parse tolerant + rebuild struktur PDF."
      descKey="header.pdf_repair_desc"
      icon='<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>'
      gradient="from-amber-500 to-orange-600"
    />

    <div class="card-base p-6 text-center animate-fade-in">
      <div class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-8 hover:border-amber-400 transition-colors cursor-pointer mb-4" id="drop-zone">
        <input type="file" id="file-input" accept=".pdf" class="hidden" />
        <svg class="w-12 h-12 mx-auto mb-3 text-matte-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        <p class="text-sm font-bold text-matte-500 dark:text-matte-300" data-i18n="pdf.repair.upload">Upload PDF yang rusak</p>
        <p class="text-2xs text-matte-400 mt-1" id="file-name">—</p>
      </div>

      <div id="repair-progress-wrap" class="hidden mb-4">
        <div class="flex justify-between text-2xs text-matte-400 mb-1">
          <span data-i18n="common.processing">Memproses...</span>
          <span id="repair-progress-label">0/0</span>
        </div>
        <div class="h-1.5 rounded-full bg-matte-100 dark:bg-surface-elevated overflow-hidden">
          <div id="repair-progress-bar" class="h-full bg-amber-500 transition-all duration-150" style="width:0%"></div>
        </div>
      </div>

      <div id="result-area" class="hidden">
        <div id="status-card" class="p-4 rounded-lg bg-matte-50 dark:bg-surface-elevated mb-4">
          <p id="status-msg" class="text-sm font-bold"></p>
          <p id="pages-info" class="text-xs text-matte-400 mt-1"></p>
        </div>
        <button id="download-btn" class="gradient-brand px-6 py-3 rounded-lg text-sm font-bold" data-i18n="pdf.repair.download">
          💾 Download PDF Hasil Repair
        </button>
      </div>
    </div>

    <p class="text-center text-xs text-matte-400 mt-6" data-i18n="pdf.repair.note">
      ⚠️ Tidak semua PDF bisa diperbaiki. Tool ini mencoba re-parse dengan pdf.js tolerant mode + rebuild dengan pdf-lib.
    </p>
  </div>
</BaseLayout>

<script>
const __page = (location.pathname.replace(/\/+$/, '') || '/');

document.addEventListener('astro:page-load', () => {
  if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;

  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileName = document.getElementById('file-name')!;
  const progressWrap = document.getElementById('repair-progress-wrap')!;
  const progressBar = document.getElementById('repair-progress-bar')!;
  const progressLabel = document.getElementById('repair-progress-label')!;
  const resultArea = document.getElementById('result-area')!;
  const statusMsg = document.getElementById('status-msg')!;
  const pagesInfo = document.getElementById('pages-info')!;
  const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;

  const toast = (m: string, t: 'success' | 'error' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(m) : m, t);

  let repairedBytes: Uint8Array | null = null;
  let origName = 'document';

  async function loadScript(src: string, globalName: string): Promise<any> {
    if ((window as any)[globalName]) return (window as any)[globalName];
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src;
      s.onload = () => resolve((window as any)[globalName]);
      s.onerror = () => reject(new Error('load ' + src));
      document.head.appendChild(s);
    });
  }

  function baseName(name: string): string {
    return name.replace(/\.pdf$/i, '').replace(/[^\w\-]+/g, '-').slice(0, 40) || 'document';
  }

  async function processFile(file: File) {
    fileName.textContent = file.name;
    origName = baseName(file.name);
    resultArea.classList.add('hidden');
    progressWrap.classList.remove('hidden');

    try {
      const [pdfjsLib, PDFLib] = await Promise.all([
        loadScript('/vendor/pdfjs/pdf.min.js', 'pdfjsLib'),
        loadScript('/vendor/pdf-lib/pdf-lib.min.js', 'PDFLib'),
      ]);
      pdfjsLib.GlobalWorkerOptions.workerSrc = '/vendor/pdfjs/pdf.worker.min.js';

      const buffer = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: buffer }).promise;
      const totalPages = pdf.numPages;

      // Rebuild dengan pdf-lib: tiap halaman di-render jadi PNG lalu di-embed ulang
      const newDoc = await PDFLib.PDFDocument.create();
      let okPages = 0;

      for (let p = 1; p <= totalPages; p++) {
        try {
          const page = await pdf.getPage(p);
          const viewport = page.getViewport({ scale: 1 });
          const canvas = document.createElement('canvas');
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          const ctx = canvas.getContext('2d')!;
          await page.render({ canvasContext: ctx, viewport }).promise;

          const imgBytes = await new Promise<Uint8Array>((resolve) => {
            canvas.toBlob(async (blob) => {
              if (!blob) { resolve(new Uint8Array()); return; }
              resolve(new Uint8Array(await blob.arrayBuffer()));
            }, 'image/png');
          });

          if (imgBytes.length > 0) {
            const img = await newDoc.embedPng(imgBytes);
            const newPage = newDoc.addPage([viewport.width, viewport.height]);
            newPage.drawImage(img, { x: 0, y: 0, width: viewport.width, height: viewport.height });
            okPages++;
          }
        } catch { /* skip corrupted page */ }

        const pct = Math.round((p / totalPages) * 100);
        progressBar.style.width = pct + '%';
        progressLabel.textContent = `${p}/${totalPages}`;
        if (p % 5 === 0) await new Promise((r) => setTimeout(r, 0));
      }

      progressWrap.classList.add('hidden');
      progressBar.style.width = '0%';

      if (okPages === 0) {
        statusMsg.innerHTML = '❌ <span class="fail-label">Gagal memperbaiki PDF</span>';
        statusMsg.className = 'text-sm font-bold text-red-600 dark:text-red-400';
        pagesInfo.textContent = '';
        resultArea.classList.remove('hidden');
        toast('Tidak ada halaman yang bisa dipulihkan.', 'error');
        return;
      }

      repairedBytes = await newDoc.save();
      statusMsg.innerHTML = '✅ <span class="ok-label">PDF berhasil diperbaiki!</span>';
      statusMsg.className = 'text-sm font-bold text-emerald-600 dark:text-emerald-400';
      pagesInfo.innerHTML = `<b>${okPages}</b>/<b>${totalPages}</b> <span class="pages-label">halaman direkonstruksi</span>`;
      resultArea.classList.remove('hidden');
      resultArea.scrollIntoView({ behavior: 'smooth' });
    } catch {
      progressWrap.classList.add('hidden');
      statusMsg.innerHTML = '❌ <span class="fail-label">Gagal memperbaiki PDF</span>';
      statusMsg.className = 'text-sm font-bold text-red-600 dark:text-red-400';
      pagesInfo.textContent = '';
      resultArea.classList.remove('hidden');
      toast('Gagal memperbaiki PDF.', 'error');
    }
  }

  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-amber-400', 'bg-amber-50/50', 'dark:bg-amber-900/10'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-amber-400', 'bg-amber-50/50', 'dark:bg-amber-900/10'));
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-amber-400', 'bg-amber-50/50', 'dark:bg-amber-900/10');
    const file = (e as DragEvent).dataTransfer?.files?.[0];
    if (file) processFile(file);
  });
  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) processFile(file);
    fileInput.value = '';
  });

  downloadBtn.addEventListener('click', () => {
    if (!repairedBytes) return;
    try {
      const blob = new Blob([repairedBytes], { type: 'application/pdf' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `${origName}-repaired.pdf`;
      a.click();
      URL.revokeObjectURL(a.href);
      toast('PDF diperbaiki didownload!');
    } catch {
      toast('Gagal mengunduh!', 'error');
    }
  });
});
</script>
