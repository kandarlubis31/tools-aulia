---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Word to PDF — Konversi DOCX ke PDF Online">
  <div class="max-w-3xl mx-auto px-4 min-h-[70vh]">
    <ToolPageHeader
      title="Word to PDF"
      desc="Konversi dokumen Word (.docx) menjadi PDF. 100% di browser — file tidak pernah di-upload."
      icon='<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6"/><path d="m8.5 12 1.5 1.5L14.5 9"/>'
      gradient="from-rose-500 to-indigo-600"
    />

    <div class="card-base p-5 md:p-6 animate-fade-in space-y-4">
      <!-- Drop zone -->
      <div id="drop-zone" class="border-2 border-dashed border-rose-300 dark:border-rose-800 rounded-2xl p-10 text-center cursor-pointer hover:border-rose-400 transition-colors">
        <input type="file" id="file-input" accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document" class="hidden" />
        <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-3 text-rose-500"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>
        <p class="font-bold text-matte-700 dark:text-white">Drop file .docx di sini atau klik</p>
        <p class="text-xs text-matte-400 mt-1">Format Word modern (.docx). Maksimal ~15 MB. Tidak di-upload ke server.</p>
        <p id="file-name" class="text-sm font-semibold text-rose-500 mt-2"></p>
      </div>

      <!-- Options -->
      <div class="flex flex-wrap items-center gap-3 justify-between">
        <div class="flex gap-2 items-center">
          <label class="text-xs font-bold uppercase text-matte-400" for="paper-size">Kertas</label>
          <select id="paper-size" class="text-sm bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border rounded-lg px-3 py-2 text-matte-700 dark:text-matte-200">
            <option value="a4">A4</option>
            <option value="letter">Letter</option>
            <option value="legal">Legal</option>
          </select>
        </div>
        <div class="flex gap-2 items-center">
          <label class="text-xs font-bold uppercase text-matte-400" for="orientation">Orientasi</label>
          <select id="orientation" class="text-sm bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border rounded-lg px-3 py-2 text-matte-700 dark:text-matte-200">
            <option value="portrait">Portrait</option>
            <option value="landscape">Landscape</option>
          </select>
        </div>
      </div>

      <!-- Convert -->
      <button id="convert-btn" disabled class="w-full bg-gradient-to-r from-rose-500 to-indigo-600 hover:from-rose-600 hover:to-indigo-700 disabled:opacity-40 disabled:cursor-not-allowed text-white font-bold py-3.5 rounded-xl shadow-lg shadow-rose-500/20 transition-all active:scale-[0.99] flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>Download PDF</span>
      </button>

      <!-- Info -->
      <div class="text-xs text-matte-400 bg-matte-100 dark:bg-surface-hover rounded-xl p-4 leading-relaxed">
        <p class="font-bold text-matte-600 dark:text-matte-300 mb-1">Yang perlu diketahui</p>
        <ul class="list-disc list-inside space-y-0.5">
          <li>Konversi mempertahankan struktur: heading, paragraf, list, tabel, gambar, bold/italic.</li>
          <li>Format kompleks (kolom, header/footer Word, smart art) bisa berbeda dari aslinya.</li>
          <li>File diproses lokal di browser — tidak ada upload, cocok untuk dokumen internal/perusahaan.</li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { loadCdnLib } from '../../composables/useCdnLib';

  const dropZone = document.getElementById('drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileNameEl = document.getElementById('file-name') as HTMLParagraphElement;
  const convertBtn = document.getElementById('convert-btn') as HTMLButtonElement;
  const paperSize = document.getElementById('paper-size') as HTMLSelectElement;
  const orientation = document.getElementById('orientation') as HTMLSelectElement;

  const MAX_SIZE = 15 * 1024 * 1024; // 15 MB
  let selectedFile: File | null = null;
  let busy = false;

  function setFile(file: File | null) {
    if (!file) return;
    const isDocx = /\.docx$/i.test(file.name) || file.type === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
    if (!isDocx) {
      window.showToast?.('Hanya file .docx yang didukung. Simpan dokumen Word lama (.doc) sebagai .docx dulu.', 'warning');
      return;
    }
    if (file.size > MAX_SIZE) {
      window.showToast?.('File terlalu besar (maksimal ~15 MB) untuk diproses di browser.', 'warning');
      return;
    }
    selectedFile = file;
    fileNameEl.textContent = file.name + ' (' + (file.size / 1024 / 1024).toFixed(2) + ' MB)';
    convertBtn.disabled = false;
  }

  // Drop zone interactions
  dropZone.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files[0]) setFile(fileInput.files[0]);
    fileInput.value = '';
  });
  ['dragover', 'dragenter'].forEach(ev => dropZone.addEventListener(ev, (e) => {
    e.preventDefault();
    dropZone.classList.add('border-rose-500', 'bg-rose-500/5');
  }));
  ['dragleave', 'drop'].forEach(ev => dropZone.addEventListener(ev, (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-rose-500', 'bg-rose-500/5');
  }));
  dropZone.addEventListener('drop', (e) => {
    const dt = (e as DragEvent).dataTransfer;
    if (dt && dt.files && dt.files[0]) setFile(dt.files[0]);
  });

  convertBtn.addEventListener('click', async () => {
    if (!selectedFile || busy) return;
    busy = true;
    const original = convertBtn.innerHTML;
    convertBtn.innerHTML = '<span>⏳ Memuat konverter...</span>';
    convertBtn.disabled = true;

    try {
      // 1) mammoth (bundled npm, vendor local — bukan CDN)
      const mammoth = await import('mammoth');
      const arrayBuffer = await selectedFile.arrayBuffer();

      convertBtn.innerHTML = '<span>⏳ Membaca dokumen...</span>';
      const result = await mammoth.convertToHtml({ arrayBuffer });
      const html = result.value;

      if (!html || !html.trim()) {
        window.showToast?.('Dokumen kosong atau tidak bisa dibaca.', 'error');
        return;
      }

      // 2) html2pdf via CDN fallback chain (pola html-to-pdf)
      convertBtn.innerHTML = '<span>⏳ Memuat library PDF...</span>';
      const cdnReady = await loadCdnLib('html2pdf', [
        'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js',
        'https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js',
        'https://unpkg.com/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js',
      ]);
      if (!cdnReady) {
        window.showToast?.('Gagal memuat library PDF. Cek koneksi internet.', 'error');
        return;
      }

      // 3) Render ke elemen offscreen lalu generate PDF
      convertBtn.innerHTML = '<span>⏳ Membuat PDF...</span>';
      const PRINT_CSS = `*, *::before, *::after { box-sizing: border-box; } body { margin: 0; font-family: system-ui, -apple-system, sans-serif; line-height: 1.55; color: #1e293b; font-size: 14px; } p { margin: 0.5em 0; } table { border-collapse: collapse; width: 100%; } td, th { border: 1px solid #cbd5e1; padding: 6px 8px; } img { max-width: 100%; height: auto; } h1,h2,h3,h4 { margin: 0.8em 0 0.4em; line-height: 1.25; } ul, ol { padding-left: 1.4em; }`;

      const tmp = document.createElement('div');
      tmp.innerHTML = `<style>${PRINT_CSS}</style>${html}`;
      tmp.style.cssText = 'position:absolute;left:-9999px;top:0;width:180mm;padding:15mm;background:#fff;';
      document.body.appendChild(tmp);

      const baseName = selectedFile.name.replace(/\.docx$/i, '');
      await (window as any).html2pdf().set({
        margin: 0,
        filename: baseName + '.pdf',
        image: { type: 'jpeg', quality: 0.96 },
        html2canvas: { scale: 2, logging: false, useCORS: true },
        jsPDF: { unit: 'mm', format: paperSize.value, orientation: orientation.value },
        pagebreak: { mode: ['css', 'legacy'] },
      }).from(tmp).save();

      window.showToast?.('PDF berhasil dibuat!', 'success');
    } catch (err) {
      console.error('word-to-pdf error:', err);
      window.showToast?.('Gagal mengonversi dokumen. Pastikan file .docx valid dan tidak terproteksi.', 'error');
    } finally {
      busy = false;
      convertBtn.innerHTML = original;
      convertBtn.disabled = !selectedFile;
    }
  });
</script>
