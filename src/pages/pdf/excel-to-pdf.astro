---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Excel to PDF — Konversi XLSX ke PDF Online">
  <div class="max-w-3xl mx-auto px-4 min-h-[70vh]">
    <ToolPageHeader
      title="Excel to PDF"
      desc="Konversi spreadsheet Excel (.xlsx/.csv) menjadi PDF dengan tabel rapi. 100% di browser — tanpa upload."
      icon='<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/>'
      gradient="from-emerald-500 to-green-600"
    />

    <div class="card-base p-5 md:p-6 animate-fade-in space-y-4">
      <!-- Drop zone -->
      <div id="drop-zone" class="border-2 border-dashed border-emerald-300 dark:border-emerald-800 rounded-2xl p-10 text-center cursor-pointer hover:border-emerald-400 transition-colors">
        <input type="file" id="file-input" accept=".xlsx,.xls,.csv" class="hidden" />
        <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-3 text-emerald-500"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 3v18"/></svg>
        <p class="font-bold text-matte-700 dark:text-white">Drop file Excel di sini atau klik</p>
        <p class="text-xs text-matte-400 mt-1">Format: .xlsx, .xls, .csv — maksimal ~10 MB. File tidak di-upload ke server.</p>
        <p id="file-name" class="text-sm font-semibold text-emerald-500 mt-2"></p>
      </div>

      <!-- Sheet + options -->
      <div id="options-row" class="hidden flex-wrap items-center gap-3 justify-between flex">
        <div class="flex gap-2 items-center">
          <label class="text-xs font-bold uppercase text-matte-400" for="sheet-select">Sheet</label>
          <select id="sheet-select" class="text-sm bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border rounded-lg px-3 py-2 text-matte-700 dark:text-matte-200 max-w-[220px]"></select>
        </div>
        <div class="flex gap-2 items-center">
          <label class="text-xs font-bold uppercase text-matte-400" for="paper-size">Kertas</label>
          <select id="paper-size" class="text-sm bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border rounded-lg px-3 py-2 text-matte-700 dark:text-matte-200">
            <option value="a4">A4</option>
            <option value="letter">Letter</option>
            <option value="legal">Legal</option>
          </select>
        </div>
        <div class="flex gap-2 items-center">
          <label class="text-xs font-bold uppercase text-matte-400" for="orientation">Orientasi</label>
          <select id="orientation" class="text-sm bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border rounded-lg px-3 py-2 text-matte-700 dark:text-matte-200">
            <option value="portrait">Portrait</option>
            <option value="landscape">Landscape</option>
          </select>
        </div>
      </div>

      <!-- Convert -->
      <button id="convert-btn" disabled class="w-full bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 disabled:opacity-40 disabled:cursor-not-allowed text-white font-bold py-3.5 rounded-xl shadow-lg shadow-emerald-500/20 transition-all active:scale-[0.99] flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>Download PDF</span>
      </button>

      <!-- Info -->
      <div class="text-xs text-matte-400 bg-matte-100 dark:bg-surface-hover rounded-xl p-4 leading-relaxed">
        <p class="font-bold text-matte-600 dark:text-matte-300 mb-1">Yang perlu diketahui</p>
        <ul class="list-disc list-inside space-y-0.5">
          <li>Satu sheet = satu PDF. Pilih sheet yang mau dikonversi di dropdown.</li>
          <li>Tabel lebar lebih rapi pakai orientasi Landscape.</li>
          <li>Rumus diekspor sebagai nilai hasilnya. Format sel kompleks mungkin tampil berbeda.</li>
          <li>File diproses lokal di browser — tidak ada upload, cocok untuk data internal/perusahaan.</li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { loadCdnLib } from '../../composables/useCdnLib';

  const dropZone = document.getElementById('drop-zone') as HTMLDivElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileNameEl = document.getElementById('file-name') as HTMLParagraphElement;
  const optionsRow = document.getElementById('options-row') as HTMLDivElement;
  const sheetSelect = document.getElementById('sheet-select') as HTMLSelectElement;
  const paperSize = document.getElementById('paper-size') as HTMLSelectElement;
  const orientation = document.getElementById('orientation') as HTMLSelectElement;
  const convertBtn = document.getElementById('convert-btn') as HTMLButtonElement;

  const MAX_SIZE = 10 * 1024 * 1024; // 10 MB
  const XLSX_URLS = [
    'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js',
    'https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js',
    'https://unpkg.com/xlsx@0.18.5/dist/xlsx.full.min.js',
  ];

  let selectedFile: File | null = null;
  let workbook: any = null;
  let busy = false;

  function escapeHtml(s: unknown): string {
    return String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  }

  async function setFile(file: File | null) {
    if (!file) return;
    const ok = /\.(xlsx|xls|csv)$/i.test(file.name);
    if (!ok) {
      window.showToast?.('Hanya file .xlsx, .xls, atau .csv yang didukung.', 'warning');
      return;
    }
    if (file.size > MAX_SIZE) {
      window.showToast?.('File terlalu besar (maksimal ~10 MB) untuk diproses di browser.', 'warning');
      return;
    }

    selectedFile = file;
    fileNameEl.textContent = file.name + ' (' + (file.size / 1024 / 1024).toFixed(2) + ' MB)';
    convertBtn.disabled = true;
    sheetSelect.innerHTML = '<option>membaca...</option>';

    // Load SheetJS lalu parse workbook untuk isi dropdown sheet
    const ready = await loadCdnLib('XLSX', XLSX_URLS);
    if (!ready) {
      window.showToast?.('Gagal memuat library Excel. Cek koneksi internet.', 'error');
      sheetSelect.innerHTML = '<option>—</option>';
      return;
    }
    try {
      const XLSX = (window as any).XLSX;
      const buf = await file.arrayBuffer();
      workbook = XLSX.read(buf, { type: 'array' });
      const names: string[] = workbook.SheetNames ?? [];
      if (names.length === 0) {
        window.showToast?.('Workbook tidak punya sheet.', 'error');
        sheetSelect.innerHTML = '<option>—</option>';
        return;
      }
      sheetSelect.innerHTML = names.map((n: string) => `<option value="${escapeHtml(n)}">${escapeHtml(n)}</option>`).join('');
      optionsRow.classList.remove('hidden');
      convertBtn.disabled = false;
    } catch (err) {
      console.error('excel-to-pdf parse error:', err);
      workbook = null;
      selectedFile = null;
      fileNameEl.textContent = '';
      sheetSelect.innerHTML = '<option>—</option>';
      window.showToast?.('Gagal membaca file. Pastikan format Excel valid dan tidak terproteksi.', 'error');
    }
  }

  // Drop zone interactions
  dropZone.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files[0]) setFile(fileInput.files[0]);
    fileInput.value = '';
  });
  ['dragover', 'dragenter'].forEach(ev => dropZone.addEventListener(ev, (e) => {
    e.preventDefault();
    dropZone.classList.add('border-emerald-500', 'bg-emerald-500/5');
  }));
  ['dragleave', 'drop'].forEach(ev => dropZone.addEventListener(ev, (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-emerald-500', 'bg-emerald-500/5');
  }));
  dropZone.addEventListener('drop', (e) => {
    const dt = (e as DragEvent).dataTransfer;
    if (dt && dt.files && dt.files[0]) setFile(dt.files[0]);
  });

  convertBtn.addEventListener('click', async () => {
    if (!selectedFile || !workbook || busy) return;
    const sheetName = sheetSelect.value;
    if (!sheetName || !workbook.Sheets?.[sheetName]) {
      window.showToast?.('Pilih sheet dulu.', 'warning');
      return;
    }
    busy = true;
    const original = convertBtn.innerHTML;
    convertBtn.innerHTML = '<span>⏳ Memuat library PDF...</span>';
    convertBtn.disabled = true;

    try {
      const XLSX = (window as any).XLSX;
      const sheet = workbook.Sheets[sheetName];

      // Sheet → HTML table (SheetJS sheet_to_html)
      convertBtn.innerHTML = '<span>⏳ Menyiapkan tabel...</span>';
      const rawHtml: string = XLSX.utils.sheet_to_html(sheet, { id: 'xl-table', header: '', footer: '' });

      // html2pdf via CDN fallback chain (pola html-to-pdf)
      const cdnReady = await loadCdnLib('html2pdf', [
        'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js',
        'https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js',
        'https://unpkg.com/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js',
      ]);
      if (!cdnReady) {
        window.showToast?.('Gagal memuat library PDF. Cek koneksi internet.', 'error');
        return;
      }

      convertBtn.innerHTML = '<span>⏳ Membuat PDF...</span>';
      const PRINT_CSS = `*, *::before, *::after { box-sizing: border-box; } body { margin: 0; font-family: system-ui, -apple-system, sans-serif; color: #1e293b; font-size: 12px; } table { border-collapse: collapse; width: 100%; } td, th { border: 1px solid #cbd5e1; padding: 5px 7px; word-break: break-word; } td:first-child, th:first-child { background: #f1f5f9; font-weight: 600; } tr:nth-child(even) td { background: #fafafa; }`;

      const tmp = document.createElement('div');
      tmp.innerHTML = `<style>${PRINT_CSS}</style>${rawHtml}`;
      tmp.style.cssText = 'position:absolute;left:-9999px;top:0;width:180mm;padding:12mm;background:#fff;';
      document.body.appendChild(tmp);

      const baseName = selectedFile.name.replace(/\.(xlsx|xls|csv)$/i, '');
      await (window as any).html2pdf().set({
        margin: 0,
        filename: baseName + '-' + sheetName.replace(/[^\w-]+/g, '_') + '.pdf',
        image: { type: 'jpeg', quality: 0.96 },
        html2canvas: { scale: 2, logging: false, useCORS: true },
        jsPDF: { unit: 'mm', format: paperSize.value, orientation: orientation.value },
        pagebreak: { mode: ['css', 'legacy'] },
      }).from(tmp).save();

      window.showToast?.('PDF berhasil dibuat!', 'success');
    } catch (err) {
      console.error('excel-to-pdf error:', err);
      window.showToast?.('Gagal membuat PDF dari sheet ini. Coba sheet lain atau kecilkan datanya.', 'error');
    } finally {
      busy = false;
      convertBtn.innerHTML = original;
      convertBtn.disabled = !selectedFile || !workbook;
    }
  });
</script>
