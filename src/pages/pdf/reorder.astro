---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Reorder PDF Pages" pdfJs={true}>
  <div class="max-w-6xl mx-auto px-4 min-h-[80vh]">
        <ToolPageHeader
      title="Reorder Pages"
      titleKey="header.pdf_reorder"
      desc="Seret dan lepas (Drag & Drop) halaman untuk mengatur ulang urutannya."
      descKey="header.pdf_reorder_desc"
      icon='<path d="m9 10 3-3 3 3"/><path d="m9 14 3 3 3-3"/><path d="M12 7v10"/>'
    />

    <div id="drop-zone" class="max-w-2xl mx-auto border border-dashed border-matte-300 dark:border-surface-border rounded-xl p-10 sm:p-12 cursor-pointer hover:border-matte-400 dark:hover:border-matte-500 hover:bg-matte-50/60 dark:hover:bg-surface-hover/40 transition-all group text-center animate-on-scroll">
      <div class="icon-mono w-14 h-14 rounded-xl border border-matte-200 dark:border-surface-border bg-matte-50 dark:bg-surface-elevated mx-auto mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/><rect x="8" y="8" width="8" height="8" rx="2" ry="2"/></svg>
      </div>
      <h3 class="text-2xl font-bold text-matte-700 dark:text-matte-200 mb-2" data-i18n="label.choose_pdf">Pilih PDF</h3>
      <p class="text-xs text-matte-400" data-i18n="reorder.drop_hint">PDF dengan urutan halaman yang berantakan? Seret kartu halaman untuk memperbaikinya.</p>
      <input type="file" id="file-input" accept="application/pdf" class="hidden" />
    </div>

    <div id="workspace" class="hidden pb-20 animate-fade-in">
      <div class="sticky top-24 z-40 bg-white/90 dark:bg-matte-900/90 backdrop-blur-md p-4 rounded-xl border border-matte-200 dark:border-matte-700 shadow-lg mb-8 flex justify-between items-center max-w-4xl mx-auto">
         <span class="text-sm font-bold text-matte-500" data-i18n="reorder.drag_hint">Drag halaman untuk menukar posisi</span>
         <button id="save-btn" class="bg-violet-600 hover:bg-violet-700 text-white font-bold py-2 px-6 rounded-lg shadow-lg transition-all active:scale-95 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            <span data-i18n="reorder.save">Simpan Urutan Baru</span>
         </button>
      </div>

      <div id="pages-grid" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4 select-none"></div>
      <p class="text-center text-xs text-matte-400 mt-6" data-i18n="reorder.privacy">Semua diproses di browser — PDF tidak pernah diupload ke mana pun.</p>
    </div>
  </div>
</BaseLayout>

<script>
  import { t } from '../../i18n/translations';

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  async function init() {
  let PDFDocument: any;
  async function _loadPdfLib() {
    if (!PDFDocument) {
      const lib = await import('pdf-lib');
      PDFDocument = lib.PDFDocument;
    }
    return PDFDocument;
  }

  const dropZone = document.getElementById('drop-zone');
  const workspace = document.getElementById('workspace');
  const pagesGrid = document.getElementById('pages-grid');
  const saveBtn = document.getElementById('save-btn');

  let currentFile = null;
  let pageOrder = []; // Array of original indices
  let draggedItem = null;

  // Drop zone (click + drag & drop) didaftarkan global via BaseLayout
  window.usePdfDropZone('drop-zone', 'file-input', {
    maxSize: 25 * 1024 * 1024,
    accentColor: 'violet',
    onFile: async (file) => {
      currentFile = file;
      dropZone.classList.add('hidden');
      workspace.classList.remove('hidden');
      await renderThumbnails(currentFile);
    },
  });

  async function renderThumbnails(file) {
    const arrayBuffer = await file.arrayBuffer();
    const pdf = await pdfjsLib.getDocument(arrayBuffer).promise;
    const totalPages = pdf.numPages;
    pageOrder = Array.from({ length: totalPages }, (_, i) => i); // [0, 1, 2, ...]

    pagesGrid.innerHTML = '';

    for (let i = 1; i <= totalPages; i++) {
      const page = await pdf.getPage(i);
      const canvas = await window.renderPageToCanvas(page, 0.5, false);
      if (!canvas) continue;
      canvas.className = "w-full h-auto rounded shadow-sm pointer-events-none";

      // Wrapper Card
      const card = document.createElement('div');
      card.className = "relative bg-matte-200 dark:bg-matte-800 p-2 rounded-lg cursor-grab active:cursor-grabbing hover:ring-2 hover:ring-violet-500 transition-all draggable-item";
      card.draggable = true;
      card.dataset.index = i - 1; // Original Index

      // Badge
      const badge = document.createElement('span');
      badge.className = "absolute top-3 left-3 bg-matte-900/80 text-white text-xs font-bold px-2 py-1 rounded shadow-sm z-10";
      badge.innerText = i;

      card.appendChild(badge);
      card.appendChild(canvas);
      pagesGrid.appendChild(card);

      // Drag Events
      card.addEventListener('dragstart', handleDragStart);
      card.addEventListener('dragover', handleDragOver);
      card.addEventListener('drop', handleDrop);
      card.addEventListener('dragend', handleDragEnd);
    }
  }

  function handleDragStart(e) {
    draggedItem = this;
    this.classList.add('opacity-50', 'scale-95');
    e.dataTransfer.effectAllowed = 'move';
  }

  function handleDragOver(e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    return false;
  }

  function handleDrop(e) {
    e.stopPropagation();
    if (draggedItem !== this) {
      // Swap DOM
      const allItems = [...pagesGrid.querySelectorAll('.draggable-item')];
      const draggedIdx = allItems.indexOf(draggedItem);
      const droppedIdx = allItems.indexOf(this);

      if (draggedIdx < droppedIdx) {
        this.after(draggedItem);
      } else {
        this.before(draggedItem);
      }
    }
    return false;
  }

  function handleDragEnd() {
    this.classList.remove('opacity-50', 'scale-95');
    draggedItem = null;
  }

  saveBtn.addEventListener('click', async () => {
    if (!currentFile) return;
    const restoreBtn = window.showButtonSpinner(saveBtn, t('reorder.processing', 'Memproses...'));

    try {
      const arrayBuffer = await currentFile.arrayBuffer();
      const pdfDoc = await (await _loadPdfLib()).load(arrayBuffer);
      const newPdf = await (await _loadPdfLib()).create();

      // Get new order from DOM
      const newOrderIndices = [...pagesGrid.querySelectorAll('.draggable-item')].map(item => parseInt(item.dataset.index));

      const copiedPages = await newPdf.copyPages(pdfDoc, newOrderIndices);
      copiedPages.forEach(page => newPdf.addPage(page));

      const pdfBytes = await newPdf.save();
      window.downloadBytes(pdfBytes, `reordered-${currentFile.name}`, 'application/pdf');
      
      window.showToast?.(window._tToast ? window._tToast(t('reorder.success', 'Berhasil mengatur ulang halaman!')) : 'Berhasil mengatur ulang halaman!', 'success');

    } catch (err) {
      window.showToast?.(window._tToast ? window._tToast(t('reorder.save_fail', 'Gagal menyimpan PDF.')) : 'Gagal menyimpan PDF.', 'error');
    } finally {
      restoreBtn();
    }
  });

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __pdfReorderPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __pdfReorderPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>