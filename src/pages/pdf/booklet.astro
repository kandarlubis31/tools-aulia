---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="PDF Booklet" pdfJs={true}>
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh] py-10">
    <ToolPageHeader title="PDF Booklet" titleKey="header.pdf_booklet" desc="Susun ulang halaman PDF untuk cetak booklet A5." descKey="header.pdf_booklet_desc" icon='<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v18H6.5a2.5 2.5 0 0 1 0 5H20"/>' gradient="from-teal-500 to-cyan-600" />
    <div class="card-base p-8 animate-fade-in">
      <div id="drop-zone" class="border-2 border-dashed border-teal-300 dark:border-teal-700 rounded-2xl p-12 text-center cursor-pointer hover:border-teal-400 transition-colors mb-6"><input type="file" id="file-input" accept=".pdf,application/pdf" class="hidden" /><p class="text-matte-500 font-bold" data-i18n="upload.drop_pdf">Drop PDF di sini atau klik</p><p class="text-xs text-matte-400 mt-1" id="file-name"></p></div>
      <button id="process" class="w-full py-3 bg-teal-600 text-white rounded-xl font-bold hover:bg-teal-700 transition-colors mb-6" data-i18n="btn.generate_booklet">📖 Generate Booklet</button>
      <div id="result" class="hidden"><p class="text-sm text-matte-500 mb-2" data-i18n="pdf.booklet.order_note">Urutan halaman untuk booklet (print 2 sisi, lipat):</p><pre id="order" class="p-4 bg-matte-50 dark:bg-surface-hover rounded-xl font-mono text-sm overflow-x-auto"></pre><button id="download" class="mt-4 w-full py-3 bg-teal-600 text-white rounded-xl font-bold hover:bg-teal-700 transition-colors" data-i18n="btn.download_booklet">📥 Download Booklet PDF</button></div>
    </div>
  </div>
</BaseLayout>
<script>

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  let pdfDoc: any = null;
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);
  const dz = document.getElementById('drop-zone') as HTMLElement;
  const fi = document.getElementById('file-input') as HTMLInputElement;
  dz.addEventListener('click', () => fi.click());
  dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('border-teal-500'); });
  dz.addEventListener('dragleave', () => dz.classList.remove('border-teal-500'));
  dz.addEventListener('drop', e => { e.preventDefault(); dz.classList.remove('border-teal-500'); loadFile((e as DragEvent).dataTransfer?.files[0]); });
  fi.addEventListener('change', () => loadFile(fi.files?.[0]));

  async function loadFile(file: File | undefined) {
    if (!file) return;
    if (file.type !== 'application/pdf') { toast('File harus PDF!', 'error'); return; }
    (document.getElementById('file-name') as HTMLElement).textContent = file.name;
    try {
      const buf = await file.arrayBuffer();
      let pdfjsLib: any = null;
      for (let i = 0; i < 50 && !pdfjsLib; i++) { pdfjsLib = (window as any).pdfjsLib; if (!pdfjsLib) await new Promise(r => setTimeout(r, 100)); }
      if (!pdfjsLib) throw new Error('pdf.js belum siap');
      pdfDoc = await pdfjsLib.getDocument({ data: buf }).promise;
      toast(pdfDoc.numPages + ' halaman dimuat!');
    } catch {
      pdfDoc = null;
      toast('PDF gagal dimuat — file mungkin korup', 'error');
    }
  }

  function bookletOrder(n: number): number[] {
    // Pad ke kelipatan 4 (blank page) supaya halaman gak dobel untuk PDF yang bukan kelipatan 4
    const N = Math.ceil(n / 4) * 4;
    const order: number[] = [];
    for (let s = 0; s < N / 4; s++) {
      order.push(N - s * 2, s * 2 + 1, s * 2 + 2, N - s * 2 - 1);
    }
    return order.filter(p => p >= 1 && p <= n); // blank page didrop
  }

  document.getElementById('process')!.addEventListener('click', () => {
    if (!pdfDoc) { toast('Upload PDF dulu!', 'error'); return; }
    (document.getElementById('order') as HTMLElement).textContent = bookletOrder(pdfDoc.numPages).join(', ');
    document.getElementById('result')!.classList.remove('hidden');
  });

  document.getElementById('download')!.addEventListener('click', async () => {
    if (!pdfDoc) return;
    try {
      const { PDFDocument } = await import('pdf-lib');
      const newPdf = await PDFDocument.create();
      const srcBytes = await pdfDoc.getData();
      const srcPdf = await PDFDocument.load(srcBytes);
      const n = srcPdf.getPageCount();
      const order = bookletOrder(n);
      for (const pg of order) {
        const [copied] = await newPdf.copyPages(srcPdf, [pg - 1]);
        newPdf.addPage(copied);
      }
      const bytes = await newPdf.save();
      const blob = new Blob([bytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = 'booklet.pdf'; a.click();
      setTimeout(() => URL.revokeObjectURL(url), 2000);
      toast('booklet.pdf diunduh!');
    } catch {
      toast('Gagal membuat booklet PDF', 'error');
    }
  });

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __pdfBookletPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __pdfBookletPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
