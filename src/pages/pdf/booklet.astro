---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="PDF Booklet">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh] py-10">
    <ToolPageHeader title="PDF Booklet" titleKey="header.pdf_booklet" desc="Susun ulang halaman PDF untuk cetak booklet A5." descKey="header.pdf_booklet_desc" icon='<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v18H6.5a2.5 2.5 0 0 1 0 5H20"/>' gradient="from-teal-500 to-cyan-600" />
    <div class="card-base p-8 animate-fade-in">
      <div id="drop-zone" class="border-2 border-dashed border-teal-300 dark:border-teal-700 rounded-2xl p-12 text-center cursor-pointer hover:border-teal-400 transition-colors mb-6"><input type="file" id="file-input" accept=".pdf" class="hidden" /><p class="text-matte-500 font-bold" data-i18n="upload.drop_pdf">Drop PDF di sini atau klik</p><p class="text-xs text-matte-400 mt-1" id="file-name"></p></div>
      <button id="process" class="w-full py-3 bg-teal-600 text-white rounded-xl font-bold hover:bg-teal-700 transition-colors mb-6">📖 Generate Booklet</button>
      <div id="result" class="hidden"><p class="text-sm text-matte-500 mb-2">Urutan halaman untuk booklet (print 2 sisi, lipat):</p><pre id="order" class="p-4 bg-matte-50 dark:bg-surface-hover rounded-xl font-mono text-sm overflow-x-auto"></pre><button id="download" class="mt-4 w-full py-3 bg-teal-600 text-white rounded-xl font-bold hover:bg-teal-700 transition-colors">📥 Download Booklet PDF</button></div>
    </div>
  </div>
</BaseLayout>
<script>
  let pdfDoc = null;
  const dz = document.getElementById('drop-zone');
  const fi = document.getElementById('file-input');
  dz.onclick = () => fi.click();
  dz.ondragover = e => { e.preventDefault(); dz.classList.add('border-teal-500'); };
  dz.ondragleave = () => dz.classList.remove('border-teal-500');
  dz.ondrop = e => { e.preventDefault(); dz.classList.remove('border-teal-500'); loadFile(e.dataTransfer.files[0]); };
  fi.onchange = e => loadFile(e.target.files[0]);
  async function loadFile(file) {
    if (!file) return;
    document.getElementById('file-name').textContent = file.name;
    const buf = await file.arrayBuffer();
    const pdfjsLib = await window.pdfjsLib;
    pdfDoc = await pdfjsLib.getDocument({ data: buf }).promise;
  }
  document.getElementById('process').onclick = async () => {
    if (!pdfDoc) { window.showToast?.(window._tToast ? window._tToast('Upload PDF dulu!') : 'Upload PDF dulu!', 'error'); return; }
    const n = pdfDoc.numPages;
    const sheets = Math.ceil(n / 4);
    const bookletOrder = [];
    for (let s = 0; s < sheets; s++) {
      bookletOrder.push(n - s * 2);
      bookletOrder.push(s * 2 + 1);
      bookletOrder.push(s * 2 + 2);
      bookletOrder.push(n - s * 2 - 1);
    }
    const cleaned = bookletOrder.filter(p => p >= 1 && p <= n);
    document.getElementById('order').textContent = cleaned.join(', ');
    document.getElementById('result').classList.remove('hidden');
  };
  document.getElementById('download').onclick = async () => {
    if (!pdfDoc) return;
    const { PDFDocument } = await import('pdf-lib');
    const newPdf = await PDFDocument.create();
    const srcBytes = await pdfDoc.getData();
    const srcPdf = await PDFDocument.load(srcBytes);
    const n = srcPdf.getPageCount();
    const sheets = Math.ceil(n / 4);
    const order = [];
    for (let s = 0; s < sheets; s++) {
      order.push(n - s * 2); order.push(s * 2 + 1); order.push(s * 2 + 2); order.push(n - s * 2 - 1);
    }
    for (const pg of order) {
      if (pg >= 1 && pg <= n) {
        const [copied] = await newPdf.copyPages(srcPdf, [pg - 1]);
        newPdf.addPage(copied);
      }
    }
    const bytes = await newPdf.save();
    const blob = new Blob([bytes], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'booklet.pdf'; a.click();
    URL.revokeObjectURL(url);
  };
</script>
