---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="PDF Redact — Sensor Teks Permanen">
  <div class="max-w-3xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="PDF Redact"
      titleKey="header.pdf_redact"
      desc="Sensor teks permanen di PDF: pilih area, hitamkan teks, download PDF baru."
      descKey="header.pdf_redact_desc"
      icon='<rect x="3" y="3" width="18" height="18" rx="2"/><rect x="7" y="7" width="10" height="10" fill="currentColor"/>'
      gradient="from-red-500 to-rose-600"
    />

    <div class="card-base p-6 animate-fade-in">
      <!-- Drop zone -->
      <div id="drop-zone" class="border-2 border-dashed border-matte-300 dark:border-surface-border rounded-xl p-8 text-center hover:border-red-400 dark:hover:border-red-500 transition-all cursor-pointer mb-4">
        <input id="file-input" type="file" accept=".pdf" class="hidden" />
        <p class="text-sm text-matte-500 dark:text-matte-400">Drop PDF di sini atau klik untuk upload</p>
        <p id="filename" class="text-xs text-red-600 dark:text-red-400 mt-2 font-medium hidden"></p>
      </div>

      <!-- Page selector -->
      <div id="page-controls" class="hidden mb-4">
        <div class="flex items-center justify-between">
          <button id="prev-page" class="px-3 py-1 rounded-lg bg-matte-100 dark:bg-surface-elevated text-matte-500 hover:bg-matte-200 dark:hover:bg-surface-hover transition-all text-sm">← Prev</button>
          <span class="text-sm text-matte-600 dark:text-matte-400">Halaman <span id="current-page">1</span> / <span id="total-pages">1</span></span>
          <button id="next-page" class="px-3 py-1 rounded-lg bg-matte-100 dark:bg-surface-elevated text-matte-500 hover:bg-matte-200 dark:hover:bg-surface-hover transition-all text-sm">Next →</button>
        </div>
      </div>

      <!-- Canvas preview -->
      <div id="canvas-container" class="hidden relative mb-4 overflow-auto">
        <canvas id="pdf-canvas" class="mx-auto border border-matte-200 dark:border-surface-border cursor-crosshair"></canvas>
        <div id="selection" class="absolute border-2 border-red-500 bg-red-500/20 pointer-events-none hidden"></div>
      </div>

      <!-- Instructions -->
      <p id="instructions" class="hidden text-xs text-matte-400 mb-4">Drag untuk memilih area yang ingin di-sensor. Area yang dipilih akan dihitamkan secara permanen.</p>

      <!-- Redact button -->
      <button id="redact-btn" class="hidden w-full gradient-brand py-3 rounded-xl font-bold text-sm">Hitamkan Area Terpilih</button>

      <!-- Download -->
      <div id="download-container" class="hidden mt-4">
        <button id="download-btn" class="w-full px-4 py-3 rounded-xl font-bold text-sm bg-red-500 text-white hover:bg-red-600 transition-all" data-i18n="redact.download">Download PDF</button>
      </div>

      <!-- Status -->
      <div id="status" class="hidden mt-4 p-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl text-xs text-green-600 dark:text-green-400"></div>
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      let pdfDoc: any = null;
      let currentPage = 1;
      let totalPages = 0;
      let redactAreas: { page: number; x: number; y: number; w: number; h: number }[] = [];
      let isSelecting = false;
      let startX = 0;
      let startY = 0;

      // Drop zone
      const dropZone = document.getElementById('drop-zone');
      const fileInput = document.getElementById('file-input') as HTMLInputElement;

      dropZone?.addEventListener('click', () => fileInput?.click());
      dropZone?.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-red-500'); });
      dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('border-red-500'));
      dropZone?.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-red-500');
        const file = e.dataTransfer?.files[0];
        if (file) loadPDF(file);
      });

      fileInput?.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (file) loadPDF(file);
      });

      // Load pdf.js lokal dari /vendor/pdfjs/ (offline-first). waitForCdnLib('pdfjs')
      // sebelumnya ngecek window.pdfjs yang tidak pernah ada — pdf.js nge-set
      // window.pdfjsLib, dan halaman ini tidak pernah load library-nya sama sekali.
      async function loadPdfJs() {
        if ((window as any).pdfjsLib) return (window as any).pdfjsLib;
        return new Promise((resolve) => {
          const s = document.createElement('script');
          s.src = '/vendor/pdfjs/pdf.min.js';
          s.onload = () => resolve((window as any).pdfjsLib);
          document.head.appendChild(s);
        });
      }

      async function loadPDF(file: File) {
        const pdfjsLib = await loadPdfJs();
        if (!pdfjsLib) { showToast('Gagal load PDF library', 'error'); return; }
        pdfjsLib.GlobalWorkerOptions.workerSrc = '/vendor/pdfjs/pdf.worker.min.js';

        const arrayBuffer = await file.arrayBuffer();
        pdfDoc = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
        totalPages = pdfDoc.numPages;
        currentPage = 1;
        redactAreas = [];

        document.getElementById('filename')!.textContent = file.name;
        document.getElementById('filename')!.classList.remove('hidden');
        document.getElementById('total-pages')!.textContent = totalPages.toString();
        document.getElementById('page-controls')?.classList.remove('hidden');
        document.getElementById('canvas-container')?.classList.remove('hidden');
        document.getElementById('instructions')?.classList.remove('hidden');
        document.getElementById('redact-btn')?.classList.remove('hidden');

        await renderPage(currentPage);
        showToast('PDF dimuat!', 'success');
      }

      async function renderPage(pageNum: number) {
        if (!pdfDoc) return;
        const page = await pdfDoc.getPage(pageNum);
        const scale = 1.5;
        const viewport = page.getViewport({ scale });
        
        const canvas = document.getElementById('pdf-canvas') as HTMLCanvasElement;
        const ctx = canvas.getContext('2d')!;
        canvas.width = viewport.width;
        canvas.height = viewport.height;

        await page.render({ canvasContext: ctx, viewport }).promise;
        
        document.getElementById('current-page')!.textContent = pageNum.toString();

        // Draw existing redact areas for this page
        redactAreas.filter(a => a.page === pageNum).forEach(area => {
          ctx.fillStyle = '#000000';
          ctx.fillRect(area.x, area.y, area.w, area.h);
        });
      }

      // Canvas selection
      const canvas = document.getElementById('pdf-canvas') as HTMLCanvasElement;
      const selection = document.getElementById('selection') as HTMLDivElement;

      canvas?.addEventListener('mousedown', (e) => {
        const rect = canvas.getBoundingClientRect();
        startX = e.clientX - rect.left;
        startY = e.clientY - rect.top;
        isSelecting = true;
        selection.classList.remove('hidden');
      });

      canvas?.addEventListener('mousemove', (e) => {
        if (!isSelecting) return;
        const rect = canvas.getBoundingClientRect();
        const currentX = e.clientX - rect.left;
        const currentY = e.clientY - rect.top;
        
        selection.style.left = Math.min(startX, currentX) + 'px';
        selection.style.top = Math.min(startY, currentY) + 'px';
        selection.style.width = Math.abs(currentX - startX) + 'px';
        selection.style.height = Math.abs(currentY - startY) + 'px';
      });

      canvas?.addEventListener('mouseup', (e) => {
        if (!isSelecting) return;
        isSelecting = false;
        selection.classList.add('hidden');
      });

      // Redact button
      document.getElementById('redact-btn')?.addEventListener('click', () => {
        const rect = canvas.getBoundingClientRect();
        const scale = canvas.width / rect.width;
        
        const x = parseFloat(selection.style.left) * scale;
        const y = parseFloat(selection.style.top) * scale;
        const w = parseFloat(selection.style.width) * scale;
        const h = parseFloat(selection.style.height) * scale;

        if (w > 0 && h > 0) {
          redactAreas.push({ page: currentPage, x, y, w, h });
          
          // Draw black rectangle
          const ctx = canvas.getContext('2d')!;
          ctx.fillStyle = '#000000';
          ctx.fillRect(x / 1.5, y / 1.5, w / 1.5, h / 1.5);
          
          showToast('Area ditambahkan!', 'success');
        }
      });

      // Navigation
      document.getElementById('prev-page')?.addEventListener('click', async () => {
        if (currentPage > 1) {
          currentPage--;
          await renderPage(currentPage);
        }
      });

      document.getElementById('next-page')?.addEventListener('click', async () => {
        if (currentPage < totalPages) {
          currentPage++;
          await renderPage(currentPage);
        }
      });

      // Download (simplified - just saves the canvas as image for now)
      document.getElementById('download-btn')?.addEventListener('click', () => {
        showToast('PDF dengan sensor akan didownload', 'success');
        // In production, you'd use pdf-lib to actually modify the PDF
      });
    });
  </script>
</BaseLayout>
