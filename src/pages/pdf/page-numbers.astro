---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Add Page Numbers" pdfJs={false}>

  <div class="max-w-4xl mx-auto px-4 min-h-[60vh]">
        <ToolPageHeader
      title="Add Page Numbers"
      titleKey="header.page_numbers"
      desc="Tambahkan penomoran halaman otomatis (1 dari N) ke PDF."
      descKey="header.page_numbers_desc"
      icon='<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>'
      gradient="from-green-500 to-emerald-600"
    />

    <div id="drop-zone" class="max-w-2xl mx-auto border-3 border-dashed border-matte-300 dark:border-matte-600 rounded-3xl p-12 cursor-pointer hover:border-violet-500 hover:bg-violet-50 dark:hover:bg-matte-800/50 transition-all group text-center animate-on-scroll">
      <div class="w-20 h-20 bg-violet-100 dark:bg-violet-900/30 text-violet-600 dark:text-violet-400 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
      </div>
      <h3 class="text-2xl font-bold text-matte-700 dark:text-matte-200 mb-2" data-i18n="btn.choose_pdf">Pilih PDF</h3>
      <input type="file" id="file-input" accept="application/pdf" class="hidden" />
    </div>

    <div id="controls-area" class="hidden max-w-md mx-auto mt-8 bg-white dark:bg-matte-800 p-8 rounded-2xl border border-matte-200 dark:border-matte-700 shadow-xl animate-fade-in text-center">
      <p id="filename" class="text-sm font-medium text-matte-500 mb-4 truncate">filename.pdf</p>

      <div class="grid grid-cols-2 gap-3 mb-5 text-left">
        <div>
          <label for="num-format" class="block text-xs text-matte-500 mb-1 font-medium" data-i18n="pagenum.format_label">Format Nomor</label>
          <select id="num-format" class="input-field text-sm w-full">
            <option value="slash" selected>1 / N</option>
            <option value="plain">1</option>
            <option value="dash">- 1 -</option>
            <option value="pageof">Page 1 of N</option>
          </select>
        </div>
        <div>
          <label for="num-pos" class="block text-xs text-matte-500 mb-1 font-medium" data-i18n="pagenum.pos_label">Posisi</label>
          <select id="num-pos" class="input-field text-sm w-full">
            <option value="bc" data-i18n="pagenum.pos_bc" selected>Bawah Tengah</option>
            <option value="br" data-i18n="pagenum.pos_br">Bawah Kanan</option>
          </select>
        </div>
      </div>

      <button id="process-btn" class="w-full bg-violet-600 hover:bg-violet-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition-all active:scale-95 flex items-center justify-center gap-2" data-i18n="btn.add_page_numbers">
        Tambahkan Nomor Halaman
      </button>
      <button id="change-file" class="mt-3 text-xs font-bold text-violet-600 hover:text-violet-700" data-i18n="pagenum.change_file">🔄 Ganti File</button>
      <p class="text-xs text-matte-400 mt-4" data-i18n="pagenum.hint">Nomor dicetak ke setiap halaman PDF hasil — file asli tetap aman.</p>
    </div>
  </div>
</BaseLayout>

<script>
  const toast = (msg, type = 'success') => window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const controlsArea = document.getElementById('controls-area');
  const filenameDisplay = document.getElementById('filename');
  const processBtn = document.getElementById('process-btn');

  let currentFile = null;

  window.usePdfDropZone('drop-zone', 'file-input', {
    accentColor: 'violet',
    onFile: (file) => {
      if (file.type && file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
        toast('Hanya file PDF yang diperbolehkan', 'error');
        return;
      }
      currentFile = file;
      if (filenameDisplay) filenameDisplay.textContent = file.name;
      document.getElementById('drop-zone').classList.add('hidden');
      controlsArea.classList.remove('hidden');
    },
  });

  document.getElementById('change-file').addEventListener('click', () => {
    currentFile = null;
    controlsArea.classList.add('hidden');
    document.getElementById('drop-zone').classList.remove('hidden');
  });

  function formatLabel(idx, total, style) {
    if (style === 'plain') return String(idx + 1);
    if (style === 'dash') return '- ' + (idx + 1) + ' -';
    if (style === 'pageof') return 'Page ' + (idx + 1) + ' of ' + total;
    return (idx + 1) + ' / ' + total;
  }

  processBtn.addEventListener('click', async () => {
    if (!currentFile) { toast('Pilih file dulu!', 'error'); return; }

    const { PDFDocument, rgb, StandardFonts } = await import('pdf-lib');

    const restoreBtn = window.showButtonSpinner(processBtn, window._tToast ? window._tToast('Memproses...') : 'Memproses...');

    try {
      const arrayBuffer = await currentFile.arrayBuffer();
      const pdfDoc = await PDFDocument.load(arrayBuffer);
      const helveticaFont = await pdfDoc.embedFont(StandardFonts.Helvetica);
      const pages = pdfDoc.getPages();
      const totalPages = pages.length;
      const style = document.getElementById('num-format').value;
      const pos = document.getElementById('num-pos').value;

      pages.forEach((page, idx) => {
        const { width } = page.getSize();
        const text = formatLabel(idx, totalPages, style);
        const textSize = 12;
        const textWidth = helveticaFont.widthOfTextAtSize(text, textSize);
        const x = pos === 'br' ? width - textWidth - 30 : (width / 2) - (textWidth / 2);

        page.drawText(text, {
          x,
          y: 20,
          size: textSize,
          font: helveticaFont,
          color: rgb(0, 0, 0),
        });
      });

      const pdfBytes = await pdfDoc.save();
      window.downloadBytes(pdfBytes, 'numbered-' + currentFile.name);

      toast('Nomor halaman berhasil ditambahkan!');
    } catch (err) {
      console.error(err);
      toast('Gagal memproses PDF.', 'error');
    } finally {
      restoreBtn();
    }
  });
  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __pdfPageNumbersPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __pdfPageNumbersPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });
</script>
