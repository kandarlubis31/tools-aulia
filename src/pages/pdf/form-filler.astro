---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
import DropZone from '../../components/DropZone.astro';
---

<BaseLayout pageTitle="PDF Form Filler — Isi Form PDF Online">
  <div class="max-w-5xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="PDF Form Filler"
      titleKey="header.form_filler"
      desc="Isi form PDF interaktif — text field, checkbox, radio — langsung di browser."
      descKey="header.form_filler_desc"
      icon='<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/><path d="m10 15 1.5 1.5L15 13"/>'
      gradient="from-teal-500 to-cyan-600"
    />

    <div class="animate-fade-in">
      <DropZone
        id="drop-zone"
        inputId="file-input"
        accept="application/pdf"
        labelKey="upload.drop_pdf"
        subLabelKey="upload.or_click"
        label="Drag & drop file PDF form di sini"
        gradient="from-teal-500 to-cyan-600"
        hoverClass="hover:border-teal-400 hover:bg-teal-50 dark:hover:bg-teal-950/20"
        className="max-w-xl mx-auto"
      />
    </div>

    <div id="editor" class="hidden mt-8 animate-fade-in">
      <div id="no-fields" class="card-base p-6 text-center text-sm text-matte-400 hidden">
        ⚠️ <span data-i18n="form.no_fields">Tidak ada field form interaktif yang terdeteksi di PDF ini (mungkin hasil scan atau tidak punya AcroForm).</span>
      </div>

      <!-- Fields -->
      <div id="fields-panel" class="card-base p-5 mb-6"></div>

      <div class="flex flex-wrap items-center justify-center gap-3 mb-6">
        <button id="download-btn" class="gradient-brand px-8 py-3 rounded-xl font-bold text-sm">💾 <span data-i18n="form.download">Download PDF Terisi</span></button>
        <label class="flex items-center gap-2 text-xs text-matte-500 dark:text-matte-300">
          <input id="flatten" type="checkbox" class="accent-teal-500" />
          <span data-i18n="form.flatten">Flatten (kunci isian jadi teks biasa)</span>
        </label>
      </div>

      <!-- Pages preview -->
      <h2 class="font-bold text-sm mb-3 text-matte-500 dark:text-matte-300" data-i18n="form.pages_preview">Preview Halaman</h2>
      <div id="pages" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    </div>
  </div>
</BaseLayout>

<script>
const __page = (location.pathname.replace(/\/+$/, '') || '/');

  document.addEventListener('astro:page-load', () => {if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;

    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const editor = document.getElementById('editor');
    const noFields = document.getElementById('no-fields');
    const fieldsPanel = document.getElementById('fields-panel');
    const pagesEl = document.getElementById('pages');
    const downloadBtn = document.getElementById('download-btn');
    const flattenInput = document.getElementById('flatten') as HTMLInputElement;

    let originalBytes: ArrayBuffer | null = null;
    let pdfFile: File | null = null;

    dropZone?.addEventListener('click', () => fileInput?.click());
    ['dragenter', 'dragover'].forEach(ev => dropZone?.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.add('border-teal-500', 'bg-teal-50', 'dark:bg-teal-950/20'); }));
    ['dragleave', 'drop'].forEach(ev => dropZone?.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.remove('border-teal-500', 'bg-teal-50', 'dark:bg-teal-950/20'); }));
    dropZone?.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      if (dt?.files.length) fileInput!.files = dt.files;
      fileInput?.dispatchEvent(new Event('change'));
    });

    fileInput?.addEventListener('change', async () => {
      const f = fileInput.files?.[0];
      if (!f) return;
      if (f.type !== 'application/pdf' && !f.name.toLowerCase().endsWith('.pdf')) {
        showToast('Pilih file PDF', 'error');
        return;
      }
      if (f.size > 50 * 1024 * 1024) { showToast('Ukuran maksimal 50 MB', 'error'); return; }

      pdfFile = f;
      originalBytes = await f.arrayBuffer();
      editor?.classList.remove('hidden');
      editor?.scrollIntoView({ behavior: 'smooth', block: 'start' });

      const { PDFDocument } = await import('pdf-lib');
      const pdfDoc = await PDFDocument.load(originalBytes, { ignoreEncryption: true });
      const form = pdfDoc.getForm();
      const fields = form.getFields();

      if (fields.length === 0) {
        noFields?.classList.remove('hidden');
        fieldsPanel!.innerHTML = '';
        downloadBtn?.classList.add('hidden');
      } else {
        noFields?.classList.add('hidden');
        downloadBtn?.classList.remove('hidden');
        renderFields(fields);
      }
      renderPages(originalBytes);
    });

    // ---- Render form controls ----
    function renderFields(fields: any[]) {
      fieldsPanel!.innerHTML = '<h2 class="font-bold text-sm mb-4" data-i18n="form.fill_fields">Isi Field Form</h2>' +
        fields.map((field, i) => renderField(field, i)).join('') +
        '<p class="text-xs text-matte-400 mt-4" data-i18n="form.auto">Isian tersimpan otomatis — klik Download untuk menyimpan hasilnya.</p>';
      (window as any).processI18n?.();
    }

    function renderField(field: any, i: number): string {
      const type = field.constructor.name;
      const name = String(field.getName() || `Field ${i + 1}`);

      if (type === 'PDFTextField') {
        const val = field.getValueAsString?.() ?? '';
        return `
          <div class="mb-4">
            <label class="block text-xs font-bold text-matte-500 dark:text-matte-300 mb-1.5" for="ff-${i}">📝 ${esc(name)}</label>
            <input id="ff-${i}" data-field="${i}" type="text" value="${esc(val)}" class="w-full px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm focus:ring-2 focus:ring-teal-500/40 outline-none" />
          </div>`;
      }

      if (type === 'PDFCheckBox') {
        const checked = field.isChecked?.() ?? false;
        return `
          <div class="mb-2 flex items-center gap-3 p-2.5 rounded-lg hover:bg-matte-50 dark:hover:bg-surface-elevated/50">
            <input id="ff-${i}" data-field="${i}" type="checkbox" ${checked ? 'checked' : ''} class="accent-teal-500 w-5 h-5" />
            <label for="ff-${i}" class="text-sm text-matte-600 dark:text-matte-300">☑️ ${esc(name)}</label>
          </div>`;
      }

      if (type === 'PDFRadioGroup' || type === 'PDFDropdown' || type === 'PDFOptionList') {
        let options: string[] = [];
        try {
          options = (field.getOptions?.() ?? []).map((o: any) => typeof o === 'string' ? o : (o?.display ?? o?.value ?? String(o)));
        } catch { options = []; }
        const selected = (field.getSelected?.() ?? [])[0] ?? '';
        const opts = options.map(o => `<option value="${esc(o)}" ${o === selected ? 'selected' : ''}>${esc(o)}</option>`).join('');
        return `
          <div class="mb-4">
            <label class="block text-xs font-bold text-matte-500 dark:text-matte-300 mb-1.5" for="ff-${i}">${type === 'PDFRadioGroup' ? '🔘' : '🔽'} ${esc(name)}</label>
            <select id="ff-${i}" data-field="${i}" class="w-full px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm focus:ring-2 focus:ring-teal-500/40 outline-none">
              ${opts}
            </select>
          </div>`;
      }

      // PDFButton, PDFSignature, PDFPushButton, dll — skip
      return '';
    }

    // ---- Download with applied values ----
    downloadBtn?.addEventListener('click', async () => {
      if (!originalBytes) return;
      const { PDFDocument } = await import('pdf-lib');
      const pdfDoc = await PDFDocument.load(originalBytes, { ignoreEncryption: true });
      const form = pdfDoc.getForm();
      const fields = form.getFields();

      fields.forEach((field: any, i: number) => {
        const input = document.getElementById(`ff-${i}`) as HTMLInputElement | HTMLSelectElement | null;
        if (!input) return;
        const type = field.constructor.name;

        if (type === 'PDFTextField') {
          const v = (input as HTMLInputElement).value;
          try { field.setText(v); } catch { /* field mungkin readonly */ }
        } else if (type === 'PDFCheckBox') {
          const checked = (input as HTMLInputElement).checked;
          try { checked ? field.check() : field.uncheck(); } catch { /* ignore */ }
        } else if (type === 'PDFRadioGroup' || type === 'PDFDropdown' || type === 'PDFOptionList') {
          const v = (input as HTMLSelectElement).value;
          try { field.select(v); } catch { /* ignore */ }
        }
      });

      if (flattenInput?.checked) {
        try { form.flatten(); } catch { /* flatten bisa gagal di beberapa field */ }
      }

      const out = await pdfDoc.save();
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([out], { type: 'application/pdf' }));
      a.download = pdfFile!.name.replace(/\.pdf$/i, '') + '-terisi.pdf';
      a.click();
      showToast('PDF berhasil diisi!');
    });

    // ---- Page previews via pdf.js ----
    async function renderPages(bytes: ArrayBuffer) {
      pagesEl!.innerHTML = '';
      const pdf = await window.pdfjsLib.getDocument(bytes).promise;
      const scale = Math.min(1, 720 / Math.max(pdf.numPages, 1));
      for (let i = 1; i <= pdf.numPages; i++) {
        const page = await pdf.getPage(i);
        const viewport = page.getViewport({ scale: 0.5 });
        const canvas = document.createElement('canvas');
        canvas.width = viewport.width;
        canvas.height = viewport.height;
        canvas.className = 'w-full h-auto rounded-lg border border-matte-200 dark:border-matte-700 bg-white';
        const wrap = document.createElement('div');
        wrap.className = 'card-base p-3';
        const label = document.createElement('p');
        label.className = 'text-2xs text-matte-400 mb-2 text-center';
        label.textContent = `Halaman ${i}`;
        wrap.append(label, canvas);
        pagesEl!.appendChild(wrap);

        const renderCtx = canvas.getContext('2d');
        if (renderCtx) {
          await page.render({ canvasContext: renderCtx, viewport }).promise.catch(() => {});
        }
      }
    }

    function esc(s: string): string {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
  });
</script>
