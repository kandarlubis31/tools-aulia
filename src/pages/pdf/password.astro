---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
import DropZone from '../../components/DropZone.astro';
---

<BaseLayout pageTitle="PDF Password — Proteksi & Buka Kunci PDF">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="PDF Password"
      titleKey="header.pdf_password"
      desc="Lindungi file PDF dengan password, atau hapus proteksi yang sudah ada."
      descKey="header.pdf_password_desc"
      icon='<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><polyline points="14 2 14 8 20 8"/><rect x="8" y="12" width="8" height="6" rx="1"/><path d="M10 12v-2a2 2 0 0 1 4 0v2"/>'
      gradient="from-amber-500 to-orange-600"
    />

    <!-- Mode Toggle -->
    <div class="flex flex-wrap justify-center gap-3 mb-8 animate-fade-in">
      <button id="mode-add" class="px-6 py-2.5 rounded-xl text-sm font-bold bg-amber-500 text-white shadow-md transition-all" data-i18n="pdfpass.add">🔒 Tambah Password</button>
      <button id="mode-remove" class="px-6 py-2.5 rounded-xl text-sm font-medium text-matte-500 hover:text-matte-700 dark:text-matte-400 hover:bg-matte-100 dark:hover:bg-surface-elevated transition-all" data-i18n="pdfpass.remove">🔓 Hapus Password</button>
    </div>

    <div class="animate-fade-in">
      <DropZone
        id="drop-zone"
        inputId="file-input"
        accept="application/pdf,.pdf"
        labelKey="upload.drop_pdf"
        subLabelKey="upload.or_click"
        label="Drag & drop file PDF di sini"
        gradient="from-amber-500 to-orange-600"
        hoverClass="hover:border-amber-400 hover:bg-amber-50 dark:hover:bg-amber-950/20"
        className="max-w-xl mx-auto"
      />
    </div>

    <!-- Options Card -->
    <div id="options-card" class="card-base p-6 mt-8 max-w-xl mx-auto hidden animate-fade-in">
      <!-- Add mode -->
      <div id="add-options">
        <label class="section-title mb-2 block" for="new-password" data-i18n="pdfpass.new_pass">Password Baru</label>
        <div class="relative">
          <input id="new-password" type="password" class="w-full px-4 py-3 pr-11 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-amber-500 transition-colors text-sm" placeholder="••••••••" autocomplete="new-password" />
          <button id="toggle-new-pass" type="button" aria-label="Tampilkan password" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-matte-400 hover:text-matte-600 transition-colors">👁️</button>
        </div>
        <label class="section-title mb-2 mt-4 block" for="confirm-password" data-i18n="pdfpass.confirm_pass">Konfirmasi Password</label>
        <input id="confirm-password" type="password" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-amber-500 transition-colors text-sm" placeholder="••••••••" autocomplete="new-password" />
        <p class="text-2xs text-matte-400 mt-3 flex items-center gap-1.5">🔒 <span data-i18n="common.safe_browser">100% di browser, file kamu aman!</span></p>
      </div>
      <!-- Remove mode -->
      <div id="remove-options" class="hidden">
        <label class="section-title mb-2 block" for="current-password" data-i18n="pdfpass.current_pass">Password Saat Ini</label>
        <input id="current-password" type="password" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-amber-500 transition-colors text-sm" placeholder="••••••••" autocomplete="current-password" />
        <p class="text-2xs text-matte-400 mt-3">ℹ️ <span data-i18n="pdfpass.remove_hint">Kami tidak bisa memulihkan password yang lupa — file diproses lokal tanpa akses ke isi password.</span></p>
      </div>

      <div class="flex items-center gap-3 mt-6">
        <button id="process-btn" class="gradient-brand px-6 py-3 rounded-xl font-bold text-sm disabled:opacity-50 disabled:cursor-not-allowed transition-all" data-i18n="pdfpass.process">🔒 Proteksi PDF</button>
        <div id="processing" class="hidden text-sm text-matte-500 dark:text-matte-400 flex items-center gap-2">
          <span class="inline-block w-4 h-4 border-2 border-amber-500 border-t-transparent rounded-full animate-spin"></span>
          <span data-i18n="common.processing">Memproses...</span>
        </div>
      </div>
    </div>

    <!-- Result -->
    <div id="result-card" class="hidden card-base p-6 mt-8 max-w-xl mx-auto animate-fade-in text-center">
      <div class="text-4xl mb-3">✅</div>
      <h3 id="result-title" class="font-bold text-matte-800 dark:text-white mb-1">Berhasil!</h3>
      <p id="result-desc" class="text-sm text-matte-500 dark:text-matte-400 mb-5">File PDF kamu sudah diproses.</p>
      <button id="download-btn" class="gradient-brand px-6 py-3 rounded-xl font-bold text-sm inline-flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span data-i18n="btn.download">Download</span>
      </button>
    </div>
  </div>
</BaseLayout>

<script>
const __page = (location.pathname.replace(/\/+$/, '') || '/');

  document.addEventListener('astro:page-load', () => {if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;

    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const optionsCard = document.getElementById('options-card');
    const addOptions = document.getElementById('add-options');
    const removeOptions = document.getElementById('remove-options');
    const newPassword = document.getElementById('new-password') as HTMLInputElement;
    const confirmPassword = document.getElementById('confirm-password') as HTMLInputElement;
    const currentPassword = document.getElementById('current-password') as HTMLInputElement;
    const modeAdd = document.getElementById('mode-add');
    const modeRemove = document.getElementById('mode-remove');
    const processBtn = document.getElementById('process-btn') as HTMLButtonElement;
    const processing = document.getElementById('processing');
    const resultCard = document.getElementById('result-card');
    const resultTitle = document.getElementById('result-title');
    const resultDesc = document.getElementById('result-desc');
    const downloadBtn = document.getElementById('download-btn');
    const toggleNewPass = document.getElementById('toggle-new-pass');

    let file: File | null = null;
    let resultBytes: Uint8Array | null = null;
    let isAddMode = true;

    const t = (key: string, fb: string) => (window.i18n?.t ? window.i18n.t(key, fb) : fb);
    toggleNewPass?.addEventListener('click', () => {
      const input = document.getElementById('new-password') as HTMLInputElement;
      input.type = input.type === 'password' ? 'text' : 'password';
    });

    function setMode(add: boolean) {
      isAddMode = add;
      addOptions?.classList.toggle('hidden', !add);
      removeOptions?.classList.toggle('hidden', add);
      if (processBtn) {
        processBtn.textContent = add ? '🔒 Proteksi PDF' : '🔓 Hapus Password';
        delete processBtn.dataset.i18n;
      }
      resultCard?.classList.add('hidden');
    }

    modeAdd?.addEventListener('click', () => {
      setMode(true);
      modeAdd.className = 'px-6 py-2.5 rounded-xl text-sm font-bold bg-amber-500 text-white shadow-md transition-all';
      modeRemove!.className = 'px-6 py-2.5 rounded-xl text-sm font-medium text-matte-500 hover:text-matte-700 dark:text-matte-400 hover:bg-matte-100 dark:hover:bg-surface-elevated transition-all';
    });
    modeRemove?.addEventListener('click', () => {
      setMode(false);
      modeRemove.className = 'px-6 py-2.5 rounded-xl text-sm font-bold bg-amber-500 text-white shadow-md transition-all';
      modeAdd!.className = 'px-6 py-2.5 rounded-xl text-sm font-medium text-matte-500 hover:text-matte-700 dark:text-matte-400 hover:bg-matte-100 dark:hover:bg-surface-elevated transition-all';
    });

    // DropZone wiring: klik / drag-drop (DropZone component handle a11y, JS-nya di sini)
    dropZone?.addEventListener('click', () => fileInput?.click());
    ['dragenter', 'dragover'].forEach(ev => dropZone?.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.add('border-amber-500', 'bg-amber-50', 'dark:bg-amber-950/20'); }));
    ['dragleave', 'drop'].forEach(ev => dropZone?.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.remove('border-amber-500', 'bg-amber-50', 'dark:bg-amber-950/20'); }));
    dropZone?.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      if (dt?.files.length) fileInput!.files = dt.files;
      fileInput?.dispatchEvent(new Event('change'));
    });

    fileInput?.addEventListener('change', () => {
      const f = fileInput.files?.[0];
      if (!f) return;
      if (f.type !== 'application/pdf' && !f.name.toLowerCase().endsWith('.pdf')) {
        showToast('File harus berformat PDF', 'error');
        fileInput.value = '';
        return;
      }
      file = f;
      optionsCard?.classList.remove('hidden');
      resultCard?.classList.add('hidden');
      showToast(`📄 ${f.name} siap diproses`);
      if (newPassword) newPassword.focus();
    });

    processBtn?.addEventListener('click', async () => {
      if (!file) { showToast('Pilih file PDF dulu', 'error'); return; }
      const pwd = isAddMode ? newPassword.value : currentPassword.value;
      if (!pwd) { showToast('Password tidak boleh kosong', 'error'); return; }
      if (isAddMode && pwd.length < 4) { showToast('Password minimal 4 karakter', 'error'); return; }
      if (isAddMode && pwd !== confirmPassword.value) { showToast('Password tidak cocok dengan konfirmasi', 'error'); return; }

      processBtn.disabled = true;
      processing?.classList.remove('hidden');
      resultCard?.classList.add('hidden');

      try {
        const { PDFDocument } = await import('pdf-lib');
        const bytes = new Uint8Array(await file.arrayBuffer());
        let pdfDoc: InstanceType<typeof PDFDocument>;

        try {
          pdfDoc = isAddMode
            ? await PDFDocument.load(bytes)
            : await PDFDocument.load(bytes, { password: pwd });
        } catch (err: any) {
          if (isAddMode) {
            showToast('File ini sudah dipassword — gunakan mode Hapus Password', 'error');
          } else {
            showToast('Password salah atau file tidak diproteksi', 'error');
          }
          throw err;
        }

        if (isAddMode) {
          pdfDoc.setEncryption({
            userPassword: pwd,
            ownerPassword: pwd,
            permissions: {
              printing: 'highResolution',
              modifying: false,
              copying: false,
              annotating: true,
              fillingForms: true,
              contentAccessibility: true,
              documentAssembly: false,
            },
          });
        } else {
          pdfDoc.setEncryption(undefined);
        }

        resultBytes = await pdfDoc.save();
        const name = file.name.replace(/\.pdf$/i, '') + (isAddMode ? '-protected.pdf' : '-unlocked.pdf');
        if (resultTitle) resultTitle.textContent = isAddMode ? '🎉 PDF Terproteksi!' : '🎉 PDF Terbuka Kuncinya!';
        if (resultDesc) resultDesc.textContent = isAddMode
          ? `Password berhasil ditambahkan ke ${file.name}.`
          : `Proteksi password berhasil dihapus dari ${file.name}.`;
        downloadBtn?.setAttribute('data-name', name);
        resultCard?.classList.remove('hidden');
        showToast(isAddMode ? 'PDF berhasil diproteksi!' : 'PDF berhasil dibuka kuncinya!');
      } catch {
        // toast sudah ditampilkan di blok khusus
      } finally {
        processBtn.disabled = false;
        processing?.classList.add('hidden');
      }
    });

    downloadBtn?.addEventListener('click', () => {
      if (!resultBytes) return;
      const name = downloadBtn.getAttribute('data-name') || 'protected.pdf';
      const blob = new Blob([resultBytes as BlobPart], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = name;
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    });
  });
</script>
