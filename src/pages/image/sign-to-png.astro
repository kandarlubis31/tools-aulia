---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Sign to PNG — Tanda Tangan Online ke PNG Transparan | ToolsAulia">
  <div class="max-w-5xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Sign to PNG"
      titleKey="tool.sign_to_png"
      descKey="tool.sign_to_png_desc"
      desc="Gambar atau upload tanda tangan, hasilkan PNG transparan siap tempel di dokumen."
      icon='<path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>'
      gradient="from-rose-500 to-orange-500"
    />

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 animate-fade-in pb-20">

      <!-- LEFT: Input -->
      <div class="lg:col-span-3">
        <div class="card-base p-5">
          <!-- Tabs -->
          <div class="flex rounded-xl overflow-hidden border border-matte-200 dark:border-surface-border text-sm font-semibold mb-5">
            <button id="tab-draw" class="stp-tab flex-1 py-2.5 px-4 transition-all" data-i18n="stp.tab_draw">✍️ Gambar</button>
            <button id="tab-upload" class="stp-tab flex-1 py-2.5 px-4 transition-all" data-i18n="stp.tab_upload">📷 Upload Foto</button>
          </div>

          <!-- Panel: Draw -->
          <div id="panel-draw">
            <div id="pad-wrap" class="rounded-xl border-2 border-dashed border-matte-200 dark:border-surface-border bg-white dark:bg-matte-900 overflow-hidden touch-none select-none">
              <canvas id="sig-pad" class="block w-full cursor-crosshair" style="height: 240px;"></canvas>
            </div>
            <p class="text-xs text-matte-400 text-center mt-2" data-i18n="stp.draw_hint">Gambar tanda tanganmu di area ini</p>

            <div class="grid sm:grid-cols-2 gap-4 mt-4">
              <!-- Ink color -->
              <div>
                <span class="section-title mb-2 block" data-i18n="stp.ink_color">Warna Tinta</span>
                <div class="flex gap-2">
                  <button class="ink-btn active" data-color="#111827" aria-label="Hitam">
                    <span class="w-5 h-5 rounded-full bg-gray-900 ring-1 ring-black/20"></span>
                  </button>
                  <button class="ink-btn" data-color="#1e40af" aria-label="Biru">
                    <span class="w-5 h-5 rounded-full bg-blue-800"></span>
                  </button>
                </div>
              </div>
              <!-- Pen size -->
              <div>
                <label class="flex justify-between section-title mb-2 block">
                  <span data-i18n="stp.pen_size">Ketebalan Pena</span>
                  <span id="pen-size-val" class="font-mono font-bold text-accent-blue normal-case tracking-normal">4</span>
                </label>
                <input type="range" id="pen-size" min="2" max="10" value="4" class="w-full h-2 bg-matte-200 dark:bg-surface-border rounded-lg appearance-none cursor-pointer accent-matte-500" />
              </div>
            </div>

            <div class="flex gap-2 mt-5">
              <button id="undo-btn" class="flex-1 py-2.5 px-4 rounded-xl text-sm font-bold bg-matte-100 dark:bg-surface-elevated text-matte-600 dark:text-matte-300 hover:bg-matte-200 dark:hover:bg-surface-hover transition-all disabled:opacity-40 disabled:cursor-not-allowed flex items-center justify-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg>
                <span data-i18n="stp.undo">Undo</span>
              </button>
              <button id="pad-clear-btn" class="flex-1 py-2.5 px-4 rounded-xl text-sm font-bold bg-matte-100 dark:bg-surface-elevated text-matte-600 dark:text-matte-300 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/30 transition-all flex items-center justify-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                <span data-i18n="stp.clear">Hapus</span>
              </button>
            </div>
          </div>

          <!-- Panel: Upload -->
          <div id="panel-upload" class="hidden">
            <div id="upload-zone" class="border-2 border-dashed border-matte-200 dark:border-surface-border rounded-xl p-8 text-center cursor-pointer transition-all hover:border-accent-blue hover:bg-matte-50 dark:hover:bg-surface-hover">
              <input type="file" id="sig-file-input" accept="image/*" class="hidden" />
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-3 text-matte-300 dark:text-matte-500">
                <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
              </svg>
              <p class="text-matte-500 dark:text-matte-300 font-medium mb-1" data-i18n="stp.upload_drop">Seret foto tanda tangan ke sini</p>
              <p class="text-xs text-matte-400" data-i18n="stp.upload_sub">atau klik untuk pilih file · TTD di kertas putih hasil paling bersih</p>
            </div>

            <div id="upload-preview-wrap" class="hidden mt-4">
              <img id="upload-preview" class="w-full max-h-56 object-contain rounded-xl border border-matte-200 dark:border-surface-border bg-white" alt="Foto tanda tangan" />
            </div>

            <div class="mt-4">
              <label class="flex justify-between section-title mb-2 block">
                <span data-i18n="stp.tolerance">Toleransi Background</span>
                <span id="tolerance-val" class="font-mono font-bold text-accent-blue normal-case tracking-normal">35</span>
              </label>
              <input type="range" id="tolerance" min="0" max="100" value="35" class="w-full h-2 bg-matte-200 dark:bg-surface-border rounded-lg appearance-none cursor-pointer accent-matte-500" />
              <p class="mt-1 text-[10px] text-matte-400" data-i18n="stp.tolerance_hint">Naikkan jika sisa kertas masih terlihat, turunkan jika goresan ikut hilang.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Result -->
      <div class="lg:col-span-2 space-y-5">
        <div class="card-base p-5">
          <div class="flex items-center justify-between mb-3 gap-2">
            <span class="section-title" data-i18n="stp.result">Hasil (PNG Transparan)</span>
            <span id="size-badge" class="text-2xs font-mono font-bold text-matte-400"></span>
          </div>

          <div id="result-wrap" class="checkerboard rounded-xl p-3 flex items-center justify-center min-h-[180px] relative overflow-hidden">
            <canvas id="result-canvas" class="hidden max-w-full h-auto block"></canvas>
            <p id="result-empty" class="text-xs text-matte-400 text-center px-4" data-i18n="stp.empty_result">Gambar atau upload tanda tangan untuk mulai</p>
          </div>

          <!-- Background toggle -->
          <div class="mt-4">
            <span class="section-title mb-2 block">Background</span>
            <div class="flex rounded-lg overflow-hidden border border-matte-200 dark:border-surface-border text-xs font-semibold">
              <button id="bg-transparent" class="bg-seg flex-1 py-2 transition-all" data-i18n="stp.bg_transparent">Transparan</button>
              <button id="bg-white" class="bg-seg flex-1 py-2 transition-all" data-i18n="stp.bg_white">Putih</button>
            </div>
          </div>

          <div class="space-y-2.5 mt-4">
            <button id="download-btn" class="action-btn w-full" disabled>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span data-i18n="stp.download">⬇️ Download PNG</span>
            </button>
            <button id="copy-btn" class="action-btn w-full" disabled>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span data-i18n="stp.copy">📋 Salin</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .stp-tab { @apply bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300; }
  .stp-tab.active { @apply bg-rose-500 text-white shadow-md; }
  .ink-btn {
    @apply w-10 h-10 rounded-xl border-2 border-transparent bg-matte-100 dark:bg-surface-elevated
      flex items-center justify-center transition-all hover:border-matte-300;
  }
  .ink-btn.active { @apply border-rose-500 bg-rose-50 dark:bg-rose-900/30; }
  .bg-seg { @apply bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300; }
  .bg-seg.active { @apply bg-matte-900 dark:bg-white text-white dark:text-matte-900; }
  .action-btn {
    @apply bg-matte-900 dark:bg-white text-white dark:text-matte-900 font-semibold py-2.5 px-4 rounded-xl hover:opacity-90 transition-all active:scale-[0.98] flex items-center justify-center gap-2;
  }
  .action-btn:disabled { @apply opacity-40 cursor-not-allowed; }
  #upload-zone.dragover { @apply border-accent-blue bg-accent-blue/5; }
  /* Checkerboard untuk menampilkan transparansi */
  .checkerboard {
    background-color: #ffffff;
    background-image:
      linear-gradient(45deg, #e5e7eb 25%, transparent 25%),
      linear-gradient(-45deg, #e5e7eb 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #e5e7eb 75%),
      linear-gradient(-45deg, transparent 75%, #e5e7eb 75%);
    background-size: 16px 16px;
    background-position: 0 0, 0 8px, 8px -8px, -8px 0;
  }
  :global(.dark) .checkerboard {
    background-color: var(--surface-hover);
    background-image:
      linear-gradient(45deg, #242b3b 25%, transparent 25%),
      linear-gradient(-45deg, #242b3b 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #242b3b 75%),
      linear-gradient(-45deg, transparent 75%, #242b3b 75%);
  }
</style>

<script>
  const __stpPage = (location.pathname.replace(/\/+$/, '') || '/');

  // FIX pola lama: init HANYA via astro:page-load (fire sekali di load pertama).
  // Tanpa bare init() → tidak ada double-bind.
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __stpPage) return;
    init();
  });

  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // Downscale gambar sumber sebelum diproses — foto HP cukup 2400px untuk TTD.
  const MAX_DIM = 2400;

  interface Stroke {
    color: string;
    width: number;   // dalam koordinat CSS px
    points: { x: number; y: number }[]; // ternormalisasi 0..1 relatif pad
  }

  function init() {
    const padWrap = document.getElementById('pad-wrap') as HTMLDivElement;
    const pad = document.getElementById('sig-pad') as HTMLCanvasElement;
    const panelDraw = document.getElementById('panel-draw') as HTMLDivElement;
    const panelUpload = document.getElementById('panel-upload') as HTMLDivElement;
    const tabDraw = document.getElementById('tab-draw') as HTMLButtonElement;
    const tabUpload = document.getElementById('tab-upload') as HTMLButtonElement;
    const penSizeSlider = document.getElementById('pen-size') as HTMLInputElement;
    const penSizeVal = document.getElementById('pen-size-val') as HTMLSpanElement;
    const undoBtn = document.getElementById('undo-btn') as HTMLButtonElement;
    const padClearBtn = document.getElementById('pad-clear-btn') as HTMLButtonElement;
    const inkBtns = Array.from(document.querySelectorAll('.ink-btn')) as HTMLButtonElement[];

    const uploadZone = document.getElementById('upload-zone') as HTMLDivElement;
    const fileInput = document.getElementById('sig-file-input') as HTMLInputElement;
    const uploadPreviewWrap = document.getElementById('upload-preview-wrap') as HTMLDivElement;
    const uploadPreview = document.getElementById('upload-preview') as HTMLImageElement;
    const toleranceSlider = document.getElementById('tolerance') as HTMLInputElement;
    const toleranceVal = document.getElementById('tolerance-val') as HTMLSpanElement;

    const resultCanvas = document.getElementById('result-canvas') as HTMLCanvasElement;
    const resultEmpty = document.getElementById('result-empty') as HTMLParagraphElement;
    const sizeBadge = document.getElementById('size-badge') as HTMLSpanElement;
    const bgTransparentBtn = document.getElementById('bg-transparent') as HTMLButtonElement;
    const bgWhiteBtn = document.getElementById('bg-white') as HTMLButtonElement;
    const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
    const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;

    // ---- state ----
    let mode: 'draw' | 'upload' = 'draw';
    let inkColor = '#111827';
    let strokes: Stroke[] = [];
    let activeStroke: Stroke | null = null;
    let uploadedImg: HTMLImageElement | null = null;
    let whiteBg = false;
    let composeTimer: ReturnType<typeof setTimeout> | null = null;

    // ================= PAD GAMBAR =================

    function sizePad() {
      const rect = pad.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      const w = Math.max(1, Math.round(rect.width * dpr));
      const h = Math.max(1, Math.round(rect.height * dpr));
      if (pad.width === w && pad.height === h) return;
      // Preserve isi saat resize (copy → resize → redraw scaled)
      let snapshot: HTMLCanvasElement | null = null;
      if (strokes.length || activeStroke) {
        snapshot = document.createElement('canvas');
        snapshot.width = pad.width; snapshot.height = pad.height;
        snapshot.getContext('2d')!.drawImage(pad, 0, 0);
      }
      pad.width = w; pad.height = h;
      if (snapshot) pad.getContext('2d')!.drawImage(snapshot, 0, 0, w, h);
    }

    function redrawPad() {
      const ctx = pad.getContext('2d')!;
      ctx.clearRect(0, 0, pad.width, pad.height);
      const all = activeStroke ? [...strokes, activeStroke] : strokes;
      for (const s of all) drawStroke(ctx, s);
    }

    function drawStroke(ctx: CanvasRenderingContext2D, s: Stroke) {
      const pts = s.points;
      if (!pts.length) return;
      ctx.strokeStyle = s.color;
      // lineWidth dalam device px; tebal slider (CSS px) dikali DPR supaya konsisten visual
      ctx.lineWidth = s.width * (window.devicePixelRatio || 1);
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.beginPath();
      const P = (p: { x: number; y: number }) => ({ x: p.x * pad.width, y: p.y * pad.height });
      const first = P(pts[0]);
      ctx.moveTo(first.x, first.y);
      if (pts.length < 3) {
        for (let i = 1; i < pts.length; i++) {
          const q = P(pts[i]);
          ctx.lineTo(q.x, q.y);
        }
      } else {
        // Smoothing quadratic antara midpoint (kurva halus ala signature pad)
        let prev = first;
        for (let i = 1; i < pts.length - 1; i++) {
          const cur = P(pts[i]);
          const next = P(pts[i + 1]);
          const mid = { x: (cur.x + next.x) / 2, y: (cur.y + next.y) / 2 };
          ctx.quadraticCurveTo(cur.x, cur.y, mid.x, mid.y);
          prev = mid;
        }
        const lastPt = P(pts[pts.length - 1]);
        ctx.lineTo(lastPt.x, lastPt.y);
      }
      ctx.stroke();
    }

    function normPoint(e: PointerEvent): { x: number; y: number } {
      const rect = pad.getBoundingClientRect();
      return {
        x: Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width)),
        y: Math.min(1, Math.max(0, (e.clientY - rect.top) / rect.height)),
      };
    }

    pad.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      pad.setPointerCapture(e.pointerId);
      sizePad();
      activeStroke = { color: inkColor, width: parseInt(penSizeSlider.value), points: [normPoint(e)] };
      redrawPad();
      scheduleCompose();
    });
    pad.addEventListener('pointermove', (e) => {
      if (!activeStroke) return;
      e.preventDefault();
      const pts = activeStroke.points;
      const p = normPoint(e);
      const last = pts[pts.length - 1];
      // skip micro-move biar titik tidak numpuk
      if (Math.abs(p.x - last.x) < 0.0015 && Math.abs(p.y - last.y) < 0.0015) return;
      pts.push(p);
      redrawPad();
    });
    const endStroke = () => {
      if (!activeStroke) return;
      strokes.push(activeStroke);
      activeStroke = null;
      undoBtn.disabled = false;
      scheduleCompose();
    };
    pad.addEventListener('pointerup', endStroke);
    pad.addEventListener('pointercancel', endStroke);

    padClearBtn.addEventListener('click', () => {
      strokes = []; activeStroke = null;
      redrawPad();
      undoBtn.disabled = true;
      scheduleCompose();
    });

    undoBtn.addEventListener('click', () => {
      if (!strokes.length) return;
      strokes.pop(); // undo per-stroke — murah & presisi (tanpa snapshot ImageData)
      undoBtn.disabled = !strokes.length;
      redrawPad();
      scheduleCompose();
    });

    inkBtns.forEach(btn => btn.addEventListener('click', () => {
      inkBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      inkColor = btn.dataset.color || '#111827';
    }));

    penSizeSlider.addEventListener('input', () => { penSizeVal.textContent = penSizeSlider.value; });

    // Resize observer ringan (debounce) — pertahankan goresan saat layar berubah
    let resizeTimer: ReturnType<typeof setTimeout> | null = null;
    window.addEventListener('resize', () => {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => { sizePad(); redrawPad(); }, 150);
    });

    // ================= TABS =================
    function setMode(m: 'draw' | 'upload') {
      mode = m;
      tabDraw.classList.toggle('active', m === 'draw');
      tabUpload.classList.toggle('active', m === 'upload');
      panelDraw.classList.toggle('hidden', m !== 'draw');
      panelUpload.classList.toggle('hidden', m !== 'upload');
      scheduleCompose();
    }
    tabDraw.addEventListener('click', () => setMode('draw'));
    tabUpload.addEventListener('click', () => setMode('upload'));

    // ================= UPLOAD + REMOVE BG =================
    function loadImage(file: File) {
      const reader = new FileReader();
      reader.onload = () => {
        const img = new Image();
        img.onload = () => {
          uploadedImg = img;
          uploadPreview.src = reader.result as string;
          uploadPreviewWrap.classList.remove('hidden');
          scheduleCompose();
        };
        img.src = reader.result as string;
      };
      reader.readAsDataURL(file);
    }

    uploadZone.addEventListener('click', () => fileInput.click());
    uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.classList.add('dragover'); });
    uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'));
    uploadZone.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadZone.classList.remove('dragover');
      const f = e.dataTransfer?.files?.[0];
      if (f && f.type.startsWith('image/')) loadImage(f);
    });
    fileInput.addEventListener('change', () => {
      const f = fileInput.files?.[0];
      if (f) loadImage(f);
    });

    toleranceSlider.addEventListener('input', () => {
      toleranceVal.textContent = toleranceSlider.value;
      scheduleCompose();
    });

    // Luminance baseline dari piksel tepi gambar (perkiraan warna kertas)
    function edgeBaseline(d: Uint8ClampedArray, w: number, h: number): number {
      let sum = 0, n = 0;
      const sample = (x: number, y: number) => {
        const i = (y * w + x) * 4;
        sum += d[i] * 0.299 + d[i + 1] * 0.587 + d[i + 2] * 0.114;
        n++;
      };
      const stepX = Math.max(1, Math.floor(w / 64));
      const stepY = Math.max(1, Math.floor(h / 64));
      for (let x = 0; x < w; x += stepX) { sample(x, 0); sample(x, h - 1); }
      for (let y = 0; y < h; y += stepY) { sample(0, y); sample(w - 1, y); }
      return n ? sum / n : 235;
    }

    function buildProcessedCanvas(): HTMLCanvasElement | null {
      if (!uploadedImg) return null;
      const img = uploadedImg;
      const scale = Math.min(1, MAX_DIM / Math.max(img.naturalWidth, img.naturalHeight));
      const w = Math.max(1, Math.round(img.naturalWidth * scale));
      const h = Math.max(1, Math.round(img.naturalHeight * scale));
      const c = document.createElement('canvas');
      c.width = w; c.height = h;
      const ctx = c.getContext('2d', { willReadFrequently: true })!;
      ctx.drawImage(img, 0, 0, w, h);

      const imageData = ctx.getImageData(0, 0, w, h);
      const d = imageData.data;
      const baseLum = edgeBaseline(d, w, h);
      const t = parseInt(toleranceSlider.value);
      // cut = ambang luminance "dianggap kertas"; naik bersama toleransi.
      const cut = Math.min(250, baseLum * 0.92 + t * 0.55);
      const band = 16;           // lebar feather anti-bergerigi
      const satMax = Math.max(12, 42 - t * 0.25); // piksel berwarna dilindungi dari penghapusan

      for (let i = 0; i < d.length; i += 4) {
        const r = d[i], g = d[i + 1], b = d[i + 2];
        const lum = r * 0.299 + g * 0.587 + b * 0.114;
        const sat = Math.max(r, g, b) - Math.min(r, g, b);
        if (sat >= satMax) continue; // goresan berwarna → aman
        const dist = lum - cut;
        if (dist >= band) d[i + 3] = 0;                       // pasti kertas
        else if (dist > -band) {                               // zona feather
          d[i + 3] = Math.max(0, Math.min(255, Math.round(127.5 - (dist / band) * 127.5)));
        } else {
          d[i + 3] = 255;                                      // pasti tinta
        }
      }
      ctx.putImageData(imageData, 0, 0);
      return c;
    }

    // ================= COMPOSE + TRIM =================
    function currentSource(): HTMLCanvasElement | null {
      if (mode === 'draw') return strokes.length ? pad : null;
      return buildProcessedCanvas();
    }

    function compose() {
      const src = currentSource();
      if (!src) {
        resultCanvas.classList.add('hidden');
        resultEmpty.classList.remove('hidden');
        sizeBadge.textContent = '';
        downloadBtn.disabled = true;
        copyBtn.disabled = true;
        return;
      }

      // Auto-trim: bounding box alpha > 8 + padding
      const sctx = src.getContext('2d', { willReadFrequently: true })!;
      const sw = src.width, sh = src.height;
      const sd = sctx.getImageData(0, 0, sw, sh).data;
      let minX = sw, minY = sh, maxX = -1, maxY = -1;
      for (let y = 0; y < sh; y++) {
        for (let x = 0; x < sw; x++) {
          if (sd[(y * sw + x) * 4 + 3] > 8) {
            if (x < minX) minX = x;
            if (x > maxX) maxX = x;
            if (y < minY) minY = y;
            if (y > maxY) maxY = y;
          }
        }
      }
      if (maxX < 0) {
        resultCanvas.classList.add('hidden');
        resultEmpty.classList.remove('hidden');
        sizeBadge.textContent = '';
        downloadBtn.disabled = true;
        copyBtn.disabled = true;
        return;
      }

      const padPx = Math.round(Math.max(sw, sh) * 0.03) + 4;
      minX = Math.max(0, minX - padPx);
      minY = Math.max(0, minY - padPx);
      maxX = Math.min(sw - 1, maxX + padPx);
      maxY = Math.min(sh - 1, maxY + padPx);
      const cw = maxX - minX + 1;
      const chh = maxY - minY + 1;

      resultCanvas.width = cw;
      resultCanvas.height = chh;
      const octx = resultCanvas.getContext('2d')!;
      octx.clearRect(0, 0, cw, chh);
      if (whiteBg) {
        octx.fillStyle = '#ffffff';
        octx.fillRect(0, 0, cw, chh);
      }
      octx.drawImage(src, minX, minY, cw, chh, 0, 0, cw, chh);

      resultCanvas.classList.remove('hidden');
      resultEmpty.classList.add('hidden');
      sizeBadge.textContent = `${cw}×${chh}px`;
      downloadBtn.disabled = false;
      copyBtn.disabled = false;
    }

    function scheduleCompose() {
      if (composeTimer) clearTimeout(composeTimer);
      composeTimer = setTimeout(compose, 120);
    }

    // ---- background toggle ----
    function setWhiteBg(on: boolean) {
      whiteBg = on;
      bgWhiteBtn.classList.toggle('active', on);
      bgTransparentBtn.classList.toggle('active', !on);
      compose();
    }
    bgTransparentBtn.addEventListener('click', () => setWhiteBg(false));
    bgWhiteBtn.addEventListener('click', () => setWhiteBg(true));

    // ================= EXPORT =================
    downloadBtn.addEventListener('click', () => {
      if (downloadBtn.disabled) return;
      resultCanvas.toBlob((blob) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.download = `signature-${Date.now()}.png`;
        link.href = url;
        link.click();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
        toast('Tanda tangan PNG diunduh!');
      }, 'image/png');
    });

    copyBtn.addEventListener('click', async () => {
      if (copyBtn.disabled) return;
      try {
        const blob = await new Promise<Blob | null>((resolve) => resultCanvas.toBlob(resolve, 'image/png'));
        if (!blob) return;
        await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
        toast('Tanda tangan disalin ke clipboard!');
      } catch {
        toast('Gagal menyalin ke clipboard', 'error');
      }
    });

    // ---- init awal ----
    sizePad();
    redrawPad();
    updateLabelsStatic();
  }

  function updateLabelsStatic() {
    // label slider diset ulang agar konsisten setelah SPA nav (nilai default HTML)
    const penSizeVal = document.getElementById('pen-size-val') as HTMLSpanElement | null;
    const penSizeSlider = document.getElementById('pen-size') as HTMLInputElement | null;
    const toleranceVal = document.getElementById('tolerance-val') as HTMLSpanElement | null;
    const toleranceSlider = document.getElementById('tolerance') as HTMLInputElement | null;
    if (penSizeVal && penSizeSlider) penSizeVal.textContent = penSizeSlider.value;
    if (toleranceVal && toleranceSlider) toleranceVal.textContent = toleranceSlider.value;
  }
</script>
