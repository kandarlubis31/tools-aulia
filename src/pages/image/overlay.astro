---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="Image Overlay — Blend 2 Gambar | ToolsAulia" description="Tumpuk & blend dua gambar dengan opacity dan blend mode (multiply, screen, overlay, dll). 100% client-side canvas." category="Image" toolHref="/image/overlay">
  <ToolPageHeader title="Image Overlay" description="Tumpuk & blend dua gambar dengan opacity + blend mode" icon='<rect x="3" y="3" width="18" height="18" rx="2"/><rect x="9" y="9" width="13" height="13" rx="2"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-matte-500 mb-1 font-medium">Gambar Background</label>
        <div class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-6 text-center cursor-pointer hover:border-accent-blue transition-colors" id="bg-zone">
          <span id="bg-placeholder">📸 Klik upload background</span>
          <img id="bg-preview" class="hidden max-h-40 mx-auto rounded" alt="Background preview">
          <input type="file" id="bg-input" class="hidden" accept="image/*">
        </div>
      </div>
      <div>
        <label class="block text-sm text-matte-500 mb-1 font-medium">Gambar Overlay</label>
        <div class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-6 text-center cursor-pointer hover:border-accent-cyan transition-colors" id="ov-zone">
          <span id="ov-placeholder">🖼️ Klik upload overlay</span>
          <img id="ov-preview" class="hidden max-h-40 mx-auto rounded" alt="Overlay preview">
          <input type="file" id="ov-input" class="hidden" accept="image/*">
        </div>
      </div>
    </div>

    <div class="flex flex-wrap gap-3 items-end">
      <div>
        <label class="block text-xs text-matte-500 mb-1">Opacity</label>
        <input id="opacity" type="range" min="0" max="100" value="50" class="w-32">
        <span id="opacity-val" class="text-sm text-matte-500 ml-1">50%</span>
      </div>
      <div>
        <label class="block text-xs text-matte-500 mb-1">Blend Mode</label>
        <select id="blend-mode" class="input-field text-sm">
          <option value="source-over">Normal</option>
          <option value="multiply">Multiply</option>
          <option value="screen">Screen</option>
          <option value="overlay" selected>Overlay</option>
          <option value="darken">Darken</option>
          <option value="lighten">Lighten</option>
          <option value="color-dodge">Color Dodge</option>
          <option value="color-burn">Color Burn</option>
          <option value="hard-light">Hard Light</option>
          <option value="soft-light">Soft Light</option>
          <option value="difference">Difference</option>
        </select>
      </div>
      <div>
        <label class="block text-xs text-matte-500 mb-1">Posisi Overlay</label>
        <select id="position" class="input-field text-sm">
          <option value="center" selected>Center</option>
          <option value="topleft">Top Left</option>
          <option value="topright">Top Right</option>
          <option value="bottomleft">Bottom Left</option>
          <option value="bottomright">Bottom Right</option>
          <option value="stretch">Stretch to Fit</option>
        </select>
      </div>
    </div>

    <div class="bg-matte-50 dark:bg-matte-800 rounded-lg p-3 flex justify-center">
      <canvas id="preview-canvas" class="max-w-full max-h-80 rounded shadow" width="600" height="400"></canvas>
    </div>

    <button id="download-btn" class="btn-primary w-full" disabled>Download Hasil (PNG)</button>
  </div>
</BaseLayout>

<script>
  let bgImg: HTMLImageElement | null = null;
  let ovImg: HTMLImageElement | null = null;

  const canvas = document.getElementById('preview-canvas')! as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const downloadBtn = document.getElementById('download-btn')! as HTMLButtonElement;

  function setupZone(zoneId: string, inputId: string, previewId: string, placeholderId: string, setter: (img: HTMLImageElement) => void) {
    const zone = document.getElementById(zoneId)!;
    const input = document.getElementById(inputId)! as HTMLInputElement;
    const preview = document.getElementById(previewId)! as HTMLImageElement;
    const placeholder = document.getElementById(placeholderId)!;

    zone.addEventListener('click', () => input.click());
    zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('border-accent-blue'); });
    zone.addEventListener('dragleave', () => zone.classList.remove('border-accent-blue'));
    zone.addEventListener('drop', e => {
      e.preventDefault(); zone.classList.remove('border-accent-blue');
      const f = e.dataTransfer?.files?.[0]; if (f) loadImg(f);
    });
    input.addEventListener('change', () => { const f = input.files?.[0]; if (f) loadImg(f); });

    function loadImg(file: File) {
      const reader = new FileReader();
      reader.onload = () => {
        const img = new Image();
        img.onload = () => {
          setter(img);
          placeholder.classList.add('hidden');
          preview.src = URL.createObjectURL(new Blob([new Uint8Array(reader.result as ArrayBuffer)]));
          preview.classList.remove('hidden');
          render();
        };
        img.src = reader.result as string;
      };
      reader.readAsDataURL(file);
    }
  }

  setupZone('bg-zone', 'bg-input', 'bg-preview', 'bg-placeholder', img => { bgImg = img; });
  setupZone('ov-zone', 'ov-input', 'ov-preview', 'ov-placeholder', img => { ovImg = img; });

  const opacitySlider = document.getElementById('opacity')! as HTMLInputElement;
  const blendSelect = document.getElementById('blend-mode')! as HTMLSelectElement;
  const posSelect = document.getElementById('position')! as HTMLSelectElement;
  const opacityVal = document.getElementById('opacity-val')!;

  [opacitySlider, blendSelect, posSelect].forEach(el => el.addEventListener('input', render));
  opacitySlider.addEventListener('input', () => { opacityVal.textContent = opacitySlider.value + '%'; });

  function render() {
    if (!bgImg) return;
    const w = canvas.width = Math.min(bgImg.naturalWidth, 800);
    const h = canvas.height = Math.min(bgImg.naturalHeight, 600);

    ctx.clearRect(0, 0, w, h);
    ctx.globalAlpha = 1;
    ctx.globalCompositeOperation = 'source-over';
    ctx.drawImage(bgImg, 0, 0, w, h);

    if (!ovImg) { downloadBtn.disabled = true; return; }
    downloadBtn.disabled = false;

    ctx.globalAlpha = parseInt(opacitySlider.value) / 100;
    ctx.globalCompositeOperation = blendSelect.value as GlobalCompositeOperation;

    const pos = posSelect.value;
    const ow = Math.min(ovImg.naturalWidth, w * 0.6);
    const oh = Math.min(ovImg.naturalHeight, h * 0.6);
    let ox = 0, oy = 0;

    if (pos === 'stretch') {
      ctx.drawImage(ovImg, 0, 0, w, h);
    } else {
      if (pos === 'center') { ox = (w - ow) / 2; oy = (h - oh) / 2; }
      else if (pos === 'topright') { ox = w - ow - 10; oy = 10; }
      else if (pos === 'bottomleft') { ox = 10; oy = h - oh - 10; }
      else if (pos === 'bottomright') { ox = w - ow - 10; oy = h - oh - 10; }
      else { ox = 10; oy = 10; }
      ctx.drawImage(ovImg, ox, oy, ow, oh);
    }

    ctx.globalAlpha = 1;
    ctx.globalCompositeOperation = 'source-over';
  }

  downloadBtn.addEventListener('click', () => {
    canvas.toBlob(blob => {
      if (!blob) return;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = 'overlay-result.png'; a.click();
      URL.revokeObjectURL(url);
      showToast?.(_tToast?.('Gambar di-download!', 'Image downloaded!'), 'success');
    }, 'image/png');
  });
</script>
