---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
import DropZone from '../../components/DropZone.astro';
---

<BaseLayout pageTitle="Image Converter (PNG/JPG/WebP)">
  <div class="flex flex-col items-center justify-center min-h-[60vh]">
    
    <ToolPageHeader
      title="Image Converter (PNG/JPG/WebP)"
      titleKey="header.converter"
      desc="Ubah format gambar (PNG, JPG, WebP) instan tanpa upload ke server."
      descKey="header.converter_desc"
      icon='<path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>'
    />

    <div class="max-w-xl w-full card-base p-8 text-center">
      <DropZone
        accept="image/png, image/jpeg, image/webp"
        label="Klik atau Tarik File Gambar ke sini"
        labelKey="text.click_drag_png"
        icon='<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>'
      />

      <div id="result-area" class="hidden mt-8 animate-fade-in">
        <div class="flex justify-center mb-6">
          <img id="preview-img" class="max-h-48 rounded-lg border border-matte-200 dark:border-matte-600 shadow-lg" alt="Converted image preview" loading="lazy" />
        </div>

        <div class="flex flex-wrap gap-4 justify-center items-center mb-6">
          <div class="flex items-center gap-2">
            <label for="out-format" class="text-2xs font-bold text-matte-400 uppercase tracking-wider" data-i18n="conv.format">Format</label>
            <select id="out-format" class="px-3 py-2 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-xs font-bold outline-none">
              <option value="image/jpeg" selected>JPG</option>
              <option value="image/png">PNG</option>
              <option value="image/webp">WebP</option>
            </select>
          </div>
          <div id="quality-wrap" class="flex items-center gap-2">
            <label for="quality" class="text-2xs font-bold text-matte-400 uppercase tracking-wider" data-i18n="conv.quality">Kualitas</label>
            <input id="quality" type="range" min="10" max="100" value="90" class="w-28 accent-sky-500" />
            <span id="quality-val" class="text-2xs font-mono text-matte-500 w-8">90%</span>
          </div>
        </div>

        <div class="flex gap-4 justify-center">
          <button id="convert-btn" class="bg-matte-900 dark:bg-white text-white dark:text-matte-900 px-6 py-2 rounded-lg font-bold transition-all active:scale-95" data-i18n="btn.download_jpg">
            Download JPG
          </button>
          <button id="reset-btn" class="text-matte-400 dark:text-matte-300 hover:text-accent-blue px-4 py-2 transition-colors" data-i18n="btn.reset">
            Reset
          </button>
        </div>
      </div>

      <!-- Info -->
      <div class="text-2xs text-matte-400 bg-matte-50 dark:bg-surface-hover rounded-xl p-4 mt-8 text-left leading-relaxed">
        <p class="font-bold text-matte-600 dark:text-matte-300 mb-1" data-i18n="conv.info_title">Yang perlu diketahui</p>
        <ul class="list-disc list-inside space-y-0.5">
          <li data-i18n="conv.info_1">Pilih format tujuan (JPG, PNG, atau WebP) sebelum menekan tombol download.</li>
          <li data-i18n="conv.info_2">Slider kualitas berlaku untuk JPG &amp; WebP. PNG lossless — ukuran bisa lebih besar dari aslinya.</li>
          <li data-i18n="conv.info_3">JPG tidak mendukung transparansi, jadi latar otomatis diisi putih. File diproses lokal di browser tanpa upload.</li>
        </ul>
      </div>

    </div>
  </div>
</BaseLayout>

<script>

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const resultArea = document.getElementById('result-area');
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const convertBtn = document.getElementById('convert-btn');
  const resetBtn = document.getElementById('reset-btn');
  const outFormat = document.getElementById('out-format') as HTMLSelectElement;
  const qualityWrap = document.getElementById('quality-wrap') as HTMLDivElement;
  const quality = document.getElementById('quality') as HTMLInputElement;
  const qualityVal = document.getElementById('quality-val') as HTMLSpanElement;

  let currentFile: File | null = null;

  // 1. Handle File Input
  if (dropZone && fileInput) {
    dropZone.addEventListener('click', () => fileInput.click());
    
    fileInput.addEventListener('change', (e) => {
      if (fileInput.files && fileInput.files[0]) {
        handleFile(fileInput.files[0]);
      }
    });

    // Drag & Drop Handling
    // PERBAIKAN DI SINI: Syntax event listener dirapikan
    dropZone.addEventListener('dragover', (e) => { 
      e.preventDefault(); 
      dropZone.classList.add('border-sky-500'); 
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-sky-500');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-sky-500');
      if (e.dataTransfer?.files[0]) handleFile(e.dataTransfer.files[0]);
    });
  }

  const MAX_FILE_SIZE = 20 * 1024 * 1024; // 20MB
  function handleFile(file: File) {
    if (file.size > MAX_FILE_SIZE) {
      window.showToast?.(window._tToast ? window._tToast('File terlalu besar! Maksimal 20MB.') : 'File terlalu besar! Maksimal 20MB.', 'error');
      return;
    }
    if (!['image/png', 'image/jpeg', 'image/webp'].includes(file.type)) {
      window.showToast?.(window._tToast ? window._tToast('Format tidak didukung! Upload PNG, JPG, atau WebP.') : 'Format tidak didukung! Upload PNG, JPG, atau WebP.', 'error');
      return;
    }
    // Sinkronkan tombol & visibility kualitas dengan format tujuan
    syncFormatUI();
    currentFile = file;
    
    const reader = new FileReader();
    reader.onload = (e) => {
      if(previewImg && e.target && dropZone && resultArea) {
        previewImg.src = e.target.result as string;
        dropZone.classList.add('hidden');
        resultArea.classList.remove('hidden');
      }
    };
    reader.readAsDataURL(file);
  }

  // 2. Logic Konversi (Canvas Magic) — dukung JPG / PNG / WebP + slider kualitas
  function syncFormatUI() {
    if (!outFormat) return;
    const isJpg = outFormat.value === 'image/jpeg';
    const lossy = isJpg || outFormat.value === 'image/webp';
    if (qualityWrap) qualityWrap.style.display = lossy ? '' : 'none';
    if (convertBtn) {
      const fmt = isJpg ? 'JPG' : outFormat.value === 'image/png' ? 'PNG' : 'WebP';
      convertBtn.textContent = 'Download ' + fmt;
    }
  }
  outFormat?.addEventListener('change', syncFormatUI);
  quality?.addEventListener('input', () => { if (qualityVal) qualityVal.textContent = quality.value + '%'; });
  syncFormatUI();

  convertBtn?.addEventListener('click', () => {
    if (!previewImg.src) return;

    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    if (!ctx) { window.showToast?.(window._tToast ? window._tToast('Gagal render: context tidak tersedia.') : 'Gagal render: context tidak tersedia.', 'error'); return; }
    const img = new Image();

    img.onload = () => {
      canvas.width = img.width;
      canvas.height = img.height;

      const mime = outFormat?.value || 'image/jpeg';
      // JPG tidak support transparan → fill putih dulu (PNG/WebP pertahankan alpha)
      if (ctx) {
        if (mime === 'image/jpeg') {
          ctx.fillStyle = '#FFFFFF';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
        }
        ctx.drawImage(img, 0, 0);
      }

      const q = (parseInt(quality?.value || '90', 10) || 90) / 100;
      const dataUrl = mime === 'image/png' ? canvas.toDataURL(mime) : canvas.toDataURL(mime, q);
      const ext = mime === 'image/jpeg' ? 'jpg' : mime === 'image/png' ? 'png' : 'webp';

      const link = document.createElement('a');
      link.download = `converted-${Date.now()}.${ext}`;
      link.href = dataUrl;
      link.click();
      window.showToast?.(window._tToast ? window._tToast('Gambar berhasil dikonversi!') : 'Gambar berhasil dikonversi!', 'success');
    };

    img.src = previewImg.src;
  });

  // 3. Reset
  resetBtn?.addEventListener('click', () => {
    currentFile = null;
    if(fileInput) fileInput.value = '';
    resultArea?.classList.add('hidden');
    dropZone?.classList.remove('hidden');
  });

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __imageConverterPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __imageConverterPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>

<style>
  .animate-fade-in { animation: fadeIn 0.5s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
