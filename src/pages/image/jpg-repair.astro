---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
import DropZone from '../../components/DropZone.astro';
---

<BaseLayout pageTitle="JPG Repair — Perbaiki Foto JPG Rusak, Gagal Dibuka" description="Perbaiki file JPG yang rusak, kepotong, atau tidak bisa dibuka. Deteksi kerusakan otomatis + rekonstruksi header. 100% di browser tanpa upload.">
  <div class="max-w-5xl mx-auto px-4 min-h-[80vh]">
    <ToolPageHeader
      title="JPG Repair"
      titleKey="tool.jpg_repair"
      desc="Perbaiki file JPG yang rusak, kepotong, atau tidak bisa dibuka. Deteksi kerusakan otomatis + rekonstruksi header. 100% di browser."
      descKey="tool.jpg_repair_desc"
      icon='<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>'
    />

    <div class="card-base p-5 mb-8 text-sm text-matte-600 dark:text-matte-400">
      <p class="font-semibold text-matte-800 dark:text-matte-200 mb-1" data-i18n="jpg.problems_title">Masalah yang bisa ditangani:</p>
      <p data-i18n="jpg.problems_desc">File kepotong saat download/copy (EOI hilang) · header/sampah byte di awal file · struktur marker rusak · file PNG/WEBP yang salah dinamai .jpg · trailing garbage setelah akhir file. Semua diproses di browser — foto lo gak pernah diupload ke mana-mana.</p>
    </div>

    <DropZone
      accept="image/jpeg,.jpg,.jpeg,.jpe"
      multiple={true}
      label="Upload Foto JPG Rusak"
      labelKey="jpg.drop_label"
      subLabel="Boleh lebih dari satu file (Max 50MB per file)"
      subLabelKey="jpg.drop_sublabel"
      icon='<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>'
      className="max-w-2xl mx-auto animate-on-scroll"
    />

    <div id="summary" class="hidden mt-8 mb-6 text-center">
      <div id="summary-text" class="inline-flex items-center gap-3 px-6 py-3 rounded-2xl bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border font-bold text-matte-700 dark:text-matte-200"></div>
    </div>

    <div id="results" class="hidden flex flex-col gap-6 pb-20"></div>
  </div>
</BaseLayout>

<script>
  import { t } from '../../i18n/translations';

  const toast = (msg, type = 'success') => window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load (guard #14).
  function init() {
  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
  const summary = document.getElementById('summary');
  const summaryText = document.getElementById('summary-text');
  const results = document.getElementById('results');

  const MAX_SIZE = 50 * 1024 * 1024; // 50MB

  if (!dropZone || !fileInput || !summary || !summaryText || !results) return;

  function formatBytes(bytes: number): string {
    if (!+bytes) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return `${parseFloat((bytes / Math.pow(k, i)).toFixed(2))} ${sizes[i]}`;
  }

  // ---------- Diagnostik struktur JPEG ----------
  interface Diag {
    isJpeg: boolean;
    realFormat: string;
    soiPos: number;        // offset FF D8 (0 = normal, -1 = tidak ada)
    hasJfif: boolean;
    hasExif: boolean;
    width: number;
    height: number;
    lastEoiPos: number;    // offset FF D9 terakhir (-1 = tidak ada)
    hasEoiAtEnd: boolean;
    structureBrokenAt: number; // offset marker rusak (-1 = struktur utuh)
    problems: string[];
  }

  function detectFormat(b: Uint8Array): string {
    if (b.length < 4) return 'unknown';
    if (b[0] === 0xFF && b[1] === 0xD8) return 'JPEG';
    if (b[0] === 0x89 && b[1] === 0x50 && b[2] === 0x4E && b[3] === 0x47) return 'PNG';
    if (b[0] === 0x47 && b[1] === 0x49 && b[2] === 0x46) return 'GIF';
    if (b[0] === 0x42 && b[1] === 0x4D) return 'BMP';
    if (b.length > 11 && b[0] === 0x52 && b[1] === 0x49 && b[2] === 0x46 && b[3] === 0x46
      && b[8] === 0x57 && b[9] === 0x45 && b[10] === 0x42 && b[11] === 0x50) return 'WEBP';
    if (b.length > 11 && b[4] === 0x66 && b[5] === 0x74 && b[6] === 0x79 && b[7] === 0x70) return 'HEIC/MP4';
    return 'unknown';
  }

  function analyze(b: Uint8Array): Diag {
    const d: Diag = {
      isJpeg: false, realFormat: 'unknown', soiPos: -1, hasJfif: false, hasExif: false,
      width: 0, height: 0, lastEoiPos: -1, hasEoiAtEnd: false, structureBrokenAt: -1, problems: [],
    };
    d.realFormat = detectFormat(b);

    // cari SOI (FF D8) di 64 byte pertama
    for (let i = 0; i < Math.min(b.length - 1, 64); i++) {
      if (b[i] === 0xFF && b[i + 1] === 0xD8) { d.soiPos = i; break; }
    }

    // cari EOI terakhir
    for (let i = b.length - 2; i >= 0; i--) {
      if (b[i] === 0xFF && b[i + 1] === 0xD9) { d.lastEoiPos = i; break; }
    }
    d.hasEoiAtEnd = d.lastEoiPos === b.length - 2;

    if (d.soiPos === -1) {
      d.problems.push(`Bukan file JPEG (terdeteksi: ${d.realFormat})`);
      return d;
    }
    d.isJpeg = true;

    if (d.soiPos > 0) d.problems.push(`Ada ${d.soiPos} byte sampah sebelum header JPEG`);
    if (d.lastEoiPos === -1) d.problems.push('Penutup file (EOI marker) hilang — file kepotong');
    else if (!d.hasEoiAtEnd) d.problems.push(`Ada ${b.length - 2 - d.lastEoiPos} byte sampah setelah akhir file`);

    // walk marker segments dari setelah SOI
    let off = d.soiPos + 2;
    while (off < b.length - 1) {
      if (b[off] !== 0xFF) { d.structureBrokenAt = off; break; }
      let marker = b[off + 1];
      // skip fill bytes FF
      while (marker === 0xFF && off < b.length - 1) { off++; marker = b[off + 1]; }
      if (marker === 0xD9) break;                                    // EOI
      if (marker === 0xDA) {                                          // SOS — scan data, selesai
        if (d.width === 0) d.problems.push('Frame gambar (SOF) tidak ditemukan');
        off = b.length; break;
      }
      if (marker === 0x01 || (marker >= 0xD0 && marker <= 0xD7)) { off += 2; continue; }
      if (off + 3 >= b.length) { d.structureBrokenAt = off; break; }
      const segLen = (b[off + 2] << 8) | b[off + 3];
      if (segLen < 2) { d.structureBrokenAt = off; break; }
      if (marker === 0xE0) d.hasJfif = true;
      if (marker === 0xE1) d.hasExif = true;
      if ((marker >= 0xC0 && marker <= 0xCF) && marker !== 0xC4 && marker !== 0xC8 && marker !== 0xCC) {
        if (off + 8 < b.length) {
          d.height = (b[off + 5] << 8) | b[off + 6];
          d.width = (b[off + 7] << 8) | b[off + 8];
        }
      }
      off += 2 + segLen;
    }
    if (d.structureBrokenAt !== -1) d.problems.push(`Struktur marker rusak di offset ${d.structureBrokenAt}`);
    if (d.width > 0 && d.hasJfif === false && d.hasExif === false) d.problems.push('Header identitas (JFIF/EXIF) hilang');

    if (d.problems.length === 0) d.problems.push('Struktur terdeteksi utuh — kemungkinan korupsi di dalam data gambar');
    return d;
  }

  // ---------- Kandidat perbaikan byte-level ----------
  function buildCandidates(b: Uint8Array, d: Diag): { name: string; bytes: Uint8Array }[] {
    const out: { name: string; bytes: Uint8Array }[] = [];
    const seen = new Set<string>();
    const push = (name: string, bytes: Uint8Array) => {
      const key = `${bytes.length}:${bytes[0]}:${bytes[1]}`;
      if (seen.has(key)) return;
      seen.add(key);
      out.push({ name, bytes });
    };

    push('File asli', b);

    // strip sampah sebelum SOI + pastikan EOI di akhir
    if (d.isJpeg && (d.soiPos > 0 || !d.hasEoiAtEnd)) {
      const core = b.slice(d.soiPos > 0 ? d.soiPos : 0);
      if (!d.hasEoiAtEnd) {
        const fixed = new Uint8Array(core.length + 2);
        fixed.set(core, 0);
        fixed[core.length] = 0xFF;
        fixed[core.length + 1] = 0xD9;
        push('Bersihkan header + tambah penutup', fixed);
      } else {
        push('Bersihkan header', core);
      }
    }

    // buang trailing garbage setelah EOI terakhir
    if (d.isJpeg && d.lastEoiPos >= 0 && !d.hasEoiAtEnd) {
      push('Buang sampah di akhir file', b.slice(0, d.lastEoiPos + 2));
    }

    // rebuild header JFIF minimal (SOI + APP0) + sisa segmen asli
    if (d.isJpeg && !d.hasJfif && !d.hasExif && d.structureBrokenAt === -1) {
      const jfif = [0xFF, 0xE0, 0x00, 0x10, 0x4A, 0x46, 0x49, 0x46, 0x00, 0x01, 0x01, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00];
      const rest = b.slice(d.soiPos + 2);
      const fixed = new Uint8Array(2 + jfif.length + rest.length);
      fixed.set([0xFF, 0xD8], 0);
      fixed.set(jfif, 2);
      fixed.set(rest, 2 + jfif.length);
      push('Rebuild header JFIF', fixed);
    }

    return out;
  }

  // ---------- Decode (dua jalur: ketat lalu longgar) ----------
  async function decodeStrict(bytes: Uint8Array): Promise<ImageBitmap | null> {
    try {
      return await createImageBitmap(new Blob([bytes.slice()], { type: 'image/jpeg' }));
    } catch { return null; }
  }

  function decodeLenient(bytes: Uint8Array): Promise<HTMLImageElement | null> {
    // <img> lebih toleran terhadap file kepotong — browser render sampai MCU terakhir yang utuh
    return new Promise((resolve) => {
      const url = URL.createObjectURL(new Blob([bytes.slice()], { type: 'image/jpeg' }));
      const img = new Image();
      img.onload = () => { URL.revokeObjectURL(url); resolve(img.width > 0 ? img : null); };
      img.onerror = () => { URL.revokeObjectURL(url); resolve(null); };
      img.src = url;
    });
  }

  async function decodeAny(bytes: Uint8Array): Promise<{ w: number; h: number; draw: (ctx: CanvasRenderingContext2D) => void } | null> {
    const bmp = await decodeStrict(bytes);
    if (bmp) return { w: bmp.width, h: bmp.height, draw: (ctx) => ctx.drawImage(bmp, 0, 0) };
    const img = await decodeLenient(bytes);
    if (img) return { w: img.naturalWidth, h: img.naturalHeight, draw: (ctx) => ctx.drawImage(img, 0, 0) };
    return null;
  }

  function reencode(decoded: { w: number; h: number; draw: (ctx: CanvasRenderingContext2D) => void }, quality: number): Promise<Blob | null> {
    return new Promise((resolve) => {
      const canvas = document.createElement('canvas');
      canvas.width = decoded.w;
      canvas.height = decoded.h;
      const ctx = canvas.getContext('2d');
      if (!ctx) return resolve(null);
      ctx.fillStyle = '#FFFFFF'; // JPG gak punya alpha — putih biar transparan gak jadi hitam
      ctx.fillRect(0, 0, decoded.w, decoded.h);
      decoded.draw(ctx);
      canvas.toBlob((blob) => resolve(blob), 'image/jpeg', quality);
    });
  }

  // ---------- Pipeline per file ----------
  interface Outcome {
    file: File;
    diag: Diag;
    status: 'ok' | 'fixed' | 'failed';
    actions: string[];
    losslessBlob: Blob | null;
    repairedBlob: Blob | null;
    width: number;
    height: number;
    previewUrl: string | null;
  }

  async function repairFile(file: File, quality: number): Promise<Outcome> {
    const buf = new Uint8Array(await file.arrayBuffer());
    const diag = analyze(buf);
    const base: Outcome = {
      file, diag, status: 'failed', actions: [], losslessBlob: null,
      repairedBlob: null, width: diag.width, height: diag.height, previewUrl: null,
    };

    // file bukan JPEG sama sekali — kalau ke-decode (PNG/WEBP dll), konversi jadi JPG asli
    if (!diag.isJpeg) {
      const decoded = await decodeAny(buf);
      if (!decoded) return base;
      const blob = await reencode(decoded, quality);
      if (!blob) return base;
      return {
        ...base, status: 'fixed', width: decoded.w, height: decoded.h,
        repairedBlob: blob, previewUrl: URL.createObjectURL(blob),
        actions: [`File ternyata ${diag.realFormat} yang salah dinamai .jpg — dikonversi ulang jadi JPG asli`],
      };
    }

    // coba tiap kandidat byte-level, decode, lalu re-encode
    const candidates = buildCandidates(buf, diag);
    for (const cand of candidates) {
      const decoded = await decodeAny(cand.bytes);
      if (!decoded) continue;
      const blob = await reencode(decoded, quality);
      if (!blob) continue;
      const isOriginal = cand.name === 'File asli';
      const lossless = !isOriginal && cand.bytes.length > 0
        ? new Blob([cand.bytes.slice()], { type: 'image/jpeg' })
        : null;
      return {
        ...base,
        status: isOriginal ? 'ok' : 'fixed',
        width: decoded.w, height: decoded.h,
        repairedBlob: blob, losslessBlob: lossless,
        previewUrl: URL.createObjectURL(blob),
        actions: [
          isOriginal ? 'File berhasil dibaca — disegarkan ulang (re-encode) jadi JPG valid' : `Diperbaiki: ${cand.name}`,
          'Ukuran & dimensi gambar dipertahankan',
        ],
      };
    }

    return base;
  }

  // ---------- Render ----------
  function card(o: Outcome): HTMLElement {
    const el = document.createElement('div');
    el.className = 'card-base p-5 flex flex-col sm:flex-row gap-5';

    const statusBadge =
      o.status === 'ok' ? '<span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">✓ Terbaca</span>'
      : o.status === 'fixed' ? '<span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">🔧 Diperbaiki</span>'
      : '<span class="px-3 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300">✕ Gagal diperbaiki</span>';

    const preview = o.previewUrl
      ? `<img src="${o.previewUrl}" alt="Hasil perbaikan" class="w-full sm:w-48 h-40 object-contain bg-matte-100 dark:bg-matte-800 rounded-xl" loading="lazy" />`
      : '<div class="w-full sm:w-48 h-40 flex items-center justify-center bg-matte-100 dark:bg-matte-800 rounded-xl text-matte-400 text-3xl">⌀</div>';

    const dimInfo = o.width > 0 ? `${o.width}×${o.height}px` : 'dimensi tidak diketahui';
    const sizeInfo = o.repairedBlob
      ? `${formatBytes(o.file.size)} → <span class="text-emerald-600 dark:text-emerald-400 font-bold">${formatBytes(o.repairedBlob.size)}</span>`
      : formatBytes(o.file.size);

    const problems = o.diag.problems.map((p) =>
      `<li class="text-rose-600 dark:text-rose-400">• ${p}</li>`).join('');
    const actions = o.actions.map((a) =>
      `<li class="text-emerald-600 dark:text-emerald-400">• ${a}</li>`).join('');

    const dlBtn = o.repairedBlob && o.previewUrl
      ? `<button data-download class="mt-3 w-full sm:w-auto bg-amber-600 hover:bg-amber-700 text-white font-bold py-2.5 px-5 rounded-xl transition-all active:scale-95">${t('jpg.download', 'Download Hasil')}</button>`
      : '';
    const losslessBtn = o.losslessBlob
      ? `<button data-lossless class="mt-3 w-full sm:w-auto bg-matte-200 hover:bg-matte-300 dark:bg-matte-700 dark:hover:bg-matte-600 text-matte-700 dark:text-matte-200 font-bold py-2.5 px-5 rounded-xl transition-all active:scale-95" title="Versi diperbaiki tanpa kompresi ulang — struktur byte diperbaiki, kualitas 100% asli">${t('jpg.lossless', 'Download Lossless')}</button>`
      : '';

    el.innerHTML = `
      ${preview}
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-3 mb-2 flex-wrap">
          <span class="font-bold text-matte-800 dark:text-matte-200 truncate max-w-full">${o.file.name}</span>
          ${statusBadge}
        </div>
        <p class="text-xs text-matte-500 dark:text-matte-400 mb-3">${dimInfo} · ${sizeInfo}${o.repairedBlob && !o.diag.hasExif ? ' · EXIF asli tidak dibawa ke hasil re-encode' : ''}</p>
        <div class="grid sm:grid-cols-2 gap-x-6 gap-y-1 text-sm mb-3">
          <div>
            <p class="font-semibold text-xs uppercase text-matte-400 mb-1">${t('jpg.findings', 'Temuan diagnosa')}</p>
            <ul class="space-y-0.5">${problems}</ul>
          </div>
          <div>
            <p class="font-semibold text-xs uppercase text-matte-400 mb-1">${t('jpg.actions_label', 'Tindakan')}</p>
            <ul class="space-y-0.5">${actions || '<li class="text-matte-400">—</li>'}</ul>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">${dlBtn}${losslessBtn}</div>
      </div>`;

    const dl = el.querySelector('[data-download]');
    if (dl && o.repairedBlob) dl.addEventListener('click', () => {
      const a = document.createElement('a');
      a.href = o.previewUrl!;
      a.download = o.file.name.replace(/\.(jpe?g)$/i, '') + '-repaired.jpg';
      a.click();
    });
    const ll = el.querySelector('[data-lossless]');
    if (ll && o.losslessBlob) ll.addEventListener('click', () => {
      const url = URL.createObjectURL(o.losslessBlob!);
      const a = document.createElement('a');
      a.href = url;
      a.download = o.file.name.replace(/\.(jpe?g)$/i, '') + '-repaired-lossless.jpg';
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 5000);
    });
    return el;
  }

  async function handleFiles(files: FileList | File[]) {
    const list = Array.from(files).filter((f) => {
      if (f.size === 0) return false;
      return true;
    });
    const skipped = Array.from(files).length - list.length;
    if (list.length === 0) {
      summary.classList.remove('hidden');
      const msg = skipped > 0
        ? t('jpg.all_empty', 'Semua file kosong (0 byte) — sayangnya tidak bisa diperbaiki')
        : t('jpg.no_files', 'Tidak ada file diproses');
      summaryText.textContent = msg;
      toast(msg, 'error');
      return;
    }

    summary.classList.remove('hidden');
    results.classList.remove('hidden');
    summaryText.textContent = t('jpg.processing', 'Memproses {n} file…').replace('{n}', String(list.length));

    let ok = 0, fixed = 0, failed = 0;
    for (const file of list) {
      if (file.size > MAX_SIZE) {
        failed++;
        const o: Outcome = {
          file, diag: { isJpeg: false, realFormat: 'unknown', soiPos: -1, hasJfif: false, hasExif: false, width: 0, height: 0, lastEoiPos: -1, hasEoiAtEnd: false, structureBrokenAt: -1, problems: [`File terlalu besar (${formatBytes(file.size)}, maks 50MB)`] },
          status: 'failed', actions: [], losslessBlob: null, repairedBlob: null, width: 0, height: 0, previewUrl: null,
        };
        results.appendChild(card(o));
        continue;
      }
      const o = await repairFile(file, 0.92);
      if (o.status === 'ok') ok++;
      else if (o.status === 'fixed') fixed++;
      else failed++;
      results.appendChild(card(o));
      summaryText.textContent = t('jpg.processing_progress', 'Memproses… ({i}/{n})')
        .replace('{i}', String(ok + fixed + failed)).replace('{n}', String(list.length));
    }

    const bits: string[] = [];
    if (fixed > 0) bits.push(`<span class="text-amber-600 dark:text-amber-400">${fixed} diperbaiki</span>`);
    if (ok > 0) bits.push(`<span class="text-emerald-600 dark:text-emerald-400">${ok} terbaca</span>`);
    if (failed > 0) bits.push(`<span class="text-rose-600 dark:text-rose-400">${failed} gagal</span>`);
    summaryText.innerHTML = `Selesai: ${bits.join(' · ')}`;
    if (skipped > 0) summaryText.innerHTML += ` <span class="text-matte-400">(${skipped} file kosong dilewati)</span>`;
    toast(t('jpg.toast_done', 'Selesai — {ok} terbaca · {fixed} diperbaiki · {failed} gagal')
      .replace('{ok}', String(ok)).replace('{fixed}', String(fixed)).replace('{failed}', String(failed)), 'success');
  }

  // wiring drop
  ['dragenter', 'dragover'].forEach((ev) =>
    dropZone.addEventListener(ev, (e) => { e.preventDefault(); dropZone.classList.add('border-amber-500'); }));
  ['dragleave', 'drop'].forEach((ev) =>
    dropZone.addEventListener(ev, () => dropZone.classList.remove('border-amber-500')));
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    const files = (e as DragEvent).dataTransfer?.files;
    if (files && files.length) handleFiles(files);
  });
  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files.length) handleFiles(fileInput.files);
    fileInput.value = '';
  });
  }

  // SPA boot (#14): guard path + guard dobel-bind (autoBound)
  const __imageJpgRepairPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __imageJpgRepairPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });
</script>
