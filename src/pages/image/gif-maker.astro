---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="GIF Maker — Buat GIF Animasi Online Gratis">
  <div class="max-w-3xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="GIF Maker"
      titleKey="header.gif_maker"
      desc="Buat animasi GIF dari beberapa frame gambar. Atur delay & loop."
      descKey="header.gif_maker_desc"
      icon='<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 8v8"/><path d="M8 12h8"/>'
      gradient="from-pink-500 to-rose-600"
    />

    <div class="animate-fade-in space-y-4">
      <!-- Frame upload -->
      <div class="card-base p-5">
        <h3 class="text-xs font-bold text-matte-500 dark:text-matte-300 uppercase tracking-wider mb-3">1. <span data-i18n="gif.add_frames">Tambah Frame</span></h3>
        <div class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-6 text-center hover:border-pink-400 dark:hover:border-pink-500 transition-colors cursor-pointer" id="drop-zone">
          <input type="file" id="file-input" accept="image/*" multiple class="hidden" />
          <svg class="w-10 h-10 mx-auto mb-2 text-matte-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <p class="text-sm font-bold text-matte-500 dark:text-matte-300" data-i18n="gif.upload">Pilih gambar untuk frame GIF</p>
          <p class="text-2xs text-matte-400 mt-1" data-i18n="gif.upload_hint">PNG, JPG, WEBP — urutan sesuai nama file</p>
        </div>
      </div>

      <!-- Frame list -->
      <div class="card-base p-5">
        <h3 class="text-xs font-bold text-matte-500 dark:text-matte-300 uppercase tracking-wider mb-3">2. <span data-i18n="gif.frames">Frame</span> <span id="frame-count" class="text-matte-400">(0)</span></h3>
        <div id="frames-preview" class="flex flex-wrap gap-2 mb-4 min-h-[80px] items-center">
          <p class="text-xs text-matte-400 text-center w-full py-4" data-i18n="gif.no_frames">Belum ada frame. Upload gambar dulu.</p>
        </div>
        <div class="flex items-center gap-3 flex-wrap">
          <button id="preview-btn" class="px-4 py-2 rounded-lg text-sm font-bold bg-pink-100 dark:bg-pink-900/40 text-pink-700 dark:text-pink-300 hover:bg-pink-200 dark:hover:bg-pink-900/60 transition-all disabled:opacity-50" disabled>
            ▶️ <span data-i18n="gif.preview">Preview Animasi</span>
          </button>
          <div class="flex items-center gap-2 text-xs ml-auto flex-wrap">
            <label class="text-2xs text-matte-400 font-bold"><span data-i18n="gif.delay">Delay</span>:</label>
            <input id="delay-input" type="number" value="300" min="50" max="5000" step="50" class="w-20 px-2 py-1.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-xs font-mono outline-none focus:ring-2 focus:ring-pink-500/40" />
            <span class="text-2xs text-matte-400">ms</span>
          </div>
        </div>
      </div>

      <!-- Preview & Download -->
      <div id="output-area" class="hidden card-base p-5 text-center">
        <h3 class="text-xs font-bold text-matte-500 dark:text-matte-300 uppercase tracking-wider mb-3">3. <span data-i18n="gif.result">Preview</span></h3>
        <canvas id="anim-canvas" class="max-w-full mx-auto rounded-lg" style="max-height:400px"></canvas>
        <div class="mt-3 flex flex-wrap gap-2 justify-center">
          <button id="play-btn" class="px-4 py-2 rounded-lg text-sm font-bold bg-pink-100 dark:bg-pink-900/40 text-pink-700 dark:text-pink-300 hover:bg-pink-200 dark:hover:bg-pink-900/60 transition-all">
            ▶️ Play / ⏸️ Pause
          </button>
          <button id="download-btn" class="gradient-brand px-5 py-2.5 rounded-lg text-sm font-bold">
            💾 <span data-i18n="gif.download_frames">Download Frame PNG</span>
          </button>
        </div>
      </div>
    </div>

    <p class="text-center text-xs text-matte-400 mt-6" data-i18n="gif.note">
      ℹ️ Frame ukuran besar (≥400px) akan diresize otomatis. Download hasil sebagai urutan frame PNG.
    </p>
  </div>
</BaseLayout>

<script>
const __page = (location.pathname.replace(/\/+$/, '') || '/');

  document.addEventListener('astro:page-load', () => {if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;

    const dropZone = document.getElementById('drop-zone')!;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const framesPreview = document.getElementById('frames-preview')!;
    const frameCount = document.getElementById('frame-count')!;
    const previewBtn = document.getElementById('preview-btn') as HTMLButtonElement;
    const delayInput = document.getElementById('delay-input') as HTMLInputElement;
    const outputArea = document.getElementById('output-area')!;
    const animCanvas = document.getElementById('anim-canvas') as HTMLCanvasElement;
    const playBtn = document.getElementById('play-btn') as HTMLButtonElement;
    const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;

    const MAX_SIZE = 400;

    interface Frame {
      canvas: HTMLCanvasElement;
      dataUrl: string;
      name: string;
    }

    let frames: Frame[] = [];
    let animInterval: number | null = null;
    let currentFrame = 0;
    let playing = false;

    function resizeImage(file: File): Promise<Frame> {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => {
          const img = new Image();
          img.onload = () => {
            let w = img.width, h = img.height;
            if (Math.max(w, h) > MAX_SIZE) {
              const ratio = MAX_SIZE / Math.max(w, h);
              w = Math.round(w * ratio);
              h = Math.round(h * ratio);
            }
            const canvas = document.createElement('canvas');
            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext('2d')!;
            ctx.drawImage(img, 0, 0, w, h);
            resolve({ canvas, dataUrl: canvas.toDataURL('image/png'), name: file.name });
          };
          img.onerror = reject;
          img.src = reader.result as string;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    async function addFiles(files: FileList | File[]) {
      const fileArr = Array.from(files).filter(f => f.type.startsWith('image/'));
      if (!fileArr.length) { showToast('Pilih file gambar (PNG, JPG, WEBP)', 'error'); return; }

      for (const file of fileArr) {
        try {
          const frame = await resizeImage(file);
          frames.push(frame);
        } catch {
          showToast(`Gagal baca: ${file.name}`, 'error');
        }
      }
      frames.sort((a, b) => a.name.localeCompare(b.name));
      stopAnim();
      renderFrames();
    }

    function renderFrames() {
      frameCount.textContent = `(${frames.length})`;
      previewBtn.disabled = frames.length < 2;

      if (!frames.length) {
        framesPreview.innerHTML = '<p class="text-xs text-matte-400 text-center w-full py-4">Belum ada frame. Upload gambar dulu.</p>';
        return;
      }

      framesPreview.innerHTML = frames.map((f, i) => `
        <div class="relative group">
          <img src="${f.dataUrl}" alt="Frame ${i+1}" class="w-20 h-20 object-cover rounded-lg border-2 border-matte-200 dark:border-matte-700" />
          <span class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-matte-600 text-white text-2xs flex items-center justify-center font-bold">${i+1}</span>
          <button class="del-btn absolute -top-1.5 -left-1.5 w-5 h-5 rounded-full bg-red-500 text-white text-2xs flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity" data-idx="${i}">✕</button>
        </div>`).join('');

      framesPreview.querySelectorAll('.del-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt((btn as HTMLElement).dataset.idx!);
          frames.splice(idx, 1);
          stopAnim();
          outputArea.classList.add('hidden');
          renderFrames();
        });
      });

      outputArea.classList.add('hidden');
    }

    function setupCanvas() {
      if (!frames.length) return;
      const f = frames[0];
      animCanvas.width = f.canvas.width;
      animCanvas.height = f.canvas.height;
    }

    function drawFrame(idx: number) {
      if (!frames.length) return;
      const ctx = animCanvas.getContext('2d')!;
      const f = frames[idx % frames.length];
      ctx.clearRect(0, 0, animCanvas.width, animCanvas.height);
      ctx.drawImage(f.canvas, 0, 0);
    }

    function startAnim() {
      stopAnim();
      playing = true;
      playBtn.innerHTML = '⏸️ Pause';
      const delay = parseInt(delayInput.value) || 300;
      animInterval = window.setInterval(() => {
        currentFrame = (currentFrame + 1) % frames.length;
        drawFrame(currentFrame);
      }, delay);
    }

    function stopAnim() {
      playing = false;
      if (animInterval) { clearInterval(animInterval); animInterval = null; }
      playBtn.innerHTML = '▶️ Play';
    }

    previewBtn.addEventListener('click', () => {
      if (frames.length < 2) return;
      setupCanvas();
      currentFrame = 0;
      drawFrame(0);
      outputArea.classList.remove('hidden');
      outputArea.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      startAnim();
    });

    playBtn.addEventListener('click', () => {
      if (playing) stopAnim();
      else startAnim();
    });

    downloadBtn.addEventListener('click', () => {
      if (!frames.length) return;
      showToast('Mendownload frame…');
      frames.forEach((f, i) => {
        setTimeout(() => {
          const a = document.createElement('a');
          a.href = f.dataUrl;
          a.download = `frame-${String(i+1).padStart(3,'0')}.png`;
          a.click();
        }, i * 200);
      });
    });

    // Drop zone
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-pink-400'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-pink-400'));
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-pink-400');
      if (e.dataTransfer?.files) addFiles(e.dataTransfer.files);
    });
    fileInput.addEventListener('change', () => { if (fileInput.files) { addFiles(fileInput.files); fileInput.value = ''; } });
  });
</script>
