---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Image Upscaler — Perbesar Gambar Online">
  <div class="max-w-2xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader title="Image Upscaler" titleKey="header.image_upscaler"
      desc="Perbesar resolusi gambar dengan bicubic/lanczos. Atur skala & sharpen."
      descKey="header.image_upscaler_desc"
      icon='<path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="10" y1="10" x2="14" y2="10"/>'
      gradient="from-blue-500 to-indigo-600" />

    <div class="card-base p-6 text-center animate-fade-in">
      <div class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-8 hover:border-blue-400 transition-colors cursor-pointer mb-4" id="drop-zone">
        <input type="file" id="file-input" accept="image/*" class="hidden" />
        <p class="text-sm font-bold text-matte-500 dark:text-matte-300">Upload gambar</p>
        <p class="text-2xs text-matte-400 mt-1" id="file-name">—</p>
      </div>

      <div class="flex items-center gap-3 justify-center mb-4 flex-wrap">
        <label class="text-2xs text-matte-400 font-bold">Scale: <span id="scale-val">2x</span></label>
        <input id="scale-slider" type="range" min="1.5" max="4" value="2" step="0.5" class="w-32 accent-blue-500" />
        <label class="text-2xs text-matte-400 font-bold"><input id="sharpen-check" type="checkbox" class="rounded mr-1" checked /> Sharpen</label>
      </div>

      <div class="grid grid-cols-2 gap-3 mb-4">
        <div class="p-2 rounded-lg bg-matte-50 dark:bg-surface-elevated"><span class="text-2xs text-matte-400 block">Original</span>
          <canvas id="orig-canvas" class="max-w-full mx-auto rounded max-h-48"></canvas></div>
        <div class="p-2 rounded-lg bg-blue-50 dark:bg-blue-900/20"><span class="text-2xs text-blue-500 block">Upscaled</span>
          <canvas id="up-canvas" class="max-w-full mx-auto rounded max-h-48"></canvas></div>
      </div>

      <button id="download-btn" class="hidden gradient-brand px-6 py-3 rounded-lg text-sm font-bold">💾 Download</button>
    </div>
  </div>
</BaseLayout>

<script>
const __page = (location.pathname.replace(/\/+$/, '') || '/');

  import { sharpenPixels } from '../../composables/useImageWorker';

  document.addEventListener('astro:page-load',()=>{if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;

    // Guard SPA leak: hanya jalan di halaman ini (orig-canvas unik di upscaler).
    // Tanpa guard, listener bocor & crash di halaman lain (dropZone null → addEventListener).
    if(!document.getElementById('orig-canvas')) return;
    const dropZone=document.getElementById('drop-zone')!,fileInput=document.getElementById('file-input') as HTMLInputElement;
    const fileName=document.getElementById('file-name')!,scaleVal=document.getElementById('scale-val')!;
    const scaleSlider=document.getElementById('scale-slider') as HTMLInputElement;
    const origCanvas=document.getElementById('orig-canvas') as HTMLCanvasElement;
    const upCanvas=document.getElementById('up-canvas') as HTMLCanvasElement;
    const downloadBtn=document.getElementById('download-btn') as HTMLButtonElement;
    const sharpenCheck=document.getElementById('sharpen-check') as HTMLInputElement;
    const toast=(m:string)=>window.showToast?.(window._tToast?window._tToast(m):m);

    let origImg:ImageData|null=null,origW=0,origH=0,upscaledDataUrl='';

    const MAX_PIXELS = 24 * 1024 * 1024; // ~24MP — cap output biar gak OOM di HP low-end
    let upscaleReq = 0; // race guard: slider input bisa nembak cepat
    let warnedCap = false;
    let upscaleBusy = false, upscaleQueued = false;

    // Gate: cuma 1 upscale jalan sekaligus (getImageData 24MP ≈ 96MB copy).
    // Event berikutnya di-coalesce jadi satu — hindari numpuk buffer besar di low-end.
    function upscale(){
      if(upscaleBusy){upscaleQueued=true;return;}
      upscaleBusy=true;
      doUpscale().finally(()=>{
        upscaleBusy=false;
        if(upscaleQueued){upscaleQueued=false;upscale();}
      });
    }

    async function doUpscale(){
      if(!origImg)return;
      let scale=parseFloat(scaleSlider.value);
      // Clamp: 4x dari 12MP = 192MP = tab crash. Batasi ke max pixel aman.
      const maxScale=Math.sqrt(MAX_PIXELS/(origW*origH));
      if(scale>maxScale){
        scale=Math.max(1,Math.floor(maxScale*10)/10);
        scaleSlider.value=String(scale);
        if(!warnedCap){warnedCap=true;toast('Skala dibatasi '+scale+'x agar aman di perangkat ini');}
      }
      scaleVal.textContent=scale+'x';
      const w=Math.round(origW*scale),h=Math.round(origH*scale);
      upCanvas.width=w;upCanvas.height=h;const octx=upCanvas.getContext('2d')!;
      octx.imageSmoothingEnabled=true;octx.imageSmoothingQuality='high';
      origCanvas.width=origW;origCanvas.height=origH;origCanvas.getContext('2d')!.putImageData(origImg,0,0);
      octx.drawImage(origCanvas,0,0,w,h);

      const reqId=++upscaleReq;
      if(sharpenCheck.checked){
        try{
          const imgData=octx.getImageData(0,0,w,h);
          const sharpened=await sharpenPixels(imgData.data,w,h); // off-main-thread
          if(reqId!==upscaleReq)return; // ada upscale lebih baru — buang hasil stale
          octx.putImageData(new ImageData(sharpened,w,h),0,0);
        }catch(err){/* fallback: hasil tetap upscale, tanpa sharpen */}
      }
      if(reqId!==upscaleReq)return;
      upscaledDataUrl=upCanvas.toDataURL('image/png');
    }

    function processFile(file:File){
      fileName.textContent=file.name;const reader=new FileReader();
      reader.onload=()=>{const img=new Image();img.onload=()=>{
        origW=img.width;origH=img.height;const c=document.createElement('canvas');c.width=origW;c.height=origH;const ctx=c.getContext('2d')!;
        ctx.drawImage(img,0,0);origImg=ctx.getImageData(0,0,origW,origH);upscale();downloadBtn.classList.remove('hidden');
      };img.src=reader.result as string};reader.readAsDataURL(file);
    }

    dropZone.addEventListener('click',()=>fileInput.click());
    dropZone.addEventListener('dragover',e=>{e.preventDefault();});
    dropZone.addEventListener('drop',e=>{e.preventDefault();const f=e.dataTransfer?.files?.[0];if(f)processFile(f);});
    fileInput.addEventListener('change',()=>{const f=fileInput.files?.[0];if(f)processFile(f);});
    // Debounce slider: tiap input = getImageData 24MP (~96MB copy). Debounce biar gak numpuk.
    let upscaleTimer: ReturnType<typeof setTimeout> | null = null;
    scaleSlider.addEventListener('input',()=>{
      if(upscaleTimer)clearTimeout(upscaleTimer);
      upscaleTimer=setTimeout(()=>{upscaleTimer=null;upscale();},80);
    });
    sharpenCheck.addEventListener('change',()=>upscale());

    downloadBtn.addEventListener('click',()=>{
      if(!upscaledDataUrl)return;const a=document.createElement('a');a.href=upscaledDataUrl;a.download='upscaled-'+Date.now()+'.png';a.click();
    });
  });
</script>
