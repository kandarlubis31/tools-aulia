---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Palette Extractor">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh] py-10">
    <ToolPageHeader title="Palette Extractor" titleKey="header.palette_extractor" desc="Ekstrak palet warna dominan dari gambar menggunakan k-means clustering." descKey="header.palette_extractor_desc" icon='<circle cx="13.5" cy="6.5" r="2.5"/><circle cx="19" cy="15.5" r="2.5"/><circle cx="6" cy="12.5" r="2.5"/><circle cx="10" cy="18" r="2.5"/>' gradient="from-pink-500 to-rose-600" />
    <div class="card-base p-8 animate-fade-in">
      <div id="drop-zone" class="border-2 border-dashed border-pink-300 dark:border-pink-700 rounded-2xl p-12 text-center cursor-pointer hover:border-pink-400 transition-colors mb-6">
        <input type="file" id="file-input" accept="image/*" class="hidden" aria-label="Pilih gambar" data-i18n-attr="aria-label" data-i18n="palette.pick_image" />
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto text-pink-400 mb-4"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        <p class="text-matte-500 font-bold" data-i18n="palette.drop_hint">Drop gambar atau klik</p>
      </div>
      <div class="flex gap-4 items-center mb-6">
        <label class="text-sm text-matte-500"><span data-i18n="palette.k_label">Jumlah warna:</span> <input id="k" type="number" value="6" min="2" max="16" class="w-16 p-2 border rounded-lg dark:bg-surface-hover dark:border-surface-border text-center font-bold" /></label>
        <button id="extract" class="px-6 py-2 bg-pink-600 text-white rounded-xl font-bold hover:bg-pink-700 transition-colors" data-i18n="palette.extract_btn">🎨 Ekstrak</button>
      </div>
      <div id="preview" class="flex justify-center mb-6"><img id="preview-img" alt="" class="max-h-64 rounded-xl hidden" /></div>
      <p id="palette-hint" class="text-xs text-matte-400 mb-4" data-i18n="palette.empty_hint">Palet warna dominan muncul di sini — klik warna untuk copy HEX.</p>
      <div id="palette" class="grid grid-cols-3 md:grid-cols-6 gap-3"></div>
      <p class="text-xs text-matte-400 text-center mt-4" data-i18n="palette.method">K-means clustering — palet stabil, tidak berubah antar klik.</p>
      <p class="text-2xs text-matte-400 text-center mt-1" data-i18n="palette.privacy">Gambar diproses lokal di browser — tidak diunggah.</p>
    </div>
  </div>
</BaseLayout>
<script>
  const toast = (msg, type = 'success') => window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  let imgData = null;
  const dz = document.getElementById('drop-zone');
  const fi = document.getElementById('file-input');

  dz.addEventListener('click', () => fi.click());
  dz.addEventListener('dragover', (e) => { e.preventDefault(); dz.classList.add('border-pink-500'); });
  dz.addEventListener('dragleave', () => dz.classList.remove('border-pink-500'));
  dz.addEventListener('drop', (e) => { e.preventDefault(); dz.classList.remove('border-pink-500'); loadImg(e.dataTransfer.files[0]); });
  fi.addEventListener('change', (e) => { loadImg(e.target.files[0]); e.target.value = ''; });

  function loadImg(file) {
    if (!file) return;
    if (!file.type || !file.type.startsWith('image/')) { toast('Upload gambar dulu!', 'error'); return; }
    const reader = new FileReader();
    reader.onerror = () => toast('Gagal membuat gambar', 'error');
    reader.onload = (e) => {
      const img = document.getElementById('preview-img');
      img.onload = () => {
        try {
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');
          const s = Math.min(100 / img.naturalWidth, 100 / img.naturalHeight) || 1;
          canvas.width = Math.max(1, Math.round(img.naturalWidth * s));
          canvas.height = Math.max(1, Math.round(img.naturalHeight * s));
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          imgData = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
        } catch { toast('Gagal membuat gambar', 'error'); }
      };
      img.onerror = () => toast('Gagal membuat gambar', 'error');
      img.src = e.target.result;
      img.classList.remove('hidden');
    };
    reader.readAsDataURL(file);
  }

  function kmeans(data, k, iters) {
    // Centroid awal deterministik ala k-means++: pertama = pixel awal, berikutnya = titik
    // terjauh dari centroid yang ada → palet stabil antar klik + tidak dobel sewarna.
    const centroids = [[data[0][0], data[0][1], data[0][2]]];
    const step = Math.max(1, Math.floor(data.length / 2000));
    while (centroids.length < k) {
      let best = null, bestD = -1;
      for (let i = 0; i < data.length; i += step) {
        const p = data[i];
        let minD = Infinity;
        for (const c of centroids) minD = Math.min(minD, (p[0] - c[0]) ** 2 + (p[1] - c[1]) ** 2 + (p[2] - c[2]) ** 2);
        if (minD > bestD) { bestD = minD; best = p; }
      }
      if (!best || bestD <= 0) break;
      centroids.push([best[0], best[1], best[2]]);
    }
    for (let iter = 0; iter < iters; iter++) {
      const clusters = Array.from({ length: centroids.length }, () => []);
      for (const pt of data) {
        let minD = Infinity, minI = 0;
        for (let i = 0; i < centroids.length; i++) {
          const d = (pt[0] - centroids[i][0]) ** 2 + (pt[1] - centroids[i][1]) ** 2 + (pt[2] - centroids[i][2]) ** 2;
          if (d < minD) { minD = d; minI = i; }
        }
        clusters[minI].push(pt);
      }
      let changed = false;
      for (let i = 0; i < centroids.length; i++) {
        if (!clusters[i].length) continue;
        const avg = [0, 0, 0];
        for (const p of clusters[i]) { avg[0] += p[0]; avg[1] += p[1]; avg[2] += p[2]; }
        const next = avg.map(v => Math.round(v / clusters[i].length));
        if (next[0] !== centroids[i][0] || next[1] !== centroids[i][1] || next[2] !== centroids[i][2]) changed = true;
        centroids[i] = next;
      }
      if (!changed) break;
    }
    // Dedupe centroid kembar → palet tanpa warna duplikat
    const seen = new Set();
    return centroids.filter((c) => {
      const h = c.join(',');
      if (seen.has(h)) return false;
      seen.add(h);
      return true;
    });
  }

  document.getElementById('extract').addEventListener('click', () => {
    if (!imgData) { toast('Upload gambar dulu!', 'error'); return; }
    const pixels = [];
    for (let i = 0; i < imgData.length; i += 4) {
      if (imgData[i + 3] > 128) pixels.push([imgData[i], imgData[i + 1], imgData[i + 2]]);
    }
    if (!pixels.length) { toast('Upload gambar dulu!', 'error'); return; }
    let k = parseInt(document.getElementById('k').value, 10) || 6;
    k = Math.min(16, Math.max(2, k));
    const colors = kmeans(pixels, k, 10);
    document.getElementById('palette-hint').classList.add('hidden');
    const el = document.getElementById('palette');
    el.textContent = '';
    colors.forEach((c) => {
      const hex = '#' + c.map(v => v.toString(16).padStart(2, '0')).join('');
      const wrap = document.createElement('div');
      wrap.className = 'text-center';
      const sw = document.createElement('div');
      sw.className = 'w-full h-16 rounded-xl border border-matte-200 dark:border-matte-700';
      sw.style.background = hex;
      const label = document.createElement('p');
      label.className = 'text-xs font-mono mt-1 text-matte-500 cursor-pointer hover:text-pink-500';
      label.textContent = hex;
      wrap.appendChild(sw);
      wrap.appendChild(label);
      wrap.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(hex); toast('Warna disalin'); }
        catch { toast('Gagal menyalin', 'error'); }
      });
      el.appendChild(wrap);
    });
  });
  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __imagePalettePage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __imagePalettePage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });
</script>
