---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Palette Extractor">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh] py-10">
    <ToolPageHeader title="Palette Extractor" titleKey="header.palette_extractor" desc="Ekstrak palet warna dominan dari gambar menggunakan k-means clustering." descKey="header.palette_extractor_desc" icon='<circle cx="13.5" cy="6.5" r="2.5"/><circle cx="19" cy="15.5" r="2.5"/><circle cx="6" cy="12.5" r="2.5"/><circle cx="10" cy="18" r="2.5"/>' gradient="from-pink-500 to-rose-600" />
    <div class="card-base p-8 animate-fade-in">
      <div id="drop-zone" class="border-2 border-dashed border-pink-300 dark:border-pink-700 rounded-2xl p-12 text-center cursor-pointer hover:border-pink-400 transition-colors mb-6"><input type="file" id="file-input" accept="image/*" class="hidden" /><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto text-pink-400 mb-4"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg><p class="text-matte-500 font-bold">Drop gambar atau klik</p></div>
      <div class="flex gap-4 mb-6"><label class="text-sm text-matte-500">Jumlah warna: <input id="k" type="number" value="6" min="2" max="16" class="w-16 p-2 border rounded-lg dark:bg-surface-hover dark:border-surface-border text-center font-bold" /></label><button id="extract" class="px-6 py-2 bg-pink-600 text-white rounded-xl font-bold hover:bg-pink-700 transition-colors">🎨 Ekstrak</button></div>
      <div id="preview" class="flex justify-center mb-6"><img id="preview-img" class="max-h-64 rounded-xl hidden" /></div>
      <div id="palette" class="grid grid-cols-3 md:grid-cols-6 gap-3"></div>
    </div>
  </div>
</BaseLayout>
<script>
  let imgData = null;
  const dz = document.getElementById('drop-zone');
  const fi = document.getElementById('file-input');
  dz.onclick = () => fi.click();
  dz.ondragover = e => { e.preventDefault(); dz.classList.add('border-pink-500'); };
  dz.ondragleave = () => dz.classList.remove('border-pink-500');
  dz.ondrop = e => { e.preventDefault(); dz.classList.remove('border-pink-500'); loadImg(e.dataTransfer.files[0]); };
  fi.onchange = e => loadImg(e.target.files[0]);
  function loadImg(file) {
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
      const img = document.getElementById('preview-img');
      img.src = e.target.result;
      img.classList.remove('hidden');
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        const s = Math.min(100 / img.naturalWidth, 100 / img.naturalHeight);
        canvas.width = img.naturalWidth * s;
        canvas.height = img.naturalHeight * s;
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        imgData = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
      };
    };
    reader.readAsDataURL(file);
  }
  function kmeans(data, k, iters) {
    let centroids = [];
    for (let i = 0; i < k; i++) centroids.push([data[Math.floor(Math.random() * data.length)]]);
    centroids = centroids.map(c => c[0]);
    for (let iter = 0; iter < iters; iter++) {
      const clusters = Array.from({ length: k }, () => []);
      for (const pt of data) {
        let minD = Infinity, minI = 0;
        for (let i = 0; i < k; i++) {
          const d = Math.pow(pt[0]-centroids[i][0],2) + Math.pow(pt[1]-centroids[i][1],2) + Math.pow(pt[2]-centroids[i][2],2);
          if (d < minD) { minD = d; minI = i; }
        }
        clusters[minI].push(pt);
      }
      for (let i = 0; i < k; i++) {
        if (clusters[i].length === 0) continue;
        centroids[i] = [0,0,0];
        for (const p of clusters[i]) { centroids[i][0] += p[0]; centroids[i][1] += p[1]; centroids[i][2] += p[2]; }
        centroids[i] = centroids[i].map(v => Math.round(v / clusters[i].length));
      }
    }
    return centroids;
  }
  document.getElementById('extract').onclick = () => {
    if (!imgData) { window.showToast?.(window._tToast ? window._tToast('Upload gambar dulu!') : 'Upload gambar dulu!', 'error'); return; }
    const pixels = [];
    for (let i = 0; i < imgData.length; i += 4) {
      if (imgData[i+3] > 128) pixels.push([imgData[i], imgData[i+1], imgData[i+2]]);
    }
    const k = parseInt(document.getElementById('k').value) || 6;
    const colors = kmeans(pixels, k, 10);
    const el = document.getElementById('palette');
    el.innerHTML = colors.map(c => {
      const hex = '#' + c.map(v => v.toString(16).padStart(2, '0')).join('');
      return '<div class="text-center"><div class="w-full h-16 rounded-xl border border-matte-200 dark:border-matte-700" style="background:' + hex + '"></div><p class="text-xs font-mono mt-1 text-matte-500 cursor-pointer hover:text-pink-500" onclick="navigator.clipboard.writeText(\''+hex+'\');this.textContent=\'Copied!\'">' + hex + '</p></div>';
    }).join('');
  };
</script>
