---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="Image Border" description="Tambah border/frame ke gambar: warna, tebal, rounded corner. 100% client-side canvas.">
  <ToolPageHeader title="Image Border" desc="Tambah frame ke gambar — warna, tebal, rounded" icon='<rect x="3" y="3" width="18" height="18" rx="2"/><rect x="6" y="6" width="12" height="12" rx="1"/>' />

  <div class="card-base p-5 space-y-4">
    <div id="drop-zone" class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-8 text-center cursor-pointer hover:border-accent-blue transition-colors">
      <span data-i18n="border.drop_hint">🖼️ Drop gambar di sini</span>
      <input type="file" id="file-input" class="hidden" accept="image/*">
    </div>

    <div id="controls" class="hidden space-y-3">
      <div class="flex flex-wrap gap-3 items-center">
        <div>
          <label class="block text-xs text-matte-500 mb-1" for="color" data-i18n="border.color">Warna Border</label>
          <input id="color" type="color" value="#2563eb" class="w-10 h-10 rounded cursor-pointer p-0 border-0">
        </div>
        <div>
          <label class="block text-xs text-matte-500 mb-1" for="thickness" data-i18n="border.thickness">Tebal (px)</label>
          <input id="thickness" type="range" min="1" max="80" value="10" class="w-24"> <span id="thick-val">10px</span>
        </div>
        <div>
          <label class="block text-xs text-matte-500 mb-1" for="radius" data-i18n="border.radius">Radius (px)</label>
          <input id="radius" type="range" min="0" max="60" value="0" class="w-24"> <span id="radius-val">0px</span>
        </div>
      </div>

      <canvas id="preview" class="max-w-full rounded-lg shadow mx-auto" width="600" height="400"></canvas>
      <button id="download-btn" class="btn-primary w-full" data-i18n="border.download">Download Gambar Berframe</button>
    </div>
  </div>
</BaseLayout>

<script>
  const toast = (msg, type = 'success') => window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const canvas = document.getElementById('preview');
  const ctx = canvas.getContext('2d');
  let img = null;
  let imgName = 'image';

  const dz = document.getElementById('drop-zone');
  const fi = document.getElementById('file-input');

  dz.addEventListener('click', () => fi.click());
  dz.addEventListener('dragover', (e) => { e.preventDefault(); dz.classList.add('border-accent-blue'); });
  dz.addEventListener('dragleave', () => dz.classList.remove('border-accent-blue'));
  dz.addEventListener('drop', (e) => { e.preventDefault(); dz.classList.remove('border-accent-blue'); loadFile(e.dataTransfer.files[0]); });
  fi.addEventListener('change', () => { loadFile(fi.files[0]); fi.value = ''; });

  function loadFile(f) {
    if (!f) return;
    if (!f.type || !f.type.startsWith('image/')) { toast('File bukan gambar.', 'error'); return; }
    imgName = f.name.replace(/\.[^.]+$/, '') || 'image';
    const r = new FileReader();
    r.onerror = () => toast('Gagal membuat gambar', 'error');
    r.onload = () => {
      img = new Image();
      img.onload = draw;
      img.onerror = () => toast('Gagal membuat gambar', 'error');
      img.src = r.result;
    };
    r.readAsDataURL(f);
  }

  ['color', 'thickness', 'radius'].forEach((id) => document.getElementById(id).addEventListener('input', draw));
  document.getElementById('thickness').addEventListener('input', function () { document.getElementById('thick-val').textContent = this.value + 'px'; });
  document.getElementById('radius').addEventListener('input', function () { document.getElementById('radius-val').textContent = this.value + 'px'; });

  function draw() {
    if (!img) return;
    document.getElementById('controls').classList.remove('hidden');
    const t = parseInt(document.getElementById('thickness').value, 10) || 0;
    const r = parseInt(document.getElementById('radius').value, 10) || 0;
    const c = document.getElementById('color').value;
    const w = Math.min(img.naturalWidth + t * 2, 800);
    const h = w * (img.naturalHeight + t * 2) / (img.naturalWidth + t * 2);
    canvas.width = w;
    canvas.height = h;

    ctx.fillStyle = c;
    ctx.beginPath();
    ctx.roundRect(0, 0, w, h, r);
    ctx.fill();

    const iw = w - t * 2, ih = h - t * 2;
    ctx.save();
    ctx.beginPath();
    ctx.roundRect(t, t, iw, ih, Math.max(0, r - t));
    ctx.clip();
    ctx.drawImage(img, t, t, iw, ih);
    ctx.restore();
  }

  document.getElementById('download-btn').addEventListener('click', () => {
    if (!img) { toast('Upload gambar dulu!', 'error'); return; }
    canvas.toBlob((b) => {
      if (!b) { toast('Gagal membuat gambar', 'error'); return; }
      const url = URL.createObjectURL(b);
      const a = document.createElement('a');
      a.href = url;
      a.download = imgName + '-framed.png';
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      toast('Download dimulai!');
    }, 'image/png');
  });

  document.getElementById('thick-val').textContent = '10px';
  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __imageBorderPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __imageBorderPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });
</script>
