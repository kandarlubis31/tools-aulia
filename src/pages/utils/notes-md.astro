---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Notes Markdown — Catatan Tersimpan Lokal">
  <div class="max-w-6xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Notes (Markdown)"
      titleKey="header.notes_md"
      desc="Catatan markdown dengan preview live, tersimpan otomatis di browser. Export .md."
      descKey="header.notes_md_desc"
      icon='<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/>'
      gradient="from-amber-500 to-yellow-600"
    />

    <div class="card-base p-4 mb-4 animate-fade-in">
      <div class="flex flex-wrap items-center gap-3">
        <input id="note-title" type="text" placeholder="Judul catatan…" class="flex-1 min-w-[200px] px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm font-bold focus:ring-2 focus:ring-amber-500/40 outline-none" />
        <div class="flex items-center gap-2">
          <button id="new-btn" class="px-4 py-2.5 rounded-lg text-sm font-bold bg-matte-100 dark:bg-surface-elevated text-matte-600 dark:text-matte-300 hover:bg-matte-200 dark:hover:bg-surface-hover transition-all" data-i18n="notes.new">📄 Baru</button>
          <button id="export-btn" class="px-4 py-2.5 rounded-lg text-sm font-bold bg-matte-100 dark:bg-surface-elevated text-matte-600 dark:text-matte-300 hover:bg-matte-200 dark:hover:bg-surface-hover transition-all">⬇️ <span data-i18n="notes.export">Export .md</span></button>
        </div>
        <div id="save-status" class="text-2xs text-matte-400 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span data-i18n="notes.saved">Tersimpan otomatis</span>
        </div>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-4 animate-fade-in">
      <!-- Editor -->
      <div class="card-base p-4 flex flex-col">
        <div class="flex items-center justify-between mb-2">
          <h2 class="text-2xs font-bold text-matte-400 uppercase tracking-wider" data-i18n="notes.editor">Editor</h2>
          <span id="char-count" class="text-2xs text-matte-400 font-mono">0 kata</span>
        </div>
        <textarea id="note-area" class="w-full flex-1 min-h-[50vh] lg:min-h-[60vh] resize-none bg-matte-50 dark:bg-surface-elevated rounded-lg p-4 text-sm leading-relaxed outline-none focus:ring-2 focus:ring-amber-500/40 font-mono" placeholder="Tulis catatanmu di sini… markdown didukung!"></textarea>
      </div>

      <!-- Preview -->
      <div class="card-base p-4 flex flex-col">
        <div class="flex items-center justify-between mb-2">
          <h2 class="text-2xs font-bold text-matte-400 uppercase tracking-wider" data-i18n="notes.preview">Preview</h2>
          <button id="clear-btn" class="text-2xs text-matte-400 hover:text-red-500 transition-colors" data-i18n="notes.clear">Hapus semua</button>
        </div>
        <div id="preview-area" class="notes-preview w-full flex-1 min-h-[50vh] lg:min-h-[60vh] rounded-lg p-4 text-sm leading-relaxed overflow-y-auto bg-matte-50 dark:bg-surface-elevated">
          <p class="text-matte-400" data-i18n="notes.hint">Tulis di kiri, hasil render muncul di sini ✨</p>
        </div>
      </div>
    </div>

    <div class="text-center mt-4">
      <div class="text-2xs text-matte-400 inline-flex items-center gap-1.5 bg-matte-50 dark:bg-surface-elevated px-3 py-1.5 rounded-full">
        <span class="text-sm">📚</span>
        <span id="history-list" class="flex items-center gap-2 flex-wrap"></span>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Markdown preview styling (tanpa plugin typography) */
  .notes-preview h1 { font-size: 1.5rem; font-weight: 800; margin: 0.75rem 0 0.5rem; }
  .notes-preview h2 { font-size: 1.25rem; font-weight: 700; margin: 0.75rem 0 0.5rem; }
  .notes-preview h3 { font-size: 1.1rem; font-weight: 700; margin: 0.6rem 0 0.4rem; }
  .notes-preview h4 { font-weight: 700; margin: 0.5rem 0 0.3rem; }
  .notes-preview p { margin: 0.4rem 0; }
  .notes-preview ul, .notes-preview ol { margin: 0.4rem 0 0.4rem 1.5rem; list-style: revert; }
  .notes-preview li { margin: 0.15rem 0; }
  .notes-preview blockquote {
    border-left: 3px solid #f59e0b;
    padding: 0.25rem 0.75rem;
    margin: 0.5rem 0;
    opacity: 0.85;
  }
  .notes-preview code {
    background: rgba(120, 130, 145, 0.15);
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    font-size: 0.85em;
    font-family: ui-monospace, monospace;
  }
  .notes-preview pre {
    background: rgba(120, 130, 145, 0.12);
    padding: 0.75rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 0.5rem 0;
  }
  .notes-preview pre code { background: none; padding: 0; }
  .notes-preview a { color: #0284c7; text-decoration: underline; }
  .notes-preview img { max-width: 100%; border-radius: 0.5rem; margin: 0.5rem 0; }
  .notes-preview table { border-collapse: collapse; margin: 0.5rem 0; width: 100%; }
  .notes-preview th, .notes-preview td { border: 1px solid rgba(120, 130, 145, 0.3); padding: 0.35rem 0.6rem; text-align: left; }
  .notes-preview hr { border: none; border-top: 1px solid rgba(120, 130, 145, 0.3); margin: 0.75rem 0; }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/dompurify@3.2.4/dist/purify.min.js"></script>

<script>
  document.addEventListener('astro:page-load', () => {
    const titleInput = document.getElementById('note-title') as HTMLInputElement;
    const area = document.getElementById('note-area') as HTMLTextAreaElement;
    const preview = document.getElementById('preview-area');
    const charCount = document.getElementById('char-count');
    const saveStatus = document.getElementById('save-status');
    const exportBtn = document.getElementById('export-btn');
    const newBtn = document.getElementById('new-btn');
    const clearBtn = document.getElementById('clear-btn');
    const historyList = document.getElementById('history-list');

    const KEY = 'ta-notes-md-current';
    const HIST_KEY = 'ta-notes-md-history';
    const MAX_HISTORY = 6;
    let saveTimer = 0;

    const toast = (msg: string, type: 'success' | 'error' = 'success') =>
      window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

    function load() {
      try {
        const saved = JSON.parse(localStorage.getItem(KEY) || '{}');
        titleInput.value = saved.title || '';
        area.value = saved.body || '';
      } catch { /* ignore */ }
      render();
      renderHistory();
    }

    function save() {
      localStorage.setItem(KEY, JSON.stringify({ title: titleInput.value, body: area.value, updatedAt: Date.now() }));
      saveStatus!.querySelector('span')!.className = 'w-1.5 h-1.5 rounded-full bg-emerald-500';
      renderHistory();
    }

    function render() {
      const text = area.value;
      const words = text.trim() ? text.trim().split(/\s+/).length : 0;
      charCount!.textContent = `${words} kata · ${text.length} char`;
      try {
        if (text.trim()) {
          const raw = (window as any).marked.parse(text);
          preview!.innerHTML = (window as any).DOMPurify.sanitize(raw);
          (window as any).processI18n?.();
        } else {
          preview!.innerHTML = '<p class="text-matte-400" data-i18n="notes.hint">Tulis di kiri, hasil render muncul di sini ✨</p>';
          (window as any).processI18n?.();
        }
      } catch {
        preview!.textContent = text;
      }
    }

    function scheduleSave() {
      saveStatus!.querySelector('span')!.className = 'w-1.5 h-1.5 rounded-full bg-amber-500';
      window.clearTimeout(saveTimer);
      saveTimer = window.setTimeout(save, 500);
    }

    function renderHistory() {
      try {
        const history: { title: string; updatedAt: number }[] = JSON.parse(localStorage.getItem(HIST_KEY) || '[]');
        historyList!.innerHTML = history.slice(0, 4).map(h => `
          <button class="history-chip text-matte-500 dark:text-matte-300 hover:text-amber-600 dark:hover:text-amber-400 transition-colors underline decoration-dotted underline-offset-2">
            ${esc(h.title || 'Tanpa judul')}
          </button>`).join('');
        historyList!.querySelectorAll('.history-chip').forEach((btn, i) => {
          btn.addEventListener('click', () => {
            const h = history[i];
            if (!h) return;
            titleInput.value = h.title || '';
            area.value = h.body || '';
            render();
            save();
            toast('Catatan dimuat!');
          });
        });
      } catch { /* ignore */ }
    }

    function esc(s: string): string {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function pushHistory() {
      if (!area.value.trim()) return;
      try {
        const history: any[] = JSON.parse(localStorage.getItem(HIST_KEY) || '[]');
        const entry = { title: titleInput.value || 'Tanpa judul', body: area.value, updatedAt: Date.now() };
        history.unshift(entry);
        localStorage.setItem(HIST_KEY, JSON.stringify(history.slice(0, MAX_HISTORY)));
        renderHistory();
      } catch { /* ignore */ }
    }

    area?.addEventListener('input', () => { render(); scheduleSave(); });
    titleInput?.addEventListener('input', scheduleSave);

    exportBtn?.addEventListener('click', () => {
      const text = `# ${titleInput.value || 'Catatan'}\n\n${area.value}`;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([text], { type: 'text/markdown' }));
      a.download = (titleInput.value || 'catatan').replace(/[^\w\- ]/g, '').trim() || 'catatan';
      a.download += '.md';
      a.click();
      toast('Export berhasil!');
    });

    newBtn?.addEventListener('click', () => {
      pushHistory();
      titleInput.value = '';
      area.value = '';
      save();
      render();
      area.focus();
      toast('Catatan baru dibuat');
    });

    clearBtn?.addEventListener('click', () => {
      if (!area.value.trim()) return;
      pushHistory();
      area.value = '';
      render();
      save();
    });

    load();
  });
</script>
