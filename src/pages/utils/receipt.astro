---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="Receipt Generator" description="Buat struk pembayaran lucu untuk konten. 100% client-side canvas.">
  <ToolPageHeader title="Receipt Generator" desc="Buat struk belanja lucu — konten & fun" icon='<rect x="2" y="4" width="20" height="16" rx="2"/><line x1="6" y1="8" x2="18" y2="8"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="6" y1="16" x2="12" y2="16"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div>
        <label for="store" class="text-xs text-matte-500 mb-1 block" data-i18n="label.store_name">Nama Toko</label>
        <input id="store" type="text" class="input-field w-full text-sm" value="Warung Pak Aul">
      </div>
      <div>
        <label for="date" class="text-xs text-matte-500 mb-1 block" data-i18n="label.receipt_date">Tanggal</label>
        <input id="date" type="date" class="input-field w-full text-sm">
      </div>
    </div>

    <div class="space-y-1" id="items-container">
      <div class="grid grid-cols-12 gap-1 text-xs text-matte-400 font-medium">
        <span class="col-span-6" data-i18n="th.item">Item</span>
        <span class="col-span-3" data-i18n="th.qty">Qty</span>
        <span class="col-span-3" data-i18n="th.price">Harga</span>
      </div>
    </div>
    <button id="add-item" class="btn-secondary text-sm w-full" data-i18n="btn.add_item">+ Tambah Item</button>

    <div class="flex justify-center"><canvas id="receipt-canvas" width="350" height="500" class="shadow-lg rounded bg-white"></canvas></div>
    <button id="gen-btn" class="btn-primary w-full" data-i18n="btn.download_png">Download Struk PNG</button>
  </div>
</BaseLayout>

<script>
  import { t } from '../../i18n/translations';

  // langchange: refresh placeholder baris item yang dibuat dinamis
  let __refreshRows: (() => void) | null = null;
  window.addEventListener('langchange', () => __refreshRows?.());

  function init() {
    const container = document.getElementById('items-container') as HTMLElement;
    let itemId = 0;

    const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
      window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

    function addItem(name = '', qty = '1', price = '10000') {
      const id = ++itemId;
      const row = document.createElement('div');
      row.className = 'grid grid-cols-12 gap-1 items-center';
      row.dataset.receiptRow = 'true';
      const nameInp = document.createElement('input');
      nameInp.type = 'text';
      nameInp.className = 'col-span-6 input-field text-xs';
      nameInp.value = name;
      nameInp.placeholder = t('ph.item_name');
      nameInp.dataset.phKey = 'ph.item_name';
      const qtyInp = document.createElement('input');
      qtyInp.type = 'number';
      qtyInp.className = 'col-span-3 input-field text-xs';
      qtyInp.value = qty; qtyInp.min = '1';
      const priceInp = document.createElement('input');
      priceInp.type = 'number';
      priceInp.className = 'col-span-2 input-field text-xs';
      priceInp.value = price; priceInp.min = '0';
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'col-span-1 text-red-400 hover:text-red-600 text-sm';
      del.textContent = '✕';
      del.setAttribute('aria-label', 'Hapus item');
      del.addEventListener('click', () => row.remove());
      row.append(nameInp, qtyInp, priceInp, del);
      container.appendChild(row);
    }

    __refreshRows = () => {
      container.querySelectorAll<HTMLInputElement>('input[data-ph-key]')
        .forEach(el => { el.placeholder = t(el.dataset.phKey || ''); });
    };

    document.getElementById('add-item')?.addEventListener('click', () => addItem());
    addItem('Nasi Goreng', '2', '15000');
    addItem('Es Teh Manis', '1', '5000');

    document.getElementById('gen-btn')?.addEventListener('click', () => {
      const canvas = document.getElementById('receipt-canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
      const store = (document.getElementById('store') as HTMLInputElement).value.trim() || 'Warung';
      const date = (document.getElementById('date') as HTMLInputElement).value || new Date().toISOString().slice(0, 10);

      const items: Array<{ name: string; qty: number; price: number }> = [];
      container.querySelectorAll('[data-receipt-row]').forEach(row => {
        const inputs = row.querySelectorAll('input');
        if (inputs.length >= 3 && inputs[0].value.trim()) {
          items.push({ name: inputs[0].value, qty: +inputs[1].value || 0, price: +inputs[2].value || 0 });
        }
      });
      if (!items.length) { toast('Minimal 1 item!', 'error'); return; }

      ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#000'; ctx.textAlign = 'center';
      ctx.font = 'bold 18px monospace'; ctx.fillText(store.toUpperCase().substring(0, 26), 175, 50);
      ctx.font = '10px monospace'; ctx.fillText(date, 175, 65);
      ctx.beginPath(); ctx.moveTo(20, 75); ctx.lineTo(330, 75); ctx.stroke();

      let y = 95;
      for (const it of items) {
        ctx.textAlign = 'left'; ctx.font = '11px monospace';
        ctx.fillText(it.name.substring(0, 22), 20, y);
        ctx.textAlign = 'center'; ctx.fillText('x' + it.qty, 200, y);
        ctx.textAlign = 'right'; ctx.fillText('Rp' + (it.qty * it.price).toLocaleString('id-ID'), 330, y);
        y += 18;
      }
      ctx.beginPath(); ctx.moveTo(20, y + 2); ctx.lineTo(330, y + 2); ctx.stroke();
      y += 18;
      const total = items.reduce((s, i) => s + i.qty * i.price, 0);
      ctx.font = 'bold 14px monospace'; ctx.textAlign = 'right';
      ctx.fillText('TOTAL: Rp' + total.toLocaleString('id-ID'), 330, y);
      y += 25;
      ctx.font = '10px monospace'; ctx.textAlign = 'center';
      ctx.fillText(t('receipt.thanks'), 175, y);

      canvas.toBlob(b => {
        if (!b) { toast('Gagal membuat gambar', 'error'); return; }
        const a = document.createElement('a');
        a.href = URL.createObjectURL(b);
        a.download = 'receipt.png';
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 2000);
        toast('Struk diunduh!');
      }, 'image/png');
    });

    (document.getElementById('date') as HTMLInputElement).value = new Date().toISOString().slice(0, 10);
  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __utilsReceiptPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __utilsReceiptPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });
</script>
