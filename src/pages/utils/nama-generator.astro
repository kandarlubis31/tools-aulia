  .seg-btn {
    background: var(--matte-100);
    color: var(--matte-500);
  }
  .dark .seg-btn {
    background: var(--surface-hover);
    color: var(--matte-300);
  }
  .seg-btn.active {
    background: #f43f5e;
    color: #fff;
  }
</style>
