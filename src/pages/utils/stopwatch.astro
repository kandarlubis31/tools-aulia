---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Stopwatch">
  <div class="max-w-2xl mx-auto px-4 min-h-[60vh] flex flex-col items-center">
    
        <ToolPageHeader
      title="Stopwatch"
      titleKey="header.stopwatch"
      desc="Pencatat waktu presisi dengan fitur putaran (Lap). Space"
      icon='<circle cx="12" cy="12" r="10"/><path d="M12 2v2"/><path d="M10 2h4"/><polyline points="12 6 12 12 16 14"/>'
      gradient="from-cyan-500 to-blue-600"
    />

    <div class="relative w-72 h-72 md:w-80 md:h-80 card-base rounded-full shadow-2xl border-8 border-matte-100 dark:border-surface-border flex items-center justify-center mb-10 animate-fade-in group">
        <div class="absolute inset-0 rounded-full border-4 border-cyan-500/20 m-2"></div>
        
        <!-- Lap count badge -->
        <div id="lap-badge" class="absolute top-6 right-8 text-2xs font-bold text-matte-400 bg-matte-100 dark:bg-surface-elevated px-2 py-0.5 rounded-full opacity-0 transition">
          LAP <span id="lap-badge-count">0</span>
        </div>

        <div class="text-center z-10">
            <div id="display-time" class="text-5xl md:text-6xl font-mono font-bold text-matte-800 dark:text-white tracking-wider tabular-nums">
                00:00:00
            </div>
            <div id="display-ms" class="text-2xl md:text-3xl font-mono font-bold text-cyan-500 mt-2 tabular-nums">
                .00
            </div>
        </div>
    </div>

    <div class="flex gap-4 mb-10 animate-fade-in">
        <button id="btn-reset" class="w-16 h-16 rounded-full bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300 font-bold hover:bg-matte-200 dark:hover:bg-surface-hover transition shadow-lg flex items-center justify-center active:scale-95" title="Reset (R)">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        </button>

        <button id="btn-start-stop" class="w-24 h-24 -mt-4 rounded-full bg-cyan-500 text-white font-bold text-xl hover:bg-cyan-600 hover:scale-105 transition shadow-xl shadow-cyan-500/30 flex items-center justify-center active:scale-95" data-i18n="btn.start">
            Start
        </button>

        <button id="btn-lap" class="w-16 h-16 rounded-full bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300 font-bold hover:bg-matte-200 dark:hover:bg-surface-hover transition shadow-lg flex items-center justify-center active:scale-95" title="Lap (L)" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
        </button>
    </div>

    <!-- Keyboard shortcuts hint -->
    <p class="text-2xs text-matte-400 mb-6 text-center">
      <kbd class="bg-matte-100 dark:bg-surface-elevated px-1.5 py-0.5 rounded text-xs font-mono">Space</kbd> Start/Stop · 
      <kbd class="bg-matte-100 dark:bg-surface-elevated px-1.5 py-0.5 rounded text-xs font-mono">L</kbd> Lap · 
      <kbd class="bg-matte-100 dark:bg-surface-elevated px-1.5 py-0.5 rounded text-xs font-mono">R</kbd> Reset
    </p>

    <div id="laps-container" class="w-full max-w-md card-base overflow-hidden hidden animate-fade-in">
        <div class="px-6 py-3 bg-matte-100 dark:bg-surface-hover border-b border-matte-200 dark:border-surface-border flex justify-between font-bold text-matte-400 text-xs uppercase tracking-wider">
            <span>Lap #</span>
            <span>Waktu Lap</span>
            <span>Total</span>
        </div>
        <div id="laps-list" class="max-h-56 overflow-y-auto custom-scrollbar">
        </div>
    </div>

  </div>
</BaseLayout>

<script>
const __page = (location.pathname.replace(/\/+$/, '') || '/');

  document.addEventListener('astro:page-load', () => {if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;

  let startTime = 0;
  let elapsedTime = 0;
  let timerInterval: ReturnType<typeof setInterval> | null = null;
  let isRunning = false;
  let lapCounter = 1;
  let lastLapTime = 0;

  const displayTime = document.getElementById('display-time');
  const displayMs = document.getElementById('display-ms');
  const btnStartStop = document.getElementById('btn-start-stop');
  const btnReset = document.getElementById('btn-reset');
  const btnLap = document.getElementById('btn-lap') as HTMLButtonElement;
  const lapsContainer = document.getElementById('laps-container');
  const lapsList = document.getElementById('laps-list');
  const lapBadge = document.getElementById('lap-badge');
  const lapBadgeCount = document.getElementById('lap-badge-count');

  function formatTime(ms: number) {
    const date = new Date(ms);
    const m = date.getUTCMinutes().toString().padStart(2, '0');
    const s = date.getUTCSeconds().toString().padStart(2, '0');
    const cs = Math.floor(date.getUTCMilliseconds() / 10).toString().padStart(2, '0');
    const h = Math.floor(ms / 3600000).toString().padStart(2, '0');
    return { main: `${h}:${m}:${s}`, ms: `.${cs}` };
  }

  function getCurrentTime() {
    return Date.now() - startTime + elapsedTime;
  }

  function updateDisplay() {
    const time = getCurrentTime();
    const formatted = formatTime(time);
    if(displayTime) displayTime.innerText = formatted.main;
    if(displayMs) displayMs.innerText = formatted.ms;
  }

  function start() {
    startTime = Date.now();
    lastLapTime = 0;
    timerInterval = setInterval(updateDisplay, 10);
    isRunning = true;
    
    if(btnStartStop) {
        btnStartStop.innerText = window._tToast ? window._tToast("Stop") : "Stop";
        btnStartStop.classList.replace('bg-cyan-500', 'bg-red-500');
        btnStartStop.classList.replace('hover:bg-cyan-600', 'hover:bg-red-600');
        btnStartStop.classList.replace('shadow-cyan-500/30', 'shadow-red-500/30');
    }
    if(btnLap) {
        btnLap.disabled = false;
        btnLap.classList.remove('opacity-50', 'cursor-not-allowed');
    }
  }

  function stop() {
    if (timerInterval) clearInterval(timerInterval);
    elapsedTime += Date.now() - startTime;
    isRunning = false;

    if(btnStartStop) {
        btnStartStop.innerText = window._tToast ? window._tToast("Start") : "Start";
        btnStartStop.classList.replace('bg-red-500', 'bg-cyan-500');
        btnStartStop.classList.replace('hover:bg-red-600', 'hover:bg-cyan-600');
        btnStartStop.classList.replace('shadow-red-500/30', 'shadow-cyan-500/30');
    }
    if(btnLap) {
        btnLap.disabled = true;
        btnLap.classList.add('opacity-50', 'cursor-not-allowed');
    }
  }

  function reset() {
    if (isRunning) stop();
    elapsedTime = 0;
    lastLapTime = 0;
    if(displayTime) displayTime.innerText = '00:00:00';
    if(displayMs) displayMs.innerText = '.00';
    if(lapsList) lapsList.innerHTML = '';
    lapsContainer?.classList.add('hidden');
    lapCounter = 1;
    if (lapBadge) lapBadge.classList.add('opacity-0');
    if (lapBadgeCount) lapBadgeCount.textContent = '0';
  }

  function logLap() {
    const totalTime = getCurrentTime();
    const lapTime = totalTime - lastLapTime;
    lastLapTime = totalTime;
    
    const totalFormatted = formatTime(totalTime);
    const lapFormatted = formatTime(lapTime);
    
    const div = document.createElement('div');
    div.className = "px-6 py-3 border-b border-matte-100 dark:border-matte-700 flex justify-between text-matte-700 dark:text-matte-300 font-mono text-sm animate-fade-in items-center";
    div.innerHTML = `
      <span class="font-bold text-cyan-500">#${lapCounter}</span>
      <span class="tabular-nums">${lapFormatted.main}<span class="text-xs text-matte-400">${lapFormatted.ms}</span></span>
      <span class="text-matte-400 tabular-nums text-xs">${totalFormatted.main}<span class="text-2xs">${totalFormatted.ms}</span></span>
    `;
    
    lapsList?.prepend(div);
    lapsContainer?.classList.remove('hidden');
    
    if (lapBadge) {
      lapBadge.classList.remove('opacity-0');
      if (lapBadgeCount) lapBadgeCount.textContent = String(lapCounter);
    }
    lapCounter++;
  }

  function toggleStartStop() {
    if (isRunning) stop();
    else start();
  }

  btnStartStop?.addEventListener('click', toggleStartStop);
  btnReset?.addEventListener('click', reset);
  btnLap?.addEventListener('click', logLap);

  // Keyboard shortcuts
  const keyHandler = (e: KeyboardEvent) => {
    const tag = document.activeElement?.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
    
    if (e.code === 'Space') {
      e.preventDefault();
      toggleStartStop();
    } else if (e.key === 'l' || e.key === 'L') {
      if (isRunning) logLap();
    } else if (e.key === 'r' || e.key === 'R') {
      reset();
    }
  };
  document.addEventListener('keydown', keyHandler);
  document.addEventListener('astro:page-leave', () => {
    document.removeEventListener('keydown', keyHandler);
    if (timerInterval) clearInterval(timerInterval);
    isRunning = false;
  });
  });
</script>
