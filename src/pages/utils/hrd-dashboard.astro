  // ==================== Import Excel/CSV massal ====================
  const XLSX_URLS = [
    'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js',
    'https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js',
    'https://unpkg.com/xlsx@0.18.5/dist/xlsx.full.min.js',
  ];
  const IMPORT_HEADER_MAP: Record<string, string> = {
    nama: 'name', name: 'name', 'nama karyawan': 'name', 'nama lengkap': 'name',
    jabatan: 'position', position: 'position',
    divisi: 'division', departemen: 'division', division: 'division', department: 'division',
    status: 'status',
    'tanggal masuk': 'joinDate', 'tgl masuk': 'joinDate', masuk: 'joinDate', joindate: 'joinDate',
    'akhir kontrak': 'contractEnd', 'kontrak habis': 'contractEnd', contractend: 'contractEnd',
    gaji: 'salary', 'gaji pokok': 'salary', upah: 'salary', salary: 'salary',
    email: 'email', mail: 'email',
    telepon: 'phone', telp: 'phone', hp: 'phone', phone: 'phone', 'no hp': 'phone', nohp: 'phone',
  };

  function parseCsvRows(text: string): string[][] {
    const first = text.split(/\r?\n/)[0] || '';
    const delim = (first.match(/;/g) || []).length >= (first.match(/,/g) || []).length ? ';' : ',';
    const rows: string[][] = [];
    let row: string[] = [], cell = '', inQ = false;
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (inQ) {
        if (c === '"') { if (text[i + 1] === '"') { cell += '"'; i++; } else inQ = false; }
        else cell += c;
      } else if (c === '"') inQ = true;
      else if (c === delim) { row.push(cell); cell = ''; }
      else if (c === '\n') { row.push(cell); rows.push(row); row = []; cell = ''; }
      else if (c !== '\r') cell += c;
    }
    if (cell !== '' || row.length > 0) { row.push(cell); rows.push(row); }
    return rows.filter(r => r.some(c => c.trim() !== ''));
  }

  function normImportDate(v: string): string {
    const s = v.trim();
    if (!s) return '';
    if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
    const m = s.match(/^(\d{1,2})[/-](\d{1,2})[/-](\d{4})$/);
    if (m) return `${m[3]}-${m[2].padStart(2, '0')}-${m[1].padStart(2, '0')}`;
    const n = Number(s.replace(/[^\d.]/g, ''));
    if (Number.isFinite(n) && n > 20000 && n < 80000) {
      return new Date(Date.UTC(1899, 11, 30) + n * 86400000).toISOString().slice(0, 10);
    }
    return '';
  }

  function normImportSalary(v: string): number {
    const n = parseInt(v.replace(/[^\d]/g, ''), 10);
    return Number.isFinite(n) ? n : 0;
  }

  async function handleImportFile(file: File) {
    const statusEl = $('emp-import-status');
    try {
      let records: Record<string, string>[] = [];
      if (file.name.toLowerCase().endsWith('.csv')) {
        const text = (await file.text()).replace(/^\uFEFF/, '');
        const rows = parseCsvRows(text);
        if (rows.length < 2) throw new Error('File kosong atau hanya berisi judul kolom.');
        const headers = rows[0].map(h => IMPORT_HEADER_MAP[h.trim().toLowerCase()] ?? '');
        records = rows.slice(1).map(r => { const o: Record<string, string> = {}; headers.forEach((h, i) => { if (h) o[h] = (r[i] ?? '').trim(); }); return o; });
      } else {
        const ready = await loadCdnLib('XLSX', XLSX_URLS);
        if (!ready) throw new Error('Library Excel gagal dimuat — cek koneksi internet.');
        const buf = await file.arrayBuffer();
        const XLSX = (window as any).XLSX;
        const wb = XLSX.read(buf, { type: 'array' });
        const rows: string[][] = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { header: 1, defval: '', raw: false });
        if (rows.length < 2) throw new Error('Sheet pertama kosong atau hanya berisi judul kolom.');
        const headers = (rows[0] as unknown as string[]).map(h => IMPORT_HEADER_MAP[String(h).trim().toLowerCase()] ?? '');
        records = rows.slice(1).map(r => { const o: Record<string, string> = {}; headers.forEach((h, i) => { if (h) o[h] = String(r[i] ?? '').trim(); }); return o; });
      }
      const valid = records.filter(r => r.name);
      const skipped = records.length - valid.length;
      if (valid.length === 0) throw new Error('Tidak ada baris dengan kolom "Nama" terisi. Pastikan baris pertama memuat header, misal: Nama; Jabatan; Divisi; Gaji Pokok.');

      let nextId = data.employees.reduce((m, e) => Math.max(m, e.id), 0) + 1;
      const added: Employee[] = valid.map(r => ({
        id: nextId++,
        name: r.name,
        position: r.position ?? '',
        division: r.division ?? '',
        status: r.status ?? 'PKWTT',
        joinDate: normImportDate(r.joinDate ?? ''),
        contractEnd: normImportDate(r.contractEnd ?? ''),
        salary: normImportSalary(r.salary ?? ''),
        email: r.email ?? '',
        phone: r.phone ?? '',
      }));
      if (!confirm(`${added.length} karyawan akan ditambahkan${skipped > 0 ? `, ${skipped} baris dilewati (nama kosong)` : ''}. Lanjutkan?`)) return;
      data.employees.push(...added);
      save(); renderAll();
      statusEl.className = 'card-base p-4 text-sm text-emerald-600 dark:text-emerald-400 font-semibold';
      statusEl.textContent = `✓ ${added.length} karyawan berhasil diimport${skipped > 0 ? `, ${skipped} baris dilewati` : ''}.`;
      statusEl.classList.remove('hidden');
      toast(`${added.length} karyawan ditambahkan`);
    } catch (e) {
      statusEl.className = 'card-base p-4 text-sm text-red-500 font-semibold';
      statusEl.textContent = '✗ ' + (e instanceof Error ? e.message : 'Gagal membaca file.');
      statusEl.classList.remove('hidden');
    }
  }

  // ==================== Render: Absensi ====================
  function renderAttendance() {
    const date = ($('att-date') as HTMLInputElement).value || todayStr();
    const list = $('att-list');
    if (data.employees.length === 0) {
      list.innerHTML = '<li class="p-8 text-center text-matte-400">Belum ada karyawan. Tambahkan dulu di tab Karyawan.</li>';
      $('att-summary').textContent = '—';
      return;
    }
    const dayAtt = new Map(data.attendance.filter(a => a.date === date).map(a => [a.empId, a.status]));
    const options: Array<{ val: Attendance['status']; label: string; on: string; off: string }> = [
      { val: 'hadir', label: 'Hadir', on: 'bg-emerald-500 border-emerald-500', off: 'hover:border-emerald-500' },
      { val: 'sakit', label: 'Sakit', on: 'bg-sky-500 border-sky-500', off: 'hover:border-sky-500' },
      { val: 'izin', label: 'Izin', on: 'bg-amber-500 border-amber-500', off: 'hover:border-amber-500' },
      { val: 'alpha', label: 'Alpha', on: 'bg-red-500 border-red-500', off: 'hover:border-red-500' },
    ];
    list.innerHTML = data.employees.map(e => {
      const cur = dayAtt.get(e.id);
      return `
        <li class="p-3 flex flex-col sm:flex-row sm:items-center gap-2 justify-between hover:bg-matte-100/50 dark:hover:bg-surface-hover/50 transition-colors">
          <div class="min-w-0">
            <p class="font-semibold text-matte-900 dark:text-white truncate">${esc(e.name)}</p>
            <p class="text-xs text-matte-400 truncate">${esc(e.position) || '—'} · ${esc(e.division) || '—'}</p>
          </div>
          <div class="flex gap-1.5 shrink-0">
            ${options.map(o => `
              <button data-att-emp="${e.id}" data-att-val="${o.val}" data-att-date="${date}"
                class="text-xs font-bold px-3 py-1.5 rounded-full border transition-colors ${cur === o.val
                  ? `${o.on} text-white`
                  : `border-matte-200 dark:border-surface-border text-matte-500 dark:text-matte-300 ${o.off}`}"
              >
                ${o.label}
              </button>`).join('')}
          </div>
        </li>`;
    }).join('');

    list.querySelectorAll<HTMLButtonElement>('[data-att-emp]').forEach(b => b.addEventListener('click', () => {
      const empId = +b.dataset.attEmp!, status = b.dataset.attVal as Attendance['status'], d = b.dataset.attDate!;
      const existing = data.attendance.find(a => a.empId === empId && a.date === d);
      if (existing && existing.status === status) {
        data.attendance = data.attendance.filter(a => a !== existing); // klik lagi = batal
      } else if (existing) {
        existing.status = status;
      } else {
        data.attendance.push({ empId, date: d, status });
      }
      save(); renderSummary(); renderAttendance();
    }));

    const counts = { hadir: 0, sakit: 0, izin: 0, alpha: 0 } as Record<Attendance['status'], number>;
    dayAtt.forEach(s => counts[s]++);
    const totalMarked = Object.values(counts).reduce((a, b) => a + b, 0);
    $('att-summary').textContent = totalMarked === 0
      ? 'Belum ada yang diabsen untuk ' + fmtDate(date)
      : `Hadir ${counts.hadir} · Sakit ${counts.sakit} · Izin ${counts.izin} · Alpha ${counts.alpha} (${totalMarked}/${data.employees.length} tercatat)`;
  }

  function markAllPresent() {
    const date = ($('att-date') as HTMLInputElement).value || todayStr();
    if (data.employees.length === 0) return;
    data.employees.forEach(e => {
      const existing = data.attendance.find(a => a.empId === e.id && a.date === date);
      if (existing) existing.status = 'hadir';
      else data.attendance.push({ empId: e.id, date, status: 'hadir' });
    });
    save(); renderSummary(); renderAttendance(); toast('Semua ditandai hadir');
  }

