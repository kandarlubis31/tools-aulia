          ${cards.length === 0
            ? '<p class="text-xs text-matte-400 py-2">Kosong</p>'
            : cards.map(c => `
              <div class="rounded-lg border border-matte-200 dark:border-surface-border p-2.5 bg-matte-100/50 dark:bg-surface-hover/50">
                <p class="text-sm font-semibold text-matte-900 dark:text-white truncate">${esc(c.name)}</p>
