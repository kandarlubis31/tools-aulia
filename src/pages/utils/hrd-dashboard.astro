                  <select data-cand-move="${c.id}" class="flex-1 text-xs p-1.5 rounded-md bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border text-matte-600 dark:text-matte-300 outline-none">
                    <option value="">→ pindah ke...</option>
                    ${STAGES.filter(s => s.key !== c.stage).map(s => `<option value="${s.key}">${s.label}</option>`).join('')}
                  </select>
                  <button data-cand-del="${c.id}" class="text-matte-400 hover:text-red-500 p-1" aria-label="Hapus pelamar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                  </button>
                </div>
              </div>`).join('')}
        </div>`;
    }).join('');

    kanban.querySelectorAll<HTMLSelectElement>('[data-cand-move]').forEach(sel => sel.addEventListener('change', () => {
      const c = data.candidates.find(x => x.id === +sel.dataset.candMove!);
      if (c && sel.value) {
        c.stage = sel.value as Candidate['stage'];
        save(); renderAll();
        toast(c.stage === 'hired' ? 'Selamat, kandidat diterima!' : 'Kandidat dipindah');
      }
    }));
    kanban.querySelectorAll<HTMLButtonElement>('[data-cand-del]').forEach(b => b.addEventListener('click', () => {
      if (confirm('Hapus pelamar ini dari pipeline?')) {
        data.candidates = data.candidates.filter(x => x.id !== +b.dataset.candDel!);
        save(); renderAll();
      }
    }));
  }

  function handleCandSubmit(e: Event) {
    e.preventDefault();
    const name = ($('cand-name') as HTMLInputElement).value.trim();
    if (!name) return;
    data.candidates.unshift({
      id: Date.now(), name,
      position: ($('cand-position') as HTMLInputElement).value.trim(),
      stage: 'applied',
      contact: ($('cand-contact') as HTMLInputElement).value.trim(),
      note: ($('cand-note') as HTMLInputElement).value.trim(),
    });
    save();
    ($('cand-form') as HTMLFormElement).reset();
    renderAll(); toast('Pelamar ditambahkan');
  }

  // ==================== Render: Payroll ====================
  function renderPayroll() {
    const month = ($('payroll-month') as HTMLInputElement).value || todayStr().slice(0, 7);
    const tbody = $('payroll-tbody');
    if (data.employees.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-10 text-center text-matte-400">Belum ada karyawan.</td></tr>';
      $('payroll-total').textContent = '';
      return;
    }
    let grandTotal = 0;
    tbody.innerHTML = data.employees.map(e => {
      const att = data.attendance.filter(a => a.empId === e.id && a.date.startsWith(month));
      const hadir = att.filter(a => a.status === 'hadir').length;
      const alpha = att.filter(a => a.status === 'alpha').length;
      const deduction = Math.round((e.salary / 22) * alpha);
      const net = Math.max(0, e.salary - deduction);
      grandTotal += net;
      return `
        <tr class="hover:bg-matte-100/50 dark:hover:bg-surface-hover/50 transition-colors">
          <td class="px-4 py-3 font-semibold text-matte-900 dark:text-white">${esc(e.name)}</td>
          <td class="px-4 py-3 text-right text-matte-600 dark:text-matte-300">${fmtRp(e.salary)}</td>
          <td class="px-4 py-3 text-center text-emerald-600 dark:text-emerald-400 font-semibold">${hadir}</td>
          <td class="px-4 py-3 text-center ${alpha > 0 ? 'text-red-500 font-semibold' : 'text-matte-400'}">${alpha}</td>
          <td class="px-4 py-3 text-right font-bold text-matte-900 dark:text-white">${fmtRp(net)}</td>
        </tr>`;
    }).join('');
    $('payroll-total').textContent = 'Total: ' + fmtRp(grandTotal);
  }

  function exportPayrollCsv() {
    const month = ($('payroll-month') as HTMLInputElement).value || todayStr().slice(0, 7);
    if (data.employees.length === 0) { toast('Belum ada data'); return; }
    const header = ['Nama', 'Divisi', 'Bulan', 'Gaji Pokok', 'Hadir', 'Alpha', 'Potongan', 'Gaji Bersih'];
    const rows = data.employees.map(e => {
      const att = data.attendance.filter(a => a.empId === e.id && a.date.startsWith(month));
      const hadir = att.filter(a => a.status === 'hadir').length;
      const alpha = att.filter(a => a.status === 'alpha').length;
      const potongan = Math.round((e.salary / 22) * alpha);
      return [e.name, e.division, month, e.salary, hadir, alpha, potongan, Math.max(0, e.salary - potongan)];
    });
    const csv = '\uFEFF' + [header, ...rows].map(r => r.map(csvCell).join(';')).join('\n');
    downloadFile('payroll-' + month + '.csv', csv, 'text/csv;charset=utf-8');
  }

  // ==================== Tab: Data ====================
  function exportJson() {
    const payload = { app: 'toolsaulia-hrd', version: 1, exportedAt: new Date().toISOString(), ...data };
    downloadFile('hrd-backup-' + todayStr() + '.json', JSON.stringify(payload, null, 2), 'application/json');
    toast('Backup didownload');
  }

  function importJson(file: File) {
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const parsed = JSON.parse(String(reader.result));
        if (!parsed || !Array.isArray(parsed.employees)) { toast('File tidak valid'); return; }
        if (!confirm('Ganti data saat ini dengan isi backup?')) return;
        data = {
          employees: (parsed.employees ?? []).map((e: Employee) => ({ contractEnd: '', ...e })),
          attendance: parsed.attendance ?? [],
          leaves: parsed.leaves ?? [],
          candidates: parsed.candidates ?? [],
        };
        save(); renderAll(); toast('Data berhasil diimpor');
      } catch { toast('File tidak valid'); }
    };
    reader.readAsText(file);
  }

  // ==================== THR reminder ====================
  // Tanggal Idulfitri = perkiraan astronomis (geser ±1 hari) — sesuaikan dengan SKB 3 Menteri tahun berjalan.
  const LEBARAN_APPROX: Record<number, string> = { 2026: '2026-03-20', 2027: '2027-03-10', 2028: '2028-02-26', 2029: '2029-02-15', 2030: '2030-02-05' };
  function thrUpcoming(): { name: string; date: string; approx: boolean } {
    const yNow = new Date().getFullYear();
    const candidates: { name: string; date: string; approx: boolean }[] = [];
    for (const y of [yNow, yNow + 1]) {
      const lb = LEBARAN_APPROX[y];
      if (lb) candidates.push({ name: `Idulfitri ${y}`, date: lb, approx: true });
      candidates.push({ name: `Natal ${y}`, date: `${y}-12-25`, approx: false });
    }
    candidates.sort((a, b) => a.date.localeCompare(b.date));
    return candidates.find(c => c.date >= todayStr()) ?? candidates[0];
  }
  function renderThr() {
    const ev = thrUpcoming();
    const days = Math.round((new Date(ev.date).getTime() - new Date(todayStr()).getTime()) / 86400000);
    $('thr-next-label').textContent = `${ev.name}${ev.approx ? ' (perkiraan)' : ''}`;
    $('thr-days').textContent = days === 0 ? 'Hari ini!' : days > 0 ? `H-${days}` : `Lewat ${-days} hari`;
    const note = $('thr-note');
    if (days > 45) note.textContent = 'Masih longgar — tapi dana THR sebaiknya mulai disisihkan dari sekarang.';
    else if (days > 7) note.textContent = 'Tenggat bayar H-7 (Permenaker 6/2016). Siapkan anggaran & estimasi pajaknya.';
    else if (days >= 0) note.textContent = '⚠️ Tinggal ≤7 hari — THR wajib sudah dibayarkan paling lambat H-7.';
    else note.textContent = 'Sudah lewat — pastikan THR sudah dibayar; terlambat kena denda 5%.';
  }

  // ==================== Boot ====================
  function renderAll() {
    renderSummary();
    renderThr();
    renderEmployees();
    renderAttendance();
    renderLeaves();
    renderRecruitment();
    renderPayroll();
  }

  function bindEvents() {
    // Auth
    $('setup-form').addEventListener('submit', handleSetup);
    $('login-form').addEventListener('submit', handleLogin);
    $('logout-btn').addEventListener('click', logout);

    // Tabs
    document.querySelectorAll<HTMLElement>('.tab-btn').forEach(b =>
      b.addEventListener('click', () => switchTab(b.dataset.tab || 'ringkasan'))
    );

    // Karyawan
    $('emp-add-btn').addEventListener('click', () => openEmpModal());
    $('emp-cancel').addEventListener('click', () => $('emp-modal').classList.add('hidden'));
    $('emp-form').addEventListener('submit', handleEmpSubmit);
    $('emp-search').addEventListener('input', renderEmployees);
    $('emp-export-btn').addEventListener('click', exportEmployeesCsv);
    $('emp-import-btn').addEventListener('click', () => $('emp-import-input').click());
    $('emp-import-input').addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.files && input.files[0]) handleImportFile(input.files[0]);
      input.value = '';
    });
    $('emp-modal').addEventListener('click', (e) => {
      if (e.target === $('emp-modal')) $('emp-modal').classList.add('hidden');
    });

    // Absensi
    ($('att-date') as HTMLInputElement).value = todayStr();
    ($('payroll-month') as HTMLInputElement).value = todayStr().slice(0, 7);
    $('att-date').addEventListener('change', renderAttendance);
    $('att-all-present').addEventListener('click', markAllPresent);

    // Cuti
    $('leave-form').addEventListener('submit', handleLeaveSubmit);

    // Rekrutmen
    $('cand-form').addEventListener('submit', handleCandSubmit);

    // Payroll
    $('payroll-month').addEventListener('change', renderPayroll);
    $('payroll-export-btn').addEventListener('click', exportPayrollCsv);

    // Data
    $('export-json-btn').addEventListener('click', exportJson);
    $('import-json-input').addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input.files && input.files[0]) importJson(input.files[0]);
      input.value = '';
    });
    $('reset-auth-btn').addEventListener('click', () => {
      if (confirm('Hapus kredensial login? Anda perlu membuat username & password baru.')) {
        localStorage.removeItem(AUTH_KEY);
        localStorage.removeItem(FAILED_KEY);
        localStorage.removeItem(LAST_ACTIVITY_KEY);
        sessionStorage.removeItem(SESSION_KEY);
        $('app-screen').classList.add('hidden');
        $('auth-screen').classList.remove('hidden');
        showLogin();
        toast('Kredensial direset');
      }
    });
    $('wipe-btn').addEventListener('click', () => {
      if (confirm('Hapus PERMANEN semua data karyawan, absensi, dan cuti?')) {
        if (confirm('Yakin 100%? Tindakan ini tidak bisa dibatalkan.')) {
          data = { employees: [], attendance: [], leaves: [], candidates: [] };
          save(); renderAll(); toast('Semua data dihapus');
        }
      }
    });

    // Esc = tutup modal
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') $('emp-modal').classList.add('hidden');
    });
  }

  // Init
  bindEvents();

  // Auto-lock: aktivitas memperpanjang sesi; cek idle tiap 30 detik
  let lastStamp = 0;
  ['click', 'keydown', 'mousemove', 'touchstart'].forEach(ev =>
    document.addEventListener(ev, () => {
      const now = Date.now();
      if (now - lastStamp > 10000) { lastStamp = now; localStorage.setItem(LAST_ACTIVITY_KEY, String(now)); }
    }, { passive: true }));
  checkIdle();
  setInterval(checkIdle, 30000);

  if (sessionStorage.getItem(SESSION_KEY) === '1' && loadAuth()) {
    enterApp();
  } else {
    showLogin();
    switchTab('ringkasan');
  }
</script>
