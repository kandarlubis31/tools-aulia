        <div class="card-base p-4 flex flex-col sm:flex-row gap-2 items-stretch sm:items-center justify-between">
          <input id="payroll-month" type="month" class="p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
          <button id="payroll-export-btn" class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 border border-emerald-500/40 hover:bg-emerald-500/10 rounded-lg px-4 py-3 transition-colors">Export CSV</button>
        </div>
        <div class="card-base overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-matte-100 dark:bg-surface-hover text-left text-xs uppercase tracking-wide text-matte-400">
                  <th class="px-4 py-3">Nama</th>
                  <th class="px-4 py-3 text-right">Gaji Pokok</th>
                  <th class="px-4 py-3 text-center">Hadir</th>
                  <th class="px-4 py-3 text-center">Alpha</th>
                  <th class="px-4 py-3 text-right">Gaji Bersih</th>
                </tr>
              </thead>
              <tbody id="payroll-tbody" class="divide-y divide-matte-100 dark:divide-surface-border"></tbody>
            </table>
          </div>
          <div class="p-3 bg-matte-100 dark:bg-surface-hover border-t border-matte-200 dark:border-surface-border text-xs text-matte-400 flex justify-between items-center">
            <span>Potongan = (gaji pokok ÷ 22) × hari alpha</span>
            <span id="payroll-total" class="font-bold text-matte-700 dark:text-white"></span>
          </div>
        </div>
      </section>

      <!-- ===== Tab: Data ===== -->
      <section id="tab-data" class="tab-panel hidden space-y-4">
        <div class="card-base p-4 md:p-5 space-y-4">
          <div>
            <h3 class="font-bold text-matte-900 dark:text-white mb-1">Backup Data</h3>
            <p class="text-sm text-matte-400 mb-3">Simpan semua data (karyawan, absensi, cuti) ke file JSON. Lakukan rutin supaya data aman walau ganti browser/perangkat.</p>
            <button id="export-json-btn" class="text-sm font-semibold text-accent-blue border border-accent-blue/40 hover:bg-accent-blue/10 rounded-lg px-4 py-2.5 transition-colors">Download Backup (JSON)</button>
          </div>
          <div class="border-t border-matte-100 dark:border-surface-border pt-4">
            <h3 class="font-bold text-matte-900 dark:text-white mb-1">Restore Data</h3>
            <p class="text-sm text-matte-400 mb-3">Impor file backup JSON. Data saat ini akan diganti dengan isi file.</p>
            <input id="import-json-input" type="file" accept=".json,application/json" class="block w-full text-sm text-matte-500 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-matte-900 dark:file:bg-white file:text-white dark:file:text-matte-900 file:font-semibold file:cursor-pointer" />
          </div>
          <div class="border-t border-matte-100 dark:border-surface-border pt-4">
            <h3 class="font-bold text-matte-900 dark:text-white mb-1">Reset Kredensial</h3>
            <p class="text-sm text-matte-400 mb-3">Hapus login (username & password) dari browser ini. Data karyawan tetap ada, tapi bisa di-setup ulang.</p>
            <button id="reset-auth-btn" class="text-sm font-semibold text-amber-600 dark:text-amber-400 border border-amber-500/40 hover:bg-amber-500/10 rounded-lg px-4 py-2.5 transition-colors">Reset Kredensial</button>
          </div>
          <div class="border-t border-matte-100 dark:border-surface-border pt-4">
            <h3 class="font-bold text-red-500 mb-1">Hapus Semua Data</h3>
            <p class="text-sm text-matte-400 mb-3">Menghapus permanen seluruh data karyawan, absensi, dan cuti dari browser ini.</p>
            <button id="wipe-btn" class="text-sm font-semibold text-red-500 border border-red-500/40 hover:bg-red-500/10 rounded-lg px-4 py-2.5 transition-colors">Hapus Permanen</button>
          </div>
        </div>
      </section>
    </div>

    <!-- ============ EMPLOYEE MODAL ============ -->
    <div id="emp-modal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center p-4">
      <div class="card-base w-full max-w-md p-5 md:p-6 max-h-[90vh] overflow-y-auto">
        <h3 id="emp-modal-title" class="font-bold text-lg text-matte-900 dark:text-white mb-4">Tambah Karyawan</h3>
        <form id="emp-form" class="space-y-3">
          <input type="hidden" id="emp-id" />
          <div>
            <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1">Nama Lengkap *</label>
            <input id="emp-name" type="text" required class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1">Jabatan</label>
              <input id="emp-position" type="text" class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1">Divisi</label>
              <input id="emp-division" type="text" list="division-options" class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
              <datalist id="division-options"></datalist>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1">Status</label>
              <select id="emp-status" class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue">
                <option value="Tetap">Tetap</option>
                <option value="Kontrak">Kontrak</option>
                <option value="Magang">Magang</option>
                <option value="Paruh Waktu">Paruh Waktu</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1">Tgl Masuk</label>
              <input id="emp-join" type="date" class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1">Akhir Kontrak (khusus PKWT, opsional)</label>
            <input id="emp-contract-end" type="date" class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1">Gaji Pokok / bulan (Rp)</label>
            <input id="emp-salary" type="number" min="0" step="100000" class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1">Email</label>
              <input id="emp-email" type="email" class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1">Telepon</label>
              <input id="emp-phone" type="tel" class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
            </div>
          </div>
          <p id="emp-error" class="hidden text-sm text-red-500 font-medium"></p>
          <div class="flex gap-2 pt-2">
            <button type="button" id="emp-cancel" class="flex-1 font-semibold py-3 rounded-lg border border-matte-200 dark:border-surface-border text-matte-600 dark:text-matte-300 transition-colors">Batal</button>
            <button type="submit" class="flex-1 bg-matte-900 dark:bg-white text-white dark:text-matte-900 font-semibold py-3 rounded-lg transition-all active:scale-95">Simpan</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { loadCdnLib } from '../../composables/useCdnLib';

  // ==================== Storage ====================
  const AUTH_KEY = 'hrd_auth_v1';
  const DATA_KEY = 'hrd_data_v1';
  const SESSION_KEY = 'hrd_session_v1';
  const FAILED_KEY = 'hrd_failed_v1';
  const LAST_ACTIVITY_KEY = 'hrd_last_activity_v1';
  const IDLE_MS = 15 * 60 * 1000;

  interface Auth { username: string; salt: string; hash: string; hint?: string; }
  interface Employee { id: number; name: string; position: string; division: string; status: string; joinDate: string; salary: number; email: string; phone: string; contractEnd: string; }
  interface Attendance { empId: number; date: string; status: 'hadir' | 'sakit' | 'izin' | 'alpha'; }
  interface Leave { id: number; empId: number; type: string; start: string; end: string; reason: string; status: 'menunggu' | 'disetujui' | 'ditolak'; }
  interface Candidate { id: number; name: string; position: string; stage: 'applied' | 'interview' | 'offer' | 'hired' | 'rejected'; contact: string; note: string; }
  interface HrdData { employees: Employee[]; attendance: Attendance[]; leaves: Leave[]; candidates: Candidate[]; }

  function loadAuth(): Auth | null {
    try { const raw = localStorage.getItem(AUTH_KEY); return raw ? JSON.parse(raw) : null; } catch { return null; }
  }
  function saveAuth(a: Auth) { localStorage.setItem(AUTH_KEY, JSON.stringify(a)); }
  function loadData(): HrdData {
    try {
      const raw = localStorage.getItem(DATA_KEY);
      if (raw) {
        const d = JSON.parse(raw);
        return { employees: d.employees ?? [], attendance: d.attendance ?? [], leaves: d.leaves ?? [], candidates: d.candidates ?? [] };
      }
    } catch { /* corrupt → reset */ }
    return { employees: [], attendance: [], leaves: [], candidates: [] };
  }
  function saveData(d: HrdData) { localStorage.setItem(DATA_KEY, JSON.stringify(d)); }

  async function sha256Hex(text: string): Promise<string> {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
    return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  // ==================== Brute-force guard & idle lock ====================
  const MAX_ATTEMPTS = 5;
  const LOCK_MS = 5 * 60 * 1000;

  function getFailed(): { n: number; until: number } {
    try { const v = JSON.parse(localStorage.getItem(FAILED_KEY) || ''); return (v && typeof v === 'object') ? v : { n: 0, until: 0 }; } catch { return { n: 0, until: 0 }; }
  }
  function markFailed(): { n: number; until: number } {
    const f = getFailed();
    const n = f.n + 1;
    const until = n >= MAX_ATTEMPTS ? Date.now() + LOCK_MS : 0;
    localStorage.setItem(FAILED_KEY, JSON.stringify({ n, until }));
    return { n, until };
  }
  function markSuccess() { localStorage.removeItem(FAILED_KEY); }
  function checkLockout(): boolean {
    const f = getFailed();
    if (f.until > Date.now()) {
      const err = $('login-error');
      err.textContent = `Terlalu banyak percobaan gagal. Coba lagi dalam ${Math.ceil((f.until - Date.now()) / 60000)} menit.`;
      err.classList.remove('hidden');
      return true;
    }
    return false;
  }
  function checkIdle() {
    if (sessionStorage.getItem(SESSION_KEY) !== '1') return;
    const last = parseInt(localStorage.getItem(LAST_ACTIVITY_KEY) || '0', 10);
    if (last > 0 && Date.now() - last > IDLE_MS) {
      sessionStorage.removeItem(SESSION_KEY);
      localStorage.removeItem(LAST_ACTIVITY_KEY);
      $('app-screen').classList.add('hidden');
      $('auth-screen').classList.remove('hidden');
      showLogin();
      toast('Sesi berakhir karena tidak ada aktivitas. Silakan login kembali.');
    }
  }

  // ==================== Helpers ====================
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  function esc(s: unknown): string {
    return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  }
  const fmtRp = (n: number) => 'Rp ' + (n || 0).toLocaleString('id-ID');
  const todayStr = () => new Date().toISOString().slice(0, 10);
  const fmtDate = (iso: string) => {
    if (!iso) return '—';
    const d = new Date(iso);
    return isNaN(d.getTime()) ? iso : d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
  };

  function downloadFile(filename: string, content: string, mime: string) {
    const blob = new Blob([content], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
  }

  function csvCell(v: unknown): string {
    const s = String(v ?? '');
    return /[",;\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
  }

  function toast(msg: string) {
    document.querySelectorAll('.hrd-toast').forEach(t => t.remove());
    const el = document.createElement('div');
    el.className = 'hrd-toast fixed bottom-5 left-1/2 -translate-x-1/2 z-[60] bg-matte-900 dark:bg-white text-white dark:text-matte-900 text-sm font-semibold px-4 py-2.5 rounded-full shadow-lg animate-fade-in';
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 2500);
  }

  // ==================== State ====================
  let data: HrdData = loadData();
  let currentTab = 'ringkasan';

  const save = () => saveData(data);
  const empById = (id: number) => data.employees.find(e => e.id === id);
  const empName = (id: number) => empById(id)?.name ?? '(karyawan terhapus)';

  function contractDaysLeft(e: Employee): number | null {
    if (!e.contractEnd) return null;
    return Math.round((new Date(e.contractEnd).getTime() - new Date(todayStr()).getTime()) / 86400000);
  }

  // ==================== Auth flow ====================
  async function handleSetup(e: Event) {
    e.preventDefault();
    const err = $('setup-error');
    err.classList.add('hidden');
    const username = ($('setup-username') as HTMLInputElement).value.trim();
    const password = ($('setup-password') as HTMLInputElement).value;
    const confirm = ($('setup-confirm') as HTMLInputElement).value;
    const hint = ($('setup-hint') as HTMLInputElement).value.trim();
    if (password !== confirm) { err.textContent = 'Password tidak sama.'; err.classList.remove('hidden'); return; }
    if (!username) { err.textContent = 'Username wajib diisi.'; err.classList.remove('hidden'); return; }
    try {
      const salt = crypto.randomUUID();
      const hash = await sha256Hex(salt + password);
      saveAuth({ username, salt, hash, hint: hint || undefined });
      sessionStorage.setItem(SESSION_KEY, '1');
      localStorage.setItem(LAST_ACTIVITY_KEY, String(Date.now()));
      enterApp();
    } catch {
      err.textContent = 'crypto.subtle tidak tersedia. Buka halaman via https:// atau localhost.'; err.classList.remove('hidden');
    }
  }

  async function handleLogin(e: Event) {
    e.preventDefault();
    const auth = loadAuth();
    if (!auth) return;
    const err = $('login-error');
    err.classList.add('hidden');
    if (checkLockout()) return;
    const username = ($('login-username') as HTMLInputElement).value.trim();
    const password = ($('login-password') as HTMLInputElement).value;
    const hash = await sha256Hex(auth.salt + password);
    if (username === auth.username && hash === auth.hash) {
      markSuccess();
      sessionStorage.setItem(SESSION_KEY, '1');
      localStorage.setItem(LAST_ACTIVITY_KEY, String(Date.now()));
      enterApp();
    } else {
      const fail = markFailed();
      if (fail.until > 0) {
        err.textContent = `Terlalu banyak percobaan gagal. Coba lagi dalam ${Math.ceil((fail.until - Date.now()) / 60000)} menit.`;
      } else {
        err.textContent = `Username atau password salah. Sisa percobaan: ${Math.max(0, MAX_ATTEMPTS - fail.n)}.`;
      }
      err.classList.remove('hidden');
    }
  }

  function enterApp() {
    const auth = loadAuth();
    $('auth-screen').classList.add('hidden');
    $('app-screen').classList.remove('hidden');
    if (auth) $('welcome-user').textContent = 'Halo, ' + auth.username;
    localStorage.setItem(LAST_ACTIVITY_KEY, String(Date.now()));
    data = loadData();
    switchTab(currentTab);
    renderAll();
  }

  function logout() {
    sessionStorage.removeItem(SESSION_KEY);
    localStorage.removeItem(LAST_ACTIVITY_KEY);
    $('app-screen').classList.add('hidden');
    $('auth-screen').classList.remove('hidden');
    showLogin();
  }

  function showLogin() {
    const auth = loadAuth();
    const login = $('auth-login'), setup = $('auth-setup');
    if (auth) {
      setup.classList.add('hidden'); login.classList.remove('hidden');
      const hintEl = $('login-hint');
      if (auth.hint) { hintEl.textContent = 'Hint: ' + auth.hint; hintEl.classList.remove('hidden'); }
    } else {
      login.classList.add('hidden'); setup.classList.remove('hidden');
    }
  }

  // ==================== Tabs ====================
  function switchTab(tab: string) {
    currentTab = tab;
    history.replaceState(null, '', '#' + tab);
    document.querySelectorAll<HTMLElement>('.tab-panel').forEach(p => p.classList.add('hidden'));
    const panel = $('tab-' + tab);
    if (panel) panel.classList.remove('hidden');
    document.querySelectorAll('.tab-btn').forEach(b => {
      const active = (b as HTMLElement).dataset.tab === tab;
      b.classList.toggle('bg-accent-blue', active);
      b.classList.toggle('text-white', active);
      b.classList.toggle('text-matte-500', !active);
      b.classList.toggle('dark:text-matte-300', !active);
      b.classList.toggle('hover:bg-matte-100', !active);
      b.classList.toggle('dark:hover:bg-surface-hover', !active);
    });
  }

  // ==================== Render: Ringkasan ====================
  function renderSummary() {
    $('stat-employees').textContent = String(data.employees.length);
    $('stat-divisions').textContent = String(new Set(data.employees.map(e => e.division).filter(Boolean)).size);

    const today = todayStr();
    const presentToday = data.attendance.filter(a => a.date === today && a.status === 'hadir').length;
    $('stat-present').textContent = String(presentToday);
    $('stat-pending').textContent = String(data.leaves.filter(l => l.status === 'menunggu').length);

    // Attendance rate bulan ini
    const month = today.slice(0, 7);
    const monthAtt = data.attendance.filter(a => a.date.startsWith(month));
    if (monthAtt.length > 0) {
      const present = monthAtt.filter(a => a.status === 'hadir').length;
      $('attendance-rate').textContent = 'Kehadiran bulan ini: ' + Math.round(present / monthAtt.length * 100) + '%';
    } else {
      $('attendance-rate').textContent = 'Belum ada data absensi bulan ini';
    }

    // Kontrak segera berakhir (≤30 hari)
    const expiring = data.employees
      .map(e => ({ e, days: contractDaysLeft(e) }))
      .filter((x): x is { e: Employee; days: number } => x.days !== null && x.days <= 30)
      .sort((a, b) => a.days - b.days);
    const contractCard = $('contract-card');
    if (expiring.length > 0) {
      contractCard.classList.remove('hidden');
      $('contract-list').innerHTML = expiring.map(({ e, days }) => `
        <div class="flex items-center justify-between gap-2">
          <span class="text-matte-600 dark:text-matte-300 truncate">${esc(e.name)} <span class="text-xs text-matte-400">· ${esc(e.position) || '—'}</span></span>
          <span class="text-xs font-bold whitespace-nowrap ${days < 0 ? 'text-red-500' : 'text-amber-600 dark:text-amber-400'}">${days < 0 ? 'Lewat ' + Math.abs(days) + ' hari' : days + ' hari lagi'}</span>
        </div>`).join('');
    } else {
      contractCard.classList.add('hidden');
    }

    // Per divisi
    const divList = $('division-list');
    const byDiv = new Map<string, number>();
    data.employees.forEach(e => { const k = e.division || '(tanpa divisi)'; byDiv.set(k, (byDiv.get(k) ?? 0) + 1); });
    const max = Math.max(1, ...byDiv.values());
    divList.innerHTML = byDiv.size === 0
      ? '<p class="text-sm text-matte-400">Belum ada karyawan. Tambahkan di tab Karyawan.</p>'
      : [...byDiv.entries()].sort((a, b) => b[1] - a[1]).map(([name, count]) => `
          <div class="flex items-center gap-3">
            <span class="w-32 sm:w-40 shrink-0 text-sm text-matte-600 dark:text-matte-300 truncate">${esc(name)}</span>
            <div class="flex-1 h-2.5 bg-matte-100 dark:bg-surface-hover rounded-full overflow-hidden">
              <div class="h-full bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full" style="width:${Math.round(count / max * 100)}%"></div>
            </div>
            <span class="text-sm font-bold text-matte-700 dark:text-white w-8 text-right">${count}</span>
          </div>`).join('');

    // Cuti terbaru
    const recent = $('recent-leaves');
