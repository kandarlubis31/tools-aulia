---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="HRD Dashboard" noIndex />
  <div class="max-w-4xl mx-auto px-4 min-h-[70vh]">
    <ToolPageHeader
      title="HRD Dashboard"
      desc="Kelola data karyawan, absensi, cuti, dan payroll. Data tersimpan 100% lokal di browser Anda."
      icon='<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>'
      gradient="from-emerald-500 to-teal-600"
    />

    <!-- ============ AUTH SCREEN ============ -->
    <div id="auth-screen" class="card-base p-6 md:p-8 animate-fade-in">
      <!-- Setup (belum ada kredensial) -->
      <div id="auth-setup" class="hidden">
        <h2 class="text-xl font-bold text-matte-900 dark:text-white mb-1">Buat Kredensial Login</h2>
        <p class="text-sm text-matte-400 mb-6">Pertama kali pakai? Buat username & password untuk melindungi data HRD Anda. Kredensial hanya disimpan di browser ini.</p>
        <form id="setup-form" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1" for="setup-username">Username</label>
            <input id="setup-username" type="text" required autocomplete="username" class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1" for="setup-password">Password (min. 6 karakter)</label>
            <input id="setup-password" type="password" required minlength="6" autocomplete="new-password" class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1" for="setup-confirm">Ulangi Password</label>
            <input id="setup-confirm" type="password" required minlength="6" autocomplete="new-password" class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1" for="setup-hint">Hint password (opsional)</label>
            <input id="setup-hint" type="text" class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue transition-colors" />
          </div>
          <p id="setup-error" class="hidden text-sm text-red-500 font-medium"></p>
          <button type="submit" class="w-full bg-matte-900 dark:bg-white text-white dark:text-matte-900 font-semibold py-3 rounded-lg transition-all active:scale-95">Simpan & Masuk</button>
        </form>
      </div>

      <!-- Login -->
      <div id="auth-login" class="hidden">
        <h2 class="text-xl font-bold text-matte-900 dark:text-white mb-1">Login</h2>
        <p class="text-sm text-matte-400 mb-6">Masukkan kredensial Anda untuk membuka dashboard.</p>
        <form id="login-form" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1" for="login-username">Username</label>
            <input id="login-username" type="text" required autocomplete="username" class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue transition-colors" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-matte-500 dark:text-matte-300 mb-1" for="login-password">Password</label>
            <input id="login-password" type="password" required autocomplete="current-password" class="w-full p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue transition-colors" />
          </div>
          <p id="login-hint" class="hidden text-xs text-matte-400"></p>
          <p id="login-error" class="hidden text-sm text-red-500 font-medium"></p>
          <button type="submit" class="w-full bg-matte-900 dark:bg-white text-white dark:text-matte-900 font-semibold py-3 rounded-lg transition-all active:scale-95">Masuk</button>
        </form>
        <p class="text-xs text-matte-400 mt-4 text-center">Data tersimpan di browser ini. Gunakan perangkat yang sama untuk membukanya kembali.</p>
      </div>
    </div>

    <!-- ============ APP SCREEN ============ -->
    <div id="app-screen" class="animate-fade-in hidden">
      <!-- Topbar -->
      <div class="card-base px-4 py-3 mb-4 flex items-center justify-between gap-3 flex-wrap">
        <div class="flex items-center gap-2 min-w-0">
          <span id="welcome-user" class="text-sm font-semibold text-matte-700 dark:text-white truncate"></span>
          <span class="text-xs text-matte-400">· HR</span>
        </div>
        <button id="logout-btn" class="text-xs font-semibold text-matte-500 dark:text-matte-400 hover:text-red-500 border border-matte-200 dark:border-surface-border hover:border-red-500/40 rounded-full px-3.5 py-1.5 transition-colors">Keluar</button>
      </div>

      <!-- Tabs -->
      <div class="card-base p-1.5 mb-4 grid grid-cols-3 sm:grid-cols-7 gap-1" role="tablist">
        <button data-tab="ringkasan" class="tab-btn px-2 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors">Ringkasan</button>
        <button data-tab="karyawan" class="tab-btn px-2 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors">Karyawan</button>
        <button data-tab="absensi" class="tab-btn px-2 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors">Absensi</button>
        <button data-tab="cuti" class="tab-btn px-2 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors">Cuti</button>
        <button data-tab="payroll" class="tab-btn px-2 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors">Payroll</button>
        <button data-tab="rekrutmen" class="tab-btn px-2 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors">Rekrutmen</button>
        <button data-tab="data" class="tab-btn px-2 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors">Data</button>
        <button data-tab="panduan" class="tab-btn px-2 py-2 rounded-lg text-xs sm:text-sm font-semibold transition-colors">❓ Panduan</button>
      </div>

      <!-- ===== Tab: Ringkasan ===== -->
      <section id="tab-ringkasan" class="tab-panel space-y-4">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
          <div class="card-base p-4">
            <p class="text-xs text-matte-400 font-medium">Total Karyawan</p>
            <p id="stat-employees" class="text-2xl font-extrabold text-matte-900 dark:text-white mt-1">0</p>
          </div>
          <div class="card-base p-4">
            <p class="text-xs text-matte-400 font-medium">Divisi</p>
            <p id="stat-divisions" class="text-2xl font-extrabold text-matte-900 dark:text-white mt-1">0</p>
          </div>
          <div class="card-base p-4">
            <p class="text-xs text-matte-400 font-medium">Hadir Hari Ini</p>
            <p id="stat-present" class="text-2xl font-extrabold text-emerald-500 mt-1">0</p>
          </div>
          <div class="card-base p-4">
            <p class="text-xs text-matte-400 font-medium">Cuti Menunggu</p>
            <p id="stat-pending" class="text-2xl font-extrabold text-amber-500 mt-1">0</p>
          </div>
        </div>
        <div class="card-base p-4 md:p-5">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-bold text-matte-900 dark:text-white">Karyawan per Divisi</h3>
            <span id="attendance-rate" class="text-xs font-semibold text-matte-400"></span>
          </div>
          <div id="division-list" class="space-y-2"></div>
        </div>
        <div id="contract-card" class="card-base p-4 md:p-5 hidden">
          <h3 class="font-bold text-matte-900 dark:text-white mb-1">⏰ Kontrak Segera Berakhir</h3>
          <p class="text-xs text-matte-400 mb-3">Karyawan PKWT yang kontraknya habis dalam ≤ 30 hari (atau sudah lewat).</p>
          <div id="contract-list" class="space-y-2 text-sm"></div>
        </div>
        <div id="thr-card" class="card-base p-4 md:p-5">
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-bold text-matte-900 dark:text-white">🎁 Countdown THR</h3>
            <span id="thr-next-label" class="text-xs font-semibold text-matte-400 text-right"></span>
          </div>
          <p id="thr-days" class="text-3xl font-extrabold text-amber-500 mt-2">—</p>
          <p id="thr-note" class="text-xs text-matte-400 mt-1"></p>
          <div class="mt-3 pt-3 border-t border-matte-100 dark:border-surface-border flex flex-wrap gap-2 text-xs">
            <a href="/calc/thr-bpjs" class="px-3 py-1.5 rounded-full bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400 font-semibold hover:bg-amber-100 dark:hover:bg-amber-900/40 transition-colors">Hitung THR</a>
            <a href="/calc/pph21-ter" class="px-3 py-1.5 rounded-full bg-matte-100 dark:bg-surface-hover text-matte-500 dark:text-matte-300 font-semibold hover:bg-matte-200 dark:hover:bg-surface-elevated transition-colors">Estimasi PPh 21</a>
            <a href="/pdf/slip-gaji" class="px-3 py-1.5 rounded-full bg-matte-100 dark:bg-surface-hover text-matte-500 dark:text-matte-300 font-semibold hover:bg-matte-200 dark:hover:bg-surface-elevated transition-colors">Cetak Slip Gaji</a>
          </div>
        </div>
        <div class="card-base p-4 md:p-5">
          <h3 class="font-bold text-matte-900 dark:text-white mb-3">Cuti Terbaru</h3>
          <div id="recent-leaves" class="space-y-2 text-sm"></div>
        </div>
      </section>

      <!-- ===== Tab: Panduan ===== -->
      <section id="tab-panduan" class="tab-panel hidden space-y-4">
        <div class="card-base p-4 md:p-6">
          <h3 class="font-bold text-matte-900 dark:text-white mb-1">Mulai dari sini 🚀</h3>
          <p class="text-sm text-matte-500 dark:text-matte-300">Dashboard ini disimpan di browser perangkat ini — pastikan pakai satu browser yang sama tiap hari, dan rutin backup lewat tab <b>Data</b>.</p>
        </div>
        <div class="card-base p-4 md:p-6 space-y-4">
          <div class="flex gap-3"><span class="shrink-0 w-7 h-7 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center">1</span><div><p class="font-bold text-matte-900 dark:text-white text-sm">Input data karyawan dulu</p><p class="text-sm text-matte-500 dark:text-matte-300">Tab <b>Karyawan</b> → tambah satu-satu lewat tombol tambah, atau kalau datanya masih di Excel/CSV langsung pakai tombol <b>Import Excel/CSV</b> — kolom dikenali otomatis (Nama, Jabatan, Divisi, Gaji Pokok, dll). Isi juga <b>akhir kontrak</b> untuk karyawan PKWT. Semua fitur lain (absensi, payroll, slip, surat) menarik data dari sini.</p></div></div>
          <div class="flex gap-3"><span class="shrink-0 w-7 h-7 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center">2</span><div><p class="font-bold text-matte-900 dark:text-white text-sm">Catat absensi tiap hari</p><p class="text-sm text-matte-500 dark:text-matte-300">Tab <b>Absensi</b> → pilih tanggal → tekan Hadir/Sakit/Izin/Alpha untuk tiap karyawan, atau pakai <b>Tandai Semua Hadir</b> lalu koreksi yang berbeda. Hari alpha otomatis jadi potongan di Payroll.</p></div></div>
          <div class="flex gap-3"><span class="shrink-0 w-7 h-7 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center">3</span><div><p class="font-bold text-matte-900 dark:text-white text-sm">Kelola cuti & rekrutmen</p><p class="text-sm text-matte-500 dark:text-matte-300">Tab <b>Cuti</b>: ajukan cuti lalu Setujui/Tolak. Tab <b>Rekrutmen</b>: catat pelamar dan geser tahapannya dari Lamar sampai Diterima.</p></div></div>
          <div class="flex gap-3"><span class="shrink-0 w-7 h-7 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center">4</span><div><p class="font-bold text-matte-900 dark:text-white text-sm">Gajian: cek Payroll & cetak slip</p><p class="text-sm text-matte-500 dark:text-matte-300">Tab <b>Payroll</b> menampilkan rekap potongan alpha otomatis, bisa diexport CSV. Untuk slip resmi per karyawan, buka <a href="/pdf/slip-gaji" class="text-blue-600 dark:text-blue-400 underline font-semibold">Slip Gaji Generator</a> — datanya terkirim otomatis dari dashboard ini.</p></div></div>
          <div class="flex gap-3"><span class="shrink-0 w-7 h-7 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center">5</span><div><p class="font-bold text-matte-900 dark:text-white text-sm">Pajak, THR, dan hari efektif</p><p class="text-sm text-matte-500 dark:text-matte-300">Potongan pajak dihitung dengan <a href="/calc/pph21-ter" class="text-blue-600 dark:text-blue-400 underline font-semibold">Kalkulator PPh 21 TER</a>, THR dengan <a href="/calc/thr-bpjs" class="text-blue-600 dark:text-blue-400 underline font-semibold">Kalkulator THR & BPJS</a> (countdown-nya ada di Ringkasan), dan hari kerja prorata dengan <a href="/calc/workdays" class="text-blue-600 dark:text-blue-400 underline font-semibold">Kalkulator Hari Kerja Efektif</a>.</p></div></div>
          <div class="flex gap-3"><span class="shrink-0 w-7 h-7 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center">6</span><div><p class="font-bold text-matte-900 dark:text-white text-sm">Surat resmi tinggal 2 klik</p><p class="text-sm text-matte-500 dark:text-matte-300"><a href="/pdf/surat-hr" class="text-blue-600 dark:text-blue-400 underline font-semibold">Surat HR Generator</a>: pilih karyawan → form terisi otomatis → pilih jenis (SKK, Surat Peringatan, PKWT) → Download PDF. Ada juga tombol SKK Massal untuk semua karyawan sekaligus.</p></div></div>
          <div class="flex gap-3"><span class="shrink-0 w-7 h-7 rounded-full bg-amber-500 text-white font-bold text-sm flex items-center justify-center">!</span><div><p class="font-bold text-matte-900 dark:text-white text-sm">Rutinitas penting</p><p class="text-sm text-matte-500 dark:text-matte-300">① Tiap akhir minggu: tab <b>Data</b> → <b>Download Backup</b> (file JSON, simpan di WhatsApp/email sendiri). ② Kalau ganti HP/laptop: backup dulu → restore di perangkat baru. ③ Dashboard terkunci otomatis setelah 15 menit tidak dipakai — cukup login ulang.</p></div></div>
        </div>
        <div class="card-base p-4 md:p-6">
          <h3 class="font-bold text-matte-900 dark:text-white mb-2">Alat pelengkap di situs ini 🔧</h3>
          <div class="grid sm:grid-cols-2 gap-2 text-sm">
            <a href="/pdf/slip-gaji" class="p-3 rounded-xl bg-matte-50 dark:bg-surface-hover hover:bg-matte-100 dark:hover:bg-surface-elevated transition-colors font-semibold text-matte-700 dark:text-matte-200">📄 Slip Gaji — payslip PDF dari data karyawan</a>
            <a href="/pdf/surat-hr" class="p-3 rounded-xl bg-matte-50 dark:bg-surface-hover hover:bg-matte-100 dark:hover:bg-surface-elevated transition-colors font-semibold text-matte-700 dark:text-matte-200">✍️ Surat HR — SKK, SP, PKWT (+massal)</a>
            <a href="/calc/pph21-ter" class="p-3 rounded-xl bg-matte-50 dark:bg-surface-hover hover:bg-matte-100 dark:hover:bg-surface-elevated transition-colors font-semibold text-matte-700 dark:text-matte-200">🧮 PPh 21 TER — pajak gaji Jan–Nov & Desember</a>
            <a href="/calc/thr-bpjs" class="p-3 rounded-xl bg-matte-50 dark:bg-surface-hover hover:bg-matte-100 dark:hover:bg-surface-elevated transition-colors font-semibold text-matte-700 dark:text-matte-200">🎁 THR & BPJS — prorata + iuran perusahaan/karyawan</a>
            <a href="/calc/workdays" class="p-3 rounded-xl bg-matte-50 dark:bg-surface-hover hover:bg-matte-100 dark:hover:bg-surface-elevated transition-colors font-semibold text-matte-700 dark:text-matte-200">📅 Hari Kerja Efektif — prorata gaji & cuti</a>
            <a href="/pdf/excel-to-pdf" class="p-3 rounded-xl bg-matte-50 dark:bg-surface-hover hover:bg-matte-100 dark:hover:bg-surface-elevated transition-colors font-semibold text-matte-700 dark:text-matte-200">📊 Excel ke PDF — rekap lama jadi rapi</a>
          </div>
        </div>
      </section>

      <!-- ===== Tab: Karyawan ===== -->
      <section id="tab-karyawan" class="tab-panel hidden space-y-4">
        <div class="card-base p-4 flex flex-col sm:flex-row gap-2">
          <input id="emp-search" type="text" placeholder="Cari nama / jabatan / divisi..." class="flex-1 p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue transition-colors" />
          <button id="emp-add-btn" class="bg-matte-900 dark:bg-white text-white dark:text-matte-900 font-semibold py-3 px-6 rounded-lg transition-all active:scale-95 whitespace-nowrap">+ Tambah Karyawan</button>
        </div>
        <div class="card-base p-4 flex flex-col sm:flex-row sm:items-center gap-2">
          <p class="flex-1 text-sm text-matte-500 dark:text-matte-300">Punya data lama di Excel? Import massal — kolom dikenali otomatis (kolom <b>Nama</b> wajib ada).</p>
          <button id="emp-import-btn" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-5 rounded-lg transition-colors whitespace-nowrap">📥 Import Excel/CSV</button>
          <input id="emp-import-input" type="file" accept=".csv,.xlsx,.xls" class="hidden" />
        </div>
        <div id="emp-import-status" class="hidden"></div>
        <div class="card-base overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-matte-100 dark:bg-surface-hover text-left text-xs uppercase tracking-wide text-matte-400">
                  <th class="px-4 py-3">Nama</th>
                  <th class="px-4 py-3">Jabatan</th>
                  <th class="px-4 py-3">Divisi</th>
                  <th class="px-4 py-3">Status</th>
                  <th class="px-4 py-3">Masuk</th>
                  <th class="px-4 py-3">Akhir Kontrak</th>
                  <th class="px-4 py-3 text-right">Aksi</th>
                </tr>
              </thead>
              <tbody id="emp-tbody" class="divide-y divide-matte-100 dark:divide-surface-border"></tbody>
            </table>
          </div>
          <div class="p-3 bg-matte-100 dark:bg-surface-hover border-t border-matte-200 dark:border-surface-border text-xs text-matte-400 flex justify-between items-center">
            <span id="emp-count">0 karyawan</span>
            <button id="emp-export-btn" class="text-emerald-600 dark:text-emerald-400 font-bold hover:underline">Export CSV</button>
          </div>
        </div>
      </section>

      <!-- ===== Tab: Absensi ===== -->
      <section id="tab-absensi" class="tab-panel hidden space-y-4">
        <div class="card-base p-4 flex flex-col sm:flex-row gap-2 items-stretch sm:items-center">
          <input id="att-date" type="date" class="p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue transition-colors" />
          <button id="att-all-present" class="text-sm font-semibold text-emerald-600 dark:text-emerald-400 border border-emerald-500/40 hover:bg-emerald-500/10 rounded-lg px-4 py-3 transition-colors">Tandai Semua Hadir</button>
        </div>
        <div class="card-base overflow-hidden">
          <ul id="att-list" class="divide-y divide-matte-100 dark:divide-surface-border"></ul>
          <div class="p-3 bg-matte-100 dark:bg-surface-hover border-t border-matte-200 dark:border-surface-border text-xs text-matte-400" id="att-summary">—</div>
        </div>
      </section>

      <!-- ===== Tab: Cuti ===== -->
      <section id="tab-cuti" class="tab-panel hidden space-y-4">
        <div class="card-base p-4 md:p-5">
          <h3 class="font-bold text-matte-900 dark:text-white mb-3">Ajukan Cuti / Izin</h3>
          <form id="leave-form" class="grid grid-cols-2 md:grid-cols-3 gap-3">
            <select id="leave-emp" required class="p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue"></select>
            <select id="leave-type" class="p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue">
              <option value="Tahunan">Cuti Tahunan</option>
              <option value="Sakit">Sakit</option>
              <option value="Melahirkan">Melahirkan</option>
              <option value="Izin">Izin Lainnya</option>
            </select>
            <div></div>
            <input id="leave-start" type="date" required class="p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
            <input id="leave-end" type="date" required class="p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
            <div></div>
            <input id="leave-reason" type="text" placeholder="Alasan (opsional)" class="col-span-2 md:col-span-2 p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
            <button type="submit" class="bg-matte-900 dark:bg-white text-white dark:text-matte-900 font-semibold py-3 rounded-lg transition-all active:scale-95">Ajukan</button>
          </form>
        </div>
        <div class="card-base overflow-hidden">
          <ul id="leave-list" class="divide-y divide-matte-100 dark:divide-surface-border"></ul>
        </div>
      </section>

      <!-- ===== Tab: Rekrutmen ===== -->
      <section id="tab-rekrutmen" class="tab-panel hidden space-y-4">
        <div class="card-base p-4 md:p-5">
          <h3 class="font-bold text-matte-900 dark:text-white mb-3">Tambah Pelamar</h3>
          <form id="cand-form" class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <input id="cand-name" type="text" required placeholder="Nama pelamar *" class="p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
            <input id="cand-position" type="text" placeholder="Posisi dilamar" class="p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
            <input id="cand-contact" type="text" placeholder="Kontak (WA/email)" class="p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
            <input id="cand-note" type="text" placeholder="Catatan" class="p-3 rounded-lg bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border outline-none focus:border-accent-blue" />
            <button type="submit" class="col-span-2 md:col-span-4 bg-matte-900 dark:bg-white text-white dark:text-matte-900 font-semibold py-3 rounded-lg transition-all active:scale-95">Tambah ke Pipeline</button>
          </form>
        </div>
        <div class="flex items-center justify-between px-1">
          <h3 class="font-bold text-matte-900 dark:text-white">Pipeline Rekrutmen</h3>
