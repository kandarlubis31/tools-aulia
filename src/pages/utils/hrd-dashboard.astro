  function handleLeaveSubmit(e: Event) {
    e.preventDefault();
    const empId = +(($('leave-emp') as HTMLSelectElement).value);
    if (!empId) { toast('Pilih karyawan dulu'); return; }
    const start = ($('leave-start') as HTMLInputElement).value;
    const end = ($('leave-end') as HTMLInputElement).value;
    if (start && end && end < start) { toast('Tanggal selesai < tanggal mulai'); return; }
    data.leaves.push({
      id: Date.now(), empId,
      type: ($('leave-type') as HTMLSelectElement).value,
      start, end,
      reason: ($('leave-reason') as HTMLInputElement).value.trim(),
      status: 'menunggu',
    });
    save();
    ($('leave-form') as HTMLFormElement).reset();
    renderAll(); toast('Pengajuan tersimpan');
  }

