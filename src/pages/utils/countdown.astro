---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="Countdown Multi — Hitung Mundur Event | ToolsAulia" description="Beberapa countdown sekaligus, simpan di localStorage. 100% client-side." category="Utils" toolHref="/utils/countdown">
  <ToolPageHeader title="Countdown Multi" description="Banyak countdown sekaligus — event, deadline, ulang tahun" icon='<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="flex gap-2">
      <input id="ev-name" type="text" class="input-field flex-1 text-sm" placeholder="Nama event...">
      <input id="ev-date" type="datetime-local" class="input-field text-sm w-48">
      <button id="add-ev" class="btn-primary text-sm">Tambah</button>
    </div>

    <div id="events" class="space-y-2"></div>
    <p id="empty" class="text-sm text-matte-400 text-center">Belum ada countdown. Tambah event di atas.</p>
  </div>
</BaseLayout>

<script>
  const KEY = 'countdown_multi';
  let events = JSON.parse(localStorage.getItem(KEY) || '[]');

  function save() { localStorage.setItem(KEY, JSON.stringify(events)); }

  function render() {
    const container = document.getElementById('events');
    const empty = document.getElementById('empty');
    if (!events.length) { container.innerHTML = ''; empty.classList.remove('hidden'); return; }
    empty.classList.add('hidden');
    container.innerHTML = events.map((ev,i) => {
      const now = Date.now();
      const target = new Date(ev.date).getTime();
      const diff = target - now;
      let text = '';
      if (diff <= 0) text = '<span class="text-green-500 font-bold">🎉 SUDAH TIBA!</span>';
      else {
        const d = Math.floor(diff/86400000);
        const h = Math.floor((diff%86400000)/3600000);
        const m = Math.floor((diff%3600000)/60000);
        const s = Math.floor((diff%60000)/1000);
        text = (d>0?d+'h ':'') + String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
      }
      return '<div class="card-base p-3 flex justify-between items-center">'+
        '<div><p class="font-medium text-sm">'+esc(ev.name)+'</p><p class="text-xs text-matte-400">'+new Date(ev.date).toLocaleString('id-ID')+'</p></div>'+
        '<div class="flex items-center gap-2"><span class="font-mono font-bold text-lg">'+text+'</span>'+
        '<button data-idx="'+i+'" class="text-red-400 hover:text-red-600 del-ev">✕</button></div></div>';
    }).join('');
    container.querySelectorAll('.del-ev').forEach(b => b.addEventListener('click', function() {
      events.splice(parseInt(this.dataset.idx), 1); save(); render();
    }));
  }

  document.getElementById('add-ev').addEventListener('click', () => {
    const name = document.getElementById('ev-name').value.trim();
    const date = document.getElementById('ev-date').value;
    if (!name || !date) { showToast?.(_tToast?.('Isi nama & tanggal', 'Fill name & date'), 'error'); return; }
    events.push({ name, date });
    save(); render();
    document.getElementById('ev-name').value = '';
    showToast?.(_tToast?.('Countdown ditambah!', 'Countdown added!'), 'success');
  });

  setInterval(render, 1000);
  render();

  function esc(s) { return String(s).replace(/</g,'&lt;'); }
</script>
