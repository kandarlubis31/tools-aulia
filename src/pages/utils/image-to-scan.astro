---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Image to Scanner">
  <div class="max-w-6xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Image to Scanner"
      titleKey="tool.image_to_scan"
      descKey="tool.image_to_scan_desc"
      desc="Ubah gambar menjadi hasil scan dokumen — grayscale, kontras tinggi, noise, dan efek scanner lainnya."
      icon='<rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line>'
      gradient="from-emerald-500 to-teal-600"
    />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fade-in pb-20">

      <!-- LEFT: Controls -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Upload Area -->
        <div class="card-base p-6">
          <div id="drop-zone" class="border-2 border-dashed border-matte-200 dark:border-surface-border rounded-xl p-8 text-center cursor-pointer transition-all hover:border-accent-blue hover:bg-matte-50 dark:hover:bg-surface-hover">
            <input type="file" id="file-input" accept="image/*" class="hidden" />
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-3 text-matte-300 dark:text-matte-500">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <p class="text-matte-500 dark:text-matte-300 font-medium mb-1" data-i18n="scan.drop_title">Seret & lepas gambar di sini</p>
            <p class="text-sm text-matte-400 dark:text-matte-500" data-i18n="scan.drop_sub">atau klik untuk memilih file · bisa juga tempel Ctrl+V</p>
          </div>

          <!-- Original Preview -->
          <div id="original-preview" class="hidden mt-4">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-semibold text-matte-700 dark:text-white" data-i18n="scan.original_label">Gambar Asli</span>
              <button id="clear-btn" class="text-xs text-red-400 hover:text-red-600 font-medium transition-colors" data-i18n="scan.remove">Hapus</button>
            </div>
            <div class="relative rounded-xl overflow-hidden bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border">
              <img id="original-img" class="w-full h-auto max-h-80 object-contain" alt="Original" />
            </div>
          </div>
        </div>

        <!-- Scanner Settings -->
        <div class="card-base p-6">
          <h3 class="text-sm font-semibold text-matte-700 dark:text-white mb-4" data-i18n="scan.settings">Pengaturan Scanner</h3>

          <!-- Mode Preset -->
          <div class="mb-5">
            <label class="block text-sm font-semibold text-matte-700 dark:text-white mb-2" data-i18n="scan.mode">Mode Scan</label>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
              <button class="scan-mode-btn active" data-mode="document" data-i18n="scan.mode_document">Dokumen</button>
              <button class="scan-mode-btn" data-mode="photo" data-i18n="scan.mode_photo">Foto Hitam Putih</button>
              <button class="scan-mode-btn" data-mode="receipt" data-i18n="scan.mode_receipt">Struk / Bon</button>
              <button class="scan-mode-btn" data-mode="sketch" data-i18n="scan.mode_sketch">Sketsa / Drawing</button>
            </div>
          </div>

          <!-- Auto Enhance -->
          <div class="flex items-center gap-3 mb-5">
            <label class="relative inline-flex items-center cursor-pointer shrink-0">
              <input type="checkbox" id="auto-enhance" class="sr-only peer" checked />
              <div class="w-10 h-5 bg-matte-200 dark:bg-surface-border peer-focus:ring-2 peer-focus:ring-emerald-400 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
            </label>
            <span class="text-sm font-semibold text-matte-700 dark:text-white" data-i18n="scan.auto_enhance">✨ Auto Enhance</span>
            <span class="text-xs text-matte-400 hidden sm:inline" data-i18n="scan.auto_hint">— normalisasi kontras otomatis (auto-levels)</span>
          </div>

          <!-- Brightness -->
          <div class="mb-4">
            <label class="flex justify-between text-sm font-semibold text-matte-700 dark:text-white mb-1">
              <span data-i18n="scan.brightness">Kecerahan</span>
              <span id="brightness-val" class="font-mono font-bold text-accent-blue">0</span>
            </label>
            <input type="range" id="brightness" min="-100" max="100" value="0" class="w-full h-2 bg-matte-200 dark:bg-surface-border rounded-lg appearance-none cursor-pointer accent-matte-500" />
          </div>

          <!-- Contrast -->
          <div class="mb-4">
            <label class="flex justify-between text-sm font-semibold text-matte-700 dark:text-white mb-1">
              <span data-i18n="scan.contrast">Kontras</span>
              <span id="contrast-val" class="font-mono font-bold text-accent-blue">30</span>
            </label>
            <input type="range" id="contrast" min="-100" max="100" value="30" class="w-full h-2 bg-matte-200 dark:bg-surface-border rounded-lg appearance-none cursor-pointer accent-matte-500" />
          </div>

          <!-- Sharpness -->
          <div class="mb-4">
            <label class="flex justify-between text-sm font-semibold text-matte-700 dark:text-white mb-1">
              <span data-i18n="scan.sharpness">Ketajaman</span>
              <span id="sharpness-val" class="font-mono font-bold text-accent-blue">20</span>
            </label>
            <input type="range" id="sharpness" min="0" max="100" value="20" class="w-full h-2 bg-matte-200 dark:bg-surface-border rounded-lg appearance-none cursor-pointer accent-matte-500" />
          </div>

          <!-- Noise Amount -->
          <div class="mb-4">
            <label class="flex justify-between text-sm font-semibold text-matte-700 dark:text-white mb-1">
              <span data-i18n="scan.noise">Noise / Grain</span>
              <span id="noise-val" class="font-mono font-bold text-accent-blue">15</span>
            </label>
            <input type="range" id="noise" min="0" max="80" value="15" class="w-full h-2 bg-matte-200 dark:bg-surface-border rounded-lg appearance-none cursor-pointer accent-matte-500" />
          </div>

          <!-- Vignette -->
          <div class="mb-4">
            <label class="flex justify-between text-sm font-semibold text-matte-700 dark:text-white mb-1">
              <span data-i18n="scan.vignette">Vignette (Gelap di Tepi)</span>
              <span id="vignette-val" class="font-mono font-bold text-accent-blue">30</span>
            </label>
            <input type="range" id="vignette" min="0" max="100" value="30" class="w-full h-2 bg-matte-200 dark:bg-surface-border rounded-lg appearance-none cursor-pointer accent-matte-500" />
          </div>

          <!-- Threshold -->
          <div class="mb-4">
            <label class="flex justify-between text-sm font-semibold text-matte-700 dark:text-white mb-1">
              <span data-i18n="scan.threshold">Threshold (Biner)</span>
              <span id="threshold-val" class="font-mono font-bold text-accent-blue">0</span>
            </label>
            <input type="range" id="threshold" min="0" max="255" value="0" class="w-full h-2 bg-matte-200 dark:bg-surface-border rounded-lg appearance-none cursor-pointer accent-matte-500" />
            <p class="mt-1 text-[10px] text-matte-400" data-i18n="scan.threshold_hint">0 = mati, aktifkan untuk efek dokumen hitam-putih murni.</p>
          </div>

          <!-- Invert -->
          <div class="flex items-center gap-3 mb-4">
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="invert" class="sr-only peer" />
              <div class="w-10 h-5 bg-matte-200 dark:bg-surface-border peer-focus:ring-2 peer-focus:ring-accent-blue rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-accent-blue"></div>
            </label>
            <span class="text-sm font-semibold text-matte-700 dark:text-white" data-i18n="scan.invert">Invert Warna</span>
          </div>

          <!-- Rotate -->
          <div class="mb-1">
            <label class="block text-sm font-semibold text-matte-700 dark:text-white mb-2" data-i18n="scan.rotation">Rotasi</label>
            <div class="grid grid-cols-4 gap-2">
              <button class="rotate-btn active" data-deg="0">0°</button>
              <button class="rotate-btn" data-deg="90">90°</button>
              <button class="rotate-btn" data-deg="180">180°</button>
              <button class="rotate-btn" data-deg="270">270°</button>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Preview + Actions -->
      <div class="space-y-6">
        <!-- Scanned Preview -->
        <div class="card-base p-6">
          <h3 class="text-sm font-semibold text-matte-700 dark:text-white mb-4" data-i18n="scan.result">Hasil Scan</h3>
          <div class="flex flex-col items-center justify-center bg-matte-100 dark:bg-surface-hover p-4 rounded-xl">
            <div id="scan-preview-container" class="bg-white p-2 rounded-xl shadow-lg transition-transform hover:scale-[1.02] duration-300 w-full flex items-center justify-center min-h-[200px] relative overflow-hidden">
              <p id="scan-placeholder" class="text-sm text-matte-400 font-medium" data-i18n="scan.placeholder">Upload gambar dulu bosku</p>
              <div id="canvas-stack" class="relative hidden">
                <canvas id="scan-canvas" class="block max-w-full h-auto"></canvas>
                <!-- Overlay asli (rotasi saja) untuk slider bandingkan — clip-path dikontrol JS -->
                <canvas id="compare-canvas" class="hidden absolute inset-0 w-full h-full pointer-events-none"></canvas>
                <!-- Spinner proses berat -->
                <div id="scan-spinner" class="hidden absolute inset-0 flex items-center justify-center bg-white/70 backdrop-blur-sm">
                  <svg class="animate-spin w-7 h-7 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/></svg>
                </div>
              </div>
            </div>
            <p class="mt-3 text-sm text-matte-400 font-medium" data-i18n="scan.preview_hint">Preview Hasil Scan</p>
            <div id="compare-row" class="hidden w-full mt-1">
              <input type="range" id="compare-range" min="0" max="100" value="0" class="w-full h-1.5 bg-matte-200 dark:bg-surface-border rounded-lg appearance-none cursor-pointer accent-emerald-500" aria-label="Bandingkan asli dan hasil" />
              <div class="flex justify-between text-[10px] text-matte-400 mt-0.5">
                <span data-i18n="scan.compare_left">Hasil</span>
                <span data-i18n="scan.compare_right">Asli</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="card-base p-6">
          <h3 class="text-sm font-semibold text-matte-700 dark:text-white mb-4" data-i18n="scan.actions">Aksi</h3>
          <div class="space-y-3">
            <div class="grid grid-cols-2 gap-3">
              <button id="download-png-btn" class="action-btn" disabled>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>PNG</span>
              </button>
              <button id="download-jpg-btn" class="action-btn" disabled>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>JPG</span>
              </button>
            </div>

            <button id="copy-btn" class="action-btn w-full" disabled>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span data-i18n="scan.copy_clipboard">Salin ke Clipboard</span>
            </button>

            <button id="share-btn" class="action-btn w-full" disabled>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
              <span data-i18n="scan.share">Bagikan</span>
            </button>
          </div>
        </div>

        <!-- PDF Document (multi-page) -->
        <div class="card-base p-6">
          <div class="flex items-center justify-between mb-3 gap-2">
            <h3 class="text-sm font-semibold text-matte-700 dark:text-white" data-i18n="scan.pdf_doc">📄 Dokumen PDF</h3>
            <span id="pages-info" class="text-2xs text-matte-400"></span>
          </div>
          <div class="space-y-3">
            <div id="pages-container" class="grid grid-cols-3 gap-2 max-h-44 overflow-y-auto pr-1 custom-scrollbar">
              <p class="col-span-full text-sm text-matte-400 text-center py-4" data-i18n="scan.pdf_empty">Belum ada halaman. Scan lalu klik "Tambah".</p>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <button id="pdf-add-btn" class="action-btn !py-2 text-sm" disabled data-i18n="scan.pdf_add">➕ Tambah ke PDF</button>
              <button id="pdf-download-btn" class="action-btn !py-2 text-sm" disabled>⬇️ PDF</button>
            </div>
            <div class="flex items-center justify-between">
              <button id="pdf-clear-btn" class="text-xs text-matte-400 hover:text-red-500 transition-colors font-medium" disabled data-i18n="scan.pdf_clear">Kosongkan</button>
              <span class="text-[10px] text-matte-400" data-i18n="scan.pdf_note">Halaman hanya tersimpan selama sesi ini.</span>
            </div>
          </div>
        </div>

        <!-- History -->
        <div class="card-base p-6">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-sm font-semibold text-matte-700 dark:text-white" data-i18n="scan.history">Riwayat</h3>
            <button id="clear-history-btn" class="text-xs text-matte-400 hover:text-red-500 transition-colors font-medium" data-i18n="scan.clear_all">Hapus Semua</button>
          </div>
          <div id="history-container" class="space-y-2 max-h-60 overflow-y-auto pr-2 custom-scrollbar">
            <p class="text-sm text-matte-400 text-center py-4" data-i18n="scan.empty_history">Belum ada riwayat</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .scan-mode-btn, .rotate-btn {
    @apply px-3 py-2 rounded-lg font-medium text-sm transition-all;
    @apply bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300 hover:bg-matte-200 dark:hover:bg-surface-hover border border-transparent;
  }
  .scan-mode-btn.active, .rotate-btn.active {
    @apply bg-matte-900 dark:bg-white text-white dark:text-matte-900 shadow-md;
  }
  .action-btn {
    @apply bg-matte-900 dark:bg-white text-white dark:text-matte-900 font-semibold py-2.5 px-4 rounded-lg hover:opacity-90 transition-all active:scale-95 flex items-center justify-center gap-2;
  }
  .action-btn:disabled {
    @apply opacity-40 cursor-not-allowed;
  }
  .action-btn:disabled:hover {
    @apply opacity-40;
  }
  #drop-zone.dragover {
    @apply border-accent-blue bg-accent-blue/5;
  }
  .history-item {
    @apply flex items-center justify-between p-3 rounded-lg bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border hover:bg-matte-200 dark:hover:bg-surface-elevated transition-colors cursor-pointer;
  }
</style>

<script>
  import { useLocalHistory } from '../../composables/useLocalHistory';

  const __page = (location.pathname.replace(/\/+$/, '') || '/');

  // Cap resolusi proses — dokumen scan tidak butuh >2200px; jaga CPU & memori.
  const MAX_DIM = 2200;
  const THUMB_DIM = 400;

  interface ScanParams {
    brightness: number; contrast: number; sharpness: number;
    noiseAmt: number; vignetteAmt: number; threshold: number;
    invert: boolean; auto: boolean;
  }

  let currentImage: HTMLImageElement | null = null;
  let currentRotation = 0;
  let currentMode = 'document';

  const presets: Record<string, Omit<ScanParams, 'auto'>> = {
    document: { contrast: 30, brightness: 0, sharpness: 20, noiseAmt: 15, vignetteAmt: 30, threshold: 0, invert: false },
    photo:    { contrast: 20, brightness: 5, sharpness: 10, noiseAmt: 10, vignetteAmt: 20, threshold: 0, invert: false },
    receipt:  { contrast: 50, brightness: 10, sharpness: 30, noiseAmt: 20, vignetteAmt: 15, threshold: 0, invert: false },
    sketch:   { contrast: 60, brightness: 15, sharpness: 40, noiseAmt: 5,  vignetteAmt: 10, threshold: 120, invert: false },
  };

  // FIX double-init: init() TIDAK dipanggil manual lagi — astro:page-load juga fire
  // saat load pertama, jadi init cukup sekali per kunjungan (dulu listener dobel).
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;
    init();
  });

  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // Grain stabil: noise deterministik dari indeks pixel (bukan Math.random per render,
  // supaya grain tidak "menari" tiap geser slider).
  function hashNoise(i: number): number {
    const s = Math.sin(i * 12.9898) * 43758.5453;
    return (s - Math.floor(s)) * 2 - 1; // [-1, 1]
  }

  function makeThumbDataUrl(src: HTMLCanvasElement, maxDim: number): string {
    const scale = Math.min(1, maxDim / Math.max(src.width, src.height));
    const c = document.createElement('canvas');
    c.width = Math.max(1, Math.round(src.width * scale));
    c.height = Math.max(1, Math.round(src.height * scale));
    c.getContext('2d')!.drawImage(src, 0, 0, c.width, c.height);
    return c.toDataURL('image/jpeg', 0.72);
  }

  // Render gambar (rotasi + cap resolusi) ke canvas target, background putih.
  function renderTo(target: HTMLCanvasElement, img: HTMLImageElement, rotDeg: number): void {
    const swap = rotDeg === 90 || rotDeg === 270;
    const natW = img.naturalWidth, natH = img.naturalHeight;
    const scale = Math.min(1, MAX_DIM / Math.max(natW, natH));
    const w = Math.max(1, Math.round((swap ? natH : natW) * scale));
    const h = Math.max(1, Math.round((swap ? natW : natH) * scale));
    target.width = w;
    target.height = h;
    const ctx = target.getContext('2d', { willReadFrequently: true })!;
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, w, h);
    ctx.save();
    ctx.translate(w / 2, h / 2);
    ctx.rotate((rotDeg * Math.PI) / 180);
    ctx.scale(scale, scale);
    ctx.drawImage(img, -natW / 2, -natH / 2);
    ctx.restore();
  }

  // Semua efek pixel digabung dalam satu pass utama (grayscale → auto-levels →
  // brightness/kontras → threshold → noise) — jauh lebih cepat daripada loop terpisah.
  function applyEffects(ctx: CanvasRenderingContext2D, w: number, h: number, p: ScanParams): void {
    const imageData = ctx.getImageData(0, 0, w, h);
    const d = imageData.data;

    // Auto-levels: cari persentil 2% & 98% luminance untuk normalisasi kontras.
    let lo = 0, hi = 255;
    if (p.auto) {
      const hist = new Uint32Array(256);
      for (let i = 0; i < d.length; i += 4) {
        hist[((d[i] * 299 + d[i + 1] * 587 + d[i + 2] * 114) / 1000) | 0]++;
      }
      const total = w * h;
      let acc = 0;
      for (let v = 0; v < 256; v++) { acc += hist[v]; if (acc >= total * 0.02) { lo = v; break; } }
      acc = 0;
      for (let v = 255; v >= 0; v--) { acc += hist[v]; if (acc >= total * 0.02) { hi = v; break; } }
      if (hi - lo < 24) { lo = 0; hi = 255; } // gambar flat — jangan distretch
    }
    const stretch = p.auto && hi > lo;
    const range = Math.max(1, hi - lo);

    const bFactor = p.brightness * 2.55;
    const cFactor = (259 * (p.contrast + 255)) / (255 * (259 - p.contrast));
    const noiseScale = p.noiseAmt * 2.5;

    // Pass A: grayscale (in place)
    for (let i = 0; i < d.length; i += 4) {
      const gray = d[i] * 0.299 + d[i + 1] * 0.587 + d[i + 2] * 0.114;
      d[i] = gray; d[i + 1] = gray; d[i + 2] = gray;
    }

    // Pass B merged: stretch → brightness/kontras → threshold → noise
    for (let i = 0; i < d.length; i += 4) {
      let v = d[i];
      if (stretch) v = ((v - lo) * 255) / range;
      v = cFactor * (v + bFactor - 128) + 128;
      if (p.threshold > 0) v = v >= p.threshold ? 255 : 0;
      if (p.noiseAmt > 0) v += hashNoise(i / 4) * noiseScale;
      const out = v < 0 ? 0 : v > 255 ? 255 : v;
      d[i] = out; d[i + 1] = out; d[i + 2] = out;
    }

    ctx.putImageData(imageData, 0, 0);

    // Vignette overlay
    if (p.vignetteAmt > 0) {
      const vigStrength = p.vignetteAmt / 100;
      const gradient = ctx.createRadialGradient(w / 2, h / 2, Math.min(w, h) * 0.2, w / 2, h / 2, Math.max(w, h) * 0.7);
      gradient.addColorStop(0, 'rgba(0,0,0,0)');
      gradient.addColorStop(1, `rgba(0,0,0,${vigStrength * 0.6})`);
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, w, h);
    }

    // Invert
    if (p.invert) {
      const invData = ctx.getImageData(0, 0, w, h);
      const dd = invData.data;
      for (let i = 0; i < dd.length; i += 4) {
        dd[i] = 255 - dd[i];
        dd[i + 1] = 255 - dd[i + 1];
        dd[i + 2] = 255 - dd[i + 2];
      }
      ctx.putImageData(invData, 0, 0);
    }

    // Sharpen (unsharp mask approximation)
    if (p.sharpness > 0) {
      const strength = p.sharpness / 100;
      const srcData = ctx.getImageData(0, 0, w, h);
      const src = srcData.data;
      const dst = new Uint8ClampedArray(src);
      for (let y = 1; y < h - 1; y++) {
        for (let x = 1; x < w - 1; x++) {
          const idx = (y * w + x) * 4;
          for (let c = 0; c < 3; c++) {
            const center = src[idx + c] * 5;
            const neighbors =
              src[((y - 1) * w + x) * 4 + c] +
              src[((y + 1) * w + x) * 4 + c] +
              src[(y * w + x - 1) * 4 + c] +
              src[(y * w + x + 1) * 4 + c];
            dst[idx + c] = Math.max(0, Math.min(255, src[idx + c] + (center - neighbors) * strength));
          }
        }
      }
      ctx.putImageData(new ImageData(dst, w, h), 0, 0);
    }
  }

  function init() {
    const dropZone = document.getElementById('drop-zone') as HTMLDivElement;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const originalPreview = document.getElementById('original-preview') as HTMLDivElement;
    const originalImg = document.getElementById('original-img') as HTMLImageElement;
    const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
    const canvasStack = document.getElementById('canvas-stack') as HTMLDivElement;
    const canvas = document.getElementById('scan-canvas') as HTMLCanvasElement;
    const compareCanvas = document.getElementById('compare-canvas') as HTMLCanvasElement;
    const scanPlaceholder = document.getElementById('scan-placeholder') as HTMLParagraphElement;
    const spinner = document.getElementById('scan-spinner') as HTMLDivElement;
    const compareRow = document.getElementById('compare-row') as HTMLDivElement;
    const compareRange = document.getElementById('compare-range') as HTMLInputElement;
    const autoEnhanceToggle = document.getElementById('auto-enhance') as HTMLInputElement;
    const pdfAddBtn = document.getElementById('pdf-add-btn') as HTMLButtonElement;
    const pdfDownloadBtn = document.getElementById('pdf-download-btn') as HTMLButtonElement;
    const pdfClearBtn = document.getElementById('pdf-clear-btn') as HTMLButtonElement;
    const pagesContainer = document.getElementById('pages-container') as HTMLDivElement;
    const pagesInfo = document.getElementById('pages-info') as HTMLSpanElement;
    const downloadPngBtn = document.getElementById('download-png-btn') as HTMLButtonElement;
    const downloadJpgBtn = document.getElementById('download-jpg-btn') as HTMLButtonElement;
    const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
    const shareBtn = document.getElementById('share-btn') as HTMLButtonElement;
    const clearHistoryBtn = document.getElementById('clear-history-btn') as HTMLButtonElement;
    const historyContainer = document.getElementById('history-container') as HTMLDivElement;

    const brightnessSlider = document.getElementById('brightness') as HTMLInputElement;
    const contrastSlider = document.getElementById('contrast') as HTMLInputElement;
    const sharpnessSlider = document.getElementById('sharpness') as HTMLInputElement;
    const noiseSlider = document.getElementById('noise') as HTMLInputElement;
    const vignetteSlider = document.getElementById('vignette') as HTMLInputElement;
    const thresholdSlider = document.getElementById('threshold') as HTMLInputElement;
    const invertToggle = document.getElementById('invert') as HTMLInputElement;

    const brightnessVal = document.getElementById('brightness-val') as HTMLSpanElement;
    const contrastVal = document.getElementById('contrast-val') as HTMLSpanElement;
    const sharpnessVal = document.getElementById('sharpness-val') as HTMLSpanElement;
    const noiseVal = document.getElementById('noise-val') as HTMLSpanElement;
    const vignetteVal = document.getElementById('vignette-val') as HTMLSpanElement;
    const thresholdVal = document.getElementById('threshold-val') as HTMLSpanElement;

    const exportBtns = [downloadPngBtn, downloadJpgBtn, copyBtn, shareBtn];

    const scanHistoryManager = useLocalHistory('scanHistory', 10);
    let scanHistory = scanHistoryManager.getAll();

    // Halaman PDF hanya di memori sesi ini (dataUrl JPEG besar — tidak layak localStorage).
    type PdfPage = { dataUrl: string; thumb: string };
    let pdfPages: PdfPage[] = [];

    function getParams(): ScanParams {
      return {
        brightness: parseInt(brightnessSlider.value),
        contrast: parseInt(contrastSlider.value),
        sharpness: parseInt(sharpnessSlider.value),
        noiseAmt: parseInt(noiseSlider.value),
        vignetteAmt: parseInt(vignetteSlider.value),
        threshold: parseInt(thresholdSlider.value),
        invert: invertToggle.checked,
        auto: autoEnhanceToggle.checked,
      };
    }

    // ---- Compare slider (asli vs hasil) ----
    function updateCompareClip() {
      const v = parseInt(compareRange.value);
      if (!currentImage || v <= 0) {
        compareCanvas.classList.add('hidden');
        return;
      }
      compareCanvas.classList.remove('hidden');
      compareCanvas.style.clipPath = `inset(0 ${100 - v}% 0 0)`; // tampilkan asli dari kiri
    }
    compareRange.addEventListener('input', updateCompareClip);

    // ---- Processing pipeline ----
    function processScan() {
      if (!currentImage) return;
      renderTo(canvas, currentImage, currentRotation);
      applyEffects(canvas.getContext('2d', { willReadFrequently: true })!, canvas.width, canvas.height, getParams());
      // Overlay "asli" untuk compare — rotasi saja, tanpa efek
      renderTo(compareCanvas, currentImage, currentRotation);
      updateCompareClip();
      scanPlaceholder.classList.add('hidden');
      canvasStack.classList.remove('hidden');
      compareRow.classList.remove('hidden');
    }

    let processTimer: ReturnType<typeof setTimeout> | null = null;

    function scheduleProcess() {
      updateLabels();
      if (processTimer) clearTimeout(processTimer);
      processTimer = setTimeout(runProcess, 80);
    }

    function runProcess() {
      if (!currentImage) return;
      const megapixels = (currentImage.naturalWidth * currentImage.naturalHeight) / 1e6;
      if (megapixels > 1.5) {
        spinner.classList.remove('hidden');
        setTimeout(() => {
          try { processScan(); } finally { spinner.classList.add('hidden'); }
        }, 30); // beri kesempatan browser melukis spinner sebelum kerja berat
      } else {
        processScan();
      }
    }

    // ---- File input ----
    function loadImage(file: File) {
      const reader = new FileReader();
      reader.onload = () => {
        const img = new Image();
        img.onload = () => {
          currentImage = img;
          originalImg.src = reader.result as string;
          originalPreview.classList.remove('hidden');
          exportBtns.forEach(b => (b as HTMLButtonElement).disabled = false);
          pdfAddBtn.disabled = false;
          compareRange.value = '0';
          runProcess();
        };
        img.src = reader.result as string;
      };
      reader.readAsDataURL(file);
    }

    // Paste dari clipboard (Ctrl+V) — handler module-level sekali bind saja.
    if (!(window as any).__itsPasteBound) {
      (window as any).__itsPasteBound = true;
      document.addEventListener('paste', (e) => {
        if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;
        const items = e.clipboardData?.items;
        if (!items) return;
        for (const item of items) {
          if (item.type.startsWith('image/')) {
            const file = item.getAsFile();
            if (file && (window as any).__itsLoadImage) {
              e.preventDefault();
              (window as any).__itsLoadImage(file);
            }
            break;
          }
        }
      });
    }
    (window as any).__itsLoadImage = loadImage;

    dropZone.addEventListener('click', () => fileInput.click());

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('dragover');
    });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('dragover');
      const file = e.dataTransfer?.files?.[0];
      if (file && file.type.startsWith('image/')) loadImage(file);
    });

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) loadImage(file);
    });

    clearBtn.addEventListener('click', () => {
      currentImage = null;
      fileInput.value = '';
      originalPreview.classList.add('hidden');
      canvasStack.classList.add('hidden');
      scanPlaceholder.classList.remove('hidden');
      compareRow.classList.add('hidden');
      exportBtns.forEach(b => (b as HTMLButtonElement).disabled = true);
      pdfAddBtn.disabled = true;
    });

    // ---- Mode presets ----
    document.querySelectorAll('.scan-mode-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.scan-mode-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentMode = (btn as HTMLElement).dataset.mode || 'document';
        const p = presets[currentMode];
        brightnessSlider.value = String(p.brightness);
        contrastSlider.value = String(p.contrast);
        sharpnessSlider.value = String(p.sharpness);
        noiseSlider.value = String(p.noiseAmt);
        vignetteSlider.value = String(p.vignetteAmt);
        thresholdSlider.value = String(p.threshold);
        invertToggle.checked = p.invert;
        scheduleProcess();
      });
    });

    // ---- Rotation ----
    document.querySelectorAll('.rotate-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.rotate-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentRotation = parseInt((btn as HTMLElement).dataset.deg || '0');
        scheduleProcess();
      });
    });

    // ---- Sliders & toggles ----
    function updateLabels() {
      brightnessVal.textContent = brightnessSlider.value;
      contrastVal.textContent = contrastSlider.value;
      sharpnessVal.textContent = sharpnessSlider.value;
      noiseVal.textContent = noiseSlider.value;
      vignetteVal.textContent = vignetteSlider.value;
      thresholdVal.textContent = thresholdSlider.value;
    }

    [brightnessSlider, contrastSlider, sharpnessSlider, noiseSlider, vignetteSlider, thresholdSlider].forEach(el => {
      el.addEventListener('input', scheduleProcess);
    });
    invertToggle.addEventListener('change', scheduleProcess);
    autoEnhanceToggle.addEventListener('change', scheduleProcess);

    updateLabels();

    // ---- Export ----
    downloadPngBtn.addEventListener('click', () => {
      if (!currentImage) return;
      canvas.toBlob((blob) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.download = `scan-${Date.now()}.png`;
        link.href = url;
        link.click();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
        addToHistory('PNG');
        toast('Hasil scan diunduh sebagai PNG!');
      }, 'image/png');
    });

    downloadJpgBtn.addEventListener('click', () => {
      if (!currentImage) return;
      const tempCanvas = document.createElement('canvas');
      tempCanvas.width = canvas.width;
      tempCanvas.height = canvas.height;
      const tempCtx = tempCanvas.getContext('2d')!;
      tempCtx.fillStyle = '#ffffff';
      tempCtx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);
      tempCtx.drawImage(canvas, 0, 0);
      const url = tempCanvas.toDataURL('image/jpeg', 0.92);
      const link = document.createElement('a');
      link.download = `scan-${Date.now()}.jpg`;
      link.href = url;
      link.click();
      addToHistory('JPG');
      toast('Hasil scan diunduh sebagai JPG!');
    });

    copyBtn.addEventListener('click', async () => {
      if (!currentImage) return;
      try {
        const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/png'));
        if (blob) {
          await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
          toast('Hasil scan disalin ke clipboard!');
        }
      } catch {
        toast('Gagal menyalin ke clipboard', 'error');
      }
    });

    shareBtn.addEventListener('click', async () => {
      if (!currentImage) return;
      if (!navigator.share || !navigator.canShare) {
        toast('Browser tidak mendukung fitur berbagi', 'error');
        return;
      }
      try {
        const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/png'));
        if (!blob) return;
        const file = new File([blob], 'scan-result.png', { type: 'image/png' });
        if (!navigator.canShare({ files: [file] })) return;
        await navigator.share({ title: 'Hasil Scan', text: 'Lihat hasil scan saya', files: [file] });
      } catch {
        toast('Gagal membagikan', 'error');
      }
    });

    // ---- PDF multi-page ----
    function renderPages() {
      pagesInfo.textContent = pdfPages.length ? `${pdfPages.length} hal.` : '';
      pdfDownloadBtn.disabled = pdfPages.length === 0;
      pdfClearBtn.disabled = pdfPages.length === 0;
      if (!pdfPages.length) {
        pagesContainer.innerHTML = '<p class="col-span-full text-sm text-matte-400 text-center py-4" data-i18n="scan.pdf_empty">Belum ada halaman. Scan lalu klik "Tambah".</p>';
        if (window.i18n?.translateNode) window.i18n.translateNode(pagesContainer);
        return;
      }
      pagesContainer.innerHTML = pdfPages.map((p, i) => `
        <div class="relative group border border-matte-200 dark:border-surface-border rounded-lg overflow-hidden bg-white">
          <img src="${p.thumb}" alt="Halaman ${i + 1}" class="block w-full h-auto">
          <span class="absolute bottom-1 left-1 text-[10px] font-bold bg-black/60 text-white px-1.5 rounded">${i + 1}</span>
          <button class="page-remove absolute top-1 right-1 w-6 h-6 rounded-md bg-black/60 hover:bg-rose-600 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity" data-i="${i}" aria-label="Hapus halaman ${i + 1}">✕</button>
        </div>`).join('');

      pagesContainer.querySelectorAll('.page-remove').forEach(btn => {
        btn.addEventListener('click', () => {
          pdfPages.splice(parseInt((btn as HTMLElement).dataset.i || '0'), 1);
          renderPages();
        });
      });
    }

    pdfAddBtn.addEventListener('click', () => {
      if (!currentImage || !canvas.width) return;
      try {
        pdfPages.push({
          dataUrl: canvas.toDataURL('image/jpeg', 0.85),
          thumb: makeThumbDataUrl(canvas, 160),
        });
        renderPages();
        toast(`Halaman ${pdfPages.length} ditambahkan ke dokumen PDF!`);
      } catch {
        toast('Gagal menambahkan halaman', 'error');
      }
    });

    pdfClearBtn.addEventListener('click', () => {
      if (!pdfPages.length || !confirm('Kosongkan semua halaman PDF?')) return;
      pdfPages = [];
      renderPages();
      toast('Dokumen PDF dikosongkan!', 'success');
    });

    pdfDownloadBtn.addEventListener('click', async () => {
      if (!pdfPages.length) return;
      const origHtml = pdfDownloadBtn.innerHTML;
      pdfDownloadBtn.disabled = true;
      pdfDownloadBtn.innerHTML = '<span>⏳ Membuat…</span>';
      try {
        const { PDFDocument } = await import('pdf-lib');
        const doc = await PDFDocument.create();
        const PW = 595.28, PH = 841.89; // A4 portrait (pt)
        for (const p of pdfPages) {
          const bytes = await (await fetch(p.dataUrl)).arrayBuffer();
          const img = await doc.embedJpg(bytes);
          const page = doc.addPage([PW, PH]);
          const s = Math.min((PW - 48) / img.width, (PH - 48) / img.height);
          const dw = img.width * s, dh = img.height * s;
          page.drawImage(img, { x: (PW - dw) / 2, y: (PH - dh) / 2, width: dw, height: dh });
        }
        const out = await doc.save();
        const url = URL.createObjectURL(new Blob([out], { type: 'application/pdf' }));
        const link = document.createElement('a');
        link.download = `scan-document-${Date.now()}.pdf`;
        link.href = url;
        link.click();
        setTimeout(() => URL.revokeObjectURL(url), 1500);
        toast(`${pdfPages.length} halaman diekspor sebagai PDF!`);
      } catch {
        toast('Gagal membuat PDF', 'error');
      } finally {
        pdfDownloadBtn.innerHTML = origHtml;
        pdfDownloadBtn.disabled = pdfPages.length === 0;
      }
    });

    // ---- History (thumbnail kecil — hemat localStorage) ----
    function addToHistory(format: string) {
      const item = {
        id: Date.now(),
        mode: currentMode,
        format,
        date: new Date().toLocaleString('id-ID'),
        dataUrl: makeThumbDataUrl(canvas, THUMB_DIM),
      };
      try {
        scanHistory = scanHistoryManager.add(item);
      } catch {
        toast('Riwayat gagal disimpan — penyimpanan penuh', 'error');
        return;
      }
      renderHistory();
    }

    function renderHistory() {
      if (scanHistory.length === 0) {
        historyContainer.innerHTML = '<p class="text-sm text-matte-400 text-center py-4" data-i18n="scan.empty_history">Belum ada riwayat</p>';
        if (window.i18n?.translateNode) window.i18n.translateNode(historyContainer);
        return;
      }
      historyContainer.innerHTML = scanHistory.map(item => `
        <div class="history-item" data-id="${item.id}">
          <div class="flex items-center gap-3 min-w-0">
            <img src="${item.dataUrl}" alt="Scan" class="w-10 h-10 rounded border border-matte-200 dark:border-surface-border bg-white object-cover">
            <div class="min-w-0">
              <p class="text-sm font-medium text-matte-700 dark:text-white uppercase truncate">${item.mode} - ${item.format}</p>
              <p class="text-[10px] text-matte-400">${item.date}</p>
            </div>
          </div>
          <button class="text-matte-400 hover:text-accent-blue transition-colors p-1" title="Unduh">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          </button>
        </div>
      `).join('');

      historyContainer.querySelectorAll('.history-item button').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = parseInt(((btn.closest('.history-item') as HTMLElement).dataset.id || '0'));
          const item = scanHistory.find(h => h.id === id);
          if (item) {
            const link = document.createElement('a');
            link.download = `scan-${item.mode}-${item.id}.${item.format.toLowerCase()}`;
            link.href = item.dataUrl;
            link.click();
            toast('Hasil scan dari riwayat diunduh!');
          }
        });
      });
    }

    clearHistoryBtn.addEventListener('click', () => {
      scanHistory = [];
      scanHistoryManager.clear();
      renderHistory();
      toast('Riwayat dihapus!');
    });

    renderHistory();
    renderPages();
  }
</script>
