---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="File Joiner" description="Gabung kembali file chunks jadi satu file utuh. 100% client-side.">
  <ToolPageHeader title="File Joiner" desc="Gabung .part chunks jadi file utuh" icon='<path d="M12 5l7 7-7 7"/><path d="M5 12h14"/>' />

  <div class="card-base p-5 space-y-4">
    <div id="drop-zone" class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-8 text-center cursor-pointer hover:border-accent-blue transition-colors">
      <span data-i18n="label.drop_parts">📁 Drop file .part di sini (bisa multiple)</span>
      <input type="file" id="file-input" class="hidden" multiple>
    </div>

    <div id="file-list" class="hidden space-y-2"></div>
    <div id="file-summary" class="hidden text-xs text-matte-400 text-center"></div>
    <button id="join-btn" class="btn-primary w-full hidden" data-i18n="btn.join_download">Gabung & Download File Utuh</button>
  </div>
</BaseLayout>

<script>
  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const parts: { name: string; data: Uint8Array; size: number }[] = [];
  const fileList = document.getElementById('file-list')!;
  const fileSummary = document.getElementById('file-summary')!;
  const joinBtn = document.getElementById('join-btn') as HTMLButtonElement;
  const dz = document.getElementById('drop-zone')!;
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);
  function esc(s: unknown) { return String(s ?? '').replace(/</g, '&lt;'); }

  document.getElementById('file-input')!.addEventListener('change', function (this: HTMLInputElement) {
    handleFiles(Array.from(this.files || []));
    this.value = '';
  });
  dz.addEventListener('click', () => (document.getElementById('file-input') as HTMLInputElement).click());
  dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('border-accent-blue'); });
  dz.addEventListener('dragleave', () => dz.classList.remove('border-accent-blue'));
  dz.addEventListener('drop', e => { e.preventDefault(); dz.classList.remove('border-accent-blue'); handleFiles(Array.from((e as DragEvent).dataTransfer?.files || [])); });

  async function handleFiles(files: File[]) {
    if (!files.length) return;
    parts.length = 0;
    try {
      for (const f of files) {
        parts.push({ name: f.name, data: new Uint8Array(await f.arrayBuffer()), size: f.size });
      }
    } catch {
      toast('Gagal membaca file', 'error');
      return;
    }
    parts.sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));
    fileList.classList.remove('hidden');
    joinBtn.classList.remove('hidden');
    fileList.innerHTML = parts.map(p =>
      '<div class="flex justify-between text-sm p-2 rounded bg-matte-50 dark:bg-matte-800"><span>' + esc(p.name) + '</span><span class="text-matte-400">' + (p.size / 1024).toFixed(1) + ' KB</span></div>'
    ).join('');
    const total = parts.reduce((s, p) => s + p.size, 0);
    fileSummary.textContent = parts.length + ' file — total ' + (total / 1024).toFixed(1) + ' KB';
    fileSummary.classList.remove('hidden');
    if (!parts.some(p => /\.part\d+/i.test(p.name) || /\.\d{3}$/.test(p.name))) {
      toast('Nama file tidak berpola .part — urutan gabungan mungkin salah', 'info');
    }
  }

  joinBtn.addEventListener('click', () => {
    if (!parts.length) { toast('Tidak ada file untuk digabung', 'error'); return; }
    try {
      const totalLen = parts.reduce((s, p) => s + p.data.length, 0);
      const merged = new Uint8Array(totalLen);
      let offset = 0;
      parts.forEach(p => { merged.set(p.data, offset); offset += p.data.length; });
      const outName = parts[0].name.replace(/\.part\d+/i, '').replace(/\.\d{3}$/, '') || 'joined-file';
      const blob = new Blob([merged]);
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = outName; a.click();
      setTimeout(() => URL.revokeObjectURL(url), 2000);
      toast('File berhasil digabung!', 'success');
    } catch {
      toast('Gagal menggabung file', 'error');
    }
  });

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __fileJoinerPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __fileJoinerPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
