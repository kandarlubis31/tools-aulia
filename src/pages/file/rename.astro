---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="File Rename Batch — Rename Banyak File | ToolsAulia" description="Rename banyak file sekaligus dengan pola, prefix, suffix, dan numbering. 100% client-side." category="File" toolHref="/file/rename">
  <ToolPageHeader title="File Rename Batch" description="Rename banyak file: prefix, suffix, pola + download" icon='<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>' />

  <div class="card-base p-5 space-y-4">
    <div id="drop-zone" class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-8 text-center cursor-pointer hover:border-accent-blue transition-colors">
      <span>📁 Drop file di sini (multiple)</span>
      <input type="file" id="file-input" class="hidden" multiple>
    </div>

    <div id="controls" class="hidden space-y-3">
      <div class="flex flex-wrap gap-3 items-end">
        <div>
          <label class="text-xs text-matte-500 mb-1 block">Pola Nama</label>
          <input id="pattern" type="text" class="input-field text-sm w-48" placeholder="foto_" value="foto_">
        </div>
        <div>
          <label class="text-xs text-matte-500 mb-1 block">Counter Start</label>
          <input id="counter" type="number" min="0" value="1" class="input-field text-sm w-16">
        </div>
        <div>
          <label class="text-xs text-matte-500 mb-1 block">Padding (00x)</label>
          <input id="padding" type="number" min="0" max="10" value="3" class="input-field text-sm w-16">
        </div>
        <div>
          <label class="text-xs text-matte-500 mb-1 block">Suffix</label>
          <input id="suffix" type="text" class="input-field text-sm w-32" placeholder="_final" value="">
        </div>
      </div>

      <div class="max-h-64 overflow-y-auto space-y-1 text-sm" id="file-list"></div>
      <button id="download-all" class="btn-primary w-full">Download Semua (Renamed)</button>
    </div>
  </div>
</BaseLayout>

<script>
  const files = [];
  let extMap = {};

  document.getElementById('file-input').addEventListener('change', handle);
  const dz = document.getElementById('drop-zone');
  dz.addEventListener('click', () => document.getElementById('file-input').click());
  dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('border-accent-blue'); });
  dz.addEventListener('dragleave', () => dz.classList.remove('border-accent-blue'));
  dz.addEventListener('drop', e => { e.preventDefault(); dz.classList.remove('border-accent-blue'); handle({ target: { files: e.dataTransfer.files } }); });

  async function handle(e) {
    files.length = 0;
    for (const f of e.target.files) files.push({ name: f.name, ext: f.name.split('.').pop(), file: f, raw: await f.arrayBuffer() });
    render();
  }

  function render() {
    document.getElementById('controls').classList.remove('hidden');
    const pattern = document.getElementById('pattern').value;
    const counter = parseInt(document.getElementById('counter').value) || 1;
    const pad = parseInt(document.getElementById('padding').value) || 0;
    const suffix = document.getElementById('suffix').value;
    const list = document.getElementById('file-list');
    list.innerHTML = files.map((f,i) => {
      const newName = pattern + String(counter+i).padStart(pad,'0') + suffix + '.' + f.ext;
      return '<div class="flex justify-between p-1 hover:bg-matte-50 dark:hover:bg-matte-800 rounded">'+
        '<span class="text-matte-400">'+esc(f.name)+'</span><span class="text-matte-500">→</span><span class="text-accent-blue">'+esc(newName)+'</span></div>';
    }).join('');
  }

  ['pattern','counter','padding','suffix'].forEach(id => document.getElementById(id).addEventListener('input', render));

  document.getElementById('download-all').addEventListener('click', () => {
    const pattern = document.getElementById('pattern').value;
    const counter = parseInt(document.getElementById('counter').value) || 1;
    const pad = parseInt(document.getElementById('padding').value) || 0;
    const suffix = document.getElementById('suffix').value;
    files.forEach((f,i) => {
      const newName = pattern + String(counter+i).padStart(pad,'0') + suffix + '.' + f.ext;
      const blob = new Blob([f.raw]);
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = newName;
      setTimeout(() => a.click(), i * 150);
    });
    showToast?.(_tToast?.('Download dimulai!','Download started!'),'success');
  });

  function esc(s) { return String(s).replace(/</g,'&lt;'); }
</script>
