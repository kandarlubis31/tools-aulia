---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="File Rename Batch" description="Rename banyak file sekaligus dengan pola, prefix, suffix, dan numbering. 100% client-side.">
  <ToolPageHeader title="File Rename Batch" desc="Rename banyak file: prefix, suffix, pola + download" icon='<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>' />

  <div class="card-base p-5 space-y-4">
    <div id="drop-zone" class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-8 text-center cursor-pointer hover:border-accent-blue transition-colors">
      <span data-i18n="rename.drop_hint">📁 Drop file di sini (multiple)</span>
      <input type="file" id="file-input" class="hidden" multiple>
    </div>

    <div id="controls" class="hidden space-y-3">
      <div class="flex flex-wrap gap-3 items-end">
        <div>
          <label class="text-xs text-matte-500 mb-1 block" for="pattern" data-i18n="rename.pattern">Pola Nama</label>
          <input id="pattern" type="text" class="input-field text-sm w-48" placeholder="foto_" value="foto_">
        </div>
        <div>
          <label class="text-xs text-matte-500 mb-1 block" for="counter" data-i18n="rename.counter">Counter Start</label>
          <input id="counter" type="number" min="0" value="1" class="input-field text-sm w-16">
        </div>
        <div>
          <label class="text-xs text-matte-500 mb-1 block" for="padding" data-i18n="rename.padding">Padding (00x)</label>
          <input id="padding" type="number" min="0" max="10" value="3" class="input-field text-sm w-16">
        </div>
        <div>
          <label class="text-xs text-matte-500 mb-1 block" for="suffix" data-i18n="rename.suffix">Suffix</label>
          <input id="suffix" type="text" class="input-field text-sm w-32" placeholder="_final" value="">
        </div>
      </div>

      <div class="max-h-64 overflow-y-auto space-y-1 text-sm" id="file-list"></div>
      <button id="download-all" class="btn-primary w-full" data-i18n="rename.download">Download Semua (Renamed)</button>
    </div>
  </div>
</BaseLayout>

<script>
  const toast = (msg, type = 'success') => window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const files = [];

  const fi = document.getElementById('file-input');
  const dz = document.getElementById('drop-zone');

  fi.addEventListener('change', () => { handle(fi.files); fi.value = ''; });
  dz.addEventListener('click', () => fi.click());
  dz.addEventListener('dragover', (e) => { e.preventDefault(); dz.classList.add('border-accent-blue'); });
  dz.addEventListener('dragleave', () => dz.classList.remove('border-accent-blue'));
  dz.addEventListener('drop', (e) => { e.preventDefault(); dz.classList.remove('border-accent-blue'); handle(e.dataTransfer.files); });

  function handle(fileList) {
    if (!fileList || !fileList.length) return;
    files.length = 0;
    for (const f of fileList) {
      const dot = f.name.lastIndexOf('.');
      files.push({ name: f.name, ext: dot > 0 ? f.name.slice(dot + 1) : '', file: f });
    }
    render();
  }

  function newNameFor(f, i) {
    const pattern = document.getElementById('pattern').value;
    const counter = Math.max(0, parseInt(document.getElementById('counter').value, 10) || 1);
    const pad = Math.min(10, Math.max(0, parseInt(document.getElementById('padding').value, 10) || 0));
    const suffix = document.getElementById('suffix').value;
    const num = String(counter + i).padStart(pad, '0');
    return f.ext ? pattern + num + suffix + '.' + f.ext : pattern + num + suffix;
  }

  function render() {
    if (!files.length) return;
    document.getElementById('controls').classList.remove('hidden');
    const list = document.getElementById('file-list');
    list.textContent = '';
    files.forEach((f, i) => {
      const row = document.createElement('div');
      row.className = 'flex justify-between gap-2 p-1 hover:bg-matte-50 dark:hover:bg-matte-800 rounded';
      const old = document.createElement('span');
      old.className = 'text-matte-400 truncate';
      old.textContent = f.name;
      const arrow = document.createElement('span');
      arrow.className = 'text-matte-500';
      arrow.textContent = '→';
      const renamed = document.createElement('span');
      renamed.className = 'text-accent-blue truncate';
      renamed.textContent = newNameFor(f, i);
      row.append(old, arrow, renamed);
      list.appendChild(row);
    });
  }

  ['pattern', 'counter', 'padding', 'suffix'].forEach((id) => document.getElementById(id).addEventListener('input', render));

  document.getElementById('download-all').addEventListener('click', () => {
    if (!files.length) { toast('Pilih file dulu!', 'error'); return; }
    files.forEach((f, i) => {
      const blob = new Blob([f.file]);
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = newNameFor(f, i);
      setTimeout(() => { a.click(); URL.revokeObjectURL(url); }, i * 150);
    });
    toast('Download dimulai!');
  });
  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __fileRenamePage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __fileRenamePage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });
</script>
