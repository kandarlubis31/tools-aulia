---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="File Splitter" description="Potong file besar jadi bagian kecil (chunks). 100% client-side.">
  <ToolPageHeader title="File Splitter" description="Potong file jadi chunks dengan ukuran kustom" icon='<path d="M5 12h14"/><path d="M12 5l7 7-7 7"/>' />

  <div class="card-base p-5 space-y-4">
    <div id="drop-zone" class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-8 text-center cursor-pointer hover:border-accent-blue transition-colors">
      <span data-i18n="split.drop_hint">📁 Drop file di sini atau klik</span>
      <input type="file" id="file-input" class="hidden">
    </div>

    <div id="info" class="hidden space-y-3">
      <span class="text-sm text-matte-500 font-medium" id="filename"></span>
      <div class="flex flex-wrap gap-3 items-end">
        <div>
          <label for="chunk-size" class="block text-xs text-matte-500 mb-1" data-i18n="split.chunk_label">Ukuran per chunk</label>
          <select id="chunk-size" class="input-field text-sm">
            <option value="1048576">1 MB</option>
            <option value="5242880" selected>5 MB</option>
            <option value="10485760">10 MB</option>
            <option value="52428800">50 MB</option>
            <option value="custom">Custom</option>
          </select>
        </div>
        <input id="custom-size" type="number" min="1024" step="1024" value="1048576" class="input-field text-sm w-32 hidden" placeholder="Bytes" data-i18n-attr="placeholder" data-i18n="split.custom_ph">
      </div>
      <p class="text-sm text-matte-500" id="chunk-info"></p>
      <button id="split-btn" class="btn-primary" data-i18n="split.btn">Potong & Download Chunks</button>
    </div>
  </div>
</BaseLayout>

<script>
  const toast = (msg, type = 'success') => window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  let fileBytes = null;
  let fileName = '';
  const MIN_CHUNK = 1024;

  const dz = document.getElementById('drop-zone');
  const fi = document.getElementById('file-input');
  const customSize = document.getElementById('custom-size');

  fi.addEventListener('change', function () { handleFile(this.files[0]); this.value = ''; });
  dz.addEventListener('click', () => fi.click());
  dz.addEventListener('dragover', (e) => { e.preventDefault(); dz.classList.add('border-accent-blue'); });
  dz.addEventListener('dragleave', () => dz.classList.remove('border-accent-blue'));
  dz.addEventListener('drop', (e) => { e.preventDefault(); dz.classList.remove('border-accent-blue'); handleFile(e.dataTransfer.files[0]); });

  document.getElementById('chunk-size').addEventListener('change', function () {
    customSize.classList.toggle('hidden', this.value !== 'custom');
    updateInfo();
  });
  customSize.addEventListener('input', updateInfo);

  function getChunkSize() {
    const sel = document.getElementById('chunk-size').value;
    let size = sel === 'custom' ? (parseInt(customSize.value, 10) || MIN_CHUNK) : parseInt(sel, 10);
    if (!Number.isFinite(size) || size < MIN_CHUNK) size = MIN_CHUNK;
    return size;
  }

  function updateInfo() {
    if (!fileBytes) return;
    const size = getChunkSize();
    const chunks = Math.ceil(fileBytes.length / size);
    document.getElementById('chunk-info').textContent = chunks + ' chunk' + (chunks > 1 ? 's' : '') + ' · ' + (size / 1048576).toFixed(1) + ' MB';
  }

  async function handleFile(file) {
    if (!file) return;
    if (file.size === 0) { toast('File kosong.', 'error'); return; }
    try { fileBytes = new Uint8Array(await file.arrayBuffer()); }
    catch { toast('Gagal membaca file', 'error'); return; }
    fileName = file.name;
    document.getElementById('filename').textContent = fileName + ' (' + (file.size / 1048576).toFixed(2) + ' MB)';
    document.getElementById('info').classList.remove('hidden');
    updateInfo();
  }

  document.getElementById('split-btn').addEventListener('click', () => {
    if (!fileBytes) { toast('Pilih file dulu!', 'error'); return; }
    const size = getChunkSize();
    for (let i = 0; i < fileBytes.length; i += size) {
      const chunk = fileBytes.slice(i, Math.min(i + size, fileBytes.length));
      const blob = new Blob([chunk]);
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = fileName + '.part' + String(Math.floor(i / size) + 1).padStart(3, '0');
      setTimeout(() => { a.click(); URL.revokeObjectURL(url); }, (i / size) * 200);
    }
    toast('Download chunks dimulai!');
  });
  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __fileSplitterPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __fileSplitterPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });
</script>
