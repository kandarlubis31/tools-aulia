---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Contrast Checker">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh] py-10">
    <ToolPageHeader title="WCAG Contrast Checker" titleKey="header.contrast_checker" desc="Cek kontras warna untuk accessibility WCAG 2.1." descKey="header.contrast_checker_desc" icon='<circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 0 20z"/>' gradient="from-amber-500 to-orange-600" />
    <div class="card-base p-8 animate-fade-in">
      <div class="grid grid-cols-2 gap-6 mb-6">
        <div><label class="text-xs text-matte-500 mb-1 block">Foreground (Teks)</label><div class="flex gap-2"><input id="fg" type="color" value="#ffffff" class="w-12 h-10 rounded-lg cursor-pointer" /><input id="fg-hex" type="text" value="#ffffff" class="flex-1 p-2 border rounded-lg dark:bg-surface-hover dark:border-surface-border font-mono text-sm" /></div></div>
        <div><label class="text-xs text-matte-500 mb-1 block">Background</label><div class="flex gap-2"><input id="bg" type="color" value="#1e293b" class="w-12 h-10 rounded-lg cursor-pointer" /><input id="bg-hex" type="text" value="#1e293b" class="flex-1 p-2 border rounded-lg dark:bg-surface-hover dark:border-surface-border font-mono text-sm" /></div></div>
      </div>
      <div id="preview" class="p-6 rounded-xl mb-6 text-center"><p class="text-2xl font-bold mb-2">Contoh Teks</p><p class="text-sm">The quick brown fox jumps over the lazy dog</p></div>
      <div id="results" class="grid grid-cols-2 md:grid-cols-4 gap-3"></div>
    </div>
  </div>
</BaseLayout>
<script>
  function luminance(r, g, b) { const a = [r,g,b].map(v => { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); }); return a[0] * 0.2126 + a[1] * 0.7152 + a[2] * 0.0722; }
  function contrastRatio(fg, bg) {
    const l1 = luminance(...fg) + 0.05;
    const l2 = luminance(...bg) + 0.05;
    return Math.max(l1, l2) / Math.min(l1, l2);
  }
  function hexToRgb(hex) { return [parseInt(hex.slice(1,3),16), parseInt(hex.slice(3,5),16), parseInt(hex.slice(5,7),16)]; }
  function render() {
    const fg = document.getElementById('fg-hex').value;
    const bg = document.getElementById('bg-hex').value;
    if (!/^#[0-9a-f]{6}$/i.test(fg) || !/^#[0-9a-f]{6}$/i.test(bg)) return;
    const ratio = contrastRatio(hexToRgb(fg), hexToRgb(bg));
    const preview = document.getElementById('preview');
    preview.style.backgroundColor = bg;
    preview.style.color = fg;
    const checks = [
      { label: 'AA Normal', pass: ratio >= 4.5 },
      { label: 'AA Large', pass: ratio >= 3 },
      { label: 'AAA Normal', pass: ratio >= 7 },
      { label: 'AAA Large', pass: ratio >= 4.5 },
    ];
    document.getElementById('results').innerHTML = '<div class="p-3 rounded-xl bg-matte-50 dark:bg-surface-hover text-center"><span class="text-2xl font-black ' + (ratio >= 4.5 ? 'text-emerald-500' : ratio >= 3 ? 'text-amber-500' : 'text-red-500') + '">' + ratio.toFixed(2) + ':1</span><br/><span class="text-xs text-matte-500">Contrast Ratio</span></div>' + checks.map(c => '<div class="p-3 rounded-xl ' + (c.pass ? 'bg-emerald-50 dark:bg-emerald-900/20' : 'bg-red-50 dark:bg-red-900/20') + ' text-center"><span class="text-lg font-black ' + (c.pass ? 'text-emerald-500' : 'text-red-500') + '">' + (c.pass ? 'PASS' : 'FAIL') + '</span><br/><span class="text-xs text-matte-500">' + c.label + '</span></div>').join('');
  }
  document.getElementById('fg').oninput = e => { document.getElementById('fg-hex').value = e.target.value; render(); };
  document.getElementById('bg').oninput = e => { document.getElementById('bg-hex').value = e.target.value; render(); };
  document.getElementById('fg-hex').oninput = e => { if (/^#[0-9a-f]{6}$/i.test(e.target.value)) { document.getElementById('fg').value = e.target.value; render(); } };
  document.getElementById('bg-hex').oninput = e => { if (/^#[0-9a-f]{6}$/i.test(e.target.value)) { document.getElementById('bg').value = e.target.value; render(); } };
  render();
</script>
