---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Subnet Calculator — Hitung CIDR & Host Range">
  <div class="max-w-3xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Subnet Calculator"
      titleKey="header.subnet_calc"
      desc="Hitung netmask, network/broadcast, dan usable host range dari IP + CIDR."
      descKey="header.subnet_calc_desc"
      icon='<rect x="9" y="2" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="16" y="16" width="6" height="6" rx="1"/><line x1="12" y1="8" x2="5" y2="16"/><line x1="12" y1="8" x2="19" y2="16"/>'
      gradient="from-indigo-500 to-violet-600"
    />

    <div class="card-base p-6 animate-fade-in">
      <div class="flex flex-wrap items-end gap-3 mb-2">
        <div class="flex-1 min-w-[200px]">
          <label for="ip-input" class="block text-xs font-bold text-matte-500 dark:text-matte-300 mb-1.5">🌐 IP Address</label>
          <input id="ip-input" type="text" value="192.168.1.0" placeholder="192.168.1.0" class="w-full px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm font-mono focus:ring-2 focus:ring-indigo-500/40 outline-none" />
        </div>
        <div class="w-28">
          <label for="cidr-input" class="block text-xs font-bold text-matte-500 dark:text-matte-300 mb-1.5">/ Prefix</label>
          <input id="cidr-input" type="number" value="24" min="0" max="32" class="w-full px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm font-mono focus:ring-2 focus:ring-indigo-500/40 outline-none" />
        </div>
        <div class="flex items-end gap-2">
          {['24', '16', '8'].map(p => (
            <button data-prefix={p} class="prefix-btn px-3 py-2.5 rounded-lg text-xs font-bold bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300 hover:bg-matte-200 dark:hover:bg-surface-hover transition-all">/{p}</button>
          ))}
        </div>
      </div>
      <p id="error-box" class="hidden text-xs text-red-500 dark:text-red-400 font-mono bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 rounded-lg px-3 py-2 mt-3"></p>
    </div>

    <div id="result" class="hidden mt-6 animate-fade-in">
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 mb-6">
        <div class="card-base p-4">
          <p class="text-2xs text-matte-400 mb-1" data-i18n="subnet.netmask">Netmask</p>
          <p id="r-netmask" class="font-mono font-bold text-matte-800 dark:text-matte-100">—</p>
        </div>
        <div class="card-base p-4">
          <p class="text-2xs text-matte-400 mb-1" data-i18n="subnet.wildcard">Wildcard</p>
          <p id="r-wildcard" class="font-mono font-bold text-matte-800 dark:text-matte-100">—</p>
        </div>
        <div class="card-base p-4">
          <p class="text-2xs text-matte-400 mb-1" data-i18n="subnet.network">Network</p>
          <p id="r-network" class="font-mono font-bold text-indigo-500">—</p>
        </div>
        <div class="card-base p-4">
          <p class="text-2xs text-matte-400 mb-1" data-i18n="subnet.broadcast">Broadcast</p>
          <p id="r-broadcast" class="font-mono font-bold text-rose-500">—</p>
        </div>
        <div class="card-base p-4">
          <p class="text-2xs text-matte-400 mb-1" data-i18n="subnet.hosts">Usable Hosts</p>
          <p id="r-hosts" class="font-mono font-bold text-matte-800 dark:text-matte-100">—</p>
        </div>
        <div class="card-base p-4">
          <p class="text-2xs text-matte-400 mb-1" data-i18n="subnet.range">Host Range</p>
          <p id="r-range" class="font-mono text-xs font-bold text-matte-800 dark:text-matte-100 break-all">—</p>
        </div>
      </div>

      <div class="card-base p-5 mb-6">
        <p class="text-xs font-bold text-matte-500 dark:text-matte-300 mb-3" data-i18n="subnet.binary">Representasi Biner</p>
        <div id="binary-view" class="font-mono text-xs space-y-1.5"></div>
      </div>

      <div class="card-base p-5">
        <p class="text-xs font-bold text-matte-500 dark:text-matte-300 mb-3" data-i18n="subnet.info">Informasi Subnet</p>
        <div id="info-view" class="text-xs text-matte-600 dark:text-matte-300 space-y-1.5"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const ipInput = document.getElementById('ip-input') as HTMLInputElement;
    const cidrInput = document.getElementById('cidr-input') as HTMLInputElement;
    const errorBox = document.getElementById('error-box');
    const result = document.getElementById('result');

    const toUint32 = (a: number, b: number, c: number, d: number) => (((a << 24) | (b << 16) | (c << 8) | d) >>> 0);
    const toIp = (n: number) => [(n >>> 24) & 255, (n >>> 16) & 255, (n >>> 8) & 255, n & 255].join('.');
    const toBin = (n: number) => (n >>> 0).toString(2).padStart(32, '0');

    function parseIp(s: string): number | null {
      const parts = s.trim().split('.');
      if (parts.length !== 4) return null;
      const nums = parts.map(Number);
      if (nums.some((x) => isNaN(x) || x < 0 || x > 255)) return null;
      return toUint32(nums[0], nums[1], nums[2], nums[3]);
    }

    function fmt(n: number): string {
      if (n >= 1e9) return (n / 1e9).toFixed(2) + ' miliar';
      if (n >= 1e6) return (n / 1e6).toFixed(2) + ' juta';
      if (n >= 1e3) return (n / 1e3).toFixed(1) + ' rb';
      return String(n);
    }

    function isPrivate(ip: number): boolean {
      const a = (ip >>> 24) & 255, b = (ip >>> 16) & 255;
      return (a === 10) || (a === 172 && b >= 16 && b <= 31) || (a === 192 && b === 168) || (a === 169 && b === 254);
    }

    function calculate() {
      const ip = parseIp(ipInput.value);
      const cidr = parseInt(cidrInput.value, 10);
      if (ip === null) { showError('Format IP tidak valid — contoh: 192.168.1.0'); return; }
      if (isNaN(cidr) || cidr < 0 || cidr > 32) { showError('Prefix harus 0–32'); return; }
      errorBox!.classList.add('hidden');

      const mask = (0xffffffff << (32 - cidr)) >>> 0;
      const wildcard = (~mask) >>> 0;
      const network = (ip & mask) >>> 0;
      const broadcast = (ip | wildcard) >>> 0;
      const totalHosts = Math.pow(2, 32 - cidr);
      const usable = cidr >= 31 ? Math.max(0, totalHosts) : Math.max(0, totalHosts - 2);
      const firstHost = cidr >= 31 ? network : network + 1;
      const lastHost = cidr >= 31 ? broadcast : broadcast - 1;

      (document.getElementById('r-netmask') as HTMLElement).textContent = toIp(mask);
      (document.getElementById('r-wildcard') as HTMLElement).textContent = toIp(wildcard);
      (document.getElementById('r-network') as HTMLElement).textContent = toIp(network);
      (document.getElementById('r-broadcast') as HTMLElement).textContent = toIp(broadcast);
      (document.getElementById('r-hosts') as HTMLElement).textContent = fmt(usable);
      (document.getElementById('r-range') as HTMLElement).textContent = cidr >= 31 ? '—' : `${toIp(firstHost)} – ${toIp(lastHost)}`;

      // Binary view
      const rows = [
        ['IP', toBin(ip)],
        ['Netmask', toBin(mask)],
        ['Network', toBin(network)],
        ['Broadcast', toBin(broadcast)],
      ];
      (document.getElementById('binary-view') as HTMLElement).innerHTML = rows.map(([label, bin]) => {
        const netPart = bin.slice(0, cidr);
        const hostPart = bin.slice(cidr);
        return `<div class="flex items-center gap-3"><span class="w-20 text-matte-400 shrink-0">${label}</span><span class="text-indigo-500">${netPart}</span><span class="text-matte-400">${hostPart}</span></div>`;
      }).join('');

      // Info
      const info: string[] = [];
      const a = (network >>> 24) & 255, b = (network >>> 16) & 255, c = (network >>> 8) & 255, d = network & 255;
      if (a >= 1 && a <= 126) info.push(`📍 Kelas A — netmask default /8`);
      else if (a >= 128 && a <= 191) info.push(`📍 Kelas B — netmask default /16`);
      else if (a >= 192 && a <= 223) info.push(`📍 Kelas C — netmask default /24`);
      else if (a >= 224 && a <= 239) info.push(`📍 Kelas D (multicast)`);
      else info.push(`📍 Kelas E (reserved)`);
      info.push(isPrivate(ip) ? `🔒 IP private (RFC 1918)` : `🌍 IP publik`);
      info.push(`🧮 Total alamat: <b>${fmt(totalHosts)}</b> (2^${32 - cidr})`);
      if (cidr >= 31) info.push(`ℹ️ /${cidr} tidak punya network/broadcast — semua alamat usable`);
      (document.getElementById('info-view') as HTMLElement).innerHTML = info.map((x) => `<div>${x}</div>`).join('');

      result?.classList.remove('hidden');
      result?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function showError(msg: string) {
      errorBox!.textContent = `⚠ ${msg}`;
      errorBox!.classList.remove('hidden');
      result?.classList.add('hidden');
    }

    ipInput?.addEventListener('input', calculate);
    cidrInput?.addEventListener('input', calculate);
    document.querySelectorAll('.prefix-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        cidrInput.value = (btn as HTMLElement).dataset.prefix!;
        calculate();
      });
    });

    calculate();
  });
</script>
