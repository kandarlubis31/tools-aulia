---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Color Harmony">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh] py-10">
    <ToolPageHeader title="Color Harmony" titleKey="header.color_harmony" desc="Temukan harmoni warna: komplementer, triadic, analogous, split-complementary." descKey="header.color_harmony_desc" icon='<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/>' gradient="from-violet-500 to-purple-600" />
    <div class="card-base p-8 animate-fade-in">
      <div class="flex gap-4 mb-6 items-center flex-wrap"><label for="base-color" class="text-sm text-matte-500" data-i18n="label.base_color">Base Color:</label><input id="base-color" type="color" value="#6366f1" class="w-16 h-10 rounded-lg cursor-pointer" /><input id="base-hex" type="text" value="#6366f1" class="w-28 p-2 border rounded-lg dark:bg-surface-hover dark:border-surface-border font-mono text-sm" aria-label="Base hex" /><select id="harmony-type" class="p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold" aria-label="Harmony type"><option value="complementary" data-i18n="harmony.complementary">Complementary</option><option value="triadic" data-i18n="harmony.triadic">Triadic</option><option value="analogous" data-i18n="harmony.analogous">Analogous</option><option value="split" data-i18n="harmony.split">Split-Complementary</option><option value="tetradic" data-i18n="harmony.tetradic">Tetradic</option><option value="monochromatic" data-i18n="harmony.monochromatic">Monochromatic</option></select></div>
      <div id="palette" class="grid grid-cols-3 md:grid-cols-6 gap-3 mb-6"></div>
      <div class="flex gap-2 mb-6">
        <button id="copy-palette" class="btn-secondary text-sm" data-i18n="btn.copy_palette">📋 Copy Palet</button>
      </div>
      <div id="preview" class="p-6 rounded-xl border border-matte-200 dark:border-surface-border"><p class="text-sm text-matte-500 mb-2" data-i18n="label.preview">Preview:</p><div id="preview-boxes" class="flex gap-2 h-16"></div></div>
    </div>
  </div>
</BaseLayout>
<script>
  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const baseHex = document.getElementById('base-hex') as HTMLInputElement;
  const paletteEl = document.getElementById('palette')!;
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  function hexToHsl(hex: string): [number, number, number] {
    let r = parseInt(hex.slice(1, 3), 16) / 255;
    let g = parseInt(hex.slice(3, 5), 16) / 255;
    let b = parseInt(hex.slice(5, 7), 16) / 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0; const l = (max + min) / 2;
    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      if (max === r) h = ((g - b) / d + (g < b ? 6 : 0)) / 6;
      else if (max === g) h = ((b - r) / d + 2) / 6;
      else h = ((r - g) / d + 4) / 6;
    }
    return [Math.round(h * 360), Math.round(s * 100), Math.round(l * 100)];
  }
  function hslToHex(h: number, s: number, l: number) {
    s /= 100; l /= 100;
    const a = s * Math.min(l, 1 - l);
    const f = (n: number) => { const k = (n + h / 30) % 12; return l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1); };
    return '#' + [f(0), f(8), f(4)].map(x => Math.round(x * 255).toString(16).padStart(2, '0')).join('');
  }
  function getHarmony(hex: string, type: string) {
    const [h, s, l] = hexToHsl(hex);
    switch (type) {
      case 'complementary': return [hex, hslToHex((h + 180) % 360, s, l)];
      case 'triadic': return [hex, hslToHex((h + 120) % 360, s, l), hslToHex((h + 240) % 360, s, l)];
      case 'analogous': return [hslToHex((h - 30 + 360) % 360, s, l), hex, hslToHex((h + 30) % 360, s, l)];
      case 'split': return [hex, hslToHex((h + 150) % 360, s, l), hslToHex((h + 210) % 360, s, l)];
      case 'tetradic': return [hex, hslToHex((h + 90) % 360, s, l), hslToHex((h + 180) % 360, s, l), hslToHex((h + 270) % 360, s, l)];
      case 'monochromatic': return [hslToHex(h, s, Math.max(l - 30, 10)), hslToHex(h, s, Math.max(l - 15, 20)), hex, hslToHex(h, s, Math.min(l + 15, 90)), hslToHex(h, s, Math.min(l + 30, 95))];
      default: return [hex];
    }
  }

  let lastColors: string[] = [];
  function render() {
    const hex = baseHex.value;
    const type = (document.getElementById('harmony-type') as HTMLSelectElement).value;
    lastColors = getHarmony(hex, type);
    paletteEl.innerHTML = lastColors.map(c =>
      '<div class="text-center cursor-pointer copy-swatch" data-color="' + c + '" title="Copy ' + c + '"><div class="w-full h-16 rounded-xl border border-matte-200 dark:border-matte-700" style="background:' + c + '"></div><p class="label text-xs font-mono mt-1 text-matte-500">' + c + '</p></div>'
    ).join('');
    document.getElementById('preview-boxes')!.innerHTML = lastColors.map(c => '<div class="flex-1 rounded-lg" style="background:' + c + '"></div>').join('');
  }

  // Delegated copy: label ikut ter-copy (hex tetap tampil), tidak pakai onclick string
  paletteEl.addEventListener('click', async (e) => {
    const sw = (e.target as HTMLElement).closest<HTMLElement>('.copy-swatch');
    if (!sw) return;
    try {
      await navigator.clipboard.writeText(sw.dataset.color || '');
      toast(sw.dataset.color + ' disalin!');
    } catch { toast('Gagal menyalin', 'error'); }
  });

  document.getElementById('copy-palette')!.addEventListener('click', async () => {
    try {
      if (!lastColors.length) { toast('Belum ada palet.', 'info'); return; }
      await navigator.clipboard.writeText(lastColors.join(', '));
      toast('Palet disalin!');
    } catch { toast('Gagal menyalin', 'error'); }
  });

  document.getElementById('base-color')!.addEventListener('input', e => { baseHex.value = (e.target as HTMLInputElement).value; render(); });
  baseHex.addEventListener('input', e => {
    const v = (e.target as HTMLInputElement).value;
    if (/^#[0-9a-f]{6}$/i.test(v)) { (document.getElementById('base-color') as HTMLInputElement).value = v; render(); }
  });
  document.getElementById('harmony-type')!.addEventListener('change', render);
  render();

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __devColorHarmonyPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __devColorHarmonyPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
