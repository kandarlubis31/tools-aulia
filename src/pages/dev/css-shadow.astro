---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="CSS Shadow Generator">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh]">
        <ToolPageHeader
      title="CSS Box Shadow"
      titleKey="css_shadow.title"
      desc="Generator efek bayangan CSS visual."
      descKey="header.css_shadow_desc"
      icon='<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M22 22 2 2"/>'
      gradient="from-pink-500 to-rose-600"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 animate-fade-in">
       <div class="bg-white dark:bg-matte-800 p-6 rounded-2xl shadow-lg border border-matte-200 dark:border-matte-700 space-y-4">
          <div><label for="x-offset" class="text-xs font-bold text-matte-500" data-i18n="label.shift_right">Shift Right</label><span class="text-xs font-mono text-matte-400 float-right" id="x-offset-val">10</span><input type="range" id="x-offset" min="-50" max="50" value="10" class="w-full h-2 bg-matte-200 rounded-lg accent-pink-500"></div>
          <div><label for="y-offset" class="text-xs font-bold text-matte-500" data-i18n="label.shift_down">Shift Down</label><span class="text-xs font-mono text-matte-400 float-right" id="y-offset-val">10</span><input type="range" id="y-offset" min="-50" max="50" value="10" class="w-full h-2 bg-matte-200 rounded-lg accent-pink-500"></div>
          <div><label for="blur" class="text-xs font-bold text-matte-500" data-i18n="label.blur">Blur</label><span class="text-xs font-mono text-matte-400 float-right" id="blur-val">20</span><input type="range" id="blur" min="0" max="100" value="20" class="w-full h-2 bg-matte-200 rounded-lg accent-pink-500"></div>
          <div><label for="spread" class="text-xs font-bold text-matte-500" data-i18n="label.spread">Spread</label><span class="text-xs font-mono text-matte-400 float-right" id="spread-val">0</span><input type="range" id="spread" min="-50" max="50" value="0" class="w-full h-2 bg-matte-200 rounded-lg accent-pink-500"></div>
          <div><label for="opacity" class="text-xs font-bold text-matte-500" data-i18n="label.opacity">Opacity</label><span class="text-xs font-mono text-matte-400 float-right" id="opacity-val">0.2</span><input type="range" id="opacity" min="0" max="1" step="0.01" value="0.2" class="w-full h-2 bg-matte-200 rounded-lg accent-pink-500"></div>
          <div class="flex items-center gap-2"><label for="color" class="text-xs font-bold text-matte-500" data-i18n="label.color">Color</label><input type="color" id="color" value="#000000" class="h-8 w-full rounded cursor-pointer"></div>
          <button id="reset-css" class="w-full text-xs px-4 py-2 rounded-lg border border-matte-200 dark:border-matte-700 font-bold text-matte-500 hover:bg-matte-100 dark:hover:bg-matte-700 transition-colors" data-i18n="btn.reset">↺ Reset</button>
       </div>

       <div class="flex flex-col items-center justify-center bg-matte-50 dark:bg-matte-900 rounded-2xl border border-matte-200 dark:border-matte-700 p-8">
          <div id="box" class="w-32 h-32 bg-white dark:bg-matte-800 rounded-xl mb-8 transition-all duration-200"></div>
          <code id="code-out" class="p-3 bg-matte-200 dark:bg-matte-800 rounded text-xs font-mono text-matte-700 dark:text-matte-300 w-full break-all">box-shadow: 10px 10px 20px 0px rgba(0,0,0,0.2);</code>
          <div class="flex gap-2 mt-3">
            <button id="copy-css" class="text-xs px-4 py-2 rounded-lg bg-matte-200 dark:bg-matte-700 font-bold hover:bg-pink-100 dark:hover:bg-pink-900/30 transition-colors" data-i18n="btn.copy_emoji">📋 Copy</button>
          </div>
       </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const inputs = document.querySelectorAll('#x-offset, #y-offset, #blur, #spread, #opacity, #color');
  const box = document.getElementById('box')!;
  const code = document.getElementById('code-out')!;
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  const DEFAULTS: Record<string, string> = { 'x-offset': '10', 'y-offset': '10', blur: '20', spread: '0', opacity: '0.2', color: '#000000' };

  function hexToRgb(hex: string) {
    const r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16);
    return `${r}, ${g}, ${b}`;
  }

  function update() {
    const x = (document.getElementById('x-offset') as HTMLInputElement).value;
    const y = (document.getElementById('y-offset') as HTMLInputElement).value;
    const blur = (document.getElementById('blur') as HTMLInputElement).value;
    const spread = (document.getElementById('spread') as HTMLInputElement).value;
    const op = (document.getElementById('opacity') as HTMLInputElement).value;
    const col = (document.getElementById('color') as HTMLInputElement).value;

    document.getElementById('x-offset-val')!.textContent = x;
    document.getElementById('y-offset-val')!.textContent = y;
    document.getElementById('blur-val')!.textContent = blur;
    document.getElementById('spread-val')!.textContent = spread;
    document.getElementById('opacity-val')!.textContent = op;

    const shadow = `${x}px ${y}px ${blur}px ${spread}px rgba(${hexToRgb(col)}, ${op})`;
    box.style.boxShadow = shadow;
    code.innerText = `box-shadow: ${shadow};`;
  }

  inputs.forEach(i => i.addEventListener('input', update));
  update();

  document.getElementById('reset-css')!.addEventListener('click', () => {
    for (const [id, val] of Object.entries(DEFAULTS)) {
      (document.getElementById(id) as HTMLInputElement).value = val;
    }
    update();
    toast('Diatur ulang!', 'info');
  });

  document.getElementById('copy-css')!.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(code.innerText);
      toast('CSS disalin!');
    } catch { toast('Gagal menyalin', 'error'); }
  });

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __devCssShadowPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __devCssShadowPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
