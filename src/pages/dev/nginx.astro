---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="NGINX Config Generator — Reverse Proxy & SSL | ToolsAulia" description="Generate NGINX config: reverse proxy, SSL, cache. 100% client-side." category="Dev" toolHref="/dev/nginx">
  <ToolPageHeader title="NGINX Config Gen" description="Generate NGINX config: proxy, SSL, cache, security" icon='<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="space-y-2">
        <div><label class="text-xs text-matte-500 mb-1 block">Server Name</label><input id="server-name" type="text" class="input-field w-full text-sm" value="tools.paklubis.my.id"></div>
        <div><label class="text-xs text-matte-500 mb-1 block">Proxy Pass (backend)</label><input id="proxy-pass" type="text" class="input-field w-full text-sm" value="http://localhost:3000" placeholder="http://localhost:3000"></div>
        <div><label class="text-xs text-matte-500 mb-1 block">Listen Port</label><input id="port" type="number" class="input-field w-24 text-sm" value="443"></div>

        <div class="space-y-1 text-sm">
          <label class="flex items-center gap-2"><input type="checkbox" id="en-ssl" checked> SSL (HTTPS)</label>
          <label class="flex items-center gap-2"><input type="checkbox" id="en-gzip"> Gzip Compression</label>
          <label class="flex items-center gap-2"><input type="checkbox" id="en-cache"> Static Cache (30d)</label>
          <label class="flex items-center gap-2"><input type="checkbox" id="en-hsts"> HSTS Header</label>
          <label class="flex items-center gap-2"><input type="checkbox" id="en-cors"> CORS Headers</label>
        </div>
      </div>

      <div>
        <label class="text-sm text-matte-500 mb-1 block font-medium">Output</label>
        <pre id="output" class="bg-matte-900 text-green-400 rounded-lg p-3 h-96 overflow-auto text-xs font-mono whitespace-pre-wrap"></pre>
        <div class="flex gap-2 mt-2"><button id="copy-btn" class="btn-secondary text-xs">📋 Copy</button><button id="download-btn" class="btn-secondary text-xs">⬇️ nginx.conf</button></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const ids = ['server-name','proxy-pass','port','en-ssl','en-gzip','en-cache','en-hsts','en-cors'];
  ids.forEach(id => document.getElementById(id).addEventListener('input', render));

  function render() {
    const srv = v('server-name');
    const proxy = v('proxy-pass');
    const port = v('port') || '443';
    const ssl = document.getElementById('en-ssl').checked;
    const gzip = document.getElementById('en-gzip').checked;
    const cache = document.getElementById('en-cache').checked;
    const hsts = document.getElementById('en-hsts').checked;
    const cors = document.getElementById('en-cors').checked;

    let cfg = `# NGINX Config — Generated by ToolsAulia\n\nserver {\n  listen ${port}${ssl?' ssl http2':''};\n  server_name ${srv};\n\n`;
    if (ssl) cfg += `  ssl_certificate /etc/ssl/${srv}.pem;\n  ssl_certificate_key /etc/ssl/${srv}-key.pem;\n  ssl_protocols TLSv1.2 TLSv1.3;\n\n`;
    if (gzip) cfg += `  gzip on;\n  gzip_types text/css application/javascript image/svg+xml;\n\n`;
    if (cache) cfg += `  location ~* \\.(css|js|jpg|png|webp|svg|woff2)$ {\n    expires 30d;\n    add_header Cache-Control "public, immutable";\n  }\n\n`;
    if (cors) cfg += `  add_header Access-Control-Allow-Origin "*";\n  add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";\n\n`;
    if (hsts) cfg += `  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload";\n\n`;
    cfg += `  location / {\n    proxy_pass ${proxy};\n    proxy_set_header Host $host;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n    proxy_set_header X-Forwarded-Proto $scheme;\n  }\n}\n`;
    document.getElementById('output').textContent = cfg;
  }

  function v(id) { return document.getElementById(id).value.trim(); }

  document.getElementById('copy-btn').addEventListener('click', () => {
    navigator.clipboard.writeText(document.getElementById('output').textContent).then(() => showToast?.(_tToast?.('Disalin!','Copied!'),'success'));
  });
  document.getElementById('download-btn').addEventListener('click', () => {
    const blob = new Blob([document.getElementById('output').textContent], { type: 'text/plain' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'nginx.conf'; a.click();
  });
  render();
</script>
