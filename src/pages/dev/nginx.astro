---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="NGINX Config Gen" description="Generate NGINX config: reverse proxy, SSL, cache. 100% client-side.">
  <ToolPageHeader title="NGINX Config Gen" desc="Generate NGINX config: proxy, SSL, cache, security" icon='<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="space-y-2">
        <div><label for="server-name" class="text-xs text-matte-500 mb-1 block" data-i18n="dev.nginx.server_name">Server Name</label><input id="server-name" type="text" class="input-field w-full text-sm" value="tools.paklubis.my.id"></div>
        <div><label for="proxy-pass" class="text-xs text-matte-500 mb-1 block" data-i18n="dev.nginx.proxy_pass">Proxy Pass (backend)</label><input id="proxy-pass" type="text" class="input-field w-full text-sm" value="http://localhost:3000" placeholder="http://localhost:3000"></div>
        <div><label for="port" class="text-xs text-matte-500 mb-1 block" data-i18n="dev.nginx.port">Listen Port</label><input id="port" type="number" class="input-field w-24 text-sm" value="443"></div>

        <div class="space-y-1 text-sm">
          <label class="flex items-center gap-2"><input type="checkbox" id="en-ssl" checked> <span data-i18n="dev.nginx.ssl">SSL (HTTPS)</span></label>
          <label class="flex items-center gap-2"><input type="checkbox" id="en-gzip"> <span data-i18n="dev.nginx.gzip">Gzip Compression</span></label>
          <label class="flex items-center gap-2"><input type="checkbox" id="en-cache"> <span data-i18n="dev.nginx.cache">Static Cache (30d)</span></label>
          <label class="flex items-center gap-2"><input type="checkbox" id="en-hsts"> <span data-i18n="dev.nginx.hsts">HSTS Header</span></label>
          <label class="flex items-center gap-2"><input type="checkbox" id="en-cors"> <span data-i18n="dev.nginx.cors">CORS Headers</span></label>
        </div>
      </div>

      <div>
        <label for="output" class="text-sm text-matte-500 mb-1 block font-medium" data-i18n="dev.nginx.output">Output</label>
        <pre id="output" class="bg-matte-900 text-green-400 rounded-lg p-3 h-96 overflow-auto text-xs font-mono whitespace-pre-wrap"></pre>
        <div class="flex gap-2 mt-2"><button id="copy-btn" class="btn-secondary text-xs" data-i18n="common.copy">📋 Copy</button><button id="download-btn" class="btn-secondary text-xs" data-i18n="common.download">⬇️ nginx.conf</button></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const ids = ['server-name', 'proxy-pass', 'port', 'en-ssl', 'en-gzip', 'en-cache', 'en-hsts', 'en-cors'];
  ids.forEach(id => document.getElementById(id)!.addEventListener('input', render));
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  function render() {
    const srv = v('server-name') || 'example.com';
    const proxy = v('proxy-pass') || 'http://localhost:3000';
    let port = parseInt(v('port'), 10);
    if (isNaN(port) || port < 1 || port > 65535) port = 443;
    const ssl = (document.getElementById('en-ssl') as HTMLInputElement).checked;
    const gzip = (document.getElementById('en-gzip') as HTMLInputElement).checked;
    const cache = (document.getElementById('en-cache') as HTMLInputElement).checked;
    const hsts = (document.getElementById('en-hsts') as HTMLInputElement).checked;
    const cors = (document.getElementById('en-cors') as HTMLInputElement).checked;

    if (ssl && port !== 443) {
      toast('SSL biasanya di port 443', 'info');
    }

    let cfg = `# NGINX Config — Generated by MasAul Tools\n\nserver {\n  listen ${port}${ssl ? ' ssl http2' : ''};\n  server_name ${srv};\n\n`;
    if (ssl) cfg += `  ssl_certificate /etc/ssl/${srv}.pem;\n  ssl_certificate_key /etc/ssl/${srv}-key.pem;\n  ssl_protocols TLSv1.2 TLSv1.3;\n\n`;
    if (gzip) cfg += `  gzip on;\n  gzip_types text/css application/javascript image/svg+xml;\n\n`;
    if (cache) cfg += `  location ~* \\.(css|js|jpg|png|webp|svg|woff2)$ {\n    expires 30d;\n    add_header Cache-Control "public, immutable";\n  }\n\n`;
    if (cors) cfg += `  add_header Access-Control-Allow-Origin "*";\n  add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";\n\n`;
    if (hsts) cfg += `  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload";\n\n`;
    cfg += `  location / {\n    proxy_pass ${proxy};\n    proxy_set_header Host $host;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n    proxy_set_header X-Forwarded-Proto $scheme;\n  }\n}\n`;
    (document.getElementById('output') as HTMLPreElement).textContent = cfg;
  }

  function v(id: string) { return (document.getElementById(id) as HTMLInputElement).value.trim(); }

  document.getElementById('copy-btn')!.addEventListener('click', async () => {
    try {
      const cfg = (document.getElementById('output') as HTMLPreElement).textContent || '';
      if (!cfg) { toast('Belum ada config.', 'info'); return; }
      await navigator.clipboard.writeText(cfg);
      toast('Disalin!');
    } catch { toast('Gagal menyalin', 'error'); }
  });
  document.getElementById('download-btn')!.addEventListener('click', () => {
    try {
      const cfg = (document.getElementById('output') as HTMLPreElement).textContent || '';
      const blob = new Blob([cfg], { type: 'text/plain' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'nginx.conf'; a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
      toast('nginx.conf diunduh!');
    } catch { toast('Gagal membuat file', 'error'); }
  });
  render();

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __devNginxPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __devNginxPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
