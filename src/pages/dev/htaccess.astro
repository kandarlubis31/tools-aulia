---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle=".htaccess Generator" description="Generate .htaccess untuk Apache: redirect, rewrite, security headers. 100% client-side.">
  <ToolPageHeader title=".htaccess Generator" desc="Builder redirect, rewrite, security — Apache" icon='<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="space-y-2">
        <p class="text-sm font-medium text-matte-500" data-i18n="htaccess.builder">Rules Builder</p>

        <select id="rule-type" class="input-field text-sm w-full">
          <option value="redirect301" data-i18n="htaccess.opt_301">301 Redirect (Permanent)</option>
          <option value="redirect302" data-i18n="htaccess.opt_302">302 Redirect (Temporary)</option>
          <option value="rewrite" data-i18n="htaccess.opt_rewrite">Rewrite (Clean URL)</option>
          <option value="https" data-i18n="htaccess.opt_https">Force HTTPS</option>
          <option value="www" data-i18n="htaccess.opt_www">Force WWW / non-WWW</option>
          <option value="cors" data-i18n="htaccess.opt_cors">CORS Headers</option>
          <option value="cache" data-i18n="htaccess.opt_cache">Cache Control</option>
        </select>

        <div id="rule-form" class="space-y-1"></div>

        <button id="add-rule" class="btn-primary text-sm" data-i18n="htaccess.add_rule">Tambah Rule</button>
      </div>

      <div>
        <label class="block text-sm text-matte-500 mb-1 font-medium" for="output" data-i18n="htaccess.output">Output .htaccess</label>
        <pre id="output" class="bg-matte-900 text-green-400 rounded-lg p-3 h-96 overflow-auto text-sm font-mono whitespace-pre-wrap"># Generated by MasAul Tools .htaccess Generator</pre>
        <div class="flex gap-2 mt-2">
          <button id="copy-btn" class="btn-secondary text-xs" data-i18n="btn.copy_emoji">📋 Copy</button>
          <button id="download-btn" class="btn-secondary text-xs" data-i18n="htaccess.download">⬇️ .htaccess</button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
import { t } from '../../i18n/translations';

// Re-render form dinamis (placeholder input) saat bahasa diganti.
let __htaccessRender: (() => void) | null = null;
window.addEventListener('langchange', () => { __htaccessRender?.(); });

const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
  window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const rules: string[] = [];
  const output = document.getElementById('output')!;
  const ruleType = document.getElementById('rule-type') as HTMLSelectElement;

  ruleType.addEventListener('change', updateForm);
  updateForm();
  __htaccessRender = updateForm;

  function updateForm() {
    const v = ruleType.value;
    let html = '';
    if (v.startsWith('redirect')) html = '<input id="rfrom" placeholder="/old-page" class="input-field text-sm w-full"> <input id="rto" placeholder="/new-page" class="input-field text-sm w-full mt-1">';
    else if (v==='rewrite') html = '<input id="rfrom" placeholder="^page/(.+)$" class="input-field text-sm w-full"> <input id="rto" placeholder="/index.php?page=1" class="input-field text-sm w-full mt-1">';
    else if (v==='https') html = `<p class="text-xs text-matte-400">${esc(t('htaccess.https_hint', 'Otomatis redirect HTTP ke HTTPS'))}</p>`;
    else if (v==='www') html = `<select id="www-opt" class="input-field text-sm w-full"><option value="www">${esc(t('htaccess.force_www', 'Force WWW'))}</option><option value="non-www">${esc(t('htaccess.force_nonwww', 'Force non-WWW'))}</option></select>`;
    else if (v==='cors') html = '<input id="cors-origin" placeholder="*" class="input-field text-sm w-full" value="*">';
    else if (v==='cache') html = '<input id="cache-ext" placeholder="css|js|jpg|png" class="input-field text-sm w-full" value="css|js|jpg|png"> <input id="cache-sec" type="number" placeholder="31536000" class="input-field text-sm w-full mt-1" value="31536000">';
    document.getElementById('rule-form')!.innerHTML = html;
  }

  function esc(s: string): string {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function val(id: string, def?: string): string {
    const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
    return el ? (el.value || def || '') : (def || '');
  }

  document.getElementById('add-rule')!.addEventListener('click', () => {
    const v = ruleType.value;
    let rule = '';
    if (v === 'redirect301' || v === 'redirect302') {
      // Validasi: from/to wajib — kalau kosong jangan push rule rusak.
      if (!val('rfrom') || !val('rto')) { toast('Isi path asal dan tujuan dulu.', 'error'); return; }
      rule = v === 'redirect301'
        ? 'Redirect 301 ' + val('rfrom') + ' ' + val('rto')
        : 'Redirect 302 ' + val('rfrom') + ' ' + val('rto');
    } else if (v === 'rewrite') {
      if (!val('rfrom') || !val('rto')) { toast('Isi pola regex dan tujuan dulu.', 'error'); return; }
      rule = 'RewriteRule ' + val('rfrom') + ' ' + val('rto');
    } else if (v === 'https') {
      rule = 'RewriteCond %{HTTPS} off\nRewriteRule ^(.*)$ https://%{HTTP_HOST}/' + val('rfrom','$1') + ' [R=301,L]';
    } else if (v === 'www') {
      const opt = (document.getElementById('www-opt') as HTMLSelectElement).value;
      rule = opt === 'www'
        ? 'RewriteCond %{HTTP_HOST} !^www\\. [NC]\nRewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]'
        : 'RewriteCond %{HTTP_HOST} ^www\\.(.+)$ [NC]\nRewriteRule ^(.*)$ https://%1/$1 [R=301,L]';
    } else if (v === 'cors') {
      rule = '<IfModule mod_headers.c>\n  Header set Access-Control-Allow-Origin "'+val('cors-origin','*')+'"\n</IfModule>';
    } else if (v === 'cache') {
      rule = '<FilesMatch "\\.('+val('cache-ext')+')$">\n  Header set Cache-Control "max-age='+val('cache-sec','31536000')+', public"\n</FilesMatch>';
    }
    rules.push(rule);
    render();
    toast('Rule ditambahkan.');
  });

  function render() {
    let txt = '# Generated by MasAul Tools .htaccess Generator\n\nRewriteEngine On\n\n';
    rules.forEach(r => txt += r + '\n\n');
    output.textContent = txt;
  }

  document.getElementById('copy-btn')!.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(output.textContent || '');
      toast('Disalin!');
    } catch {
      toast('Gagal menyalin.', 'error');
    }
  });
  document.getElementById('download-btn')!.addEventListener('click', () => {
    try {
      const blob = new Blob([output.textContent || ''], { type: 'text/plain' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = '.htaccess'; a.click();
      URL.revokeObjectURL(a.href);
      toast('Diunduh!');
    } catch {
      toast('Gagal mengunduh.', 'error');
    }
  });

  render();

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __devHtaccessPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __devHtaccessPage) { __htaccessRender = null; return; }
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
