---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title=".htaccess Generator — Builder Redirect & Rewrite | ToolsAulia" description="Generate .htaccess untuk Apache: redirect, rewrite, security headers. 100% client-side." category="Dev" toolHref="/dev/htaccess">
  <ToolPageHeader title=".htaccess Generator" description="Builder redirect, rewrite, security — Apache" icon='<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="space-y-2">
        <p class="text-sm font-medium text-matte-500">Rules Builder</p>

        <select id="rule-type" class="input-field text-sm w-full">
          <option value="redirect301">301 Redirect (Permanent)</option>
          <option value="redirect302">302 Redirect (Temporary)</option>
          <option value="rewrite">Rewrite (Clean URL)</option>
          <option value="https">Force HTTPS</option>
          <option value="www">Force WWW / non-WWW</option>
          <option value="cors">CORS Headers</option>
          <option value="cache">Cache Control</option>
        </select>

        <div id="rule-form" class="space-y-1"></div>

        <button id="add-rule" class="btn-primary text-sm">Tambah Rule</button>
      </div>

      <div>
        <label class="block text-sm text-matte-500 mb-1 font-medium">Output .htaccess</label>
        <pre id="output" class="bg-matte-900 text-green-400 rounded-lg p-3 h-96 overflow-auto text-sm font-mono whitespace-pre-wrap"># Generated by ToolsAulia .htaccess Generator</pre>
        <div class="flex gap-2 mt-2">
          <button id="copy-btn" class="btn-secondary text-xs">📋 Copy</button>
          <button id="download-btn" class="btn-secondary text-xs">⬇️ .htaccess</button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const rules = [];
  const output = document.getElementById('output');

  document.getElementById('rule-type').addEventListener('change', updateForm);
  updateForm();

  function updateForm() {
    const t = document.getElementById('rule-type').value;
    let html = '';
    if (t.startsWith('redirect')) html = '<input id="rfrom" placeholder="/old-page" class="input-field text-sm w-full"> <input id="rto" placeholder="/new-page" class="input-field text-sm w-full mt-1">';
    else if (t==='rewrite') html = '<input id="rfrom" placeholder="^page/(.+)$" class="input-field text-sm w-full"> <input id="rto" placeholder="/index.php?page=1" class="input-field text-sm w-full mt-1">';
    else if (t==='https') html = '<p class="text-xs text-matte-400">Otomatis redirect HTTP ke HTTPS</p>';
    else if (t==='www') html = '<select id="www-opt" class="input-field text-sm w-full"><option value="www">Force WWW</option><option value="non-www">Force non-WWW</option></select>';
    else if (t==='cors') html = '<input id="cors-origin" placeholder="*" class="input-field text-sm w-full" value="*">';
    else if (t==='cache') html = '<input id="cache-ext" placeholder="css|js|jpg|png" class="input-field text-sm w-full" value="css|js|jpg|png"> <input id="cache-sec" type="number" placeholder="31536000" class="input-field text-sm w-full mt-1" value="31536000">';
    document.getElementById('rule-form').innerHTML = html;
  }

  document.getElementById('add-rule').addEventListener('click', () => {
    const t = document.getElementById('rule-type').value;
    let rule = '';
    if (t === 'redirect301') {
      rule = 'Redirect 301 ' + val('rfrom') + ' ' + val('rto');
    } else if (t === 'redirect302') {
      rule = 'Redirect 302 ' + val('rfrom') + ' ' + val('rto');
    } else if (t === 'rewrite') {
      rule = 'RewriteRule ' + val('rfrom') + ' ' + val('rto');
    } else if (t === 'https') {
      rule = 'RewriteCond %{HTTPS} off\nRewriteRule ^(.*)$ https://%{HTTP_HOST}/' + val('rfrom','$1') + ' [R=301,L]';
    } else if (t === 'www') {
      const opt = document.getElementById('www-opt').value;
      rule = opt === 'www'
        ? 'RewriteCond %{HTTP_HOST} !^www\\. [NC]\nRewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]'
        : 'RewriteCond %{HTTP_HOST} ^www\\.(.+)$ [NC]\nRewriteRule ^(.*)$ https://%1/$1 [R=301,L]';
    } else if (t === 'cors') {
      rule = '<IfModule mod_headers.c>\n  Header set Access-Control-Allow-Origin "'+val('cors-origin','*')+'"\n</IfModule>';
    } else if (t === 'cache') {
      rule = '<FilesMatch "\\.('+val('cache-ext')+')$">\n  Header set Cache-Control "max-age='+val('cache-sec','31536000')+', public"\n</FilesMatch>';
    }
    rules.push(rule);
    render();
  });

  function val(id, def) { const el = document.getElementById(id); return el ? el.value || def : def; }

  function render() {
    let txt = '# Generated by ToolsAulia .htaccess Generator\n\nRewriteEngine On\n\n';
    rules.forEach(r => txt += r + '\n\n');
    output.textContent = txt;
  }

  document.getElementById('copy-btn').addEventListener('click', () => {
    navigator.clipboard.writeText(output.textContent).then(() => showToast?.(_tToast?.('Disalin!','Copied!'),'success'));
  });
  document.getElementById('download-btn').addEventListener('click', () => {
    const blob = new Blob([output.textContent], { type: 'text/plain' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = '.htaccess'; a.click();
  });

  render();
</script>
