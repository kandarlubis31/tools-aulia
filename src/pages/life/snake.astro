---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Snake Game">
  <div class="max-w-lg mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Snake Game"
      titleKey="header.snake"
      desc="Game snake klasik di browser. Mainkan & kalahkan high score!"
      descKey="header.snake_desc"
      icon='<path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/><path d="M8.5 8.5v.01"/><path d="M15.5 8.5v.01"/><path d="M9 14a6 6 0 0 0 6 0"/>'
    />

    <div class="animate-fade-in space-y-4">
      <div id="snake-card" class="card-base p-4 text-center">
        <div class="flex items-center justify-center gap-6 mb-3">
          <div>
            <span class="text-2xs text-matte-400 block font-bold uppercase" data-i18n="snake.score">Score</span>
            <span id="score-display" class="text-3xl font-extrabold tabular-nums text-matte-800 dark:text-white">0</span>
          </div>
          <div>
            <span class="text-2xs text-matte-400 block font-bold uppercase" data-i18n="snake.high">🏆 High</span>
            <span id="high-display" class="text-3xl font-extrabold tabular-nums text-amber-500">0</span>
          </div>
        </div>
        <!-- max-w-full+h-auto: canvas 300px muat di layar 320px; touch-none: swipe gak ikut scroll halaman -->
        <canvas id="game-canvas" width="300" height="300" class="mx-auto rounded-lg bg-matte-900 max-w-full h-auto touch-none"></canvas>
        <div class="mt-3 flex gap-2 justify-center flex-wrap">
          <button id="start-btn" class="gradient-brand px-6 py-2.5 rounded-lg text-sm font-bold">▶️ <span data-i18n="snake.start">Mulai</span></button>
          <button id="fs-btn" class="btn-secondary px-4 py-2.5 rounded-lg text-sm font-bold" aria-label="Layar penuh"><span aria-hidden="true">⛶</span> <span data-i18n="btn.fullscreen">Layar Penuh</span></button>
        </div>
        <p class="snake-hint text-2xs text-matte-400 mt-2">Gunakan <kbd class="px-1.5 py-0.5 rounded bg-matte-100 dark:bg-surface-elevated text-xs">↑↓←→</kbd> atau <kbd class="px-1.5 py-0.5 rounded bg-matte-100 dark:bg-surface-elevated text-xs">WASD</kbd> · <span data-i18n="snake.swipe_hint">atau swipe di HP</span></p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Fullscreen: hanya card game yang naik (header/footer di luar, gak ikut).
     Ukuran canvas = sisi persegi yang selalu muat: 90vmin / sisa tinggi layar / cap 600px. */
  #snake-card:fullscreen,
  #snake-card:-webkit-full-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border-radius: 0;
    padding: 24px;
    overflow: auto;
  }
  #snake-card:fullscreen #game-canvas,
  #snake-card:-webkit-full-screen #game-canvas {
    width: min(90vmin, calc(100vh - 240px), 600px);
    height: min(90vmin, calc(100vh - 240px), 600px);
    image-rendering: pixelated;
  }
  #snake-card:fullscreen .snake-hint,
  #snake-card:-webkit-full-screen .snake-hint {
    display: none;
  }
</style>

<script>
const __page = (location.pathname.replace(/\/+$/, '') || '/');

  // Element refs — di-query ulang tiap page-load (DOM baru tiap balik navigasi SPA)
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let scoreDisplay: HTMLElement | null = null;
  let highDisplay: HTMLElement | null = null;
  let startBtn: HTMLButtonElement | null = null;
  let fsBtn: HTMLButtonElement | null = null;

  const STORAGE_KEY = 'ta-snake-highscore';
  const GRID = 15;
  let COLS = 20;
  let ROWS = 20;

  let snake: [number, number][] = [];
  let food: [number, number] = [0, 0];
  let dir: [number, number] = [1, 0];
  let nextDir: [number, number] = [1, 0];
  let score = 0;
  let highScore = 0;
  let running = false;
  let paused = false;
  let interval: number | null = null;
  let speed = 120;
  let touchX = 0, touchY = 0;

  function refreshElements() {
    canvas = document.getElementById('game-canvas') as HTMLCanvasElement | null;
    ctx = canvas?.getContext('2d') ?? null;
    scoreDisplay = document.getElementById('score-display');
    highDisplay = document.getElementById('high-display');
    startBtn = document.getElementById('start-btn') as HTMLButtonElement | null;
    fsBtn = document.getElementById('fs-btn') as HTMLButtonElement | null;
    if (canvas) { COLS = canvas.width / GRID; ROWS = canvas.height / GRID; }
  }

  function loadHigh() {
    try { highScore = parseInt(localStorage.getItem(STORAGE_KEY) || '0') || 0; } catch { highScore = 0; }
    if (highDisplay) highDisplay.textContent = String(highScore);
  }

  function saveHigh() {
    if (score > highScore) {
      highScore = score;
      try { localStorage.setItem(STORAGE_KEY, String(highScore)); } catch { /* storage penuh/blokir — skip */ }
      if (highDisplay) highDisplay.textContent = String(highScore);
    }
  }

  function randomFood(): [number, number] {
    let pos: [number, number];
    do {
      pos = [Math.floor(Math.random() * COLS), Math.floor(Math.random() * ROWS)];
    } while (snake.some(s => s[0] === pos[0] && s[1] === pos[1]));
    return pos;
  }

  // Reset papan ke state awal (dipanggil tiap masuk halaman + tiap start)
  function init() {
    snake = [[5, 5], [4, 5], [3, 5]];
    dir = [1, 0];
    nextDir = [1, 0];
    score = 0;
    speed = 120;
    if (scoreDisplay) scoreDisplay.textContent = '0';
    food = randomFood();
  }

  function draw() {
    if (!canvas || !ctx) return;
    // Background
    ctx.fillStyle = '#0f172a';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Grid lines
    ctx.strokeStyle = '#1e293b';
    ctx.lineWidth = 0.5;
    for (let x = 0; x < COLS; x++) {
      ctx.beginPath();
      ctx.moveTo(x * GRID, 0);
      ctx.lineTo(x * GRID, canvas.height);
      ctx.stroke();
    }
    for (let y = 0; y < ROWS; y++) {
      ctx.beginPath();
      ctx.moveTo(0, y * GRID);
      ctx.lineTo(canvas.width, y * GRID);
      ctx.stroke();
    }

    // Snake
    snake.forEach((s, i) => {
      ctx!.fillStyle = i === 0 ? '#4ade80' : '#22c55e';
      ctx!.fillRect(s[0] * GRID + 1, s[1] * GRID + 1, GRID - 2, GRID - 2);
    });

    // Food
    ctx.fillStyle = '#f43f5e';
    ctx.beginPath();
    ctx.arc(food[0] * GRID + GRID / 2, food[1] * GRID + GRID / 2, GRID / 2 - 1, 0, Math.PI * 2);
    ctx.fill();
  }

  function tick() {
    if (!canvas || !ctx) return;
    dir = [nextDir[0], nextDir[1]];
    const head = snake[0];
    const newHead: [number, number] = [head[0] + dir[0], head[1] + dir[1]];

    // Wall collision = game over
    if (newHead[0] < 0 || newHead[0] >= COLS || newHead[1] < 0 || newHead[1] >= ROWS) {
      gameOver();
      return;
    }

    // Self collision
    if (snake.some(s => s[0] === newHead[0] && s[1] === newHead[1])) {
      gameOver();
      return;
    }

    snake.unshift(newHead);

    // Eat food?
    if (newHead[0] === food[0] && newHead[1] === food[1]) {
      score += 10;
      if (scoreDisplay) scoreDisplay.textContent = String(score);
      food = randomFood();
      if (speed > 50) speed -= 2;
      if (interval) {
        clearInterval(interval);
        interval = window.setInterval(tick, speed);
      }
    } else {
      snake.pop();
    }

    draw();
  }

  function gameOver() {
    running = false;
    if (interval) { clearInterval(interval); interval = null; }
    const isNewHigh = score > highScore;
    saveHigh();

    // Overlay
    if (canvas && ctx) {
      ctx.fillStyle = 'rgba(0,0,0,0.7)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 24px monospace';
      ctx.textAlign = 'center';
      ctx.fillText('GAME OVER', canvas.width / 2, canvas.height / 2 - 20);
      ctx.font = '14px monospace';
      ctx.fillText(`Score: ${score}`, canvas.width / 2, canvas.height / 2 + 10);
      if (isNewHigh && score > 0) {
        ctx.fillStyle = '#fbbf24';
        ctx.font = 'bold 16px monospace';
        ctx.fillText('🏆 ' + (window._tToast ? window._tToast('Rekor baru!') : 'Rekor baru!'), canvas.width / 2, canvas.height / 2 + 40);
      }
    }
    if (isNewHigh && score > 0) {
      window.showToast?.(window._tToast ? window._tToast('Rekor baru!') : 'Rekor baru!', 'success');
    }

    if (startBtn) {
      startBtn.innerHTML = '🔄 <span data-i18n="snake.restart">Ulangi</span>';
      (window as any).processI18n?.();
    }
  }

  function setStartLabel(html: string) {
    if (!startBtn) return;
    startBtn.innerHTML = html;
    (window as any).processI18n?.();
  }

  function start() {
    init();
    draw();
    running = true;
    paused = false;
    if (interval) clearInterval(interval);
    interval = window.setInterval(tick, speed);
    setStartLabel('⏸️ <span data-i18n="snake.pause">Pause</span>');
  }

  function pauseToggle() {
    if (!running) return;
    paused = !paused;
    if (paused) {
      if (interval) { clearInterval(interval); interval = null; }
      setStartLabel('▶️ <span data-i18n="snake.resume">Lanjut</span>');
    } else {
      interval = window.setInterval(tick, speed);
      setStartLabel('⏸️ <span data-i18n="snake.pause">Pause</span>');
    }
  }

  function onStartClick() {
    if (running) { pauseToggle(); return; }
    start();
  }

  // Handler level document — di-bind SEKALI per load (bukan per page-load, anti dobel)
  function onKey(e: KeyboardEvent) {
    if (!canvas || !canvas.isConnected) return;
    const k = e.key;
    const isArrow = k === 'ArrowUp' || k === 'ArrowDown' || k === 'ArrowLeft' || k === 'ArrowRight';

    if (!running) {
      if (k === 'Enter' || k === ' ') {
        const t = e.target as HTMLElement | null;
        if (t && (t.tagName === 'BUTTON' || t.tagName === 'A' || t.tagName === 'INPUT')) return; // biarkan button yang proses
        e.preventDefault();
        start();
      }
      return; // di luar game: arrow dibiarkan buat scroll halaman
    }

    // Game berjalan: blok scroll default (bug: arrow bawah = web ikut ke bawah), lalu proses input
    if (isArrow || k === ' ') e.preventDefault();

    switch (k) {
      case 'ArrowUp': case 'w': case 'W':
        if (dir[1] === 0) nextDir = [0, -1]; break;
      case 'ArrowDown': case 's': case 'S':
        if (dir[1] === 0) nextDir = [0, 1]; break;
      case 'ArrowLeft': case 'a': case 'A':
        if (dir[0] === 0) nextDir = [-1, 0]; break;
      case 'ArrowRight': case 'd': case 'D':
        if (dir[0] === 0) nextDir = [1, 0]; break;
      case 'p': case 'P':
        pauseToggle(); break;
    }
  }

  // Auto-pause saat tab ke luar — ular gak mati diam-diam di background
  function onVisibility() {
    if (document.hidden && running && !paused) pauseToggle();
  }

  // Cleanup (#2): timer + fullscreen dibersihkan saat pindah halaman
  function onPageLeave() {
    if (interval) { clearInterval(interval); interval = null; }
    running = false;
    paused = false;
    if (document.fullscreenElement) { document.exitFullscreen().catch(() => {}); }
  }

  function onFsClick() {
    const card = document.getElementById('snake-card');
    if (document.fullscreenElement) {
      document.exitFullscreen().catch(() => {});
    } else if (card?.requestFullscreen) {
      card.requestFullscreen().catch(() => {});
    }
  }

  function onFullscreenChange() {
    if (!fsBtn || !fsBtn.isConnected) return;
    const active = !!document.fullscreenElement;
    fsBtn.innerHTML = active
      ? '<span aria-hidden="true">⛶</span> <span data-i18n="btn.exit_fullscreen">Keluar Layar Penuh</span>'
      : '<span aria-hidden="true">⛶</span> <span data-i18n="btn.fullscreen">Layar Penuh</span>';
    (window as any).processI18n?.();
  }

  function onTouchStart(e: TouchEvent) {
    touchX = e.touches[0].clientX;
    touchY = e.touches[0].clientY;
  }
  function onTouchEnd(e: TouchEvent) {
    if (!dir) return;
    const dx = e.changedTouches[0].clientX - touchX;
    const dy = e.changedTouches[0].clientY - touchY;
    if (Math.abs(dx) < 20 && Math.abs(dy) < 20) return; // tap — abaikan
    if (Math.abs(dx) > Math.abs(dy)) {
      if (dir[0] === 0) nextDir = [dx > 0 ? 1 : -1, 0];
    } else {
      if (dir[1] === 0) nextDir = [0, dy > 0 ? 1 : -1];
    }
  }

  // Listener global (document) di-bind sekali — kalau tiap page-load nambah lagi,
  // handler menumpuk & menempel di DOM mati (guard #2: anti dobel-bind).
  let __globalBound = false;
  function bindGlobalOnce() {
    if (__globalBound) return;
    __globalBound = true;
    document.addEventListener('keydown', onKey);
    document.addEventListener('visibilitychange', onVisibility);
    document.addEventListener('fullscreenchange', onFullscreenChange);
    document.addEventListener('astro:page-leave', onPageLeave);
  }

  // SPA boot (#14): guard path + guard dobel-bind — semua binding & render awal di sini
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';

    refreshElements();
    bindGlobalOnce();

    startBtn?.addEventListener('click', onStartClick);
    fsBtn?.addEventListener('click', onFsClick);
    // Swipe controls (mobile — DoD agar bisa dimainkan di HP)
    canvas?.addEventListener('touchstart', onTouchStart, { passive: true });
    canvas?.addEventListener('touchend', onTouchEnd, { passive: true });

    // Balik dari halaman lain = papan baru (state lama udah dibersihkan page-leave)
    init();
    loadHigh();
    draw();
  });
</script>
