---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="Sleep Calculator" description="Hitung waktu tidur ideal berdasarkan sleep cycle 90 menit. 100% client-side.">
  <ToolPageHeader title="Sleep Calculator" titleKey="header.sleep_calc" desc="Waktu tidur ideal — bangun seger tiap pagi" descKey="header.sleep_calc_desc" icon='<path d="M18 20v-4"/><path d="M12 20V4"/><path d="M6 20v-4"/>' />

  <div class="space-y-4">
    <div class="card-base p-5 space-y-4">
      <div class="flex gap-4">
        <button id="mode-wake" class="btn-primary flex-1 text-sm" data-i18n="btn.mode_wake">Saya mau bangun jam...</button>
        <button id="mode-sleep" class="btn-secondary flex-1 text-sm" data-i18n="btn.mode_sleep">Saya mau tidur jam...</button>
      </div>

      <!-- Format 24 jam langsung (AM/PM dibuang — Nov 2026) -->
      <div class="flex gap-2 items-center justify-center">
        <input id="hour" type="number" min="0" max="23" value="7" inputmode="numeric" class="input-field w-16 text-center text-sm" aria-label="Jam" data-i18n-attr="aria-label" data-i18n="label.hour">
        <span class="text-matte-500">:</span>
        <input id="min" type="number" min="0" max="59" value="0" inputmode="numeric" class="input-field w-16 text-center text-sm" aria-label="Menit" data-i18n-attr="aria-label" data-i18n="label.minute">
      </div>

      <!-- Jam cepat — sekali tap di HP, gak perlu ketik (isinya mode-dependent) -->
      <div id="chips" class="flex flex-wrap gap-2 justify-center"></div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="results"></div>
      <p class="text-xs text-matte-400 text-center" data-i18n="text.sleep_note">Sleep cycle rata-rata 90 menit. Tidur 5-6 cycle (7.5-9 jam) ideal.</p>
      <p class="text-xs text-matte-400 text-center" data-i18n="sleep.copy_hint">Klik salah satu jam untuk menyalinnya.</p>
    </div>

    <!-- INFO: cara kerja + saran (pola card info pesangon) -->
    <div class="card-base p-5 sm:p-6 animate-fade-in">
      <h3 class="text-lg font-bold text-matte-800 dark:text-white mb-4 flex items-center gap-3">
        <div class="w-9 h-9 shrink-0 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-xl flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        </div>
        <span data-i18n="sleep.info_title">Cara kerja &amp; saran</span>
      </h3>
      <ol class="space-y-3 text-sm text-matte-600 dark:text-matte-300 list-none">
        <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-lg bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-2xs font-black flex items-center justify-center">1</span><span data-i18n="sleep.info_1">Satu siklus tidur berlangsung sekitar 90 menit: tidur ringan - tidur dalam - REM. Bangun tepat di akhir siklus bikin segar, bangun di tengah siklus bikin grogi (sleep inertia).</span></li>
        <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-lg bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-2xs font-black flex items-center justify-center">2</span><span data-i18n="sleep.info_2">Perhitungan sudah termasuk 15 menit waktu untuk tertidur. Di mode bangun, jam tidur yang tampil adalah waktu kamu mulai berbaring - bukan waktu mata terpejam.</span></li>
        <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-lg bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-2xs font-black flex items-center justify-center">3</span><span data-i18n="sleep.info_3">Dewasa idealnya tidur 5-6 siklus (7,5-9 jam) per malam. Jam tidur dan bangun yang konsisten setiap hari lebih berpengaruh daripada begadang lalu tidur panjang di akhir pekan.</span></li>
        <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-lg bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-2xs font-black flex items-center justify-center">4</span><span data-i18n="sleep.info_4">Tips: kurangi layar dan kafein minimal 1 jam sebelum tidur, pilih jam tidur yang menampilkan 5-6 siklus, dan pakai jam cepat di atas biar gak perlu ketik manual.</span></li>
      </ol>
      <p class="mt-4 text-2xs leading-relaxed text-matte-400" data-i18n="sleep.disclaimer">Simulasi edukatif - kebutuhan tidur tiap orang berbeda. Bila punya gangguan tidur kronis, konsultasikan ke dokter.</p>
    </div>
  </div>
</BaseLayout>

<script>
import { t } from '../../i18n/translations';

// Re-render i18n dinamis: label hasil di-bake via t() → render ulang saat ganti bahasa
// (pola sama dengan dev/contrast).
let __sleepRender: (() => void) | null = null;
window.addEventListener('langchange', () => { __sleepRender?.(); });

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  let mode: 'wake' | 'sleep' = 'wake';
  const hourInp = document.getElementById('hour') as HTMLInputElement;
  const minInp = document.getElementById('min') as HTMLInputElement;
  const modeWake = document.getElementById('mode-wake') as HTMLButtonElement;
  const modeSleep = document.getElementById('mode-sleep') as HTMLButtonElement;
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // Jam cepat per mode (24 jam) — sekali tap, UX mobile tanpa ketik
  const CHIPS: Record<'wake' | 'sleep', string[]> = {
    wake: ['05:00', '06:00', '07:00', '08:00'],
    sleep: ['21:00', '22:00', '23:00', '00:00'],
  };
  function renderChips() {
    const box = document.getElementById('chips');
    if (!box) return;
    box.innerHTML = CHIPS[mode].map(tm =>
      '<button type="button" data-chip="' + tm + '" class="min-h-[36px] px-3 py-1.5 rounded-full text-sm font-mono font-bold border border-matte-200 dark:border-surface-border bg-matte-50 dark:bg-surface-hover text-matte-700 dark:text-matte-200 hover:border-accent-blue hover:text-accent-blue transition-colors">' + tm + '</button>'
    ).join('');
  }

  function setMode(m: 'wake' | 'sleep') {
    mode = m;
    modeWake.className = (m === 'wake' ? 'btn-primary' : 'btn-secondary') + ' flex-1 text-sm';
    modeSleep.className = (m === 'sleep' ? 'btn-primary' : 'btn-secondary') + ' flex-1 text-sm';
    renderChips();
    calc();
  }
  modeWake.addEventListener('click', () => setMode('wake'));
  modeSleep.addEventListener('click', () => setMode('sleep'));
  [hourInp, minInp].forEach(el => el.addEventListener('input', calc));

  // Klik jam cepat → isi input (delegasi, aman karena innerHTML di-render ulang tiap mode)
  document.getElementById('chips')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-chip]') as HTMLButtonElement | null;
    if (!btn) return;
    const [ch, cm] = (btn.dataset.chip || '00:00').split(':');
    hourInp.value = String(parseInt(ch, 10));
    minInp.value = String(parseInt(cm, 10));
    calc();
  });

  const pad = (n: number) => String(n).padStart(2, '0');

  function calc() {
    let h = parseInt(hourInp.value, 10) || 0;
    let m = parseInt(minInp.value, 10) || 0;
    h = Math.min(23, Math.max(0, h));
    m = Math.min(59, Math.max(0, m));
    if (String(parseInt(hourInp.value, 10)) !== hourInp.value) hourInp.value = String(h);

    const totalMin = h * 60 + m;
    const cycle = 90;
    const buffer = 15; // waktu rata-rata tertidur — konsisten di 2 mode
    const results: { label: string; time: string; count: number }[] = [];

    if (mode === 'wake') {
      // Bangun jam X → mundur: buffer + n siklus (harus berbaring 15 menit sebelum tertidur)
      for (let c = 6; c >= 3; c--) {
        let tm = totalMin - buffer - c * cycle;
        while (tm < 0) tm += 1440;
        const hh = Math.floor(tm / 60) % 24, mm = tm % 60;
        results.push({ label: c === 6 ? t('sleep.ideal', 'Ideal (9 jam)') : c + ' ' + t('sleep.cycle_hours', 'cycle ({h}j)').replace('{h}', String(c * 1.5)), time: pad(hh) + ':' + pad(mm), count: c });
      }
    } else {
      // Tidur jam X → maju: buffer + n siklus
      for (let c = 3; c <= 6; c++) {
        const tm = (totalMin + buffer + c * cycle) % 1440;
        const hh = Math.floor(tm / 60), mm = tm % 60;
        results.push({ label: (c >= 5 ? '⭐ ' : '') + c + ' ' + t('sleep.cycle_hours', 'cycle ({h}j)').replace('{h}', String(c * 1.5)), time: pad(hh) + ':' + pad(mm), count: c });
      }
    }

    const box = document.getElementById('results');
    if (!box) return;
    box.innerHTML = results.map(r =>
      '<button type="button" class="card-base p-3 text-center w-full cursor-pointer hover:border-accent-blue transition-colors ' + (r.count >= 5 ? 'border-2 border-accent-green/30 bg-accent-green/5' : '') + '" data-time="' + r.time + '">' +
      '<p class="text-xs text-matte-400">' + r.label + '</p><p class="text-2xl font-bold font-mono text-accent-blue">' + r.time + '</p></button>'
    ).join('');
  }

  // Klik jam hasil → salin ke clipboard (delegasi, aman karena innerHTML di-render ulang tiap calc)
  document.getElementById('results')!.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-time]') as HTMLButtonElement | null;
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.time || '');
      toast('Disalin!');
    } catch { toast('Gagal menyalin', 'error'); }
  });

  __sleepRender = calc;
  renderChips();
  calc();

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __lifeSleepPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __lifeSleepPage) { __sleepRender = null; return; }
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
