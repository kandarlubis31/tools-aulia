---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Kerang Ajaib - Tanya Nasib & Tarik Tali" description="Kerang ajaib ala Club SpongeBob: ketik pertanyaan, tarik talinya, dengarkan sabda mutlaknya. Fun tool 100% client-side.">
  <div class="max-w-lg mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Kerang Ajaib"
      titleKey="header.magic_8ball"
      desc="Tarik talinya & dengarkan sabda mutlaknya!"
      descKey="header.magic_8ball_desc"
      icon='<path d="M12 21 4.3 12.8A9.7 9.7 0 0 1 19.7 12.8Z"/><path d="M12 21 9 11"/><path d="M12 21v-10"/><path d="M12 21 15 11"/>'
    />

    <div class="card-base p-8 text-center animate-fade-in">
      <!-- Dua elemen: parent float (CSS animation) > child shake (inline transform) —
           biar animasi melayang gak ketimpa getaran (cascade: animation > inline) -->
      <div class="mx-auto w-40 h-40 mb-4 conch-float">
        <button id="conch" type="button"
          aria-label="Kerang ajaib - klik untuk menarik tali" data-i18n-attr="aria-label" data-i18n="magic.aria"
          class="w-full h-full text-[88px] leading-none cursor-pointer active:scale-95 transition-transform focus:outline-none">🐚</button>
      </div>

      <p class="text-sm text-matte-500 dark:text-matte-300 mb-3 italic" data-i18n="magic.think">Pikirkan pertanyaanmu, lalu tarik talinya…</p>
      <p class="text-xs text-matte-400 mb-3" data-i18n="magic.hint">Tekan Enter atau klik kerang untuk menarik tali.</p>

      <input id="question-input" type="text" placeholder="Tanyakan nasibmu (cth: Boleh aku makan?)"
        class="w-full max-w-xs px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm text-center outline-none focus:ring-2 focus:ring-purple-500/40"
        data-i18n-attr="placeholder" data-i18n="magic.placeholder" />

      <button id="pull-btn" class="btn-primary mt-4" data-i18n="magic.pull_btn">Tarik Tali! 🧵</button>

      <!-- Response box (pola referensi): initial (di-i18n, diganti proses langchange) vs
           dynamic span (diisi JS — TANPA data-i18n biar gak ditimpa processI18n) -->
      <div id="conch-response" class="mt-5 min-h-[72px] px-4 py-4 rounded-xl bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 flex items-center justify-center">
        <span id="conch-initial" class="text-sm font-bold text-matte-400" data-i18n="magic.initial">"Puja Kerang Ajaib..."</span>
        <span id="conch-answer" class="hidden"></span>
      </div>

      <button id="copy-answer" class="hidden mt-4 text-xs px-3 py-1.5 bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-300 rounded-full" data-i18n="magic.copy_btn">Salin jawaban</button>
    </div>
  </div>
</BaseLayout>

<style>
  .conch-float { animation: conchFloat 4s ease-in-out infinite; }
  @keyframes conchFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(3deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .conch-float { animation: none; }
  }
</style>

<script>
  import { t } from '../../i18n/translations';

  const toast = (msg, type = 'success') => window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // 8 sabda legendaris dari episode Club SpongeBob — pola array inline ID/EN
  const SABDA_ID = [
    'Jangan lakukan apa-apa.',
    'Dua-duanya boleh.',
    'Mungkin suatu hari nanti.',
    'Kurasa tidak.',
    'Coba tanya lagi nanti.',
    'Tidak.',
    'Ya.',
    'Sama sekali tidak.',
  ];
  const SABDA_EN = [
    'Do nothing.',
    'Both are fine.',
    'Maybe someday.',
    "I don't think so.",
    'Ask again later.',
    'No.',
    'Yes.',
    'Absolutely not.',
  ];

  function getSabda() {
    try { return (localStorage.getItem('lang') || 'id') === 'en' ? SABDA_EN : SABDA_ID; }
    catch { return SABDA_ID; }
  }

  // Class literal (bukan template dinamis — guard #6) buat 3 state response
  const CLS = {
    loading: 'text-sm font-bold text-matte-400',
    empty: 'text-sm font-bold text-rose-500',
    answer: 'text-base font-bold text-amber-500',
  };

  let __pullInt: number | null = null; // dirujuk page-leave biar timer gak bocor (#2)

  function init() {
    const conch = document.getElementById('conch')!;
    const input = document.getElementById('question-input') as HTMLInputElement;
    const pullBtn = document.getElementById('pull-btn')!;
    const initial = document.getElementById('conch-initial')!;
    const answerEl = document.getElementById('conch-answer')!;
    const copyBtn = document.getElementById('copy-answer')!;
    let pulling = false;
    let lastSabda = '';

    function showSabda() {
      const list = getSabda();
      lastSabda = list[Math.floor(Math.random() * list.length)];
      answerEl.className = CLS.answer;
      answerEl.textContent = '📢 "' + lastSabda + '"';
      initial.classList.add('hidden');
      answerEl.classList.remove('hidden');
      copyBtn.classList.remove('hidden');
    }

    function pull() {
      if (pulling) return;
      initial.classList.add('hidden');
      answerEl.classList.remove('hidden');

      // Pertanyaan kosong → sabda penolakan (mekanik mainan: gak ditarik, langsung jawab)
      if (!input.value.trim()) {
        lastSabda = '';
        copyBtn.classList.add('hidden');
        answerEl.className = CLS.empty;
        answerEl.textContent = t('magic.empty_q', 'Isi pertanyaannya dulu, Squidward! 🙄');
        return;
      }

      pulling = true;
      copyBtn.classList.add('hidden');
      answerEl.className = CLS.loading;
      answerEl.textContent = t('magic.loading', '*Sreeettt... (Tali ditarik)* 🤔');

      // Getar — 16 tick × 60ms ≈ 1 dtk, sama kayak jeda "berpikir" di referensi
      const shakes = 16;
      let i = 0;
      __pullInt = window.setInterval(() => {
        i++;
        const x = (i % 2 === 0 ? 10 : -10) * (1 - i / shakes);
        conch.style.transform = 'rotate(' + x + 'deg)';
        if (i >= shakes) {
          clearInterval(__pullInt!);
          __pullInt = null;
          conch.style.transform = '';
          pulling = false;
          showSabda();
        }
      }, 60);
    }

    conch.addEventListener('click', pull);
    pullBtn.addEventListener('click', pull);
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') pull(); });

    copyBtn.addEventListener('click', async () => {
      if (!lastSabda) return;
      try { await navigator.clipboard.writeText(lastSabda); toast('Jawaban disalin'); }
      catch { toast('Gagal menyalin', 'error'); }
    });
  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __lifeMagic8ballPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __lifeMagic8ballPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

  // Cleanup (#2): timer getar dibersihkan saat pindah halaman
  document.addEventListener('astro:page-leave', () => {
    if (__pullInt !== null) { clearInterval(__pullInt); __pullInt = null; }
  });
</script>
