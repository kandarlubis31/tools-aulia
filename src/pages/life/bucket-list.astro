---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="Bucket List — Catat Goals & Mimpi | MasAul Tools" description="Catat & track mimpi hidup. 100% client-side localStorage." category="Life" toolHref="/life/bucket-list">
  <ToolPageHeader title="Bucket List" description="Catat mimpi & goals — progress tracker" icon='<path d="M12 2L15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2z" />' />

  <div class="card-base p-5 space-y-4">
    <div class="flex gap-2">
      <input id="goal-input" type="text" class="input-field flex-1 text-sm" placeholder="Apa yang ingin kamu capai?" data-i18n-attr="placeholder" data-i18n="ph.goal_placeholder">
      <button id="add-btn" class="btn-primary text-sm" data-i18n="btn.add_goal">Tambah Goal</button>
    </div>

    <div id="goals" class="space-y-2"></div>
    <p class="text-xs text-matte-400 text-center" id="empty-msg" data-i18n="text.bucket_empty">✨ Tambah mimpi pertama kamu di atas!</p>
  </div>
</BaseLayout>

<script>
  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const KEY = 'bucket_list';
  const goalInput = document.getElementById('goal-input') as HTMLInputElement;
  const goalsEl = document.getElementById('goals')!;
  const emptyMsg = document.getElementById('empty-msg')!;
  let goals: { text: string; date: string; done: boolean }[] = [];
  try { goals = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { goals = []; }

  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);
  function esc(s: unknown) { return String(s ?? '').replace(/</g, '&lt;'); }

  function save() { localStorage.setItem(KEY, JSON.stringify(goals)); render(); }

  function render() {
    const done = goals.filter(g => g.done).length;
    goalsEl.innerHTML = goals.length
      ? `<p class="text-xs text-matte-400 text-center">${done}/${goals.length} <span data-i18n="text.goals_done">tercapai</span> 🎯</p>` +
        goals.map((g, i) => `<div class="card-base p-3 flex items-center gap-3 ${g.done ? 'opacity-60' : ''}">
        <input type="checkbox" data-idx="${i}" ${g.done ? 'checked' : ''} class="rounded w-5 h-5">
        <span class="flex-1 text-sm ${g.done ? 'line-through text-matte-400' : ''}">${esc(g.text)}</span>
        <span class="text-xs text-matte-400">${esc(g.date)}</span>
        <button data-idx="${i}" class="text-red-400 hover:text-red-600 del-goal text-sm" aria-label="Delete">✕</button>
      </div>`).join('')
      : '';
    emptyMsg.classList.toggle('hidden', goals.length > 0);

    goalsEl.querySelectorAll<HTMLElement>('[data-idx]').forEach(el => {
      if (el.tagName === 'INPUT') el.addEventListener('change', function (this: HTMLInputElement) { goals[Number(this.dataset.idx)].done = this.checked; save(); });
      else el.addEventListener('click', function (this: HTMLElement) { goals.splice(Number(this.dataset.idx), 1); save(); });
    });
  }

  document.getElementById('add-btn')!.addEventListener('click', () => {
    const text = goalInput.value.trim();
    if (!text) { toast('Tulis goal dulu!', 'error'); return; }
    if (text.length > 200) { toast('Goal terlalu panjang (maks 200 karakter)', 'error'); return; }
    goals.push({ text, date: new Date().toISOString().slice(0, 10), done: false });
    goalInput.value = '';
    save();
    toast('Goal ditambahkan!');
  });
  goalInput.addEventListener('keydown', e => { if (e.key === 'Enter') document.getElementById('add-btn')!.click(); });

  render();

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __lifeBucketListPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __lifeBucketListPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
