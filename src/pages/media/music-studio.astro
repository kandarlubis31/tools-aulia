  const drumsEl = document.getElementById('ms-drums')!;
  const kitSelect = document.getElementById('ms-kit') as HTMLSelectElement;
  const pianoEl = document.getElementById('ms-piano')!;
  const synthTabs = document.getElementById('ms-synth-tabs')!;
  const presetSelect = document.getElementById('ms-preset') as HTMLSelectElement;
  const mixerEl = document.getElementById('ms-mixer')!;
  const songEl = document.getElementById('ms-song')!;
  const songCount = document.getElementById('ms-song-count')!;
  const songClearBtn = document.getElementById('ms-song-clear') as HTMLButtonElement;
  const songAddEl = document.getElementById('ms-song-add')!;
  const noteLengthSelect = document.getElementById('ms-note-length') as HTMLSelectElement;
  const noteVelocitySlider = document.getElementById('ms-note-velocity') as HTMLInputElement;
  const noteVelocityValue = document.getElementById('ms-note-velocity-val')!;
  const saveBtn = document.getElementById('ms-save') as HTMLButtonElement;
  const projectExportBtn = document.getElementById('ms-project-export') as HTMLButtonElement;
  const projectFileInput = document.getElementById('ms-project-file') as HTMLInputElement;

  // ── Audio engine ───────────────────────────────────────────
  let audioCtx: AudioContext | null = null;
  let masterNode: GainNode | null = null;

  // Satu strip (gain + panner) per track, dibuat SEKALI per AudioContext.
  // Dulu tiap hit bikin 1 gain + 1 panner baru → ratusan node/detik + GC.
  const stripCache = new WeakMap<BaseAudioContext, StripSet>();
  const noiseCache = new WeakMap<BaseAudioContext, AudioBuffer>();

  function hasSolo(): boolean {
    return mixer.some((m) => m.solo);
  }

  function trackAudible(index: number): boolean {
    const m = mixer[index];
    if (m.mute) return false;
    return !hasSolo() || m.solo;
  }

  function trackGain(index: number): number {
    return trackAudible(index) ? mixer[index].vol : 0;
  }

  function getStrips(ctx: BaseAudioContext, dest: AudioNode): StripSet {
    let set = stripCache.get(ctx);
    if (!set) {
      const gains: GainNode[] = [];
      const pans: StereoPannerNode[] = [];
      for (let i = 0; i < MIXER_NAMES.length; i++) {
        const gain = ctx.createGain();
        gain.gain.value = trackGain(i);
        const pan = ctx.createStereoPanner();
        pan.pan.value = mixer[i].pan;
        gain.connect(pan);
        pan.connect(dest);
        gains.push(gain);
        pans.push(pan);
      }
      set = { gains, pans };
      stripCache.set(ctx, set);
    }
    return set;
  }

  function getCtx(): AudioContext {
    if (!audioCtx) {
      audioCtx = new AudioContext();
      masterNode = audioCtx.createGain();
      masterNode.gain.value = masterVol;
      masterNode.connect(audioCtx.destination);
      getStrips(audioCtx, masterNode);
    }
    return audioCtx;
  }

  function syncMixerNodes(): void {
    if (!audioCtx || !masterNode) return;
    const set = stripCache.get(audioCtx);
    if (!set) return;
    const now = audioCtx.currentTime;
    for (let i = 0; i < MIXER_NAMES.length; i++) {
      set.gains[i].gain.setTargetAtTime(trackGain(i), now, 0.01);
      set.pans[i].pan.setTargetAtTime(mixer[i].pan, now, 0.01);
    }
  }

  // Satu buffer noise 1 detik dipakai ulang (random offset per hit) — dulu
  // tiap snare/hat/clap mengisi buffer baru sample-per-sample (mahal + GC).
  function noiseBuffer(ctx: BaseAudioContext): AudioBuffer {
    let buffer = noiseCache.get(ctx);
    if (!buffer) {
      buffer = ctx.createBuffer(1, Math.floor(ctx.sampleRate), ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
      noiseCache.set(ctx, buffer);
    }
    return buffer;
  }

  function noiseSource(ctx: BaseAudioContext, when: number, duration: number): AudioBufferSourceNode {
    const buffer = noiseBuffer(ctx);
    const src = ctx.createBufferSource();
    src.buffer = buffer;
    const maxOffset = Math.max(0, buffer.duration - duration - 0.01);
    src.start(when, Math.random() * maxOffset, duration);
    return src;
  }

  function playDrum(ctx: BaseAudioContext, dest: AudioNode, id: string, when: number, vel: number): void {
    const kit = KITS[kitIndex];

    if (id === 'kick') {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(kit.kick.f0, when);
      osc.frequency.exponentialRampToValueAtTime(kit.kick.f1, when + 0.13);
      gain.gain.setValueAtTime(vel, when);
      gain.gain.exponentialRampToValueAtTime(0.001, when + kit.kick.decay);
      osc.connect(gain);
      gain.connect(dest);
      osc.start(when);
      osc.stop(when + kit.kick.decay + 0.02);
      return;
    }

    if (id === 'snare') {
      const osc = ctx.createOscillator();
      const tone = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(kit.snare.tone, when);
      tone.gain.setValueAtTime(0.5 * vel, when);
      tone.gain.exponentialRampToValueAtTime(0.001, when + 0.12);
      osc.connect(tone);
      tone.connect(dest);
      osc.start(when);
      osc.stop(when + 0.14);

      const noise = noiseSource(ctx, when, 0.16);
      const hp = ctx.createBiquadFilter();
      hp.type = 'highpass';
      hp.frequency.value = kit.snare.hp;
      const ng = ctx.createGain();
      ng.gain.setValueAtTime(0.6 * vel, when);
      ng.gain.exponentialRampToValueAtTime(0.001, when + kit.snare.decay);
      noise.connect(hp);
      hp.connect(ng);
      ng.connect(dest);
      return;
    }

    if (id === 'clap') {
      for (let i = 0; i < 3; i++) {
        const at = when + i * kit.clap.spread;
        const noise = noiseSource(ctx, at, 0.03);
        const hp = ctx.createBiquadFilter();
        hp.type = 'highpass';
        hp.frequency.value = kit.clap.hp;
        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.5 * vel, at);
        gain.gain.exponentialRampToValueAtTime(0.001, at + kit.clap.decay + 0.01);
        noise.connect(hp);
        hp.connect(gain);
        gain.connect(dest);
      }
      return;
    }

    if (id === 'hat' || id === 'ohat') {
      const cfg = id === 'hat' ? kit.hat : kit.ohat;
      const noise = noiseSource(ctx, when, cfg.decay + 0.02);
      const hp = ctx.createBiquadFilter();
      hp.type = 'highpass';
      hp.frequency.value = cfg.hp;
      const gain = ctx.createGain();
      gain.gain.setValueAtTime((id === 'hat' ? 0.45 : 0.3) * vel, when);
      gain.gain.exponentialRampToValueAtTime(0.001, when + cfg.decay);
      noise.connect(hp);
      hp.connect(gain);
      gain.connect(dest);
      return;
    }

    // perc
    const osc = ctx.createOscillator();
    const bp = ctx.createBiquadFilter();
    const gain = ctx.createGain();
    osc.type = kit.perc.type;
    osc.frequency.setValueAtTime(kit.perc.f0, when);
    osc.frequency.exponentialRampToValueAtTime(kit.perc.f1, when + kit.perc.decay * 0.7);
    bp.type = 'bandpass';
    bp.frequency.value = kit.perc.bp;
    bp.Q.value = 1.4;
    gain.gain.setValueAtTime(0.5 * vel, when);
    gain.gain.exponentialRampToValueAtTime(0.001, when + kit.perc.decay);
    osc.connect(bp);
    bp.connect(gain);
    gain.connect(dest);
    osc.start(when);
    osc.stop(when + kit.perc.decay + 0.02);
  }

  function scheduleNote(
    ctx: BaseAudioContext,
    dest: AudioNode,
    midi: number,
    preset: SynthPreset,
    when: number,
    duration: number,
    vel: number,
  ): void {
    const osc = ctx.createOscillator();
    osc.type = preset.wave;
    osc.frequency.value = midiToFreq(midi);

    const filter = ctx.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.value = preset.cutoff;
    filter.Q.value = preset.q;

    const env = ctx.createGain();
    const peak = 0.7 * vel;
    const sustain = Math.max(0.0001, peak * preset.sustain);
    const attackEnd = when + preset.attack;
    const decayEnd = attackEnd + preset.decay;
    const releaseStart = Math.max(decayEnd, when + duration * 0.65);

    env.gain.setValueAtTime(0.0001, when);
    env.gain.exponentialRampToValueAtTime(peak, attackEnd);
    env.gain.exponentialRampToValueAtTime(sustain, decayEnd);
    env.gain.setValueAtTime(sustain, releaseStart);
    env.gain.exponentialRampToValueAtTime(0.0001, releaseStart + preset.release);

    osc.connect(filter);
    filter.connect(env);
    env.connect(dest);
    osc.start(when);
    osc.stop(releaseStart + preset.release + 0.03);
  }

  function scheduleClick(ctx: BaseAudioContext, dest: AudioNode, when: number, accent: boolean): void {
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'square';
    osc.frequency.value = accent ? 1600 : 1100;
    gain.gain.setValueAtTime(0.12, when);
    gain.gain.exponentialRampToValueAtTime(0.001, when + 0.03);
    osc.connect(gain);
    gain.connect(dest);
    osc.start(when);
    osc.stop(when + 0.04);
  }

  // ── Playback ───────────────────────────────────────────────
  let playing = false;
  let timerId = 0;
  let rafId = 0;
  let startAt = 0;
  let nextStep = 0;
  let chain: number[] = [];
  let audioSources: AudioBufferSourceNode[] = [];
  let currentStepShown = -1;
  let playbackEndAt = 0;

  const barDur = () => (60 / bpm) * 4;
  const stepDur = () => barDur() / STEPS;
  const arrangement = () => (mode === 'song' ? song : [currentPattern]);
  const swingOffset = (stepIndex: number, duration: number) =>
    stepIndex % 2 === 1 ? (swing / 100) * duration * 0.5 : 0;
  const cellVelocity = (cell: HTMLElement) => Number(cell.style.getPropertyValue('--ms-velocity')) || 0;
  const timeFor = (stepIndex: number, duration: number) =>
    startAt + stepIndex * duration + swingOffset(stepIndex, duration);

  function scheduleStepAt(
    ctx: BaseAudioContext,
    strips: StripSet,
    pat: PatternState,
    step: number,
    when: number,
    durPerStep: number,
  ): void {
    DRUMS.forEach((def, i) => {
      const state = pat.drums[i][step];
      if (!state || !trackAudible(i)) return;
      playDrum(ctx, strips.gains[i], def.id, when, state === 2 ? 1.35 : 1);
    });

    SYNTHS.forEach((syn, i) => {
      const trackIdx = synthTrack(i);
      if (!trackAudible(trackIdx)) return;
      const preset = SYNTH_PRESETS[presets[i]];
      for (let row = 0; row < NOTES; row++) {
        const note = pat.notes[i][row][step];
        if (!note) continue;
        scheduleNote(ctx, strips.gains[trackIdx], syn.base + row, preset, when, Math.max(durPerStep, durPerStep * note.length - preset.release), note.velocity / 127);
      }
    });
  }

  function scheduleAudioTracks(ctx: BaseAudioContext, strips: StripSet, t0: number, bars: number[]): void {
    const barSeconds = barDur();
    audioTracks.forEach((audio, i) => {
      if (!audio.buffer || audio.startBar > bars.length) return;
      const trackIdx = audioTrack(i);
      if (!trackAudible(trackIdx)) return;
      const src = ctx.createBufferSource();
      src.buffer = audio.buffer;
      src.connect(strips.gains[trackIdx]);
      src.start(t0 + (audio.startBar - 1) * barSeconds);
      audioSources.push(src);
    });
  }

  function scheduleAhead(): void {
    if (!playing || !audioCtx || !masterNode) return;
    const ctx = audioCtx;
    const strips = getStrips(ctx, masterNode);
    const ahead = ctx.currentTime + 0.15;
    const dur = stepDur();

    if (mode === 'pattern') {
      while (timeFor(nextStep, dur) < ahead) {
        const when = timeFor(nextStep, dur);
        if (metronome && nextStep % 4 === 0 && masterNode) {
          scheduleClick(ctx, masterNode, when, nextStep % 16 === 0);
        }
        scheduleStepAt(ctx, strips, patterns[currentPattern], nextStep % STEPS, when, dur);
        nextStep++;
      }
      return;
    }

    const total = chain.length * STEPS;
    while (nextStep < total && timeFor(nextStep, dur) < ahead) {
      const when = timeFor(nextStep, dur);
      const bar = Math.floor(nextStep / STEPS);
      if (metronome && nextStep % 4 === 0 && masterNode) {
        scheduleClick(ctx, masterNode, when, nextStep % 16 === 0);
      }
      scheduleStepAt(ctx, strips, patterns[chain[bar]], nextStep % STEPS, when, dur);
      nextStep++;
    }
  }

  function tickUI(): void {
    if (!playing || !audioCtx) return;
    const elapsed = audioCtx.currentTime - startAt;
    const pos = Math.max(0, elapsed) / stepDur();
    currentStepShown = Math.floor(pos) % STEPS;
    applyStepHighlight(currentStepShown);

    if (mode === 'song') {
      const bar = Math.min(chain.length - 1, Math.max(0, Math.floor(pos / STEPS)));
      highlightPlayingPattern(chain[bar]);
      if (audioCtx.currentTime >= playbackEndAt) {
        stopPlayback();
        return;
      }
    } else {
      highlightPlayingPattern(currentPattern);
    }

    rafId = requestAnimationFrame(tickUI);
  }

  function startPlayback(): void {
    if (playing) {
      stopPlayback();
      return;
    }
    if (mode === 'song' && song.length === 0) {
      toast('Susunan lagu kosong.', 'error');
      return;
    }

    const ctx = getCtx();
    ctx.resume().catch(() => {});
    chain = arrangement();
    audioSources = [];
    startAt = ctx.currentTime + 0.12;
    nextStep = 0;
    playing = true;

    const barSeconds = barDur();
    let songEnd = chain.length * barSeconds;
    audioTracks.forEach((audio) => {
      if (!audio.buffer || audio.startBar > chain.length) return;
      songEnd = Math.max(songEnd, (audio.startBar - 1) * barSeconds + audio.buffer.duration);
    });
    playbackEndAt = startAt + songEnd;

    if (mode === 'song' && masterNode) {
      scheduleAudioTracks(ctx, getStrips(ctx, masterNode), startAt, chain);
    }

    timerId = window.setInterval(scheduleAhead, 25);
    scheduleAhead();
    rafId = requestAnimationFrame(tickUI);
    updatePlayUI();
  }

  function stopPlayback(): void {
    playing = false;
    if (timerId) {
      clearInterval(timerId);
      timerId = 0;
    }
    if (rafId) {
      cancelAnimationFrame(rafId);
      rafId = 0;
    }
    audioSources.forEach((src) => {
      try {
        src.stop();
      } catch {
        /* already stopped */
      }
    });
    audioSources = [];
    currentStepShown = -1;
    applyStepHighlight(-1);
    highlightPlayingPattern(-1);
    updatePlayUI();
  }

  function updatePlayUI(): void {
    playIcon.textContent = playing ? '\u275A\u275A' : '\u25B6';
    playBtn.classList.toggle('ring-2', playing);
    playBtn.classList.toggle('ring-rose-300', playing);
  }

  // ── Highlight (dulu querySelectorAll tiap frame = sumber lag) ──
  const stepCells: HTMLElement[][] = Array.from({ length: STEPS }, () => []);
  let highlightedStep = -1;
  let shownPattern = -1;
  let patternChips: HTMLElement[] = [];

  function applyStepHighlight(step: number): void {
    if (step === highlightedStep) return;
    const previous = highlightedStep;
    highlightedStep = step;
    if (previous >= 0) {
      stepCells[previous]?.forEach((el) => {
        el.classList.remove('is-playing');
        el.style.removeProperty('--ms-playhead-velocity');
      });
    }
    if (step >= 0) {
      stepCells[step]?.forEach((el) => {
        el.classList.add('is-playing');
        if (el.matches('#ms-piano .ms-cell')) el.style.setProperty('--ms-playhead-velocity', String(cellVelocity(el)));
      });
    }
  }

  function highlightPlayingPattern(patternIndex: number): void {
    if (patternIndex === shownPattern) return;
    const previous = shownPattern;
    shownPattern = patternIndex;
    if (previous >= 0) patternChips[previous]?.classList.remove('is-playing');
    if (patternIndex >= 0) patternChips[patternIndex]?.classList.add('is-playing');
  }

  function rebuildStepCells(): void {
    stepCells.forEach((cells) => {
      cells.length = 0;
    });
    highlightedStep = -1;
    root.querySelectorAll<HTMLElement>('.ms-cell[data-ms-step]').forEach((el) => {
      const step = Number(el.dataset.msStep);
      if (step >= 0 && step < STEPS) stepCells[step].push(el);
    });
    if (playing) applyStepHighlight(currentStepShown);
  }

  // ── Rendering ──────────────────────────────────────────────
  function renderStepNumbers(): void {
    drumNumbers.innerHTML = '';
    for (let i = 0; i < STEPS; i++) {
      const el = document.createElement('div');
      el.className = `flex-1 text-center text-2xs font-mono font-bold ${i % 4 === 0 ? 'text-rose-500' : 'text-matte-400'}`;
      el.textContent = String(i + 1);
      drumNumbers.appendChild(el);
    }
  }

  function updateDrumRow(rowIndex: number): void {
    const cells = drumsEl.querySelectorAll<HTMLButtonElement>(`.ms-cell[data-drum="${rowIndex}"]`);
    for (let step = 0; step < STEPS; step++) {
      const cell = cells[step];
      if (!cell) continue;
      cell.className = drumCellClass(patterns[currentPattern].drums[rowIndex][step], step % 4 === 0) +
        (step === highlightedStep ? ' is-playing' : '');
    }
  }

  function renderDrums(): void {
    drumsEl.innerHTML = '';
    DRUMS.forEach((def, i) => {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-1';

      const label = document.createElement('div');
      label.className = 'w-24 shrink-0 text-2xs font-bold text-matte-500 truncate pr-2';
      label.textContent = def.name;
      row.appendChild(label);

      const grid = document.createElement('div');
      grid.className = 'flex flex-1 gap-0.5';

      for (let s = 0; s < STEPS; s++) {
        const cell = document.createElement('button');
        const state = patterns[currentPattern].drums[i][s];
        const beat = s % 4 === 0;
        cell.className = drumCellClass(state, beat);
        cell.dataset.msStep = String(s);
        cell.dataset.drum = String(i);
        cell.setAttribute('aria-label', `${def.name} step ${s + 1}`);
        grid.appendChild(cell);
      }

      row.appendChild(grid);
      drumsEl.appendChild(row);
    });
  }

  function renderSynthTabs(): void {
    synthTabs.innerHTML = '';
    SYNTHS.forEach((syn, i) => {
      const btn = document.createElement('button');
      btn.className = `px-3 py-1 rounded-lg text-2xs font-bold transition-colors ${
        i === currentSynth
          ? 'bg-violet-500 text-white'
          : 'bg-matte-100 dark:bg-surface-elevated text-matte-500 hover:text-violet-500'
      }`;
      btn.textContent = syn.name;
      btn.addEventListener('click', () => {
        currentSynth = i;
        presetSelect.value = String(presets[i]);
        selectedNote = null;
        refreshPiano();
        queueAutosave();
      });
      synthTabs.appendChild(btn);
    });
  }

  function updatePianoRow(synthIndex: number, row: number): void {
    if (synthIndex !== currentSynth) return;
    const pat = patterns[currentPattern];
    const syn = SYNTHS[synthIndex];
    const black = noteName(syn.base + row).includes('#');
    const cells = pianoEl.querySelectorAll<HTMLButtonElement>(`.ms-cell[data-note="${row}"]`);
    for (let step = 0; step < STEPS; step++) {
      const cell = cells[step];
      if (!cell) continue;
      const rowNotes = pat.notes[synthIndex][row];
      const head = rowNotes[step];
      let owner: NoteState | null = null;
      let headStep = -1;
      if (!head) {
        for (let candidateStep = step - 1; candidateStep >= 0; candidateStep--) {
          const candidate = rowNotes[candidateStep];
          if (candidate && candidateStep + candidate.length > step) {
            owner = candidate;
            headStep = candidateStep;
            break;
          }
        }
      }
      const tail = !head && !!owner;
      const noteStep = head ? step : headStep;
      cell.className = pianoCellClass(!!head || tail, black, step % 4 === 0) +
        (head ? ' ms-note-head' : tail ? ' ms-note-tail' : '') +
        (selectedNote?.synth === synthIndex && selectedNote.row === row && selectedNote.step === noteStep ? ' ms-note-selected' : '') +
        (step === highlightedStep ? ' is-playing' : '');
      cell.style.setProperty('--ms-velocity', String(head ? head.velocity / 127 : owner ? owner.velocity / 127 : 0));
      if (step === highlightedStep) cell.style.setProperty('--ms-playhead-velocity', String(cellVelocity(cell)));
      else cell.style.removeProperty('--ms-playhead-velocity');
      if (head) {
        cell.dataset.noteLength = String(head.length);
        cell.title = `${noteName(syn.base + row)} · step ${step + 1} · ${head.length}/16 · ${Math.round(head.velocity / 127 * 100)}%`;
      } else {
        delete cell.dataset.noteLength;
        cell.title = `${noteName(syn.base + row)} · step ${step + 1}${tail ? ` · ${owner.length}/16` : ''}`;
      }
    }
