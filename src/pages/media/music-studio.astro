  // ── Preview ────────────────────────────────────────────────
  function previewDrum(trackIdx: number, vel: number): void {
    const ctx = getCtx();
    if (!masterNode) return;
    const strips = getStrips(ctx, masterNode);
    playDrum(ctx, strips.gains[trackIdx], DRUMS[trackIdx].id, ctx.currentTime + 0.01, Math.max(0.6, vel));
  }

  function previewNote(synthIdx: number, midi: number, velocity = 0.8): void {
    const ctx = getCtx();
    if (!masterNode) return;
    const strips = getStrips(ctx, masterNode);
    scheduleNote(ctx, strips.gains[synthTrack(synthIdx)], midi, SYNTH_PRESETS[presets[synthIdx]], ctx.currentTime + 0.01, 0.3, velocity);
  }

  // ── Audio import ───────────────────────────────────────────
  async function importAudio(index: number, file: File): Promise<void> {
    if (file.size > 40 * 1024 * 1024) {
      toast('File terlalu besar (maks 40 MB).', 'error');
      return;
    }
    try {
      const arrayBuffer = await file.arrayBuffer();
      const ctx = getCtx();
      const buffer = await ctx.decodeAudioData(arrayBuffer);
      if (buffer.duration > 720) {
        toast('Audio terlalu panjang (maks 12 menit).', 'error');
        return;
      }
      audioTracks[index] = { buffer, name: file.name, startBar: audioTracks[index].startBar };
      updateAudioUI();
      toast('Audio diimpor!');
    } catch {
      toast('Gagal membaca audio.', 'error');
    }
  }

  // ── WAV export ─────────────────────────────────────────────
  function encodeWav(buffer: AudioBuffer): Blob {
    const channels = Math.min(2, buffer.numberOfChannels);
    const bytes = buffer.length * channels * 2;
    const arrayBuffer = new ArrayBuffer(44 + bytes);
    const view = new DataView(arrayBuffer);

    const writeText = (offset: number, text: string) => {
      for (let i = 0; i < text.length; i++) view.setUint8(offset + i, text.charCodeAt(i));
    };

    writeText(0, 'RIFF');
    view.setUint32(4, 36 + bytes, true);
    writeText(8, 'WAVE');
    writeText(12, 'fmt ');
    view.setUint32(16, 16, true);
    view.setUint16(20, 1, true);
    view.setUint16(22, channels, true);
    view.setUint32(24, buffer.sampleRate, true);
    view.setUint32(28, buffer.sampleRate * channels * 2, true);
    view.setUint16(32, channels * 2, true);
    view.setUint16(34, 16, true);
    writeText(36, 'data');
    view.setUint32(40, bytes, true);

    const data: Float32Array[] = [];
    for (let ch = 0; ch < channels; ch++) data.push(buffer.getChannelData(ch));

    let offset = 44;
    for (let i = 0; i < buffer.length; i++) {
      for (let ch = 0; ch < channels; ch++) {
        const sample = Math.max(-1, Math.min(1, data[ch][i]));
        view.setInt16(offset, sample < 0 ? sample * 0x8000 : sample * 0x7fff, true);
        offset += 2;
      }
    }

    return new Blob([arrayBuffer], { type: 'audio/wav' });
  }

  async function exportWav(): Promise<void> {
    const bars = arrangement();
    if (bars.length === 0) {
      toast('Susunan lagu kosong.', 'error');
      return;
    }

    exportBtn.disabled = true;
    toast('Merender\u2026', 'info');

    try {
      const barSeconds = barDur();
      const durPerStep = stepDur();
      let duration = bars.length * barSeconds;

      audioTracks.forEach((audio) => {
        if (!audio.buffer || audio.startBar > bars.length) return;
        duration = Math.max(duration, (audio.startBar - 1) * barSeconds + audio.buffer.duration);
      });
      duration += 0.4;

      const sampleRate = 44100;
      const offline = new OfflineAudioContext(2, Math.max(1, Math.ceil(duration * sampleRate)), sampleRate);
      const out = offline.createGain();
      out.gain.value = masterVol;
      out.connect(offline.destination);
      const strips = getStrips(offline, out);

      bars.forEach((patIdx, barIdx) => {
        for (let s = 0; s < STEPS; s++) {
          // Ikutkan swing juga di render (dulu hanya playback → hasil WAV
          // beda dengan yang didengar begitu swing > 0).
          const when = barIdx * barSeconds + s * durPerStep + swingOffset(s, durPerStep);
          scheduleStepAt(offline, strips, patterns[patIdx], s, when, durPerStep);
        }
      });

      audioTracks.forEach((audio, i) => {
        if (!audio.buffer || audio.startBar > bars.length) return;
        const trackIdx = audioTrack(i);
        if (!trackAudible(trackIdx)) return;
        const src = offline.createBufferSource();
        src.buffer = audio.buffer;
        src.connect(strips.gains[trackIdx]);
        src.start((audio.startBar - 1) * barSeconds);
      });

      const rendered = await offline.startRendering();
      const blob = encodeWav(rendered);
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `music-studio-${Date.now()}.wav`;
      link.click();
      setTimeout(() => URL.revokeObjectURL(url), 1500);
      toast('WAV siap didownload!');
    } catch {
      toast('Gagal export audio.', 'error');
    } finally {
      exportBtn.disabled = false;
    }
  }

  // ── Event binding ──────────────────────────────────────────
  root.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const drumCell = target.closest<HTMLButtonElement>('#ms-drums [data-drum][data-ms-step]');
    if (drumCell) {
      const row = Number(drumCell.dataset.drum);
      const step = Number(drumCell.dataset.msStep);
      if (!Number.isInteger(row) || row < 0 || row >= DRUM_COUNT || !Number.isInteger(step) || step < 0 || step >= STEPS) return;
      const next = (patterns[currentPattern].drums[row][step] + 1) % 3;
      patterns[currentPattern].drums[row][step] = next;
      drumCell.className = drumCellClass(next, step % 4 === 0) + (step === highlightedStep ? ' is-playing' : '');
      if (next) previewDrum(row, next === 2 ? 1.35 : 1);
      queueAutosave();
      return;
    }

    const pianoCell = target.closest<HTMLButtonElement>('#ms-piano [data-note][data-ms-step]');
    if (!pianoCell) return;
    const row = Number(pianoCell.dataset.note);
    const step = Number(pianoCell.dataset.msStep);
    if (!Number.isInteger(row) || row < 0 || row >= NOTES || !Number.isInteger(step) || step < 0 || step >= STEPS) return;
    const notes = patterns[currentPattern].notes[currentSynth][row];
    let noteStep = step;
    let existing = notes[step];
    if (!existing) {
      for (let candidate = step - 1; candidate >= 0; candidate--) {
        if (notes[candidate] && candidate + notes[candidate]!.length > step) {
          noteStep = candidate;
          existing = notes[candidate];
          break;
        }
      }
    }
    if (existing) {
      if (selectedNote?.synth === currentSynth && selectedNote.row === row && selectedNote.step === noteStep) {
        notes[noteStep] = null;
        selectedNote = null;
      } else {
        selectedNote = { synth: currentSynth, row, step: noteStep };
        noteLengthSelect.value = String(existing.length);
        noteLength = existing.length;
        noteVelocity = existing.velocity;
        noteVelocitySlider.value = String(noteVelocity);
        noteVelocityValue.textContent = String(Math.round(noteVelocity / 127 * 100));
      }
    } else {
      notes[step] = { length: Math.min(noteLength, STEPS - step), velocity: noteVelocity };
      selectedNote = { synth: currentSynth, row, step };
      previewNote(currentSynth, SYNTHS[currentSynth].base + row, noteVelocity / 127);
    }
    updatePianoRow(currentSynth, row);
    queueAutosave();
  });

  function syncNoteControls(): void {
