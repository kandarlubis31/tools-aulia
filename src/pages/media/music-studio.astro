  const patCopyBtn = document.getElementById('ms-pat-copy') as HTMLButtonElement;
  const patPasteBtn = document.getElementById('ms-pat-paste') as HTMLButtonElement;
  const patClearBtn = document.getElementById('ms-pat-clear') as HTMLButtonElement;
  const demoBtn = document.getElementById('ms-demo') as HTMLButtonElement;
  const exportBtn = document.getElementById('ms-export') as HTMLButtonElement;
