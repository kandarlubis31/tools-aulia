  noteLengthSelect.addEventListener('change', () => {
    noteLength = Math.max(1, Math.min(STEPS, Number(noteLengthSelect.value) || 1));
    if (selectedNote) {
      const rowNotes = patterns[currentPattern].notes[selectedNote.synth][selectedNote.row];
      const available = Math.min(STEPS - selectedNote.step, ...rowNotes.slice(selectedNote.step + 1).map((note, offset) => note ? offset + 1 : STEPS));
      noteLength = Math.min(noteLength, available);
      const note = rowNotes[selectedNote.step];
      if (note) {
        note.length = noteLength;
        updatePianoRow(selectedNote.synth, selectedNote.row);
      }
