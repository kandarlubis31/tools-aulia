  function onKeyDown(event: KeyboardEvent): void {
    if (event.code !== 'Space') return;
    const target = event.target as HTMLElement | null;
    if (target) {
      const tag = target.tagName;
      if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA' || tag === 'BUTTON' || tag === 'A' || target.isContentEditable) return;
    }
    event.preventDefault();
    startPlayback();
  }
  document.addEventListener('keydown', onKeyDown);

  function refreshPiano(): void {
    const rows = pianoEl.children;
    for (let visualRow = 0; visualRow < NOTES; visualRow++) {
      const row = NOTES - 1 - visualRow;
      const label = rows[visualRow]?.firstElementChild;
      if (label) label.textContent = noteName(SYNTHS[currentSynth].base + row);
      updatePianoRow(currentSynth, row);
    }
    renderSynthTabs();
    presetSelect.value = String(presets[currentSynth]);
    syncNoteControls();
    rebuildStepCells();
  }

  function renderAll(): void {
    renderDrums();
    renderPiano();
    renderPatternBtns();
    renderSong();
    buildMixer();
    updateAudioUI();
    rebuildStepCells();
  }

  function projectData(): ProjectData {
    return {
      version: 1,
      patterns: patterns.map(clonePattern),
      mixer: mixer.map((track) => ({ ...track })),
      presets: [...presets],
      song: [...song],
      currentPattern,
      currentSynth,
      mode,
      bpm,
      masterVol,
      swing,
      kitIndex,
      metronome,
      noteLength,
      noteVelocity,
      audioStartBars: audioTracks.map((track) => track.startBar),
    };
  }

  function validProject(value: unknown): value is ProjectData {
    if (!value || typeof value !== 'object') return false;
    const data = value as Partial<ProjectData>;
    const validInt = (n: unknown, min: number, max: number) => Number.isInteger(n) && Number(n) >= min && Number(n) <= max;
    if (data.version !== 1 || !Array.isArray(data.patterns) || data.patterns.length !== PATTERNS ||
        !Array.isArray(data.mixer) || data.mixer.length !== MIXER_NAMES.length ||
        !Array.isArray(data.presets) || data.presets.length !== SYNTH_COUNT ||
        !Array.isArray(data.song) || data.song.length > MAX_BARS ||
        !Array.isArray(data.audioStartBars) || data.audioStartBars.length !== audioTracks.length ||
        !validInt(data.currentPattern, 0, PATTERNS - 1) || !validInt(data.currentSynth, 0, SYNTH_COUNT - 1) ||
        (data.mode !== 'pattern' && data.mode !== 'song') || !validInt(data.bpm, 40, 240) ||
        typeof data.masterVol !== 'number' || !Number.isFinite(data.masterVol) || data.masterVol < 0 || data.masterVol > 1 ||
        !validInt(data.swing, 0, 60) || !validInt(data.kitIndex, 0, KITS.length - 1) ||
        typeof data.metronome !== 'boolean' || !validInt(data.noteLength, 1, STEPS) || !validInt(data.noteVelocity, 1, 127)) return false;
    if (!data.song.every((idx) => validInt(idx, 0, PATTERNS - 1)) ||
        !data.presets.every((idx) => validInt(idx, 0, SYNTH_PRESETS.length - 1)) ||
        !data.audioStartBars.every((bar) => validInt(bar, 1, MAX_BARS))) return false;

    return data.patterns.every((pattern) =>
      !!pattern && Array.isArray(pattern.drums) && pattern.drums.length === DRUM_COUNT &&
      pattern.drums.every((row) => Array.isArray(row) && row.length === STEPS && row.every((state) => validInt(state, 0, 2))) &&
      Array.isArray(pattern.notes) && pattern.notes.length === SYNTH_COUNT &&
      pattern.notes.every((track) => Array.isArray(track) && track.length === NOTES &&
        track.every((row) => Array.isArray(row) && row.length === STEPS && row.every((note, step) =>
          note === null || (!!note && validInt(note.length, 1, Math.min(STEPS, STEPS - step)) && validInt(note.velocity, 1, 127)))))
    ) && data.mixer.every((track) =>
      !!track && typeof track.vol === 'number' && Number.isFinite(track.vol) && track.vol >= 0 && track.vol <= 1 &&
      typeof track.pan === 'number' && Number.isFinite(track.pan) && track.pan >= -1 && track.pan <= 1 &&
      typeof track.mute === 'boolean' && typeof track.solo === 'boolean'
    );
  }

  function applyProject(value: unknown): boolean {
    if (!validProject(value)) return false;
    if (playing) stopPlayback();
    const data = value;
    data.patterns.forEach((pattern, index) => { patterns[index] = clonePattern(pattern); });
    data.mixer.forEach((track, index) => { mixer[index] = { ...track }; });
    data.presets.forEach((preset, index) => { presets[index] = preset; });
    song = [...data.song];
    currentPattern = data.currentPattern;
    currentSynth = data.currentSynth;
    mode = data.mode;
    bpm = data.bpm;
    masterVol = data.masterVol;
    swing = data.swing;
    kitIndex = data.kitIndex;
    metronome = data.metronome;
    noteLength = data.noteLength;
    noteVelocity = data.noteVelocity;
    data.audioStartBars.forEach((startBar, index) => {
      audioTracks[index].startBar = startBar;
    });
    selectedNote = null;
    kitSelect.value = String(kitIndex);
    renderAll();
    updateTransportUI();
    syncNoteControls();
    syncMixerNodes();
    return true;
  }

  function queueAutosave(): void {
    if (autosaveTimer) window.clearTimeout(autosaveTimer);
    autosaveTimer = window.setTimeout(() => {
      autosaveTimer = 0;
      try {
        localStorage.setItem(LOCAL_PROJECT_KEY, JSON.stringify(projectData()));
      } catch {
        toast('Gagal menyimpan proyek di browser.', 'error');
      }
    }, 350);
  }

  function downloadProjectJson(): void {
    const blob = new Blob([JSON.stringify(projectData(), null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `music-studio-${Date.now()}.json`;
    link.click();
    setTimeout(() => URL.revokeObjectURL(url), 1500);
    toast('Ekspor JSON siap didownload!');
  }

  saveBtn.addEventListener('click', () => {
    try {
      localStorage.setItem(LOCAL_PROJECT_KEY, JSON.stringify(projectData()));
      toast('Proyek disimpan.', 'info');
    } catch {
      toast('Gagal menyimpan proyek di browser.', 'error');
    }
  });

  projectExportBtn.addEventListener('click', downloadProjectJson);
  projectFileInput.addEventListener('change', () => {
    const file = projectFileInput.files?.[0];
    projectFileInput.value = '';
    if (!file) return;
    void file.text().then((text) => {
      const data = JSON.parse(text);
      if (!applyProject(data)) {
        toast('File proyek tidak valid.', 'error');
        return;
      }
      queueAutosave();
      toast('Proyek dimuat.', 'info');
    }).catch(() => toast('File proyek tidak valid.', 'error'));
  });

  renderPresetOptions();
  renderStepNumbers();
  let restored = false;
  try {
    const saved = localStorage.getItem(LOCAL_PROJECT_KEY);
    if (saved) restored = applyProject(JSON.parse(saved));
  } catch {
    restored = false;
  }
  if (!restored) {
    renderAll();
    updateTransportUI();
  }

  return () => {
    stopPlayback();
    if (autosaveTimer) {
      window.clearTimeout(autosaveTimer);
      autosaveTimer = 0;
      try {
        localStorage.setItem(LOCAL_PROJECT_KEY, JSON.stringify(projectData()));
      } catch {
        toast('Gagal menyimpan proyek di browser.', 'error');
      }
    }
    document.removeEventListener('keydown', onKeyDown);
    window.removeEventListener('langchange', updateAudioUI);
    root.dataset.bound = '0';
    if (audioCtx) {
      void audioCtx.close().catch(() => {});
      audioCtx = null;
      masterNode = null;
    }
  };
}

let cleanup: (() => void) | null = null;

document.addEventListener('astro:page-load', () => {
  if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;
  cleanup?.();
  cleanup = init();
});

document.addEventListener('astro:page-leave', () => {
  cleanup?.();
  cleanup = null;
});
</script>
