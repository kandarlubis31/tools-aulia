---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Music Studio — Mini DAW di Browser (Drum, Piano Roll, Export WAV)">
  <div id="ms-root" class="max-w-5xl mx-auto px-4 min-h-[85vh] pb-20">
    <ToolPageHeader
      title="Music Studio"
      titleKey="header.music_studio"
      desc="Mini DAW 100% di browser: 6 drum track + 3 kit, 4 synth + preset, accent & swing, import audio/stems, mixer, song mode, export WAV. Tanpa upload."
      descKey="header.music_studio_desc"
      icon='<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M12 4v16M17 4v16"/><path d="M5 4v8M9.5 4v8M14.5 4v8M19 4v8"/>'
    />

    <div class="animate-fade-in space-y-3">
      <!-- Transport -->
      <div class="card-base p-4">
        <div class="flex flex-wrap items-center gap-3">
          <button id="ms-play" class="gradient-brand px-5 py-2 rounded-full text-sm font-bold flex items-center gap-2 active:scale-95 transition-transform">
            <span id="ms-play-icon">&#9654;</span>
            <span data-i18n="ms.play">Main</span>
          </button>

          <button id="ms-metro" class="px-2.5 py-1.5 rounded-lg text-2xs font-bold bg-matte-100 dark:bg-surface-elevated text-matte-500 transition-colors" data-i18n="ms.metronome">Metronom</button>

          <div class="flex items-center gap-1.5">
            <span class="text-2xs text-matte-400 font-bold" data-i18n="ms.bpm">BPM</span>
            <input id="ms-bpm" type="number" value="112" min="40" max="240" class="w-14 px-2 py-1.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-xs font-mono font-bold outline-none focus:ring-2 focus:ring-rose-500/40 text-center" />
            <input id="ms-bpm-slider" type="range" min="40" max="240" value="112" class="w-20 h-1 accent-rose-500" />
          </div>

          <div class="flex items-center gap-1.5">
            <span class="text-2xs text-matte-400 font-bold" data-i18n="ms.swing">Swing</span>
            <input id="ms-swing" type="range" min="0" max="60" value="0" class="w-16 h-1 accent-amber-500" />
            <span id="ms-swing-val" class="text-2xs font-mono text-matte-400 w-7">0%</span>
          </div>

          <div class="flex items-center gap-1.5">
            <span class="text-2xs text-matte-400 font-bold" data-i18n="ms.master">Master</span>
            <input id="ms-master" type="range" min="0" max="100" value="80" class="w-20 h-1 accent-violet-500" />
          </div>

          <div class="flex items-center gap-1">
            <span class="text-2xs text-matte-400 font-bold" data-i18n="ms.mode">Mode</span>
            <div class="flex gap-0.5">
              <button id="ms-mode-pattern" class="px-2.5 py-1.5 rounded-lg text-2xs font-bold transition-colors" data-i18n="ms.mode_pattern">Pattern</button>
              <button id="ms-mode-song" class="px-2.5 py-1.5 rounded-lg text-2xs font-bold transition-colors" data-i18n="ms.mode_song">Song</button>
            </div>
          </div>

          <div class="flex items-center gap-1">
            <span class="text-2xs text-matte-400 font-bold">PTN</span>
            <div id="ms-patterns" class="flex gap-0.5"></div>
            <div class="flex gap-0.5 ml-1">
              <button id="ms-pat-copy" class="px-1.5 py-1.5 rounded-lg bg-matte-100 dark:bg-surface-elevated text-2xs font-bold text-matte-500 hover:text-rose-500 transition-colors" data-i18n="ms.copy">Copy</button>
              <button id="ms-pat-paste" class="px-1.5 py-1.5 rounded-lg bg-matte-100 dark:bg-surface-elevated text-2xs font-bold text-matte-500 hover:text-rose-500 transition-colors" data-i18n="ms.paste">Paste</button>
              <button id="ms-pat-clear" class="px-1.5 py-1.5 rounded-lg bg-matte-100 dark:bg-surface-elevated text-2xs font-bold text-matte-500 hover:text-red-500 transition-colors" data-i18n="ms.reset">Reset</button>
            </div>
          </div>

          <div class="flex items-center gap-1 ml-auto">
            <button id="ms-save" class="px-3 py-1.5 rounded-lg bg-matte-100 dark:bg-surface-elevated text-2xs font-bold text-matte-500 hover:text-rose-500 transition-colors" data-i18n="ms.save">Simpan</button>
            <button id="ms-project-export" class="px-3 py-1.5 rounded-lg bg-matte-100 dark:bg-surface-elevated text-2xs font-bold text-matte-500 hover:text-rose-500 transition-colors" data-i18n="ms.export_project">JSON</button>
            <label for="ms-project-file" class="px-3 py-1.5 rounded-lg bg-matte-100 dark:bg-surface-elevated text-2xs font-bold text-matte-500 hover:text-rose-500 transition-colors cursor-pointer" data-i18n="ms.import_project">Muat JSON</label>
            <input id="ms-project-file" type="file" accept="application/json,.json" class="hidden" />
            <button id="ms-demo" class="px-3 py-1.5 rounded-lg bg-matte-100 dark:bg-surface-elevated text-2xs font-bold text-matte-500 hover:text-rose-500 transition-colors" data-i18n="ms.demo">Demo</button>
            <button id="ms-export" class="px-3 py-1.5 rounded-lg bg-rose-500 text-white text-2xs font-bold hover:bg-rose-600 transition-colors" data-i18n="ms.export">Export WAV</button>
          </div>
        </div>
      </div>

      <div class="grid lg:grid-cols-[minmax(0,1fr)_280px] gap-3 items-start">
        <div class="space-y-3">
          <!-- Drum sequencer -->
          <div class="card-base p-4 overflow-x-auto">
            <div class="flex flex-wrap items-center justify-between mb-2 gap-2">
              <h2 class="text-sm font-bold text-matte-700 dark:text-matte-200" data-i18n="ms.drums">Drum Sequencer</h2>
              <div class="flex items-center gap-2">
                <label class="flex items-center gap-1.5">
                  <span class="text-2xs text-matte-400 font-bold" data-i18n="ms.kit">Kit</span>
                  <select id="ms-kit" class="px-2 py-1 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-2xs font-bold outline-none focus:ring-2 focus:ring-rose-500/40">
                    <option value="0">808</option>
                    <option value="1">Acoustic</option>
                    <option value="2">Lo-Fi</option>
                  </select>
                </label>
                <span class="hidden sm:inline text-2xs text-matte-400" data-i18n="ms.accent_hint">Klik: off → on → aksen</span>
              </div>
            </div>
            <div class="min-w-[540px]">
              <div class="flex items-center mb-1">
                <div class="w-24 shrink-0"></div>
                <div id="ms-drum-numbers" class="flex flex-1 gap-0.5"></div>
              </div>
              <div id="ms-drums" class="space-y-1"></div>
            </div>
          </div>

          <!-- Piano roll -->
          <div class="card-base p-4">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <h2 class="text-sm font-bold text-matte-700 dark:text-matte-200" data-i18n="ms.piano">Piano Roll</h2>
              <div id="ms-synth-tabs" class="flex gap-0.5"></div>
              <label class="flex items-center gap-1.5">
                <span class="text-2xs text-matte-400 font-bold" data-i18n="ms.preset">Preset</span>
                <select id="ms-preset" class="px-2 py-1 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-2xs font-bold outline-none focus:ring-2 focus:ring-violet-500/40"></select>
              </label>
              <label class="ml-auto flex items-center gap-1.5">
                <span class="text-2xs text-matte-400 font-bold" data-i18n="ms.note_length">Length</span>
                <select id="ms-note-length" class="px-2 py-1 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-2xs font-bold outline-none focus:ring-2 focus:ring-violet-500/40">
                  <option value="1">1/16</option><option value="2">2 steps</option><option value="3">3 steps</option><option value="4">1/4</option><option value="5">5 steps</option><option value="6">6 steps</option><option value="7">7 steps</option><option value="8">1/2</option><option value="9">9 steps</option><option value="10">10 steps</option><option value="11">11 steps</option><option value="12">12 steps</option><option value="13">13 steps</option><option value="14">14 steps</option><option value="15">15 steps</option><option value="16">1 bar</option>
                </select>
              </label>
              <label class="flex items-center gap-1.5">
                <span class="text-2xs text-matte-400 font-bold" data-i18n="ms.velocity">Velocity</span>
                <input id="ms-note-velocity" type="range" min="1" max="127" value="102" class="w-16 h-1 accent-violet-500" />
                <span id="ms-note-velocity-val" class="w-6 text-right text-2xs font-mono text-matte-400">80</span>
              </label>
            </div>
            <div class="overflow-x-auto">
              <div id="ms-piano" class="min-w-[540px]"></div>
              <p class="mt-2 text-2xs text-matte-400" data-i18n="ms.stems_not_saved">Project menyimpan pattern dan mixer; file audio perlu diimpor ulang.</p>
            </div>
          </div>

          <!-- Audio import -->
          <div class="card-base p-4">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
              <h2 class="text-sm font-bold text-matte-700 dark:text-matte-200" data-i18n="ms.audio">Audio / Stems</h2>
              <span class="text-2xs text-matte-400" data-i18n="ms.audio_hint">Diputar di Song mode, mulai dari bar yang dipilih.</span>
            </div>
            <div class="grid sm:grid-cols-2 gap-3">
              <div class="rounded-xl border border-matte-200 dark:border-matte-700 p-3 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-2xs font-bold text-matte-600 dark:text-matte-300">Audio 1</span>
                  <button id="ms-audio-clear-0" class="hidden text-2xs text-matte-400 hover:text-red-500 transition-colors" title="Hapus">&#10005;</button>
                </div>
                <label class="flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg border-2 border-dashed border-matte-300 dark:border-matte-600 cursor-pointer hover:border-rose-400 transition-colors">
                  <input id="ms-audio-file-0" type="file" accept="audio/*" class="hidden" />
                  <span class="text-2xs font-bold text-matte-500 dark:text-matte-300" data-i18n="ms.import">Import audio</span>
                </label>
                <p id="ms-audio-name-0" class="text-2xs text-matte-400 italic truncate" data-i18n="ms.no_audio">Belum ada audio. Import stem dari Suno atau file WAV/MP3.</p>
                <label class="flex items-center gap-1.5">
                  <span class="text-2xs text-matte-400" data-i18n="ms.start_bar">Mulai bar</span>
                  <input id="ms-audio-start-0" type="number" min="1" max="16" value="1" class="w-14 px-2 py-1 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-2xs font-mono outline-none focus:ring-2 focus:ring-rose-500/40 text-center" />
                </label>
              </div>

              <div class="rounded-xl border border-matte-200 dark:border-matte-700 p-3 space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-2xs font-bold text-matte-600 dark:text-matte-300">Audio 2</span>
                  <button id="ms-audio-clear-1" class="hidden text-2xs text-matte-400 hover:text-red-500 transition-colors" title="Hapus">&#10005;</button>
                </div>
                <label class="flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg border-2 border-dashed border-matte-300 dark:border-matte-600 cursor-pointer hover:border-rose-400 transition-colors">
                  <input id="ms-audio-file-1" type="file" accept="audio/*" class="hidden" />
                  <span class="text-2xs font-bold text-matte-500 dark:text-matte-300" data-i18n="ms.import">Import audio</span>
                </label>
                <p id="ms-audio-name-1" class="text-2xs text-matte-400 italic truncate" data-i18n="ms.no_audio">Belum ada audio. Import stem dari Suno atau file WAV/MP3.</p>
                <label class="flex items-center gap-1.5">
                  <span class="text-2xs text-matte-400" data-i18n="ms.start_bar">Mulai bar</span>
                  <input id="ms-audio-start-1" type="number" min="1" max="16" value="1" class="w-14 px-2 py-1 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-2xs font-mono outline-none focus:ring-2 focus:ring-rose-500/40 text-center" />
                </label>
              </div>
            </div>
          </div>

          <!-- Song mode -->
          <div class="card-base p-4">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <h2 class="text-sm font-bold text-matte-700 dark:text-matte-200" data-i18n="ms.song_title">Susunan Lagu</h2>
              <span id="ms-song-count" class="text-2xs text-matte-400 font-mono"></span>
              <button id="ms-song-clear" class="ml-auto text-2xs text-matte-400 hover:text-red-500 transition-colors" data-i18n="ms.clear">Kosongkan</button>
            </div>
            <div id="ms-song" class="flex flex-wrap gap-1.5 mb-2 min-h-[30px]"></div>
            <div class="flex flex-wrap items-center gap-1.5">
              <span class="text-2xs text-matte-400" data-i18n="ms.add_bar">Tambah bar</span>
              <div id="ms-song-add" class="flex gap-0.5"></div>
            </div>
          </div>
        </div>

        <!-- Mixer -->
        <div class="card-base p-4">
          <h2 class="text-sm font-bold text-matte-700 dark:text-matte-200" data-i18n="ms.mixer">Mixer</h2>
          <div id="ms-mixer" class="space-y-2.5 mt-2"></div>
          <p class="text-2xs text-matte-400 mt-3 leading-relaxed" data-i18n="ms.privacy">Semua audio diproses di browser — file tidak pernah di-upload.</p>
        </div>
      </div>

      <p class="text-center text-2xs text-matte-400" data-i18n="ms.keys">Spasi = Play/Stop. Klik drum: off → on → aksen, piano: on/off.</p>
    </div>
  </div>
</BaseLayout>

<script>
const __page = '/media/music-studio';

const STEPS = 16;
const PATTERNS = 4;
const NOTES = 13;
const MAX_BARS = 16;
const PATTERN_LETTERS = ['A', 'B', 'C', 'D'];
const NOTE_NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];

const DRUMS = [
  { id: 'kick', name: 'Kick' },
  { id: 'snare', name: 'Snare' },
  { id: 'clap', name: 'Clap' },
  { id: 'hat', name: 'Hat' },
  { id: 'ohat', name: 'Open Hat' },
  { id: 'perc', name: 'Perc' },
];

const SYNTHS = [
  { name: 'Bass', base: 36 },
  { name: 'Lead', base: 60 },
  { name: 'Pad', base: 48 },
  { name: 'Keys', base: 60 },
];

interface SynthPreset {
  name: string;
  wave: OscillatorType;
  cutoff: number;
  q: number;
  attack: number;
  decay: number;
  sustain: number;
  release: number;
}

// Preset ala FL: satu track bisa ganti karakter tanpa ganti track.
const SYNTH_PRESETS: SynthPreset[] = [
  { name: 'Saw Lead', wave: 'sawtooth', cutoff: 2800, q: 1.2, attack: 0.008, decay: 0.09, sustain: 0.5, release: 0.06 },
  { name: 'Square Bass', wave: 'square', cutoff: 900, q: 1.4, attack: 0.006, decay: 0.1, sustain: 0.6, release: 0.05 },
  { name: 'Warm Pad', wave: 'triangle', cutoff: 1600, q: 0.7, attack: 0.12, decay: 0.25, sustain: 0.75, release: 0.35 },
  { name: 'Pluck', wave: 'sawtooth', cutoff: 3600, q: 2, attack: 0.004, decay: 0.11, sustain: 0.15, release: 0.08 },
  { name: 'Sub Sine', wave: 'sine', cutoff: 420, q: 0.6, attack: 0.01, decay: 0.08, sustain: 0.8, release: 0.06 },
];

interface Kit {
  name: string;
  kick: { f0: number; f1: number; decay: number };
  snare: { tone: number; hp: number; decay: number };
  clap: { hp: number; spread: number; decay: number };
  hat: { hp: number; decay: number };
  ohat: { hp: number; decay: number };
  perc: { type: OscillatorType; f0: number; f1: number; bp: number; decay: number };
}

// Kit = karakter drum. "Acoustic" lebih pendek/tebal, "Lo-Fi" lebih gelap.
const KITS: Kit[] = [
  {
    name: '808',
    kick: { f0: 150, f1: 40, decay: 0.45 },
    snare: { tone: 190, hp: 1400, decay: 0.15 },
    clap: { hp: 1200, spread: 0.011, decay: 0.02 },
    hat: { hp: 8000, decay: 0.05 },
    ohat: { hp: 7000, decay: 0.3 },
    perc: { type: 'square', f0: 620, f1: 420, bp: 900, decay: 0.12 },
  },
  {
    name: 'Acoustic',
    kick: { f0: 170, f1: 55, decay: 0.28 },
    snare: { tone: 180, hp: 1600, decay: 0.18 },
    clap: { hp: 1100, spread: 0.013, decay: 0.024 },
    hat: { hp: 9000, decay: 0.06 },
    ohat: { hp: 8000, decay: 0.34 },
    perc: { type: 'triangle', f0: 230, f1: 150, bp: 600, decay: 0.2 },
  },
  {
    name: 'Lo-Fi',
    kick: { f0: 120, f1: 46, decay: 0.32 },
    snare: { tone: 240, hp: 900, decay: 0.12 },
    clap: { hp: 900, spread: 0.014, decay: 0.02 },
    hat: { hp: 6500, decay: 0.045 },
    ohat: { hp: 6000, decay: 0.24 },
    perc: { type: 'triangle', f0: 420, f1: 300, bp: 700, decay: 0.1 },
  },
];

const DRUM_COUNT = DRUMS.length;
const SYNTH_COUNT = SYNTHS.length;
const MIXER_NAMES = [...DRUMS.map((d) => d.name), ...SYNTHS.map((s) => s.name), 'Audio 1', 'Audio 2'];
const synthTrack = (index: number) => DRUM_COUNT + index;
const audioTrack = (index: number) => DRUM_COUNT + SYNTH_COUNT + index;

interface NoteState {
  length: number;
  velocity: number;
}

interface PatternState {
  /** 0 = off, 1 = on, 2 = accent */
  drums: number[][];
  notes: (NoteState | null)[][][];
}

interface MixerState {
  vol: number;
  pan: number;
  mute: boolean;
  solo: boolean;
}

interface ProjectData {
  version: 1;
  patterns: PatternState[];
  mixer: MixerState[];
  presets: number[];
  song: number[];
  currentPattern: number;
  currentSynth: number;
  mode: 'pattern' | 'song';
  bpm: number;
  masterVol: number;
  swing: number;
  kitIndex: number;
  metronome: boolean;
  noteLength: number;
  noteVelocity: number;
  audioStartBars: number[];
}

interface AudioState {
  buffer: AudioBuffer | null;
  name: string;
  startBar: number;
}

interface StripSet {
  gains: GainNode[];
  pans: StereoPannerNode[];
}

function emptyPattern(): PatternState {
  return {
    drums: DRUMS.map(() => new Array<number>(STEPS).fill(0)),
    notes: SYNTHS.map(() => Array.from({ length: NOTES }, () => new Array<NoteState | null>(STEPS).fill(null))),
  };
}

function clonePattern(pattern: PatternState): PatternState {
  return {
    drums: pattern.drums.map((row) => [...row]),
    notes: pattern.notes.map((track) => track.map((row) => row.map((note) => note ? { ...note } : null))),
  };
}

function noteName(midi: number): string {
  return NOTE_NAMES[midi % 12] + (Math.floor(midi / 12) - 1);
}

function midiToFreq(midi: number): number {
  return 440 * Math.pow(2, (midi - 69) / 12);
}


function drumCellClass(state: number, beat: boolean): string {
  const base = 'ms-cell flex-1 aspect-square max-h-8 rounded-sm transition-all active:scale-90 ';
  if (state === 2) return base + 'bg-rose-400 ms-accent hover:bg-rose-300';
  if (state === 1) return base + 'bg-rose-500 hover:bg-rose-400';
  return (
    base +
    (beat
      ? 'bg-matte-200 dark:bg-surface-elevated hover:bg-rose-200 dark:hover:bg-rose-900/30'
      : 'bg-matte-100 dark:bg-matte-800 hover:bg-rose-200 dark:hover:bg-rose-900/30')
  );
}

function pianoCellClass(on: boolean, black: boolean, beat: boolean): string {
  const base = 'ms-cell flex-1 h-5 rounded-sm transition-colors ';
  if (on) return base + 'bg-violet-500 hover:bg-violet-400';
  return (
    base +
    (black
      ? 'bg-matte-200 dark:bg-surface-elevated hover:bg-violet-200 dark:hover:bg-violet-900/30'
      : beat
        ? 'bg-matte-100 dark:bg-matte-800 hover:bg-violet-100 dark:hover:bg-violet-900/20'
        : 'bg-matte-50 dark:bg-matte-800/40 hover:bg-violet-100 dark:hover:bg-violet-900/20')
  );
}

function init(): () => void {
  const root = document.getElementById('ms-root');
  if (!root || root.dataset.bound === '1') return () => {};
  root.dataset.bound = '1';

  const tI18n = (key: string, fallback: string) => window.i18n?.t?.(key, fallback) ?? fallback;
  const toast = (msg: string, type = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);
  const LOCAL_PROJECT_KEY = 'music-studio-project-v1';

  // ── State ──────────────────────────────────────────────────
  const patterns: PatternState[] = Array.from({ length: PATTERNS }, emptyPattern);
  const mixer: MixerState[] = MIXER_NAMES.map(() => ({ vol: 0.8, pan: 0, mute: false, solo: false }));
  const audioTracks: AudioState[] = [
    { buffer: null, name: '', startBar: 1 },
    { buffer: null, name: '', startBar: 1 },
  ];
  const presets: number[] = [1, 0, 2, 3];
  let song: number[] = [0, 0, 1, 0];
  let currentPattern = 0;
  let currentSynth = 0;
  let mode: 'pattern' | 'song' = 'pattern';
  let bpm = 112;
  let masterVol = 0.8;
  let swing = 0;
  let kitIndex = 0;
  let metronome = false;
  let noteLength = 1;
  let noteVelocity = 102;
  let selectedNote: { synth: number; row: number; step: number } | null = null;
  let autosaveTimer = 0;
  let patternClipboard: PatternState | null = null;

  // ── Demo content ───────────────────────────────────────────
  function seedDemo(): void {
    const paintDrums = (pat: PatternState, row: number, steps: number[], accents: number[] = []) => {
      steps.forEach((s) => {
        pat.drums[row][s] = accents.includes(s) ? 2 : 1;
      });
    };

    const a = patterns[0];
    paintDrums(a, 0, [0, 4, 8, 12], [0, 8]);
    paintDrums(a, 1, [4, 12]);
    paintDrums(a, 2, [12]);
    paintDrums(a, 3, [0, 2, 4, 6, 8, 10, 12, 14]);
    paintDrums(a, 4, [6, 14]);
    paintDrums(a, 5, [7, 15]);
    const bassA: [number, number][] = [[0, 0], [3, 0], [6, 7], [8, 3], [12, 10], [14, 7]];
    bassA.forEach(([s, r]) => {
      a.notes[0][r][s] = { length: 1, velocity: 102 };
    });

    const b = patterns[1];
    paintDrums(b, 0, [0, 4, 7, 8, 12], [0]);
    paintDrums(b, 1, [4, 12]);
    paintDrums(b, 2, [4, 12]);
    paintDrums(b, 3, [2, 6, 10, 14]);
    paintDrums(b, 4, [4, 12]);
    const bassB: [number, number][] = [[0, 7], [4, 3], [8, 0], [10, 10], [12, 7], [15, 3]];
    bassB.forEach(([s, r]) => {
      b.notes[0][r][s] = { length: 1, velocity: 102 };
    });
    const leadB: [number, number][] = [[0, 7], [2, 7], [4, 9], [6, 7], [8, 4], [10, 2], [12, 0], [14, 2]];
    leadB.forEach(([s, r]) => {
      b.notes[1][r][s] = { length: 1, velocity: 102 };
    });
    const padB: [number, number][] = [[0, 0], [8, 0]];

    padB.forEach(([s, r]) => {
      b.notes[2][r][s] = { length: 8, velocity: 80 };
      b.notes[2][r + 4][s] = { length: 8, velocity: 80 };
      b.notes[2][r + 7][s] = { length: 8, velocity: 80 };
    });
  }
  seedDemo();

  // ── DOM refs ───────────────────────────────────────────────
  const playBtn = document.getElementById('ms-play') as HTMLButtonElement;
  const playIcon = document.getElementById('ms-play-icon')!;
  const metroBtn = document.getElementById('ms-metro') as HTMLButtonElement;
  const bpmInput = document.getElementById('ms-bpm') as HTMLInputElement;
