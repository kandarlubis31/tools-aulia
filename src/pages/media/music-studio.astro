      for (let s = 0; s < STEPS; s++) {
        const cell = document.createElement('button');
        const note = patterns[currentPattern].notes[currentSynth][row][s];
        const beat = s % 4 === 0;
        cell.className = pianoCellClass(!!note, black, beat);
        cell.dataset.msStep = String(s);
