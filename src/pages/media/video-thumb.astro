---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="Video Thumbnail — Ekstrak Screenshot Video | ToolsAulia" description="Ekstrak thumbnail/screenshot dari video di waktu tertentu. 100% client-side." category="Media" toolHref="/media/video-thumb">
  <ToolPageHeader title="Video Thumbnail" description="Ekstrak frame dari video — screenshot di detik tertentu" icon='<rect x="2" y="4" width="20" height="16" rx="2"/><polygon points="10 8 16 12 10 16 10 8"/>' />

  <div class="card-base p-5 space-y-4">
    <input type="file" id="file-input" accept="video/*" class="input-field text-sm w-full">
    <div class="flex gap-2 items-end">
      <div><label class="text-xs text-matte-500 mb-1 block">Waktu (detik)</label><input id="time" type="number" min="0" step="0.1" value="5" class="input-field w-20 text-sm"></div>
      <div><label class="text-xs text-matte-500 mb-1 block">Mode</label><select id="mode" class="input-field text-sm w-32"><option value="single">Single Frame</option><option value="grid">Grid 3x3</option></select></div>
      <button id="capture-btn" class="btn-primary text-sm">Capture</button>
    </div>

    <div class="bg-matte-50 dark:bg-matte-800 rounded-lg p-3 flex justify-center flex-wrap gap-2" id="frames"></div>
    <button id="download-all" class="btn-primary w-full hidden">Download Semua PNG</button>
  </div>
</BaseLayout>

<script>
  let videoFile;
  const frames = [];

  document.getElementById('file-input').addEventListener('change', function() { videoFile = this.files[0]; });

  document.getElementById('capture-btn').addEventListener('click', async () => {
    if (!videoFile) { showToast?.(_tToast?.('Pilih video dulu','Select video first'),'error'); return; }
    const video = document.createElement('video');
    video.src = URL.createObjectURL(videoFile);
    video.muted = true;
    await new Promise(r => { video.onloadedmetadata = r; });
    const mode = document.getElementById('mode').value;
    const start = parseFloat(document.getElementById('time').value) || 5;
    const container = document.getElementById('frames');
    container.innerHTML = '';
    frames.length = 0;

    const times = mode === 'grid' ? Array.from({length:9}, (_,i) => start + i * (video.duration - start) / 9) : [start];

    for (const t of times) {
      video.currentTime = Math.min(t, video.duration - 0.1);
      await new Promise(r => { video.onseeked = r; });
      const c = document.createElement('canvas');
      c.width = video.videoWidth / 2; c.height = video.videoHeight / 2;
      c.getContext('2d').drawImage(video, 0, 0, c.width, c.height);
      c.className = 'rounded shadow cursor-pointer hover:ring-2 hover:ring-accent-blue';
      c.title = 'Klik download';
      c.addEventListener('click', () => {
        c.toBlob(b => { const a = document.createElement('a'); a.href = URL.createObjectURL(b); a.download = 'thumb-'+Math.round(t)+'s.png'; a.click(); }, 'image/png');
      });
      container.appendChild(c);
      frames.push({ canvas: c, time: t });
    }
    URL.revokeObjectURL(video.src);
    document.getElementById('download-all').classList.toggle('hidden', !frames.length);
  });

  document.getElementById('download-all').addEventListener('click', () => {
    frames.forEach((f,i) => setTimeout(() => {
      f.canvas.toBlob(b => { const a = document.createElement('a'); a.href = URL.createObjectURL(b); a.download = 'thumb-'+Math.round(f.time)+'s.png'; a.click(); }, 'image/png');
    }, i*200));
  });
</script>
