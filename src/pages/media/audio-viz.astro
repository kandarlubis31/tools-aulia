---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="Audio Visualizer" description="Real-time frequency bars dari mic atau file audio. 100% client-side WebAudio.">
  <ToolPageHeader title="Audio Visualizer" desc="Live frequency bars — mic atau file audio" icon='<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="flex flex-wrap gap-2">
      <button id="mic-btn" class="btn-primary text-sm" data-i18n="audioviz.mic">🎤 Start Mic</button>
      <input type="file" id="file-input" accept="audio/*" class="input-field text-sm">
      <select id="style" class="input-field text-sm w-32">
        <option value="bars" data-i18n="audioviz.style_bars">Bars</option>
        <option value="wave" data-i18n="audioviz.style_wave">Waveform</option>
        <option value="circle" data-i18n="audioviz.style_circle">Circle</option>
      </select>
      <button id="stop-btn" class="btn-secondary text-sm" data-i18n="audioviz.stop">Stop</button>
    </div>

    <canvas id="viz" width="800" height="250" class="w-full rounded-lg shadow bg-matte-900"></canvas>
  </div>
</BaseLayout>

<script>
  import { t } from '../../i18n/translations';
  const toast = (msg, type = 'success') => window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const canvas = document.getElementById('viz');
  const ctx = canvas ? canvas.getContext('2d') : null;
  if (!canvas || !ctx) { toast(t('audioviz.err_canvas', 'Canvas tidak tersedia di browser ini.'), 'error'); return; }
  let audioCtx, analyser, animationId, source, micStream;

  document.getElementById('mic-btn').addEventListener('click', async () => {
    try {
      micStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      audioCtx = new AudioContext();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 256;
      source = audioCtx.createMediaStreamSource(micStream);
      source.connect(analyser);
      animate();
    } catch { toast(t('audioviz.err_mic', 'Mic tidak tersedia'), 'error'); }
  });

  document.getElementById('file-input').addEventListener('change', function() {
    const f = this.files[0]; if (!f) return;
    audioCtx = new AudioContext();
    analyser = audioCtx.createAnalyser();
    analyser.fftSize = 256;
    const reader = new FileReader();
    reader.onerror = () => toast(t('audioviz.err_read', 'Gagal membaca file audio.'), 'error');
    reader.onload = () => audioCtx.decodeAudioData(reader.result).then(buf => {
      source = audioCtx.createBufferSource();
      source.buffer = buf; source.connect(analyser); analyser.connect(audioCtx.destination);
      source.start(); animate();
    }).catch(() => toast(t('audioviz.err_decode', 'Gagal mendekode audio.'), 'error'));
    reader.readAsArrayBuffer(f);
  });

  // Stop total: hentikan loop, putuskan node, TUTUP MIC (tracks), tutup AudioContext.
  // Bug lama: getUserMedia menyisakan track aktif → indikator mic tetap menyala
  // selamanya karena track-nya tidak pernah di-stop.
  function stopAll() {
    if (animationId) cancelAnimationFrame(animationId);
    animationId = null;
    try { if (source) source.disconnect(); } catch { /* node sudah lepas */ }
    if (micStream) { micStream.getTracks().forEach((t) => t.stop()); micStream = null; }
    if (audioCtx) { audioCtx.close().catch(() => { /* sudah ditutup */ }); audioCtx = null; }
    analyser = null;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
  }
  document.getElementById('stop-btn').addEventListener('click', stopAll);
  // Bersihkan saat meninggalkan halaman (SPA) — kalau tidak, RAF loop + mic tetap hidup.
  __vizStop = stopAll;

  function animate() {
    if (!analyser) return;
    animationId = requestAnimationFrame(animate);
    const bufLen = analyser.frequencyBinCount;
    const data = new Uint8Array(bufLen);
    analyser.getByteFrequencyData(data);
    const style = document.getElementById('style').value;
    ctx.fillStyle = '#0f172a'; ctx.fillRect(0,0,canvas.width,canvas.height);

    if (style === 'bars') {
      const barW = canvas.width / bufLen;
      for (let i=0; i<bufLen; i++) {
        const h = data[i]/255 * canvas.height;
        const hue = i*2;
        ctx.fillStyle = 'hsl('+hue+',80%,60%)';
        ctx.fillRect(i*barW, canvas.height-h, barW-1, h);
      }
    } else if (style === 'wave') {
      ctx.beginPath(); ctx.strokeStyle = '#06b6d4'; ctx.lineWidth = 2;
      for (let i=0; i<bufLen; i++) {
        const x = i/bufLen * canvas.width;
        const y = canvas.height/2 + (data[i]-128)/128 * canvas.height/2;
        i===0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);
      }
      ctx.stroke();
    } else {
      const cx = canvas.width/2, cy = canvas.height/2, r = Math.min(cx,cy)-10;
      ctx.beginPath(); ctx.strokeStyle = '#8b5cf6'; ctx.lineWidth = 2;
      for (let i=0; i<bufLen; i++) {
        const angle = (i/bufLen)*Math.PI*2;
        const amp = r + data[i]/255 * 40;
        const x = cx + Math.cos(angle)*amp, y = cy + Math.sin(angle)*amp;
        i===0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);
      }
      ctx.closePath(); ctx.stroke();
    }
  }

  }

  // Cleanup lintas-navigasi: satu listener di module scope (pola CONTEXT #14/#15) —
  // init() di-bind ulang tiap kunjungan jadi listener per-init akan menumpuk.
  let __vizStop = null;
  document.addEventListener('astro:before-swap', () => {
    if (__vizStop) { __vizStop(); __vizStop = null; }
  });

  // SPA boot (#14): guard path + guard dobel-bind
  const __mediaAudioVizPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __mediaAudioVizPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
