---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="Media Info — Metadata Audio/Video | MasAul Tools" description="Tampilkan metadata audio/video: codec, bitrate, durasi, resolusi. 100% client-side." category="Media" toolHref="/media/media-info">
  <ToolPageHeader title="Media Info" description="Metadata audio/video: codec, bitrate, durasi, resolusi" icon='<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>' />

  <div class="card-base p-5 space-y-4">
    <div id="drop-zone" class="border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-8 text-center cursor-pointer hover:border-accent-blue transition-colors">
      <span data-i18n="label.drop_media">🎬 Drop audio/video di sini</span>
      <input type="file" id="file-input" class="hidden" accept="audio/*,video/*">
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-sm" id="info-cards"></div>
  </div>
</BaseLayout>

<script>
  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const dz = document.getElementById('drop-zone')!;
  const cardsEl = document.getElementById('info-cards')!;
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);
  function esc(s: unknown) { return String(s ?? '').replace(/</g, '&lt;'); }
  function fmtTime(s: number) { if (!s || isNaN(s)) return 'N/A'; const m = Math.floor(s / 60), sec = Math.floor(s % 60); return m + ':' + String(sec).padStart(2, '0'); }

  fileInput.addEventListener('change', () => handleFiles(Array.from(fileInput.files || [])));
  dz.addEventListener('click', () => fileInput.click());
  dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('border-accent-blue'); });
  dz.addEventListener('dragleave', () => dz.classList.remove('border-accent-blue'));
  dz.addEventListener('drop', e => { e.preventDefault(); dz.classList.remove('border-accent-blue'); handleFiles(Array.from((e as DragEvent).dataTransfer?.files || [])); });

  function handleFiles(files: File[]) {
    const f = files[0];
    if (!f) return;
    if (!f.type.startsWith('audio/') && !f.type.startsWith('video/')) { toast('File harus audio/video!', 'error'); return; }
    const url = URL.createObjectURL(f);
    const el = document.createElement(f.type.startsWith('video') ? 'video' : 'audio');
    let settled = false;
    el.addEventListener('loadedmetadata', () => {
      settled = true;
      const cards: [string, string][] = [
        ['Nama File', f.name],
        ['Tipe', f.type || '—'],
        ['Ukuran', (f.size / 1048576).toFixed(2) + ' MB'],
        ['Durasi', fmtTime(el.duration)],
        ['Channels', String((el as any).audioTracks?.length ?? (el as any).webkitAudioSampleRate ?? 'N/A')],
      ];
      if (el.videoWidth) cards.push(['Resolusi', el.videoWidth + '×' + el.videoHeight]);
      if (el.videoWidth && el.videoHeight) cards.push(['Aspect Ratio', (el.videoWidth / el.videoHeight).toFixed(2)]);
      cards.push(['Sample Rate', String((el as any).mozSampleRate ?? 'N/A')]);
      cardsEl.innerHTML = cards.map(([k, v]) =>
        '<div class="card-base p-2"><span class="text-xs text-matte-400">' + esc(k) + '</span><p class="font-mono text-xs break-all">' + esc(v) + '</p></div>'
      ).join('');
      URL.revokeObjectURL(url);
    });
    el.addEventListener('error', () => {
      if (settled) return;
      settled = true;
      URL.revokeObjectURL(url);
      cardsEl.innerHTML = '';
      toast('Media gagal dibaca — codec mungkin tidak didukung browser', 'error');
    });
    setTimeout(() => { if (!settled) { settled = true; URL.revokeObjectURL(url); toast('Gagal memuat metadata (timeout)', 'error'); } }, 8000);
    el.src = url;
  }

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __mediaMediaInfoPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __mediaMediaInfoPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
