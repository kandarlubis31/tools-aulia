---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Beat Maker — FL Studio Style Drum Machine">
  <div class="max-w-5xl mx-auto px-4 min-h-[85vh] pb-20">
    <ToolPageHeader
      title="Beat Maker"
      titleKey="header.beat_maker"
      desc="Drum machine ala FL Studio: 16 step sequencer, 8 track, multi-kit, pattern manager, export WAV."
      descKey="header.beat_maker_desc"
      icon='<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>'
      gradient="from-orange-500 to-red-600"
    />

    <div class="animate-fade-in space-y-3">
      <!-- Top Control Bar -->
      <div class="card-base p-4">
        <div class="flex flex-wrap items-center gap-3">
          <!-- Play/Stop -->
          <button id="play-btn" class="gradient-brand px-6 py-2 rounded-full text-sm font-bold flex items-center gap-2 active:scale-95 transition-transform">
            <span id="play-icon">&#9654;</span> <span id="play-text" data-i18n="beat.play">Play</span>
          </button>

          <!-- BPM -->
          <div class="flex items-center gap-1.5">
            <span class="text-2xs text-matte-400 font-bold">BPM</span>
            <input id="bpm-input" type="number" value="120" min="40" max="300" class="w-14 px-2 py-1.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-xs font-mono font-bold outline-none focus:ring-2 focus:ring-orange-500/40 text-center" />
            <input id="bpm-slider" type="range" min="40" max="300" value="120" class="w-20 h-1 accent-orange-500" />
          </div>

          <!-- Swing -->
          <div class="flex items-center gap-1.5">
            <span class="text-2xs text-matte-400 font-bold">SWING</span>
            <input id="swing-slider" type="range" min="0" max="100" value="0" class="w-16 h-1 accent-orange-500" />
            <span id="swing-val" class="text-2xs font-mono text-matte-500 w-6">0%</span>
          </div>

          <!-- Kit Picker -->
          <div class="flex items-center gap-1.5">
            <span class="text-2xs text-matte-400 font-bold">KIT</span>
            <select id="kit-select" class="px-2 py-1.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-xs font-bold outline-none focus:ring-2 focus:ring-orange-500/40">
              <option value="808">808</option>
              <option value="909">909</option>
              <option value="acoustic">Acoustic</option>
              <option value="trap">Trap</option>
            </select>
          </div>

          <!-- Preset Patterns -->
          <div class="flex items-center gap-1.5">
            <span class="text-2xs text-matte-400 font-bold">PRESET</span>
            <select id="preset-select" class="px-2 py-1.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-xs font-bold outline-none focus:ring-2 focus:ring-orange-500/40">
              <option value="">— Load —</option>
              <option value="hiphop">Hip-Hop</option>
              <option value="techno">Techno</option>
              <option value="house">House</option>
              <option value="trap">Trap</option>
              <option value="dnb">Drum & Bass</option>
              <option value="reggaeton">Reggaeton</option>
            </select>
          </div>

          <!-- Pattern -->
          <div class="flex items-center gap-1">
            <span class="text-2xs text-matte-400 font-bold">PTN</span>
            <div id="pattern-btns" class="flex gap-0.5"></div>
          </div>

          <!-- Actions -->
          <div class="flex items-center gap-1 ml-auto">
            <button id="clear-btn" class="px-3 py-1.5 rounded-lg bg-matte-100 dark:bg-surface-elevated text-2xs font-bold text-matte-500 hover:text-red-500 transition-colors" title="Clear Pattern">CLR</button>
            <button id="copy-btn" class="px-3 py-1.5 rounded-lg bg-matte-100 dark:bg-surface-elevated text-2xs font-bold text-matte-500 hover:text-blue-500 transition-colors" title="Copy Pattern">CPY</button>
            <button id="paste-btn" class="px-3 py-1.5 rounded-lg bg-matte-100 dark:bg-surface-elevated text-2xs font-bold text-matte-500 hover:text-green-500 transition-colors" title="Paste Pattern">PST</button>
            <button id="export-btn" class="px-3 py-1.5 rounded-lg bg-orange-500 text-white text-2xs font-bold hover:bg-orange-600 transition-colors" title="Export WAV">WAV</button>
          </div>
        </div>
      </div>

      <!-- Sequencer Grid -->
      <div class="card-base p-4 overflow-x-auto">
        <div class="min-w-[700px]">
          <!-- Step Numbers -->
          <div class="flex items-center mb-2">
            <div class="w-44 shrink-0"></div>
            <div class="flex gap-0 flex-1" id="step-numbers"></div>
          </div>

          <!-- Tracks -->
          <div id="tracks-container" class="space-y-1"></div>
        </div>
      </div>

      <!-- Keyboard Shortcuts -->
      <div class="text-center">
        <button id="shortcuts-toggle" class="text-2xs text-matte-400 hover:text-matte-600 dark:hover:text-matte-300 transition-colors underline decoration-dotted">
          Keyboard Shortcuts
        </button>
        <div id="shortcuts-panel" class="hidden mt-2 card-base p-3 inline-block text-left">
          <div class="grid grid-cols-2 gap-x-6 gap-y-1 text-2xs text-matte-500">
            <span><kbd class="px-1 py-0.5 bg-matte-100 dark:bg-surface-elevated rounded font-mono">Space</kbd> Play / Stop</span>
            <span><kbd class="px-1 py-0.5 bg-matte-100 dark:bg-surface-elevated rounded font-mono">1-8</kbd> Toggle track solo</span>
            <span><kbd class="px-1 py-0.5 bg-matte-100 dark:bg-surface-elevated rounded font-mono">Q-P</kbd> Toggle step 1-16 (selected track)</span>
            <span><kbd class="px-1 py-0.5 bg-matte-100 dark:bg-surface-elevated rounded font-mono">↑↓</kbd> Select track</span>
            <span><kbd class="px-1 py-0.5 bg-matte-100 dark:bg-surface-elevated rounded font-mono">Ctrl+C</kbd> Copy pattern</span>
            <span><kbd class="px-1 py-0.5 bg-matte-100 dark:bg-surface-elevated rounded font-mono">Ctrl+V</kbd> Paste pattern</span>
            <span><kbd class="px-1 py-0.5 bg-matte-100 dark:bg-surface-elevated rounded font-mono">Ctrl+E</kbd> Export WAV</span>
            <span><kbd class="px-1 py-0.5 bg-matte-100 dark:bg-surface-elevated rounded font-mono">Backspace</kbd> Clear pattern</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
const __page = (location.pathname.replace(/\\/+$/, '') || '/');

document.addEventListener('astro:page-load', () => {if ((location.pathname.replace(/\\/+$/, '') || '/') !== __page) return;

// ════════════════════════════════════════════════════════════════
// DATA STRUCTURES
// ════════════════════════════════════════════════════════════════

const STEPS = 16;
const TRACK_DEFS = [
  { id: 'kick',    name: 'Kick',    icon: '' },
  { id: 'snare',   name: 'Snare',   icon: '' },
  { id: 'chihat',  name: 'C.Hat',   icon: '' },
  { id: 'ohihat',  name: 'O.Hat',   icon: '' },
  { id: 'clap',    name: 'Clap',    icon: '' },
  { id: 'tom',     name: 'Tom',     icon: '' },
  { id: 'cymbal',  name: 'Cymbal',  icon: '' },
  { id: 'perc',    name: 'Perc',    icon: '' },
];

const NUM_PATTERNS = 8;
const PATTERN_NAMES = 'ABCDEFGH'.split('');

interface TrackState {
  volume: number;  // 0-1
  pan: number;     // -1 to 1
  solo: boolean;
  mute: boolean;
  steps: boolean[];
  velocity: number[]; // 0-1 per step
  chance: number[];   // 0.25, 0.5, 0.75, 1.0 per step (probability)
}

interface PatternState {
  tracks: TrackState[];
}

function createEmptyTrack(): TrackState {
  return {
    volume: 0.8,
    pan: 0,
    solo: false,
    mute: false,
    steps: new Array(STEPS).fill(false),
    velocity: new Array(STEPS).fill(1),
    chance: new Array(STEPS).fill(1),
  };
}

function createEmptyPattern(): PatternState {
  return {
    tracks: TRACK_DEFS.map(() => createEmptyTrack()),
  };
}

// ════════════════════════════════════════════════════════════════
// PRESET PATTERNS
// ════════════════════════════════════════════════════════════════

function makePresetTrack(on: number[], vel: number[] = [], chance: number[] = []): TrackState {
  const steps = new Array(STEPS).fill(false);
  const velocity = new Array(STEPS).fill(1);
  const ch = new Array(STEPS).fill(1);
  on.forEach(i => { steps[i] = true; });
  vel.forEach((v, i) => { if (on[i] !== undefined) velocity[on[i]] = v; });
  chance.forEach((c, i) => { if (on[i] !== undefined) ch[on[i]] = c; });
  return { volume: 0.8, pan: 0, solo: false, mute: false, steps, velocity, chance: ch };
}

const PRESETS: Record<string, { name: string; bpm: number; swing: number; kit: string; tracks: number[][] }> = {
  hiphop: {
    name: 'Hip-Hop', bpm: 90, swing: 30, kit: '808',
    tracks: [
      [0, 4, 8, 12],                    // kick
      [4, 12],                           // snare
      [0, 2, 4, 6, 8, 10, 12, 14],      // chihat
      [],                                // ohihat
      [4, 12],                           // clap
      [],                                // tom
      [],                                // cymbal
      [6, 14],                           // perc
    ],
  },
  techno: {
    name: 'Techno', bpm: 130, swing: 0, kit: '909',
    tracks: [
      [0, 4, 8, 12],                    // kick
      [4, 12],                           // snare
      [0, 2, 4, 6, 8, 10, 12, 14],      // chihat
      [2, 6, 10, 14],                    // ohihat
      [],                                // clap
      [6, 14],                           // tom
      [0, 8],                            // cymbal
      [3, 7, 11, 15],                    // perc
    ],
  },
  house: {
    name: 'House', bpm: 124, swing: 0, kit: '909',
    tracks: [
      [0, 4, 8, 12],                    // kick
      [4, 12],                           // snare
      [0, 2, 4, 6, 8, 10, 12, 14],      // chihat
      [2, 6, 10, 14],                    // ohihat
      [],                                // clap
      [],                                // tom
      [],                                // cymbal
      [0, 8],                            // perc
    ],
  },
  trap: {
    name: 'Trap', bpm: 140, swing: 15, kit: 'trap',
    tracks: [
      [0, 3, 4, 8, 11, 12],             // kick
      [4, 12],                           // snare
      [0, 2, 3, 4, 6, 8, 10, 11, 12, 14], // chihat (fast rolls)
      [],                                // ohihat
      [],                                // clap
      [],                                // tom
      [],                                // cymbal
      [6, 14],                           // perc
    ],
  },
  dnb: {
    name: 'Drum & Bass', bpm: 174, swing: 0, kit: 'acoustic',
    tracks: [
      [0, 10],                           // kick
      [4, 12],                           // snare
      [0, 2, 4, 6, 8, 10, 12, 14],      // chihat
      [2, 6, 10, 14],                    // ohihat
      [],                                // clap
      [],                                // tom
      [0, 8],                            // cymbal
      [3, 7, 11, 15],                    // perc
    ],
  },
  reggaeton: {
    name: 'Reggaeton', bpm: 95, swing: 0, kit: '808',
    tracks: [
      [0, 3, 4, 7, 8, 11, 12, 15],      // kick (dembow)
      [4, 12],                           // snare
      [0, 2, 4, 6, 8, 10, 12, 14],      // chihat
      [],                                // ohihat
      [4, 12],                           // clap
      [],                                // tom
      [],                                // cymbal
      [2, 6, 10, 14],                    // perc
    ],
  },
};

function loadPreset(presetKey: string) {
  const preset = PRESETS[presetKey];
  if (!preset) return;

  // Set BPM + swing + kit
  bpmInput.value = String(preset.bpm);
  bpmSlider.value = String(preset.bpm);
  swingSlider.value = String(preset.swing);
  swingVal.textContent = preset.swing + '%';
  kitSelect.value = preset.kit;

  // Build pattern
  const pattern = createEmptyPattern();
  preset.tracks.forEach((onSteps, trackIdx) => {
    if (trackIdx >= pattern.tracks.length) return;
    const track = pattern.tracks[trackIdx];
    onSteps.forEach(step => { track.steps[step] = true; });
    // Add slight velocity variation for hi-hats
    if (TRACK_DEFS[trackIdx].id === 'chihat') {
      onSteps.forEach(step => {
        track.velocity[step] = step % 4 === 0 ? 1 : (0.7 + Math.random() * 0.3);
      });
    }
  });

  patterns[currentPattern] = pattern;
  renderTracks();
  (window as any).showToast?.(`Loaded: ${preset.name}`, 'success');
}

// ════════════════════════════════════════════════════════════════
// STATE
// ════════════════════════════════════════════════════════════════

let patterns: PatternState[] = Array.from({ length: NUM_PATTERNS }, createEmptyPattern);
let currentPattern = 0;
let selectedTrack = 0;
let clipboard: PatternState | null = null;

// Playback
let playing = false;
let currentStep = 0;
let timer: number | null = null;
let audioCtx: AudioContext | null = null;
let masterGain: GainNode | null = null;

// DOM refs
const bpmInput = document.getElementById('bpm-input') as HTMLInputElement;
const bpmSlider = document.getElementById('bpm-slider') as HTMLInputElement;
const swingSlider = document.getElementById('swing-slider') as HTMLInputElement;
const swingVal = document.getElementById('swing-val')!;
const kitSelect = document.getElementById('kit-select') as HTMLSelectElement;
const playBtn = document.getElementById('play-btn')!;
const playIcon = document.getElementById('play-icon')!;
const playText = document.getElementById('play-text')!;
const tracksContainer = document.getElementById('tracks-container')!;
const stepNumbers = document.getElementById('step-numbers')!;
const patternBtns = document.getElementById('pattern-btns')!;
const clearBtn = document.getElementById('clear-btn')!;
const copyBtn = document.getElementById('copy-btn')!;
const pasteBtn = document.getElementById('paste-btn')!;
const exportBtn = document.getElementById('export-btn')!;
const shortcutsToggle = document.getElementById('shortcuts-toggle')!;
const shortcutsPanel = document.getElementById('shortcuts-panel')!;

function getPattern(): PatternState { return patterns[currentPattern]; }
function getTrack(): TrackState { return getPattern().tracks[selectedTrack]; }

// ════════════════════════════════════════════════════════════════
// DRUM KIT SYNTH ENGINE
// ════════════════════════════════════════════════════════════════

function getAudioCtx(): AudioContext {
  if (!audioCtx) {
    audioCtx = new AudioContext();
    masterGain = audioCtx.createGain();
    masterGain.gain.value = 0.7;
    masterGain.connect(audioCtx.destination);
  }
  return audioCtx;
}

function playSound(trackId: string, velocity: number, pan: number, kit: string) {
  const ctx = getAudioCtx();
  if (!masterGain) return;
  const t = ctx.currentTime;
  const vel = Math.max(0.01, velocity);

  // Pan node
  const panner = ctx.createStereoPanner();
  panner.pan.value = pan;

  // Track gain (velocity + volume)
  const gain = ctx.createGain();
  gain.gain.value = vel;

  panner.connect(gain);
  gain.connect(masterGain);

  const kits: Record<string, Record<string, () => void>> = {
    '808': {
      kick: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'sine';
        o.frequency.setValueAtTime(160, t);
        o.frequency.exponentialRampToValueAtTime(30, t + 0.15);
        g.gain.setValueAtTime(1, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.5);
        o.connect(g); g.connect(panner);
        o.start(t); o.stop(t + 0.5);
      },
      snare: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'triangle';
        o.frequency.setValueAtTime(250, t);
        o.frequency.exponentialRampToValueAtTime(80, t + 0.05);
        g.gain.setValueAtTime(0.6, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.15);
        o.connect(g); g.connect(panner);
        o.start(t); o.stop(t + 0.15);
        // Noise burst
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.1, ctx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * 0.4;
        const ns = ctx.createBufferSource();
        ns.buffer = buf;
        const ng = ctx.createGain();
        ng.gain.setValueAtTime(0.5, t);
        ng.gain.exponentialRampToValueAtTime(0.001, t + 0.1);
        ns.connect(ng); ng.connect(panner);
        ns.start(t); ns.stop(t + 0.1);
      },
      chihat: () => {
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.05, ctx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);
        const ns = ctx.createBufferSource();
        ns.buffer = buf;
        const f = ctx.createBiquadFilter();
        f.type = 'highpass'; f.frequency.value = 8000;
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.4, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.05);
        ns.connect(f); f.connect(g); g.connect(panner);
        ns.start(t); ns.stop(t + 0.05);
      },
      ohihat: () => {
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.3, ctx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);
        const ns = ctx.createBufferSource();
        ns.buffer = buf;
        const f = ctx.createBiquadFilter();
        f.type = 'highpass'; f.frequency.value = 6000;
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.35, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.3);
        ns.connect(f); f.connect(g); g.connect(panner);
        ns.start(t); ns.stop(t + 0.3);
      },
      clap: () => {
        for (let j = 0; j < 3; j++) {
          const buf = ctx.createBuffer(1, ctx.sampleRate * 0.02, ctx.sampleRate);
          const data = buf.getChannelData(0);
          for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);
          const ns = ctx.createBufferSource();
          ns.buffer = buf;
          const g = ctx.createGain();
          g.gain.setValueAtTime(0.5, t + j * 0.01);
          g.gain.exponentialRampToValueAtTime(0.001, t + j * 0.01 + 0.02);
          ns.connect(g); g.connect(panner);
          ns.start(t + j * 0.01); ns.stop(t + j * 0.01 + 0.02);
        }
      },
      tom: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'sine';
        o.frequency.setValueAtTime(200, t);
        o.frequency.exponentialRampToValueAtTime(60, t + 0.2);
        g.gain.setValueAtTime(0.7, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.3);
        o.connect(g); g.connect(panner);
        o.start(t); o.stop(t + 0.3);
      },
      cymbal: () => {
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.5, ctx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);
        const ns = ctx.createBufferSource();
        ns.buffer = buf;
        const f = ctx.createBiquadFilter();
        f.type = 'bandpass'; f.frequency.value = 5000; f.Q.value = 2;
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.3, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.5);
        ns.connect(f); f.connect(g); g.connect(panner);
        ns.start(t); ns.stop(t + 0.5);
      },
      perc: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'square';
        o.frequency.setValueAtTime(800, t);
        o.frequency.exponentialRampToValueAtTime(200, t + 0.03);
        g.gain.setValueAtTime(0.3, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.08);
        o.connect(g); g.connect(panner);
        o.start(t); o.stop(t + 0.08);
      },
    },
    '909': {
      kick: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'sine';
        o.frequency.setValueAtTime(180, t);
        o.frequency.exponentialRampToValueAtTime(40, t + 0.08);
        g.gain.setValueAtTime(1, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.4);
        o.connect(g); g.connect(panner);
        o.start(t); o.stop(t + 0.4);
      },
      snare: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'triangle';
        o.frequency.setValueAtTime(300, t);
        o.frequency.exponentialRampToValueAtTime(120, t + 0.03);
        g.gain.setValueAtTime(0.7, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.12);
        o.connect(g); g.connect(panner);
        o.start(t); o.stop(t + 0.12);
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.08, ctx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * 0.5;
        const ns = ctx.createBufferSource();
        ns.buffer = buf;
        const ng = ctx.createGain();
        ng.gain.setValueAtTime(0.6, t);
        ng.gain.exponentialRampToValueAtTime(0.001, t + 0.08);
        ns.connect(ng); ng.connect(panner);
        ns.start(t); ns.stop(t + 0.08);
      },
      chihat: () => {
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.04, ctx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);
        const ns = ctx.createBufferSource();
        ns.buffer = buf;
        const f = ctx.createBiquadFilter();
        f.type = 'highpass'; f.frequency.value = 9000;
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.45, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.04);
        ns.connect(f); f.connect(g); g.connect(panner);
        ns.start(t); ns.stop(t + 0.04);
      },
      ohihat: () => {
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.25, ctx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);
        const ns = ctx.createBufferSource();
        ns.buffer = buf;
        const f = ctx.createBiquadFilter();
        f.type = 'highpass'; f.frequency.value = 7000;
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.4, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.25);
        ns.connect(f); f.connect(g); g.connect(panner);
        ns.start(t); ns.stop(t + 0.25);
      },
      clap: () => {
        for (let j = 0; j < 3; j++) {
          const buf = ctx.createBuffer(1, ctx.sampleRate * 0.015, ctx.sampleRate);
          const data = buf.getChannelData(0);
          for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);
          const ns = ctx.createBufferSource();
          ns.buffer = buf;
          const g = ctx.createGain();
          g.gain.setValueAtTime(0.5, t + j * 0.008);
          g.gain.exponentialRampToValueAtTime(0.001, t + j * 0.008 + 0.015);
          ns.connect(g); g.connect(panner);
          ns.start(t + j * 0.008); ns.stop(t + j * 0.008 + 0.015);
        }
      },
      tom: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'sine';
        o.frequency.setValueAtTime(250, t);
        o.frequency.exponentialRampToValueAtTime(70, t + 0.18);
        g.gain.setValueAtTime(0.6, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.25);
        o.connect(g); g.connect(panner);
        o.start(t); o.stop(t + 0.25);
      },
      cymbal: () => {
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.4, ctx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);
        const ns = ctx.createBufferSource();
        ns.buffer = buf;
        const f = ctx.createBiquadFilter();
        f.type = 'bandpass'; f.frequency.value = 6000; f.Q.value = 1.5;
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.35, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.4);
        ns.connect(f); f.connect(g); g.connect(panner);
        ns.start(t); ns.stop(t + 0.4);
      },
      perc: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'sawtooth';
        o.frequency.setValueAtTime(600, t);
        o.frequency.exponentialRampToValueAtTime(150, t + 0.04);
        g.gain.setValueAtTime(0.25, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.06);
        o.connect(g); g.connect(panner);
        o.start(t); o.stop(t + 0.06);
      },
    },
    'acoustic': {
      kick: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'sine';
        o.frequency.setValueAtTime(120, t);
        o.frequency.exponentialRampToValueAtTime(50, t + 0.12);
        g.gain.setValueAtTime(0.9, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.35);
        o.connect(g); g.connect(panner);
