---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Beat Maker — Drum Machine Online">
  <div class="max-w-lg mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Beat Maker"
      titleKey="header.beat_maker"
      desc="Drum machine sederhana: 4 beat × 4 track. WebAudio synth."
      descKey="header.beat_maker_desc"
      icon='<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>'
      gradient="from-orange-500 to-red-600"
    />

    <div class="animate-fade-in space-y-4">
      <div class="card-base p-5">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="text-2xs text-matte-400 font-bold">BPM:</span>
            <input id="bpm-input" type="number" value="120" min="60" max="200" class="w-16 px-2 py-1.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-xs font-mono font-bold outline-none focus:ring-2 focus:ring-orange-500/40" />
          </div>
          <button id="play-btn" class="gradient-brand px-8 py-2.5 rounded-full text-sm font-bold">
            ▶️ <span data-i18n="beat.play">Play</span>
          </button>
        </div>

        <!-- Beat grid -->
        <div id="grid" class="space-y-2 mb-4">
          {[
            { name: 'Kick', key: 'kick', freq: 60 },
            { name: 'Snare', key: 'snare', freq: 200 },
            { name: 'Hi-hat', key: 'hihat', freq: 8000 },
            { name: 'Clap', key: 'clap', freq: 1000 },
          ].map((track) => (
            <div class="flex items-center gap-2">
              <span class="w-16 text-2xs font-bold text-matte-400">{track.name}</span>
              <div class="flex gap-1 flex-1">
                {[0,1,2,3,4,5,6,7].map(step => (
                  <button class="beat-cell w-full aspect-square rounded-md bg-matte-100 dark:bg-surface-elevated hover:bg-orange-200 dark:hover:bg-orange-900/30 transition-all active:scale-90" data-track={track.key} data-step={String(step)}></button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <p class="text-center text-2xs text-matte-400">
        Klik kotak untuk aktifkan beat. 4 baris × 8 step. Play untuk dengar loop-nya!
      </p>
    </div>
  </div>
</BaseLayout>

<script>
const __page = (location.pathname.replace(/\/+$/, '') || '/');

  document.addEventListener('astro:page-load', () => {if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;

    const bpmInput = document.getElementById('bpm-input') as HTMLInputElement;
    const playBtn = document.getElementById('play-btn') as HTMLButtonElement;

    let playing = false;
    let currentStep = 0;
    let timer: number | null = null;
    let audioCtx: AudioContext | null = null;
    const grid: Record<string, boolean[]> = { kick: [], snare: [], hihat: [], clap: [] };

    function getAudioCtx() {
      if (!audioCtx) audioCtx = new AudioContext();
      return audioCtx;
    }

    function playSound(track: string) {
      const ctx = getAudioCtx();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      const filter = ctx.createBiquadFilter();

      switch (track) {
        case 'kick':
          osc.type = 'sine';
          osc.frequency.setValueAtTime(150, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(40, ctx.currentTime + 0.1);
          gain.gain.setValueAtTime(0.6, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);
          break;
        case 'snare':
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(200, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(100, ctx.currentTime + 0.05);
          gain.gain.setValueAtTime(0.3, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);
          break;
        case 'hihat':
          osc.type = 'square';
          osc.frequency.setValueAtTime(8000, ctx.currentTime);
          filter.type = 'highpass';
          filter.frequency.setValueAtTime(7000, ctx.currentTime);
          gain.gain.setValueAtTime(0.08, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);
          break;
        case 'clap':
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(1000, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(400, ctx.currentTime + 0.03);
          gain.gain.setValueAtTime(0.15, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);
          break;
      }

      osc.connect(filter);
      filter.connect(gain);
      gain.connect(ctx.destination);
      osc.start(ctx.currentTime);
      osc.stop(ctx.currentTime + 0.4);
    }

    function highlightStep(step: number) {
      document.querySelectorAll('.beat-cell').forEach(cell => {
        const el = cell as HTMLElement;
        const isActive = parseInt(el.dataset.step!) === step;
        if (isActive && grid[el.dataset.track!]?.[step]) {
          el.classList.add('ring-2', 'ring-orange-500');
          setTimeout(() => el.classList.remove('ring-2', 'ring-orange-500'), 80);
        }
      });
    }

    function tick() {
      Object.entries(grid).forEach(([track, steps]) => {
        if (steps[currentStep]) playSound(track);
      });
      highlightStep(currentStep);
      currentStep = (currentStep + 1) % 8;
      const bpm = parseInt(bpmInput.value) || 120;
      timer = window.setTimeout(tick, (60 / bpm) * 1000 / 2); // 8th notes
    }

    function start() {
      if (playing) return;
      playing = true;
      currentStep = 0;
      getAudioCtx().resume();
      tick();
      playBtn.innerHTML = '⏸️ <span data-i18n="beat.stop">Stop</span>';
      (window as any).processI18n?.();
    }

    function stop() {
      playing = false;
      if (timer) { clearTimeout(timer); timer = null; }
      playBtn.innerHTML = '▶️ <span data-i18n="beat.play">Play</span>';
      (window as any).processI18n?.();
    }

    playBtn.addEventListener('click', () => playing ? stop() : start());

    // Grid click handlers
    document.querySelectorAll('.beat-cell').forEach(cell => {
      cell.addEventListener('click', () => {
        const el = cell as HTMLElement;
        const track = el.dataset.track!;
        const step = parseInt(el.dataset.step!);
        if (!grid[track]) grid[track] = new Array(8).fill(false);
        grid[track][step] = !grid[track][step];
        if (grid[track][step]) {
          el.classList.add('bg-orange-400', 'dark:bg-orange-600');
          el.classList.remove('bg-matte-100', 'dark:bg-surface-elevated');
        } else {
          el.classList.remove('bg-orange-400', 'dark:bg-orange-600');
          el.classList.add('bg-matte-100', 'dark:bg-surface-elevated');
        }
      });
    });
  });
</script>
