        const ng = ctx.createGain();
        ng.gain.setValueAtTime(0.5, t);
        ng.gain.exponentialRampToValueAtTime(0.001, t + 0.15);
        ns.connect(f); f.connect(ng); ng.connect(panner);
        ns.start(t); ns.stop(t + 0.15);
      },
      chihat: () => {
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.06, ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1);
        const ns = ctx.createBufferSource(); ns.buffer = buf;
        const f = ctx.createBiquadFilter();
        f.type = 'highpass'; f.frequency.value = 8000;
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.35, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.06);
        ns.connect(f); f.connect(g); g.connect(panner);
        ns.start(t); ns.stop(t + 0.06);
      },
      ohihat: () => {
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.35, ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1);
        const ns = ctx.createBufferSource(); ns.buffer = buf;
        const f = ctx.createBiquadFilter();
        f.type = 'highpass'; f.frequency.value = 6000;
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.3, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.35);
        ns.connect(f); f.connect(g); g.connect(panner);
        ns.start(t); ns.stop(t + 0.35);
      },
      clap: () => {
        for (let j = 0; j < 4; j++) {
          const buf = ctx.createBuffer(1, ctx.sampleRate * 0.01, ctx.sampleRate);
          const d = buf.getChannelData(0);
          for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1);
          const ns = ctx.createBufferSource(); ns.buffer = buf;
          const g = ctx.createGain();
          g.gain.setValueAtTime(0.4, t + j * 0.007);
          g.gain.exponentialRampToValueAtTime(0.001, t + j * 0.007 + 0.01);
          ns.connect(g); g.connect(panner);
          ns.start(t + j * 0.007); ns.stop(t + j * 0.007 + 0.01);
        }
      },
      tom: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'sine';
        o.frequency.setValueAtTime(160, t);
        o.frequency.exponentialRampToValueAtTime(60, t + 0.22);
        g.gain.setValueAtTime(0.65, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.3);
        o.connect(g); g.connect(panner);
        o.start(t); o.stop(t + 0.3);
      },
      cymbal: () => {
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.6, ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1);
        const ns = ctx.createBufferSource(); ns.buffer = buf;
        const f = ctx.createBiquadFilter();
        f.type = 'bandpass'; f.frequency.value = 4000; f.Q.value = 2;
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.25, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.6);
        ns.connect(f); f.connect(g); g.connect(panner);
        ns.start(t); ns.stop(t + 0.6);
      },
      perc: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'sine';
        o.frequency.setValueAtTime(1200, t);
        o.frequency.exponentialRampToValueAtTime(400, t + 0.02);
        g.gain.setValueAtTime(0.2, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.05);
        o.connect(g); g.connect(panner);
        o.start(t); o.stop(t + 0.05);
      },
    },
    'trap': {
      kick: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'sine';
        o.frequency.setValueAtTime(200, t);
        o.frequency.exponentialRampToValueAtTime(25, t + 0.2);
        g.gain.setValueAtTime(1, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.6);
        o.connect(g); g.connect(panner);
        o.start(t); o.stop(t + 0.6);
      },
      snare: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'triangle';
        o.frequency.setValueAtTime(350, t);
        o.frequency.exponentialRampToValueAtTime(100, t + 0.03);
        g.gain.setValueAtTime(0.8, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.1);
        o.connect(g); g.connect(panner);
        o.start(t); o.stop(t + 0.1);
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.08, ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1);
        const ns = ctx.createBufferSource(); ns.buffer = buf;
        const ng = ctx.createGain();
        ng.gain.setValueAtTime(0.7, t);
        ng.gain.exponentialRampToValueAtTime(0.001, t + 0.08);
        ns.connect(ng); ng.connect(panner);
        ns.start(t); ns.stop(t + 0.08);
      },
      chihat: () => {
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.03, ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1);
        const ns = ctx.createBufferSource(); ns.buffer = buf;
        const f = ctx.createBiquadFilter();
        f.type = 'highpass'; f.frequency.value = 10000;
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.5, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.03);
        ns.connect(f); f.connect(g); g.connect(panner);
        ns.start(t); ns.stop(t + 0.03);
      },
      ohihat: () => {
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.2, ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1);
        const ns = ctx.createBufferSource(); ns.buffer = buf;
        const f = ctx.createBiquadFilter();
        f.type = 'highpass'; f.frequency.value = 8000;
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.45, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.2);
        ns.connect(f); f.connect(g); g.connect(panner);
        ns.start(t); ns.stop(t + 0.2);
      },
      clap: () => {
        for (let j = 0; j < 3; j++) {
          const buf = ctx.createBuffer(1, ctx.sampleRate * 0.012, ctx.sampleRate);
          const d = buf.getChannelData(0);
          for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1);
          const ns = ctx.createBufferSource(); ns.buffer = buf;
          const g = ctx.createGain();
          g.gain.setValueAtTime(0.6, t + j * 0.006);
          g.gain.exponentialRampToValueAtTime(0.001, t + j * 0.006 + 0.012);
          ns.connect(g); g.connect(panner);
          ns.start(t + j * 0.006); ns.stop(t + j * 0.006 + 0.012);
        }
      },
      tom: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'sine';
        o.frequency.setValueAtTime(300, t);
        o.frequency.exponentialRampToValueAtTime(50, t + 0.15);
        g.gain.setValueAtTime(0.7, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.2);
        o.connect(g); g.connect(panner);
        o.start(t); o.stop(t + 0.2);
      },
      cymbal: () => {
        const buf = ctx.createBuffer(1, ctx.sampleRate * 0.45, ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1);
        const ns = ctx.createBufferSource(); ns.buffer = buf;
        const f = ctx.createBiquadFilter();
        f.type = 'bandpass'; f.frequency.value = 7000; f.Q.value = 1.5;
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.2, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.45);
        ns.connect(f); f.connect(g); g.connect(panner);
        ns.start(t); ns.stop(t + 0.45);
      },
      perc: () => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'square';
        o.frequency.setValueAtTime(1500, t);
        o.frequency.exponentialRampToValueAtTime(300, t + 0.015);
        g.gain.setValueAtTime(0.15, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.04);
        o.connect(g); g.connect(panner);
        o.start(t); o.stop(t + 0.04);
      },
    },
  };

  const kitSounds = kits[kit] || kits['808'];
  const soundFn = kitSounds[trackId];
  if (soundFn) soundFn();
}

// ════════════════════════════════════════════════════════════════
// UI RENDERING
// ════════════════════════════════════════════════════════════════

function renderStepNumbers() {
  stepNumbers.innerHTML = '';
  for (let i = 0; i < STEPS; i++) {
    const el = document.createElement('div');
    el.className = `flex-1 text-center text-2xs font-mono font-bold ${i % 4 === 0 ? 'text-orange-500' : 'text-matte-400'}`;
    el.textContent = String(i + 1);
    stepNumbers.appendChild(el);
  }
}

function renderTracks() {
  tracksContainer.innerHTML = '';
  const pattern = getPattern();

  TRACK_DEFS.forEach((def, idx) => {
    const track = pattern.tracks[idx];
    const isSelected = idx === selectedTrack;

    const row = document.createElement('div');
    row.className = `flex items-center gap-1 rounded-lg transition-all ${isSelected ? 'bg-orange-50 dark:bg-orange-900/10 ring-1 ring-orange-300 dark:ring-orange-700' : 'hover:bg-matte-50 dark:hover:bg-surface-hover'}`;
    row.dataset.trackIdx = String(idx);

    // Track info + controls
    const trackInfo = document.createElement('div');
    trackInfo.className = 'w-44 shrink-0 flex items-center gap-1.5 px-2 py-1.5';

    // Select track on click
    trackInfo.addEventListener('click', () => { selectedTrack = idx; renderTracks(); });

    // Track name
    const nameEl = document.createElement('span');
    nameEl.className = `text-2xs font-bold ${isSelected ? 'text-orange-600 dark:text-orange-400' : 'text-matte-500'} w-12 truncate`;
    nameEl.textContent = def.name;
    trackInfo.appendChild(nameEl);

    // Solo button
    const soloBtn = document.createElement('button');
    soloBtn.className = `w-5 h-5 rounded text-2xs font-bold transition-colors ${track.solo ? 'bg-yellow-400 text-white' : 'bg-matte-200 dark:bg-surface-elevated text-matte-400 hover:text-yellow-500'}`;
    soloBtn.textContent = 'S';
    soloBtn.title = 'Solo';
    soloBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      track.solo = !track.solo;
      if (track.solo) track.mute = false;
      renderTracks();
    });
    trackInfo.appendChild(soloBtn);

    // Mute button
    const muteBtn = document.createElement('button');
    muteBtn.className = `w-5 h-5 rounded text-2xs font-bold transition-colors ${track.mute ? 'bg-red-400 text-white' : 'bg-matte-200 dark:bg-surface-elevated text-matte-400 hover:text-red-500'}`;
    muteBtn.textContent = 'M';
    muteBtn.title = 'Mute';
    muteBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      track.mute = !track.mute;
      if (track.mute) track.solo = false;
      renderTracks();
    });
    trackInfo.appendChild(muteBtn);

    // Volume slider
    const volSlider = document.createElement('input');
    volSlider.type = 'range';
    volSlider.min = '0';
    volSlider.max = '100';
    volSlider.value = String(Math.round(track.volume * 100));
    volSlider.className = 'w-12 h-1 accent-orange-500';
    volSlider.title = `Volume: ${Math.round(track.volume * 100)}%`;
    volSlider.addEventListener('input', (e) => {
      e.stopPropagation();
      track.volume = parseInt(volSlider.value) / 100;
    });
    trackInfo.appendChild(volSlider);

    // Pan knob (simplified as small slider)
    const panSlider = document.createElement('input');
    panSlider.type = 'range';
    panSlider.min = '-100';
    panSlider.max = '100';
    panSlider.value = String(Math.round(track.pan * 100));
    panSlider.className = 'w-10 h-1 accent-blue-500';
    panSlider.title = `Pan: ${track.pan === 0 ? 'C' : track.pan < 0 ? 'L' + Math.abs(track.pan * 100) : 'R' + track.pan * 100}`;
    panSlider.addEventListener('input', (e) => {
      e.stopPropagation();
      track.pan = parseInt(panSlider.value) / 100;
    });
    trackInfo.appendChild(panSlider);

    row.appendChild(trackInfo);

    // Step grid
    const gridRow = document.createElement('div');
    gridRow.className = 'flex gap-0 flex-1';

    for (let step = 0; step < STEPS; step++) {
      const cell = document.createElement('button');
      const isActive = track.steps[step];
      const isBeatStart = step % 4 === 0;
      const isCurrentStep = playing && step === currentStep;

      // Determine cell visual state
      const chance = track.chance[step];
      const vel = track.velocity[step];
      const isPartial = isActive && (chance < 1 || vel < 1);

      cell.className = `flex-1 aspect-square rounded-sm transition-all active:scale-90 ${
        isCurrentStep && isActive
          ? 'bg-orange-400 dark:bg-orange-500 ring-2 ring-orange-300'
          : isActive
            ? isPartial
              ? 'bg-orange-300/60 dark:bg-orange-700/60 border border-dashed border-orange-400 dark:border-orange-500 hover:bg-orange-400/70'
              : 'bg-orange-400 dark:bg-orange-600 hover:bg-orange-500 dark:hover:bg-orange-500'
            : isBeatStart
              ? 'bg-matte-200 dark:bg-surface-elevated hover:bg-orange-200 dark:hover:bg-orange-900/30'
              : 'bg-matte-100 dark:bg-matte-800 hover:bg-orange-200 dark:hover:bg-orange-900/30'
      }`;
      cell.dataset.trackIdx = String(idx);
      cell.dataset.step = String(step);

      // Velocity bar indicator (gradient from bottom)
      if (isActive) {
        const opacity = vel * (chance < 1 ? 0.7 : 1);
        cell.style.background = `linear-gradient(to top, rgba(249,115,22,${opacity}) ${vel * 100}%, transparent ${vel * 100}%)`;
      } else {
        cell.style.background = '';
      }

      // Chance badge (tiny dot indicator)
      if (isActive && chance < 1) {
        const badge = document.createElement('span');
        badge.className = 'absolute bottom-0 right-0 w-1.5 h-1.5 rounded-full bg-yellow-400 border border-yellow-600';
        badge.title = `Chance: ${Math.round(chance * 100)}%`;
        cell.style.position = 'relative';
        cell.appendChild(badge);
      }

      cell.addEventListener('click', (e) => {
        e.stopPropagation();
        if (e.shiftKey) {
          // Shift+Click: cycle CHANCE (probability)
          if (!track.steps[step]) {
            track.steps[step] = true;
            track.chance[step] = 0.75;
          } else {
            // Cycle: 1.0 → 0.75 → 0.5 → 0.25 → 1.0
            if (track.chance[step] >= 1) track.chance[step] = 0.75;
            else if (track.chance[step] >= 0.75) track.chance[step] = 0.5;
            else if (track.chance[step] >= 0.5) track.chance[step] = 0.25;
            else track.chance[step] = 1;
          }
        } else {
          // Normal click: toggle + cycle VELOCITY
          track.steps[step] = !track.steps[step];
          if (track.steps[step]) {
            // Cycle velocity: 1.0 → 0.75 → 0.5 → 0.25 → 1.0
            if (track.velocity[step] >= 1) track.velocity[step] = 0.75;
            else if (track.velocity[step] >= 0.75) track.velocity[step] = 0.5;
            else if (track.velocity[step] >= 0.5) track.velocity[step] = 0.25;
            else track.velocity[step] = 1;
          }
        }
        // Preview sound if step is on
        if (track.steps[step]) {
          playSound(def.id, track.velocity[step], track.pan, kitSelect.value);
        }
        renderTracks();
      });

      // Right-click to reset velocity + chance
      cell.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (track.steps[step]) {
          track.velocity[step] = 1;
          track.chance[step] = 1;
          renderTracks();
        }
      });

      gridRow.appendChild(cell);
    }

    row.appendChild(gridRow);
    tracksContainer.appendChild(row);
  });
}

function renderPatternBtns() {
  patternBtns.innerHTML = '';
  PATTERN_NAMES.forEach((name, idx) => {
    const btn = document.createElement('button');
    btn.className = `w-6 h-6 rounded text-2xs font-bold transition-colors ${
      idx === currentPattern
        ? 'bg-orange-500 text-white'
        : 'bg-matte-200 dark:bg-surface-elevated text-matte-500 hover:bg-orange-200 dark:hover:bg-orange-900/30'
    }`;
    btn.textContent = name;
    btn.addEventListener('click', () => {
      currentPattern = idx;
      renderAll();
    });
    patternBtns.appendChild(btn);
  });
}

function renderAll() {
  renderStepNumbers();
  renderTracks();
  renderPatternBtns();
}

// ════════════════════════════════════════════════════════════════
// PLAYBACK ENGINE
// ════════════════════════════════════════════════════════════════

function tick() {
  const pattern = getPattern();
  const kit = kitSelect.value;
  const swing = parseInt(swingSlider.value) / 100;

  // Check if any track has solo enabled
  const hasSolo = pattern.tracks.some(t => t.solo);

  for (let i = 0; i < TRACK_DEFS.length; i++) {
    const track = pattern.tracks[i];
    const def = TRACK_DEFS[i];

    if (track.steps[currentStep]) {
      // Skip if muted (or if solo is active and this track isn't soloed)
      if (track.mute || (hasSolo && !track.solo)) continue;
      // Chance: probability of triggering this step
      if (track.chance[currentStep] < 1 && Math.random() >= track.chance[currentStep]) continue;
      playSound(def.id, track.velocity[currentStep], track.pan, kit);
    }
  }

  // Highlight current step
  highlightStep(currentStep);

  // Advance
  currentStep = (currentStep + 1) % STEPS;

  // Calculate timing with swing
  const bpm = parseInt(bpmInput.value) || 120;
  let delay = (60 / bpm) * 1000 / 4; // 16th notes

  // Apply swing to off-beats (odd steps)
  if (currentStep % 2 === 1) {
    delay *= (1 + swing * 0.5);
  } else if (currentStep % 2 === 0 && swing > 0) {
    delay *= (1 - swing * 0.25);
  }

  timer = window.setTimeout(tick, delay);
}

function highlightStep(step: number) {
  document.querySelectorAll('[data-step]').forEach(cell => {
    const el = cell as HTMLElement;
    const s = parseInt(el.dataset.step!);
    if (s === step) {
      el.classList.add('ring-1', 'ring-orange-400', 'dark:ring-orange-500');
    } else {
      el.classList.remove('ring-1', 'ring-orange-400', 'dark:ring-orange-500');
    }
  });
}

function start() {
  if (playing) return;
  playing = true;
  currentStep = 0;
  getAudioCtx().resume();
  tick();
  playIcon.textContent = '\u23F8';
  playText.textContent = 'Stop';
}

function stop() {
  playing = false;
  if (timer) { clearTimeout(timer); timer = null; }
  playIcon.textContent = '\u25B6';
  playText.textContent = 'Play';
  // Clear highlights
  document.querySelectorAll('[data-step]').forEach(el => {
    el.classList.remove('ring-1', 'ring-orange-400', 'dark:ring-orange-500');
  });
}

// ════════════════════════════════════════════════════════════════
// PATTERN OPERATIONS
// ════════════════════════════════════════════════════════════════

function clearPattern() {
  patterns[currentPattern] = createEmptyPattern();
  renderTracks();
}

function copyPattern() {
  clipboard = JSON.parse(JSON.stringify(getPattern()));
  (window as any).showToast?.('Pattern copied!', 'success');
}

function pastePattern() {
  if (!clipboard) {
    (window as any).showToast?.('Nothing to paste', 'error');
    return;
  }
  patterns[currentPattern] = JSON.parse(JSON.stringify(clipboard));
  renderTracks();
  (window as any).showToast?.('Pattern pasted!', 'success');
}

// ════════════════════════════════════════════════════════════════
// WAV EXPORT
// ════════════════════════════════════════════════════════════════

async function exportWAV() {
  const bpm = parseInt(bpmInput.value) || 120;
  const secondsPerStep = (60 / bpm) / 4;
  const totalDuration = STEPS * secondsPerStep;
  const sampleRate = 44100;
  const offlineCtx = new OfflineAudioContext(2, sampleRate * totalDuration, sampleRate);

  const offlineMaster = offlineCtx.createGain();
  offlineMaster.gain.value = 0.7;
  offlineMaster.connect(offlineCtx.destination);

  const pattern = getPattern();
  const kit = kitSelect.value;
  const hasSolo = pattern.tracks.some(t => t.solo);

  for (let step = 0; step < STEPS; step++) {
    const time = step * secondsPerStep;

    for (let i = 0; i < TRACK_DEFS.length; i++) {
      const track = pattern.tracks[i];
      const def = TRACK_DEFS[i];

      if (!track.steps[step] || track.mute || (hasSolo && !track.solo)) continue;

      const vel = track.velocity[step];
      const pan = track.pan;

      const panner = offlineCtx.createStereoPanner();
      panner.pan.value = pan;
      const gain = offlineCtx.createGain();
      gain.gain.value = vel * track.volume;
      panner.connect(gain);
      gain.connect(offlineMaster);

      // Render sound (simplified versions for offline)
      const t = time;
      switch (def.id) {
        case 'kick': {
          const o = offlineCtx.createOscillator();
          const g = offlineCtx.createGain();
          o.type = 'sine';
          o.frequency.setValueAtTime(160, t);
          o.frequency.exponentialRampToValueAtTime(30, t + 0.15);
          g.gain.setValueAtTime(1, t);
          g.gain.exponentialRampToValueAtTime(0.001, t + 0.5);
          o.connect(g); g.connect(panner);
          o.start(t); o.stop(t + 0.5);
          break;
        }
        case 'snare': {
          const o = offlineCtx.createOscillator();
          const g = offlineCtx.createGain();
          o.type = 'triangle';
          o.frequency.setValueAtTime(250, t);
          o.frequency.exponentialRampToValueAtTime(80, t + 0.05);
          g.gain.setValueAtTime(0.6, t);
          g.gain.exponentialRampToValueAtTime(0.001, t + 0.15);
          o.connect(g); g.connect(panner);
          o.start(t); o.stop(t + 0.15);
          const buf = offlineCtx.createBuffer(1, sampleRate * 0.1, sampleRate);
          const d = buf.getChannelData(0);
          for (let j = 0; j < d.length; j++) d[j] = (Math.random() * 2 - 1) * 0.4;
          const ns = offlineCtx.createBufferSource(); ns.buffer = buf;
          const ng = offlineCtx.createGain();
          ng.gain.setValueAtTime(0.5, t);
          ng.gain.exponentialRampToValueAtTime(0.001, t + 0.1);
          ns.connect(ng); ng.connect(panner);
          ns.start(t); ns.stop(t + 0.1);
          break;
        }
        case 'chihat': case 'ohihat': {
          const dur = def.id === 'chihat' ? 0.05 : 0.3;
          const buf = offlineCtx.createBuffer(1, sampleRate * dur, sampleRate);
          const d = buf.getChannelData(0);
          for (let j = 0; j < d.length; j++) d[j] = (Math.random() * 2 - 1);
          const ns = offlineCtx.createBufferSource(); ns.buffer = buf;
          const f = offlineCtx.createBiquadFilter();
          f.type = 'highpass'; f.frequency.value = 8000;
          const g = offlineCtx.createGain();
          g.gain.setValueAtTime(0.4, t);
          g.gain.exponentialRampToValueAtTime(0.001, t + dur);
          ns.connect(f); f.connect(g); g.connect(panner);
          ns.start(t); ns.stop(t + dur);
          break;
        }
        case 'clap': {
          for (let j = 0; j < 3; j++) {
            const buf = offlineCtx.createBuffer(1, sampleRate * 0.02, sampleRate);
            const d = buf.getChannelData(0);
            for (let k = 0; k < d.length; k++) d[k] = (Math.random() * 2 - 1);
            const ns = offlineCtx.createBufferSource(); ns.buffer = buf;
            const g = offlineCtx.createGain();
            g.gain.setValueAtTime(0.5, t + j * 0.01);
            g.gain.exponentialRampToValueAtTime(0.001, t + j * 0.01 + 0.02);
            ns.connect(g); g.connect(panner);
            ns.start(t + j * 0.01); ns.stop(t + j * 0.01 + 0.02);
          }
          break;
        }
        case 'tom': {
          const o = offlineCtx.createOscillator();
          const g = offlineCtx.createGain();
          o.type = 'sine';
          o.frequency.setValueAtTime(200, t);
          o.frequency.exponentialRampToValueAtTime(60, t + 0.2);
          g.gain.setValueAtTime(0.7, t);
          g.gain.exponentialRampToValueAtTime(0.001, t + 0.3);
          o.connect(g); g.connect(panner);
          o.start(t); o.stop(t + 0.3);
          break;
        }
        case 'cymbal': {
          const buf = offlineCtx.createBuffer(1, sampleRate * 0.5, sampleRate);
          const d = buf.getChannelData(0);
          for (let j = 0; j < d.length; j++) d[j] = (Math.random() * 2 - 1);
          const ns = offlineCtx.createBufferSource(); ns.buffer = buf;
          const f = offlineCtx.createBiquadFilter();
          f.type = 'bandpass'; f.frequency.value = 5000; f.Q.value = 2;
          const g = offlineCtx.createGain();
          g.gain.setValueAtTime(0.3, t);
          g.gain.exponentialRampToValueAtTime(0.001, t + 0.5);
          ns.connect(f); f.connect(g); g.connect(panner);
          ns.start(t); ns.stop(t + 0.5);
          break;
        }
        case 'perc': {
          const o = offlineCtx.createOscillator();
          const g = offlineCtx.createGain();
          o.type = 'square';
          o.frequency.setValueAtTime(800, t);
          o.frequency.exponentialRampToValueAtTime(200, t + 0.03);
          g.gain.setValueAtTime(0.3, t);
          g.gain.exponentialRampToValueAtTime(0.001, t + 0.08);
          o.connect(g); g.connect(panner);
          o.start(t); o.stop(t + 0.08);
          break;
        }
      }
    }
  }

  (window as any).showToast?.('Rendering WAV...', 'info');

  try {
    const rendered = await offlineCtx.startRendering();
    const wav = audioBufferToWav(rendered);
    const blob = new Blob([wav], { type: 'audio/wav' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `beat-${PATTERN_NAMES[currentPattern]}-${bpm}bpm.wav`;
    a.click();
    URL.revokeObjectURL(url);
    (window as any).showToast?.('WAV exported!', 'success');
  } catch (err) {
    (window as any).showToast?.('Export failed: ' + err, 'error');
  }
}

function audioBufferToWav(buffer: AudioBuffer): ArrayBuffer {
  const numChannels = buffer.numberOfChannels;
  const sampleRate = buffer.sampleRate;
  const format = 1; // PCM
  const bitDepth = 16;
  const bytesPerSample = bitDepth / 8;
  const blockAlign = numChannels * bytesPerSample;
  const dataLength = buffer.length * blockAlign;
  const headerLength = 44;
  const totalLength = headerLength + dataLength;
  const arrayBuffer = new ArrayBuffer(totalLength);
  const view = new DataView(arrayBuffer);

  function writeString(offset: number, str: string) {
    for (let i = 0; i < str.length; i++) view.setUint8(offset + i, str.charCodeAt(i));
  }

  writeString(0, 'RIFF');
  view.setUint32(4, totalLength - 8, true);
  writeString(8, 'WAVE');
  writeString(12, 'fmt ');
  view.setUint32(16, 16, true);
  view.setUint16(20, format, true);
  view.setUint16(22, numChannels, true);
  view.setUint32(24, sampleRate, true);
  view.setUint32(28, sampleRate * blockAlign, true);
  view.setUint16(32, blockAlign, true);
  view.setUint16(34, bitDepth, true);
  writeString(36, 'data');
  view.setUint32(40, dataLength, true);

  const channels: Float32Array[] = [];
  for (let c = 0; c < numChannels; c++) channels.push(buffer.getChannelData(c));

  let offset = 44;
  for (let i = 0; i < buffer.length; i++) {
    for (let c = 0; c < numChannels; c++) {
      const sample = Math.max(-1, Math.min(1, channels[c][i]));
      view.setInt16(offset, sample < 0 ? sample * 0x8000 : sample * 0x7FFF, true);
      offset += 2;
    }
  }

  return arrayBuffer;
}

