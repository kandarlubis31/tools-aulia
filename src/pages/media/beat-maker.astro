// EVENT BINDING
// ════════════════════════════════════════════════════════════════

// BPM sync
bpmInput.addEventListener('input', () => { bpmSlider.value = bpmInput.value; });
bpmSlider.addEventListener('input', () => { bpmInput.value = bpmSlider.value; });

// Swing display
swingSlider.addEventListener('input', () => { swingVal.textContent = swingSlider.value + '%'; });

// Play/Stop
playBtn.addEventListener('click', () => playing ? stop() : start());

// Pattern operations
clearBtn.addEventListener('click', clearPattern);
copyBtn.addEventListener('click', copyPattern);
pasteBtn.addEventListener('click', pastePattern);
exportBtn.addEventListener('click', exportWAV);

// Shortcuts panel toggle
shortcutsToggle.addEventListener('click', () => {
  shortcutsPanel.classList.toggle('hidden');
});

// Keyboard shortcuts
function handleKeydown(e: KeyboardEvent) {
  // Don't trigger if typing in input
  if ((e.target as HTMLElement).tagName === 'INPUT' || (e.target as HTMLElement).tagName === 'SELECT') return;

  if (e.code === 'Space') {
    e.preventDefault();
    playing ? stop() : start();
  } else if (e.key === 'ArrowUp') {
    e.preventDefault();
    selectedTrack = (selectedTrack - 1 + TRACK_DEFS.length) % TRACK_DEFS.length;
    renderTracks();
  } else if (e.key === 'ArrowDown') {
    e.preventDefault();
    selectedTrack = (selectedTrack + 1) % TRACK_DEFS.length;
    renderTracks();
  } else if (e.key === 'Backspace') {
    e.preventDefault();
    clearPattern();
  } else if (e.ctrlKey || e.metaKey) {
    if (e.key === 'c') { e.preventDefault(); copyPattern(); }
    else if (e.key === 'v') { e.preventDefault(); pastePattern(); }
    else if (e.key === 'e') { e.preventDefault(); exportWAV(); }
  } else if (e.key >= '1' && e.key <= '8') {
    // Toggle solo for track 1-8
    const idx = parseInt(e.key) - 1;
    if (idx < TRACK_DEFS.length) {
      const track = getPattern().tracks[idx];
      track.solo = !track.solo;
      if (track.solo) track.mute = false;
      renderTracks();
    }
  }
}

document.addEventListener('keydown', handleKeydown);
document.addEventListener('astro:page-leave', () => {
  document.removeEventListener('keydown', handleKeydown);
  stop();
}, { once: true });

// ════════════════════════════════════════════════════════════════
