---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="Email Header Analyzer — Parse Email Headers | ToolsAulia" description="Parse & analisis email headers: SPF, DKIM, DMARC, routing. 100% client-side." category="Network" toolHref="/network/email-header">
  <ToolPageHeader title="Email Header Analyzer" description="Parse email headers: spam, routing, auth check" icon='<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 7L2 7"/>' />

  <div class="card-base p-5 space-y-4">
    <textarea id="header-input" class="input-field w-full h-40 font-mono text-sm" placeholder="Paste full email headers di sini...&#10;From: sender@example.com&#10;To: receiver@example.com&#10;Subject: Hello&#10;Received: from mail.example.com&#10;Authentication-Results: spf=pass"></textarea>
    <button id="analyze-btn" class="btn-primary">Analisis Headers</button>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm" id="results"></div>
    <div class="space-y-1 text-xs" id="received-chain"></div>
  </div>
</BaseLayout>

<script>
  document.getElementById('analyze-btn').addEventListener('click', analyze);

  function analyze() {
    const raw = document.getElementById('header-input').value;
    const lines = raw.split('\n');
    const headers = {};
    let current = '';
    lines.forEach(line => {
      if (/^\s/.test(line) && current) { headers[current] += '\n' + line.trim(); }
      else { const m = line.match(/^([^:]+):\s*(.*)/); if (m) { current = m[1].toLowerCase(); headers[current] = m[2]; } }
    });

    let html = '';
    const fields = ['from','to','subject','date','return-path','message-id','mime-version','content-type'];
    fields.forEach(f => {
      if (headers[f]) html += '<div class="card-base p-2"><span class="text-xs text-matte-400">'+f.toUpperCase()+'</span><p class="font-mono text-xs break-all">'+esc(headers[f])+'</p></div>';
    });

    // Auth check
    if (headers['authentication-results'] || headers['received-spf']) {
      const auth = (headers['authentication-results'] || '') + ' ' + (headers['received-spf'] || '');
      html += '<div class="card-base p-2 col-span-2"><span class="text-xs text-matte-400">Auth</span><p class="text-xs">';
      if (/spf=pass/i.test(auth)) html += '✅ SPF Pass ';
      else if (/spf/i.test(auth)) html += '❌ SPF Fail ';
      if (/dkim=pass/i.test(auth)) html += '✅ DKIM Pass ';
      else if (/dkim/i.test(auth)) html += '⚠️ DKIM Check ';
      if (/dmarc=pass/i.test(auth)) html += '✅ DMARC Pass';
      else if (/dmarc/i.test(auth)) html += '❌ DMARC Fail';
      html += '</p></div>';
    }

    // Received chain
    const receiveds = Object.entries(headers).filter(([k]) => k === 'received');
    if (receiveds.length) {
      const chain = receiveds.map(([,v]) => {
        const m = v.match(/from\s+(\S+)|by\s+(\S+)/gi);
        return m ? m.join(' → ') : v.substring(0, 80);
      });
      document.getElementById('received-chain').innerHTML = '<span class="text-matte-400 font-medium">Routing Chain:</span><br>' + chain.map((c,i) => '<span class="text-matte-500">'+(i+1)+'. '+esc(c)+'</span>').join('<br>');
    }

    document.getElementById('results').innerHTML = html || '<p class="col-span-2 text-matte-400">Paste email headers untuk analisis.</p>';
  }

  function esc(s) { return String(s||'').replace(/</g,'&lt;'); }
</script>
