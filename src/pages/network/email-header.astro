---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="Email Header Analyzer" description="Parse & analisis email headers: SPF, DKIM, DMARC, routing. 100% client-side.">
  <ToolPageHeader title="Email Header Analyzer" description="Parse email headers: spam, routing, auth check" icon='<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 7L2 7"/>' />

  <div class="card-base p-5 space-y-4">
    <textarea id="header-input" class="input-field w-full h-40 font-mono text-sm" placeholder="Paste full email headers di sini...&#10;From: sender@example.com&#10;To: receiver@example.com&#10;Subject: Hello&#10;Received: from mail.example.com&#10;Authentication-Results: spf=pass" data-i18n-attr="placeholder" data-i18n="ph.paste_email_headers"></textarea>
    <div class="flex gap-2">
      <button id="analyze-btn" class="btn-primary flex-1" data-i18n="btn.analyze_headers">Analisis Headers</button>
      <button id="clear-btn" class="btn-secondary text-sm" data-i18n="btn.clear">Bersihkan</button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm" id="results"></div>
    <div class="space-y-1 text-xs" id="received-chain"></div>
  </div>
</BaseLayout>

<script>
import { t } from '../../i18n/translations';

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const input = document.getElementById('header-input') as HTMLTextAreaElement;
  const resultsEl = document.getElementById('results')!;
  const chainEl = document.getElementById('received-chain')!;
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  function analyze() {
    const raw = input.value;
    if (!raw.trim()) { toast('Paste email headers dulu!', 'error'); return; }
    const lines = raw.split('\n');
    const headers: Record<string, string> = {};
    let current = '';
    lines.forEach(line => {
      if (/^\s/.test(line) && current) { headers[current] += '\n' + line.trim(); }
      else { const m = line.match(/^([^:]+):\s*(.*)/); if (m) { current = m[1].toLowerCase(); headers[current] = m[2]; } }
    });

    let html = '';
    const fields = ['from', 'to', 'subject', 'date', 'return-path', 'message-id', 'mime-version', 'content-type'];
    fields.forEach(f => {
      if (headers[f]) html += '<div class="card-base p-2"><span class="text-xs text-matte-400">' + f.toUpperCase() + '</span><p class="font-mono text-xs break-all">' + esc(headers[f]) + '</p></div>';
    });

    // Auth check
    if (headers['authentication-results'] || headers['received-spf']) {
      const auth = (headers['authentication-results'] || '') + ' ' + (headers['received-spf'] || '');
      html += '<div class="card-base p-2 col-span-2"><span class="text-xs text-matte-400">Auth</span><p class="text-xs">';
      if (/spf=pass/i.test(auth)) html += '✅ ' + t('email.spf_pass', 'SPF Pass') + ' ';
      else if (/spf/i.test(auth)) html += '❌ ' + t('email.spf_fail', 'SPF Fail') + ' ';
      if (/dkim=pass/i.test(auth)) html += '✅ ' + t('email.dkim_pass', 'DKIM Pass') + ' ';
      else if (/dkim/i.test(auth)) html += '⚠️ ' + t('email.dkim_check', 'DKIM Check') + ' ';
      if (/dmarc=pass/i.test(auth)) html += '✅ ' + t('email.dmarc_pass', 'DMARC Pass');
      else if (/dmarc/i.test(auth)) html += '❌ ' + t('email.dmarc_fail', 'DMARC Fail');
      html += '</p></div>';
    }

    // Received chain
    const receiveds = Object.entries(headers).filter(([k]) => k === 'received');
    if (receiveds.length) {
      const chain = receiveds.map(([, v]) => {
        const m = v.match(/from\s+(\S+)|by\s+(\S+)/gi);
        return m ? m.join(' → ') : v.substring(0, 80);
      });
      chainEl.innerHTML = '<span class="text-matte-400 font-medium">' + t('email.routing_chain', 'Routing Chain:') + '</span><br>' + chain.map((c, i) => '<span class="text-matte-500">' + (i + 1) + '. ' + esc(c) + '</span>').join('<br>');
    } else {
      chainEl.innerHTML = '';
    }

    resultsEl.innerHTML = html || '<p class="col-span-2 text-matte-400">' + t('email.no_headers', 'Tidak ada header standar yang terdeteksi.') + '</p>';
  }

  function esc(s: unknown) { return String(s ?? '').replace(/</g, '&lt;'); }

  document.getElementById('analyze-btn')!.addEventListener('click', analyze);
  input.addEventListener('keydown', e => { if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) analyze(); });
  document.getElementById('clear-btn')!.addEventListener('click', () => {
    input.value = '';
    resultsEl.innerHTML = '';
    chainEl.innerHTML = '';
    toast('Headers dikosongkan', 'info');
  });

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __networkEmailHeaderPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __networkEmailHeaderPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
