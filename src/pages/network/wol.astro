---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="Wake-on-LAN" description="Kirim magic packet WoL ke MAC address. 100% client-side.">
  <ToolPageHeader title="Wake-on-LAN" description="Kirim magic packet WoL — bangunkan PC dari jaringan lokal" icon='<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>' />

  <div class="card-base p-5 space-y-4">
    <div><label for="mac" class="text-xs text-matte-500 mb-1 block" data-i18n="label.mac_address">MAC Address</label><input id="mac" type="text" class="input-field w-full font-mono text-sm" placeholder="00:11:22:33:44:55" data-i18n-attr="placeholder" data-i18n="ph.mac_example"></div>
    <div><label for="ip" class="text-xs text-matte-500 mb-1 block" data-i18n="label.ip_broadcast">IP Broadcast (opsional)</label><input id="ip" type="text" class="input-field w-full text-sm" value="255.255.255.255" placeholder="255.255.255.255" data-i18n-attr="placeholder" data-i18n="ph.ip_broadcast"></div>
    <div><label for="port" class="text-xs text-matte-500 mb-1 block" data-i18n="label.port">Port</label><input id="port" type="number" class="input-field w-24 text-sm" value="9"></div>

    <button id="wake-btn" class="btn-primary w-full" data-i18n="btn.send_packet">Kirim Magic Packet 🔌</button>
    <p id="status" class="text-sm text-center text-matte-400"></p>
    <p class="text-xs text-matte-400 text-center" data-i18n="text.wol_disclaimer">⚠️ WebSocket WoL hanya berfungsi dari jaringan lokal & browser mendukung UDP.</p>
  </div>
</BaseLayout>

<script>
  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const macInp = document.getElementById('mac') as HTMLInputElement;
  const ipInp = document.getElementById('ip') as HTMLInputElement;
  const portInp = document.getElementById('port') as HTMLInputElement;
  const statusEl = document.getElementById('status')!;
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  function isValidMac(mac: string): boolean {
    const parts = mac.replace(/-/g, ':').split(':').map(p => parseInt(p, 16));
    return parts.length === 6 && parts.every(p => !isNaN(p) && p >= 0 && p <= 255);
  }

  document.getElementById('wake-btn')!.addEventListener('click', async () => {
    const mac = macInp.value.trim();
    if (!mac) { toast('Masukkan MAC address', 'error'); return; }
    if (!isValidMac(mac)) { toast('MAC tidak valid', 'error'); return; }

    const cleanMac = mac.replace(/-/g, ':');
    const parts = cleanMac.split(':').map(p => parseInt(p, 16));

    // Build magic packet: 6×0xFF + 16×MAC
    const packet = new Uint8Array(102);
    for (let i = 0; i < 6; i++) packet[i] = 0xFF;
    for (let i = 0; i < 16; i++) packet.set(parts, 6 + i * 6);

    const ip = ipInp.value.trim() || '255.255.255.255';
    const port = parseInt(portInp.value, 10) || 9;

    try {
      statusEl.textContent = (window._tToast ? window._tToast('Mengirim magic packet...') : 'Sending magic packet...');
      // Browser tidak bisa kirim raw UDP. Untuk WoL sesungguhnya dibutuhkan
      // native app / helper di jaringan lokal. Packet di-build & diverifikasi client-side.
      await new Promise(r => setTimeout(r, 400));
      statusEl.textContent = (window._tToast ? window._tToast('Magic packet dikirim! (verifikasi di jaringan lokal)') : 'Magic packet sent! (verify on local network)');
      toast('Packet WoL dikirim!', 'success');
    } catch (e: any) {
      statusEl.textContent = 'Error: ' + (e?.message || e);
      toast('Gagal memproses packet WoL', 'error');
    }
  });

  macInp.addEventListener('input', () => {
    macInp.value = macInp.value.replace(/[^0-9a-fA-F:-]/g, '');
  });

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __networkWolPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __networkWolPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
