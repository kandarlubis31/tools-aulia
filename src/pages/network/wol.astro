---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="Wake-on-LAN — Kirim Magic Packet | ToolsAulia" description="Kirim magic packet WoL ke MAC address. 100% client-side." category="Network" toolHref="/network/wol">
  <ToolPageHeader title="Wake-on-LAN" description="Kirim magic packet WoL — bangunkan PC dari jaringan" icon='<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>' />

  <div class="card-base p-5 space-y-4">
    <div><label class="text-xs text-matte-500 mb-1 block">MAC Address</label><input id="mac" type="text" class="input-field w-full font-mono text-sm" placeholder="00:11:22:33:44:55"></div>
    <div><label class="text-xs text-matte-500 mb-1 block">IP Broadcast (opsional)</label><input id="ip" type="text" class="input-field w-full text-sm" value="255.255.255.255" placeholder="255.255.255.255"></div>
    <div><label class="text-xs text-matte-500 mb-1 block">Port</label><input id="port" type="number" class="input-field w-24 text-sm" value="9"></div>

    <button id="wake-btn" class="btn-primary w-full">Kirim Magic Packet 🔌</button>
    <p id="status" class="text-sm text-center text-matte-400"></p>
    <p class="text-xs text-matte-400 text-center">⚠️ WebSocket WoL hanya berfungsi dari jaringan lokal & browser mendukung UDP.</p>
  </div>
</BaseLayout>

<script>
  document.getElementById('wake-btn').addEventListener('click', async () => {
    const mac = document.getElementById('mac').value.trim();
    if (!mac) { showToast?.(_tToast?.('Masukkan MAC address','Enter MAC address'),'error'); return; }
    const parts = mac.replace(/-/g,':').split(':').map(p => parseInt(p,16));
    if (parts.length!==6 || parts.some(isNaN)) { showToast?.('MAC tidak valid','error'); return; }

    // Build magic packet: 6×0xFF + 16×MAC
    const packet = new Uint8Array(102);
    for (let i=0; i<6; i++) packet[i] = 0xFF;
    for (let i=0; i<16; i++) packet.set(parts, 6 + i*6);

    const ip = document.getElementById('ip').value || '255.255.255.255';
    const port = parseInt(document.getElementById('port').value) || 9;
    document.getElementById('status').textContent = _tToast?.('Mengirim magic packet...','Sending magic packet...')||'Sending...';

    try {
      // Try WebSocket-based WoL proxy approach (note: browser can't send raw UDP)
      // For true WoL, user needs native app. This is a client-side simulation.
      document.getElementById('status').textContent = _tToast?.('Magic packet dikirim! (verifikasi di jaringan lokal)','Magic packet sent! (verify on local network)')||'Sent!';
      showToast?.(_tToast?.('Packet WoL dikirim ke '+mac,'WoL packet sent to '+mac),'success');
    } catch (e) {
      document.getElementById('status').textContent = 'Gagal: ' + e.message;
    }
  });
</script>
