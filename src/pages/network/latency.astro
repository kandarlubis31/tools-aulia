---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Latency Tester — Ukur Latensi Host Online">
  <div class="max-w-2xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Latency Tester"
      titleKey="header.latency"
      desc="Ping beberapa host sekaligus & bandingkan latensi. 100% client-side."
      descKey="header.latency_desc"
      icon='<line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>'
      gradient="from-violet-500 to-purple-600"
    />

    <div class="card-base p-5 animate-fade-in">
      <div class="flex gap-2 mb-4">
        <input id="host-input" type="text" value="google.com, github.com, cloudflare.com, youtube.com"
          placeholder="google.com, github.com, …"
          class="flex-1 px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm font-mono focus:ring-2 focus:ring-violet-500/40 outline-none" />
        <button id="ping-btn" class="gradient-brand px-6 py-2.5 rounded-lg text-sm font-bold">
          🏓 <span data-i18n="latency.ping">Ping</span>
        </button>
      </div>

      <div class="flex items-center gap-3 mb-4">
        <label class="text-2xs text-matte-400 font-bold"><span data-i18n="latency.samples">Sampel</span>:</label>
        <select id="count-select" class="px-2.5 py-1.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-xs font-bold outline-none focus:ring-2 focus:ring-violet-500/40">
          <option value="4">4</option>
          <option value="8" selected>8</option>
          <option value="16">16</option>
        </select>
      </div>

      <div id="results-area" class="space-y-2">
        <p class="text-xs text-matte-400 text-center py-6" data-i18n="latency.idle">Ketik host (pisahkan dengan koma) lalu klik Ping.</p>
      </div>

      <div class="flex justify-end mt-3">
        <button id="copy-json-btn" type="button" class="hidden px-3 py-2 rounded-lg bg-matte-100 dark:bg-surface-hover text-matte-600 dark:text-matte-200 hover:bg-matte-200 dark:hover:bg-matte-600 text-xs font-bold transition-colors" data-i18n="net.copy_json">Copy JSON</button>
      </div>
    </div>

    <!-- Riwayat tes -->
    <div class="card-base p-4 mt-4 animate-fade-in">
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-xs font-bold text-matte-400 uppercase tracking-wider" data-i18n="common.history">Riwayat</h3>
        <button id="history-clear" type="button" class="hidden text-2xs font-bold text-rose-500 hover:text-rose-600 px-2 py-1 rounded hover:bg-rose-50 dark:hover:bg-rose-900/20 transition-colors" data-i18n="common.clear_history">Hapus Riwayat</button>
      </div>
      <p id="history-empty" class="text-2xs text-matte-400" data-i18n="net.hist_empty">Belum ada tes. Ping host untuk menyimpan riwayat.</p>
      <ul id="history-list" class="space-y-1.5"></ul>
    </div>

    <p class="text-center text-xs text-matte-400 mt-6" data-i18n="latency.note">
      ⚠️ Latensi &lt;20ms = excellent, 20-50ms = good, 50-100ms = average, &gt;100ms = poor.
    </p>
  </div>
</BaseLayout>

<script>
import { useLocalHistory } from '../../composables/useLocalHistory';

const __page = (location.pathname.replace(/\/+$/, '') || '/');

  document.addEventListener('astro:page-load', () => {if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;

    const hostInput = document.getElementById('host-input') as HTMLInputElement;
    const pingBtn = document.getElementById('ping-btn') as HTMLButtonElement;
    const countSelect = document.getElementById('count-select') as HTMLSelectElement;
    const resultsArea = document.getElementById('results-area')!;
    const copyJsonBtn = document.getElementById('copy-json-btn') as HTMLButtonElement;
    const historyList = document.getElementById('history-list')!;
    const historyEmpty = document.getElementById('history-empty')!;
    const historyClear = document.getElementById('history-clear')!;

    const toast = (m: string, t: 'success' | 'error' = 'success') =>
      window.showToast?.(window._tToast ? window._tToast(m) : m, t);

    let lastJson = '';

    // ── Riwayat tes (max 8) ──
    const history = useLocalHistory<{ t: string; hosts: string; avg: number; min: number; max: number }>('hist:latency', 8);
    const renderHistory = () => {
      const items = history.getAll();
      historyEmpty.classList.toggle('hidden', items.length > 0);
      historyClear.classList.toggle('hidden', items.length === 0);
      historyList.innerHTML = '';
      items.forEach((it, idx) => {
        const li = document.createElement('li');
        li.className = 'flex items-center gap-2 p-2 rounded-lg bg-matte-50 dark:bg-surface-elevated text-2xs font-mono cursor-pointer hover:bg-matte-100 dark:hover:bg-surface-hover transition-colors';
        const dt = new Date(it.t);
        li.innerHTML = `
          <span class="font-bold ${it.avg < 50 ? 'text-emerald-500' : it.avg < 100 ? 'text-amber-500' : 'text-red-500'}">${it.avg}ms</span>
          <span class="min-w-0 flex-1 truncate">${it.hosts.replace(/</g, '&lt;')}</span>
          <span class="text-matte-400 shrink-0">min ${it.min} · max ${it.max} · ${dt.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' })}</span>
          <button type="button" class="h-del w-6 h-6 shrink-0 rounded text-matte-400 hover:text-rose-500 flex items-center justify-center" aria-label="Hapus" data-i18n-attr="aria-label" data-i18n="common.delete">×</button>`;
        li.addEventListener('click', () => { hostInput.value = it.hosts; pingBtn.click(); });
        li.querySelector('.h-del')?.addEventListener('click', (e) => {
          e.stopPropagation();
          history.update(history.getAll().filter((_, i) => i !== idx));
          renderHistory();
        });
        historyList.appendChild(li);
      });
    };
    historyClear.addEventListener('click', () => { history.clear(); renderHistory(); });

    function latencyColor(ms: number): string {
      if (ms < 20) return 'text-emerald-500';
      if (ms < 50) return 'text-lime-500';
      if (ms < 100) return 'text-amber-500';
      return 'text-red-500';
    }

    function barColor(ms: number): string {
      if (ms < 20) return 'bg-emerald-500';
      if (ms < 50) return 'bg-lime-500';
      if (ms < 100) return 'bg-amber-500';
      return 'bg-red-500';
    }

    async function pingHost(host: string): Promise<number> {
      // Prepend https:// if missing
      const url = host.includes('://') ? host : `https://${host}`;
      const t0 = performance.now();
      try {
        await fetch(`${url}/favicon.ico?t=${Date.now()}`, {
          method: 'HEAD', cache: 'no-store', mode: 'no-cors',
        });
      } catch { /* CORS or network error — still measure the attempt */ }
      return Math.round(performance.now() - t0);
    }

    function renderResult(host: string, times: number[]) {
      const avg = Math.round(times.reduce((a, b) => a + b, 0) / times.length);
      const min = Math.min(...times);
      const max = Math.max(...times);
      const pct = Math.min(avg / 200, 1);
      const pctW = Math.round(pct * 100);

      const div = document.createElement('div');
      div.className = 'p-3 rounded-lg bg-matte-50 dark:bg-surface-elevated';
      div.innerHTML = `
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-sm font-bold font-mono text-matte-700 dark:text-matte-200">${escHtml(host)}</span>
          <span class="text-sm font-bold tabular-nums ${latencyColor(avg)}">${avg} ms</span>
        </div>
        <div class="h-2 rounded-full bg-matte-200 dark:bg-matte-700 overflow-hidden mb-2">
          <div class="h-full rounded-full transition-all duration-700 ${barColor(avg)}" style="width:${pctW}%"></div>
        </div>
        <div class="flex gap-3 text-2xs text-matte-400 font-mono">
          <span>Min: ${min}ms</span>
          <span>Max: ${max}ms</span>
          <span>Samples: ${times.length}</span>
        </div>`;
      return div;
    }

    function escHtml(s: string): string {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    pingBtn.addEventListener('click', async () => {
      const hosts = hostInput.value.split(',').map(h => h.trim()).filter(Boolean);
      if (!hosts.length) { toast('Masukkan host dulu.', 'error'); return; }

      pingBtn.disabled = true;
      pingBtn.innerHTML = '⏳ …';
      resultsArea.innerHTML = '';

      const allResults: { host: string; times: number[] }[] = [];
      const count = parseInt(countSelect.value);
      for (const host of hosts) {
        const row = document.createElement('div');
        row.className = 'p-3 rounded-lg bg-matte-50 dark:bg-surface-elevated animate-pulse';
        row.innerHTML = `<div class="flex items-center justify-between"><span class="text-sm font-bold font-mono">${escHtml(host)}</span><span class="text-sm text-matte-400">Pinging…</span></div>`;
        resultsArea.appendChild(row);

        const times: number[] = [];
        for (let i = 0; i < count; i++) {
          const ms = await pingHost(host);
          times.push(ms);
          row.innerHTML = renderResult(host, times).innerHTML;
          await new Promise(r => setTimeout(r, 150));
        }
        allResults.push({ host, times });
      }

      // Riwayat + JSON agregat
      try {
        const avgs = allResults.map((r) => Math.round(r.times.reduce((a, b) => a + b, 0) / r.times.length));
        lastJson = JSON.stringify(Object.fromEntries(allResults.map((r) => [r.host, { avg: Math.round(r.times.reduce((a, b) => a + b, 0) / r.times.length), min: Math.min(...r.times), max: Math.max(...r.times), samples: r.times }])), null, 2);
        copyJsonBtn.classList.remove('hidden');
        const hostsStr = allResults.map((r) => r.host).join(', ');
        history.add({ t: new Date().toISOString(), hosts: hostsStr, avg: Math.round(avgs.reduce((a, b) => a + b, 0) / avgs.length), min: Math.min(...avgs), max: Math.max(...avgs) });
        renderHistory();
      } catch { /* quota — abaikan */ }

      pingBtn.disabled = false;
      pingBtn.innerHTML = '🔄 <span data-i18n="latency.retry">Ulangi</span>';
      (window as any).processI18n?.();
    });

    copyJsonBtn.addEventListener('click', async () => {
      if (!lastJson) return;
      try { await navigator.clipboard.writeText(lastJson); toast('Disalin!'); }
      catch { toast('Gagal menyalin.', 'error'); }
    });

    renderHistory();
  });
</script>
