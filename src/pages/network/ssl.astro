---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="SSL Checker - Cek Sertifikat SSL Domain Online">
  <div class="max-w-2xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="SSL Checker"
      titleKey="header.ssl"
      desc="Cek masa berlaku & info sertifikat SSL domain manapun."
      descKey="header.ssl_desc"
      icon='<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>'
      gradient="from-emerald-500 to-green-600"
    />

    <div class="card-base p-5 animate-fade-in">
      <div class="flex gap-2 mb-5">
        <input id="domain-input" type="text" value="google.com"
          placeholder="google.com"
          class="flex-1 px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm font-mono focus:ring-2 focus:ring-emerald-500/40 outline-none" />
        <button id="check-btn" class="gradient-brand px-6 py-2.5 rounded-lg text-sm font-bold">
          <span data-i18n="ssl.check">Check SSL</span>
        </button>
      </div>

      <div id="result-area">
        <p class="text-xs text-matte-400 text-center py-6" data-i18n="ssl.idle">Masukkan domain lalu klik Check SSL.</p>
      </div>
    </div>

    <p class="text-center text-xs text-matte-400 mt-6" data-i18n="ssl.note">
      SSL info diperoleh dari Certificate Transparency logs (crt.sh).
    </p>
  </div>
</BaseLayout>

<script>
const __page = (location.pathname.replace(/\/+$/, '') || '/');

  document.addEventListener('astro:page-load', () => {if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;

    const domainInput = document.getElementById('domain-input') as HTMLInputElement;
    const checkBtn = document.getElementById('check-btn') as HTMLButtonElement;
    const resultArea = document.getElementById('result-area')!;

    function escHtml(s: string): string {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function daysBetween(d1: Date, d2: Date): number {
      return Math.ceil((d2.getTime() - d1.getTime()) / (1000 * 60 * 60 * 24));
    }

    function formatDate(d: Date): string {
      return d.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
    }

    async function checkSSL() {
      let domain = domainInput.value.trim().toLowerCase();
      if (!domain) { window.showToast?.('Masukkan domain', 'error'); return; }
      domain = domain.replace(/^https?:\/\//, '').replace(/\/.*$/, '');

      checkBtn.disabled = true;
      checkBtn.innerHTML = '<span class="animate-pulse">Checking...</span>';
      resultArea.innerHTML = '<p class="text-matte-400 text-center py-6 animate-pulse">Fetching SSL info dari crt.sh...</p>';

      try {
        // Use server-side proxy to bypass CORS (crt.sh added to proxy allowlist)
        const ctRes = await fetch(`/api/proxy?url=${encodeURIComponent(`https://crt.sh/?q=${domain}&output=json`)}`);

        if (!ctRes.ok) throw new Error('crt.sh returned ' + ctRes.status);

        const certs = await ctRes.json();
        if (!certs || certs.length === 0) {
          resultArea.innerHTML = `<div class="p-4 rounded-lg bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400 text-sm">
            Tidak ditemukan sertifikat untuk <strong>${escHtml(domain)}</strong> di CT logs.
          </div>`;
          return;
        }

        // Get the latest cert
        const latest = certs[0];
        const issuer = latest.issuer_name || 'Unknown';
        const notBefore = latest.not_before ? new Date(latest.not_before) : null;
        const notAfter = latest.not_after ? new Date(latest.not_after) : null;
        const now = new Date();
        const daysLeft = notAfter ? daysBetween(now, notAfter) : null;

        // Determine status
        let statusText: string;
        let statusClass: string;
        if (daysLeft !== null && daysLeft < 0) {
          statusText = 'EXPIRED';
          statusClass = 'bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400';
        } else if (daysLeft !== null && daysLeft < 30) {
          statusText = 'Expiring Soon';
          statusClass = 'bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400';
        } else {
          statusText = 'Valid';
          statusClass = 'bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300';
        }

        // Count unique subdomains in CT logs
        const subdomains = new Set<string>();
        certs.forEach((c: any) => {
          if (c.name_value) {
            c.name_value.split('\n').forEach((n: string) => subdomains.add(n.trim()));
          }
        });

        let html = '<div class="space-y-3">';

        // Main info grid
        html += `<div class="grid grid-cols-2 gap-3">
          <div class="p-3 rounded-lg bg-matte-50 dark:bg-surface-elevated">
            <span class="text-2xs text-matte-400 block">Domain</span>
            <span class="font-bold font-mono text-sm">${escHtml(domain)}</span>
          </div>
          <div class="p-3 rounded-lg ${statusClass}">
            <span class="text-2xs opacity-70 block">SSL Status</span>
            <span class="font-bold text-sm">${statusText}</span>
          </div>
          <div class="p-3 rounded-lg bg-matte-50 dark:bg-surface-elevated">
            <span class="text-2xs text-matte-400 block">Issuer</span>
            <span class="font-bold text-sm text-xs">${escHtml(issuer)}</span>
          </div>
          <div class="p-3 rounded-lg bg-matte-50 dark:bg-surface-elevated">
            <span class="text-2xs text-matte-400 block">CT Logs</span>
            <span class="font-bold text-sm">${certs.length} entries</span>
          </div>
        </div>`;

        // Expiry details
        if (notBefore || notAfter) {
          html += `<div class="p-3 rounded-lg bg-matte-50 dark:bg-surface-elevated">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <span class="text-2xs text-matte-400 block">Valid From</span>
                <span class="font-bold text-sm">${notBefore ? formatDate(notBefore) : '-'}</span>
              </div>
              <div>
                <span class="text-2xs text-matte-400 block">Expires</span>
                <span class="font-bold text-sm ${daysLeft !== null && daysLeft < 30 ? 'text-red-500' : daysLeft !== null && daysLeft < 90 ? 'text-amber-500' : ''}">${notAfter ? formatDate(notAfter) : '-'}</span>
              </div>
            </div>
            ${daysLeft !== null ? `<div class="mt-2 text-xs ${daysLeft < 0 ? 'text-red-500 font-bold' : daysLeft < 30 ? 'text-amber-500' : 'text-matte-500'}">${daysLeft < 0 ? `Expired ${Math.abs(daysLeft)} days ago` : `${daysLeft} days remaining`}</div>` : ''}
          </div>`;
        }

        // Subdomains found
        if (subdomains.size > 0) {
          const subArr = Array.from(subdomains).slice(0, 10);
          html += `<div class="p-3 rounded-lg bg-matte-50 dark:bg-surface-elevated">
            <span class="text-2xs text-matte-400 block mb-1">Subdomains (${subdomains.size} found)</span>
            <div class="flex flex-wrap gap-1">
              ${subArr.map(s => `<span class="text-2xs font-mono bg-matte-200 dark:bg-matte-700 px-1.5 py-0.5 rounded">${escHtml(s)}</span>`).join('')}
              ${subdomains.size > 10 ? `<span class="text-2xs text-matte-400">+${subdomains.size - 10} more</span>` : ''}
            </div>
          </div>`;
        }

        html += '</div>';
        resultArea.innerHTML = html;

      } catch (e: any) {
        resultArea.innerHTML = `<div class="p-4 rounded-lg bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 text-sm">
          Gagal mengambil data SSL. Pastikan domain valid dan coba lagi.
          <br><br><span class="font-mono text-xs">${escHtml(e.message || 'Unknown error')}</span>
        </div>`;
      } finally {
        checkBtn.disabled = false;
        checkBtn.innerHTML = '<span data-i18n="ssl.check">Check SSL</span>';
        (window as any).processI18n?.();
      }
    }

    checkBtn.addEventListener('click', checkSSL);
    domainInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') checkSSL(); });
  });
</script>
