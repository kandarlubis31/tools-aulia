---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPageHeader from '../components/ToolPageHeader.astro';
import { publicTools as tools } from '../data/tools';

// --- Curated editor picks (order = rank) ---
const curatedHrefs = [
  '/pdf/merge',
  '/pdf/compress',
  '/pdf/sign',
  '/pdf/to-jpg',
  '/image/remove-bg',
  '/image/compressor',
  '/image/editor',
  '/image/converter',
  '/dev/json',
  '/dev/base64',
  '/dev/markdown',
  '/security/password',
  '/security/hash',
  '/calc/currency',
  '/calc/bmi',
  '/calc/age',
  '/utils/qr',
  '/utils/paste-to-md',
  '/utils/wa-builder',
  '/text/typing-test',
];
const curated = curatedHrefs
  .map((href) => tools.find((t) => t.href === href))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));

// Full tool data for client-side usage ranking (Most Used section)
const toolsForJs = tools.map((t) => ({
  href: t.href,
  title: t.title,
  desc: t.desc,
  category: t.category,
  icon: t.icon,
}));
---

<BaseLayout
  pageTitle="Top 20 Tools Terbaik"
  description={`Kurasi ${curated.length} tools paling populer & bermanfaat di Tools MasAul. Semua 100% di browser — tanpa install, data aman.`}
>
  <ToolPageHeader
    title="Top 20 Tools Terbaik"
    desc="Kurasi 20 tools paling populer & bermanfaat di Tools MasAul. Semua 100% di browser — tanpa install, data aman."
    icon='<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>'
    titleKey="showcase.title"
    descKey="showcase.desc"
  />

  <!-- Tool data for client-side ranking -->
  <script is:inline type="application/json" id="showcase-tools-data" set:html={JSON.stringify(toolsForJs)}></script>

  <!-- ===== Section 1: Most Used (per-user, client-rendered) ===== -->
  <section id="top-used-section" class="max-w-7xl mx-auto px-4 mb-8 hidden">
    <div class="flex items-center justify-between mb-3">
      <div>
        <h2 class="section-title" data-i18n="showcase.top_used">Paling Sering Dipakai</h2>
        <p class="text-xs text-matte-400 dark:text-matte-300 mt-0.5" data-i18n="showcase.top_used_desc">Berdasarkan aktivitas kamu di browser ini.</p>
      </div>
      <a href="/" class="text-2xs font-semibold text-accent-blue hover:underline shrink-0" data-i18n="showcase.see_all">Lihat Semua Tools</a>
    </div>
    <div id="top-used-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"></div>
  </section>

  <!-- ===== Section 2: Editor Picks (curated, server-rendered) ===== -->
  <section class="max-w-7xl mx-auto px-4 pb-24">
    <div class="flex items-center justify-between mb-3">
      <div>
        <h2 class="section-title" data-i18n="showcase.editors_pick">Pilihan Editor</h2>
        <p class="text-xs text-matte-400 dark:text-matte-300 mt-0.5" data-i18n="showcase.editors_pick_desc">Tools yang paling sering dipakai dan paling bermanfaat.</p>
      </div>
      <a href="/" class="text-2xs font-semibold text-accent-blue hover:underline shrink-0" data-i18n="showcase.see_all">Lihat Semua Tools</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {curated.map((tool, i) => (
        <a
          href={tool.href}
          class="tool-tile group relative flex flex-col p-5"
        >
          <span class="absolute top-2.5 right-3 text-xl font-bold tabular-nums text-matte-200 dark:text-matte-700 select-none">{String(i + 1).padStart(2, '0')}</span>

          <div class="flex items-start gap-3 pr-8">
            <div class="icon-mono w-10 h-10 shrink-0 rounded-xl border border-matte-200 dark:border-surface-border bg-matte-50 dark:bg-surface-elevated">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={tool.icon} />
            </div>
            <div class="min-w-0">
              <h3 class="text-sm font-semibold text-matte-800 dark:text-white truncate" data-i18n={tool.titleKey || undefined}>{tool.title}</h3>
              <p class="text-xs text-matte-400 dark:text-matte-300 leading-relaxed mt-0.5 line-clamp-2" data-i18n={tool.descKey || undefined}>{tool.desc}</p>
            </div>
          </div>

          <div class="mt-3 flex items-center gap-2">
            <span class="badge-muted text-2xs px-2 py-0.5">{tool.category}</span>
            <span class="text-2xs font-semibold text-accent-blue ml-auto opacity-0 group-hover:opacity-100 transition-opacity" data-i18n="showcase.open">Buka Tools →</span>
          </div>
        </a>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-10">
      <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-matte-900 dark:bg-white text-white dark:text-matte-900 text-sm font-semibold hover:opacity-90 transition-opacity">
        <span data-i18n="showcase.see_all">Lihat Semua Tools</span>
        <span>{tools.length}+</span>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
const __page = (location.pathname.replace(/\/+$/, '') || '/');

  document.addEventListener('astro:page-load', () => {if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;

    const section = document.getElementById('top-used-section');
    const grid = document.getElementById('top-used-grid');
    const dataEl = document.getElementById('showcase-tools-data');
    if (!section || !grid || !dataEl) return;

    let toolsData: { href: string; title: string; desc: string; category: string; icon: string }[] = [];
    try {
      toolsData = JSON.parse(dataEl.textContent || '[]');
    } catch {
      /* ignore */
    }

    const cardHTML = (t: (typeof toolsData)[number], rank: number, count?: number) => `
      <a href="${t.href}" class="tool-tile group relative flex flex-col p-5">
        <span class="absolute top-2.5 right-3 text-xl font-bold tabular-nums text-matte-200 dark:text-matte-700 select-none">${String(rank).padStart(2, '0')}</span>
        <div class="flex items-start gap-3 pr-8">
          <div class="icon-mono w-10 h-10 shrink-0 rounded-xl border border-matte-200 dark:border-surface-border bg-matte-50 dark:bg-surface-elevated">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${t.icon}</svg>
          </div>
          <div class="min-w-0">
            <h3 class="text-sm font-semibold text-matte-800 dark:text-white truncate">${t.title}</h3>
            <p class="text-xs text-matte-400 dark:text-matte-300 leading-relaxed mt-0.5 line-clamp-2">${t.desc}</p>
          </div>
        </div>
        <div class="mt-3 flex items-center gap-2">
          <span class="badge-muted text-2xs px-2 py-0.5">${t.category}</span>
          ${count ? `<span class="text-2xs font-semibold text-matte-400">${count}×</span>` : ''}
          <span class="text-2xs font-semibold text-accent-blue ml-auto opacity-0 group-hover:opacity-100 transition-opacity">Buka Tools →</span>
        </div>
      </a>`;

    try {
      const counts: Record<string, number> = JSON.parse(localStorage.getItem('toolUsage') || '{}');
      const ranked = Object.entries(counts)
        .map(([href, count]) => ({ href, count, tool: toolsData.find((t) => t.href === href) }))
        .filter((x): x is { href: string; count: number; tool: (typeof toolsData)[number] } => Boolean(x.tool) && x.count > 0)
        .sort((a, b) => b.count - a.count)
        .slice(0, 20);

      if (ranked.length === 0) {
        section.classList.add('hidden');
        return;
      }
      section.classList.remove('hidden');
      grid.innerHTML = ranked.map((x, i) => cardHTML(x.tool, i + 1, x.count)).join('');
    } catch {
      section.classList.add('hidden');
    }
  });
</script>
