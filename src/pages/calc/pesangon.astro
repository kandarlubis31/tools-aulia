---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Severance Calculator (PP 35/2021)">
  <div class="max-w-5xl mx-auto px-4 min-h-[60vh] py-10">

    <ToolPageHeader
      title="Kalkulator Pesangon PHK (PP 35/2021)"
      titleKey="header.pesangon"
      desc="Hitung uang pesangon, UPMK, uang penggantian hak & pajaknya sesuai PP 35/2021 (UU Cipta Kerja) — 100% di browser."
      descKey="header.pesangon_desc"
      icon='<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M6 12h.01M18 12h.01"/>'
    />

    <!-- INPUT -->
    <div class="card-base p-6 mb-6 animate-fade-in">
      <h3 class="text-xl font-bold text-matte-800 dark:text-white mb-5" data-i18n="pesangon.sec_input">Data Karyawan &amp; PHK</h3>

      <div class="grid md:grid-cols-2 gap-4 mb-4">
        <div>
          <label for="pg-wage" class="block text-2xs font-bold text-matte-400 uppercase tracking-wider mb-2" data-i18n="pesangon.salary">Upah bulanan (upah pokok + tunjangan tetap)</label>
          <div class="flex items-center gap-2">
            <input id="pg-wage" type="text" inputmode="numeric" value="10.000.000" placeholder="10.000.000"
              class="w-full px-4 py-3 rounded-xl bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-lg font-bold text-matte-800 dark:text-white outline-none focus:ring-2 focus:ring-emerald-500/40 transition-all" />
            <span class="font-bold text-matte-400 text-sm">Rp</span>
          </div>
        </div>
        <div>
          <label for="pg-umk" class="block text-2xs font-bold text-matte-400 uppercase tracking-wider mb-2" data-i18n="pesangon.umk">Upah minimum UMK/UMP (opsional — dasar terendah)</label>
          <div class="flex items-center gap-2">
            <input id="pg-umk" type="text" inputmode="numeric" value="" data-i18n-attr="placeholder" data-i18n="pesangon.ph_umk" placeholder="cth. 3.300.000"
              class="w-full px-4 py-3 rounded-xl bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-lg font-bold text-matte-800 dark:text-white outline-none focus:ring-2 focus:ring-emerald-500/40 transition-all" />
            <span class="font-bold text-matte-400 text-sm">Rp</span>
          </div>
          <p class="mt-1.5 text-2xs text-matte-400" data-i18n="pesangon.umk_hint">Dasar pesangon tidak boleh lebih rendah dari upah minimum domisili perusahaan (Pasal 81 UU Cipta Kerja).</p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-4 mb-4">
        <div>
          <span class="block text-2xs font-bold text-matte-400 uppercase tracking-wider mb-2" data-i18n="pesangon.service">Masa kerja</span>
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-2">
              <input id="pg-years" type="number" min="0" max="60" value="7"
                class="w-24 px-3 py-3 rounded-xl bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-lg font-bold text-center text-matte-800 dark:text-white outline-none focus:ring-2 focus:ring-emerald-500/40 transition-all" />
              <span class="text-xs font-bold text-matte-400" data-i18n="pesangon.years">tahun</span>
            </div>
            <div class="flex items-center gap-2">
              <input id="pg-months" type="number" min="0" max="11" value="0"
                class="w-20 px-3 py-3 rounded-xl bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-lg font-bold text-center text-matte-800 dark:text-white outline-none focus:ring-2 focus:ring-emerald-500/40 transition-all" />
              <span class="text-xs font-bold text-matte-400" data-i18n="pesangon.months">bulan</span>
            </div>
          </div>
        </div>
        <div>
          <label for="pg-reason" class="block text-2xs font-bold text-matte-400 uppercase tracking-wider mb-2" data-i18n="pesangon.reason">Alasan PHK</label>
          <div class="flex items-center gap-3">
            <select id="pg-reason"
              class="flex-1 min-w-0 px-3 py-3 rounded-xl bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm font-bold text-matte-800 dark:text-white outline-none focus:ring-2 focus:ring-emerald-500/40 transition-all">
              <optgroup label="0×">
                <option value="resign" data-i18n="pesangon.r_resign">Mengundurkan diri atas kemauan sendiri</option>
                <option value="mangkir" data-i18n="pesangon.r_mangkir">Mangkir ≥5 hari kerja berturut tanpa keterangan &amp; telah dipanggil 2×</option>
                <option value="ditahan" data-i18n="pesangon.r_ditahan">Ditahan pihak berwajib &gt;6 bulan &amp; dinyatakan bersalah</option>
                <option value="urgent_violation" data-i18n="pesangon.r_urgent">Melakukan pelanggaran bersifat mendesak (PK/PP/PKB)</option>
                <option value="no_fault" data-i18n="pesangon.r_nofault">Pengadilan memutuskan pengusaha tidak terbukti berbuat salah</option>
              </optgroup>
              <optgroup label="0,5×">
                <option value="sp3_violation" data-i18n="pesangon.r_sp3">Melanggar ketentuan PK/PP/PKB setelah SP-1/2/3</option>
                <option value="eff_loss" data-i18n="pesangon.r_effloss">Efisiensi karena perusahaan mengalami kerugian</option>
                <option value="close_loss" data-i18n="pesangon.r_closeloss">Perusahaan tutup karena kerugian terus-menerus 2 tahun</option>
                <option value="fm_close" data-i18n="pesangon.r_fmclose">Tutup akibat keadaan memaksa (force majeure)</option>
                <option value="debt_loss" data-i18n="pesangon.r_debtloss">Menunda kewajiban bayar utang karena mengalami kerugian</option>
                <option value="bankrupt" data-i18n="pesangon.r_bankrupt">Perusahaan pailit</option>
                <option value="takeover_terms" data-i18n="pesangon.r_takeovert">Pengambilalihan perusahaan, syarat kerja berubah &amp; pihak tidak bersedia lanjut</option>
              </optgroup>
              <optgroup label="0,75×">
                <option value="fm_noclose" data-i18n="pesangon.r_fmno">Force majeure yang tidak mengakibatkan perusahaan tutup</option>
              </optgroup>
              <optgroup label="1×">
                <option value="merger" data-i18n="pesangon.r_merger">Penggabungan/peleburan/pemisahan &amp; pihak tidak bersedia lanjut</option>
                <option value="takeover" data-i18n="pesangon.r_takeover">Pengambilalihan perusahaan</option>
                <option value="eff_prevent" data-i18n="pesangon.r_effprev">Efisiensi untuk mencegah kerugian</option>
                <option value="close_noloss" data-i18n="pesangon.r_closeno">Perusahaan tutup bukan karena kerugian</option>
                <option value="debt_noloss" data-i18n="pesangon.r_debtno">Menunda bayar utang bukan karena kerugian</option>
                <option value="misconduct" data-i18n="pesangon.r_misconduct">PHK diminta pekerja karena perbuatan pengusaha (Pasal 36 g)</option>
              </optgroup>
              <optgroup label="1,75×">
                <option value="retire" data-i18n="pesangon.r_retire">Memasuki usia pensiun</option>
              </optgroup>
              <optgroup label="2×">
                <option value="illness" data-i18n="pesangon.r_illness">Sakit berkepanjangan/cacat kecelakaan kerja, tidak bisa kerja setelah 12 bulan</option>
                <option value="death" data-i18n="pesangon.r_death">Pekerja meninggal dunia</option>
              </optgroup>
            </select>
            <div class="shrink-0 text-center rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900 px-3 py-2">
              <div class="text-2xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider" data-i18n="pesangon.multiplier">Pengali UP</div>
              <div id="pg-multiplier" class="text-xl font-black text-matte-900 dark:text-white">1×</div>
            </div>
          </div>
        </div>
      </div>

      <!-- UPH -->
      <div class="border-t border-matte-100 dark:border-matte-800 pt-4 mt-4">
        <div class="flex items-center justify-between gap-3 mb-3">
          <h4 class="text-sm font-bold text-matte-700 dark:text-matte-200" data-i18n="pesangon.comp_uph">Uang Penggantian Hak (UPH)</h4>
          <label class="flex items-center gap-2 cursor-pointer select-none">
            <input id="pg-tax" type="checkbox" class="w-4 h-4 accent-emerald-600 cursor-pointer" />
            <span class="text-2xs font-semibold text-matte-500 dark:text-matte-400" data-i18n="pesangon.tax_label">Hitung PPh 21 final 5% atas UP &amp; UPMK (PP 68/2009)</span>
          </label>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div>
            <label for="pg-cuti" class="block text-2xs font-bold text-matte-400 uppercase tracking-wider mb-2" data-i18n="pesangon.cuti">Cuti tahunan belum diambil (hari)</label>
            <input id="pg-cuti" type="number" min="0" max="120" value="0"
              class="w-full px-3 py-2.5 rounded-xl bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm font-bold text-matte-800 dark:text-white outline-none focus:ring-2 focus:ring-emerald-500/40 transition-all" />
          </div>
          <div>
            <label for="pg-divider" class="block text-2xs font-bold text-matte-400 uppercase tracking-wider mb-2" data-i18n="pesangon.divider">Pembagi hari kerja (1 hari cuti = upah ÷ pembagi)</label>
            <select id="pg-divider"
              class="w-full px-3 py-2.5 rounded-xl bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm font-bold text-matte-800 dark:text-white outline-none focus:ring-2 focus:ring-emerald-500/40 transition-all">
              <option value="21">21</option>
              <option value="25">25</option>
              <option value="30">30</option>
            </select>
          </div>
          <div>
            <label for="pg-ongkos" class="block text-2xs font-bold text-matte-400 uppercase tracking-wider mb-2" data-i18n="pesangon.ongkos">Ongkos pulang pekerja &amp; keluarga (Rp)</label>
            <input id="pg-ongkos" type="text" inputmode="numeric" value="" placeholder="0"
              class="w-full px-3 py-2.5 rounded-xl bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm font-bold text-matte-800 dark:text-white outline-none focus:ring-2 focus:ring-emerald-500/40 transition-all" />
          </div>
          <div>
            <label for="pg-lain" class="block text-2xs font-bold text-matte-400 uppercase tracking-wider mb-2" data-i18n="pesangon.lain">Hak lain dalam PK/PP/PKB (Rp)</label>
            <input id="pg-lain" type="text" inputmode="numeric" value="" placeholder="0"
              class="w-full px-3 py-2.5 rounded-xl bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm font-bold text-matte-800 dark:text-white outline-none focus:ring-2 focus:ring-emerald-500/40 transition-all" />
          </div>
        </div>
        <p class="mt-3 text-2xs leading-relaxed text-matte-400" data-i18n="pesangon.uph_note">PP 35/2021: UPH meliputi sisa cuti tahunan, ongkos pulang, dan hak lain yang ditetapkan dalam PK/PP/PKB. Komponen “penggantian perumahan &amp; pengobatan 15%” sudah dihapus.</p>
      </div>
    </div>

    <!-- HASIL -->
    <div class="card-base p-6 mb-6 animate-fade-in">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <h3 class="text-xl font-bold text-matte-800 dark:text-white" data-i18n="pesangon.result_title">Rincian Hak PHK</h3>
        <button id="pg-copy" type="button"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-matte-500 dark:text-matte-400 hover:text-emerald-600 dark:hover:text-emerald-400 border border-matte-200 dark:border-matte-700 hover:border-emerald-400/50 rounded-full px-3.5 py-1.5 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <span data-i18n="pesangon.copy">Salin Rincian</span>
        </button>
      </div>

      <p id="pg-empty" class="hidden text-sm text-matte-400" data-i18n="pesangon.empty">Masukkan upah bulanan untuk melihat rincian.</p>

      <div id="pg-results">
        <div class="grid sm:grid-cols-3 gap-3 mb-4">
          <div class="rounded-2xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-900 p-4">
            <div class="text-2xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider mb-1" data-i18n="pesangon.comp_up">Uang Pesangon (UP)</div>
            <div id="pg-up-val" class="text-2xl font-black text-matte-900 dark:text-white">Rp0</div>
            <div id="pg-up-formula" class="text-2xs text-matte-500 dark:text-matte-400 mt-1">—</div>
            <div id="pg-up-none" class="hidden text-2xs font-semibold text-emerald-700 dark:text-emerald-300 mt-1" data-i18n="pesangon.up_note_none">Alasan ini tidak memberi hak pesangon</div>
          </div>
          <div class="rounded-2xl bg-sky-50 dark:bg-sky-950/30 border border-sky-200 dark:border-sky-900 p-4">
            <div class="text-2xs font-bold text-sky-600 dark:text-sky-400 uppercase tracking-wider mb-1">
              <span data-i18n="pesangon.comp_upmk">Uang Penghargaan Masa Kerja (UPMK)</span>
            </div>
            <div id="pg-upmk-val" class="text-2xl font-black text-matte-900 dark:text-white">Rp0</div>
            <div id="pg-upmk-formula" class="text-2xs text-matte-500 dark:text-matte-400 mt-1">—</div>
            <div id="pg-upmk-none" class="hidden text-2xs font-semibold text-sky-700 dark:text-sky-300 mt-1" data-i18n="pesangon.upmk_none">Tidak berhak — masa kerja kurang dari 3 tahun</div>
            <div id="pg-upmk-pisah" class="hidden text-2xs font-semibold text-sky-700 dark:text-sky-300 mt-1" data-i18n="pesangon.pisah_note">Uang pisah = nilai UPMK bila tidak diatur dalam PK/PP/PKB</div>
          </div>
          <div class="rounded-2xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-900 p-4">
            <div class="text-2xs font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider mb-1" data-i18n="pesangon.comp_uph">Uang Penggantian Hak (UPH)</div>
            <div id="pg-uph-val" class="text-2xl font-black text-matte-900 dark:text-white">Rp0</div>
            <div id="pg-uph-formula" class="text-2xs text-matte-500 dark:text-matte-400 mt-1">—</div>
          </div>
        </div>

        <p id="pg-basis-note" class="hidden mb-4 inline-block rounded-full bg-teal-100 dark:bg-teal-900/40 text-teal-700 dark:text-teal-300 text-2xs font-bold px-3 py-1.5" data-i18n="pesangon.basis_umk_note">Upah &lt; UMK → dasar hitung dinaikkan ke upah minimum</p>

        <div class="rounded-2xl border border-matte-200 dark:border-matte-700 divide-y divide-matte-100 dark:divide-matte-800 text-sm">
          <div class="flex items-center justify-between px-4 py-3">
            <span class="font-semibold text-matte-500 dark:text-matte-400" data-i18n="pesangon.total_bruto">Jumlah bruto</span>
            <span id="pg-gross" class="font-black text-matte-800 dark:text-white">Rp0</span>
          </div>
          <div id="pg-tax-row" class="hidden flex items-center justify-between px-4 py-3">
            <span class="font-semibold text-matte-500 dark:text-matte-400" data-i18n="pesangon.tax">PPh 21 final (5%) atas UP + UPMK</span>
            <span id="pg-tax-val" class="font-black text-rose-500">−Rp0</span>
          </div>
          <div class="flex items-center justify-between px-4 py-3 bg-matte-50 dark:bg-surface-elevated rounded-b-2xl">
            <span class="font-bold text-matte-700 dark:text-matte-200" data-i18n="pesangon.total_net">Total diterima (bersih)</span>
            <span id="pg-net" class="text-xl font-black text-emerald-600 dark:text-emerald-400">Rp0</span>
          </div>
        </div>
      </div>
    </div>

    <!-- TABEL REFERENSI -->
    <div class="card-base p-6 mb-6 animate-fade-in">
      <h3 class="text-xl font-bold text-matte-800 dark:text-white mb-4" data-i18n="pesangon.table_title">Tabel referensi: masa kerja → bulan upah</h3>
      <div class="overflow-x-auto -mx-2 px-2">
        <table class="w-full text-xs text-center border-collapse">
          <thead>
            <tr class="text-2xs font-black text-matte-400 uppercase tracking-wider">
              <th class="py-2.5 px-2 text-left" data-i18n="pesangon.th_service">Masa kerja (tahun)</th>
              <th class="py-2.5 px-2" data-i18n="pesangon.th_up">UP (bulan upah)</th>
              <th class="py-2.5 px-2" data-i18n="pesangon.th_upmk">UPMK (bulan upah)</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-matte-100 dark:bg-surface-elevated"><td colspan="3" class="py-2 px-2 text-left font-bold text-matte-600 dark:text-matte-300" data-i18n="pesangon.comp_up">Uang Pesangon (UP)</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">&lt;1</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">1</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">1–2</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">2</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">2–3</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">3</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">3–4</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">4</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">4–5</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">5</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">5–6</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">6</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">6–7</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">7</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">7–8</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">8</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">8+</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">9</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td></tr>
            <tr class="bg-matte-100 dark:bg-surface-elevated"><td colspan="3" class="py-2 px-2 text-left font-bold text-matte-600 dark:text-matte-300" data-i18n="pesangon.comp_upmk">Uang Penghargaan Masa Kerja (UPMK)</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">&lt;3</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">3–6</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">2</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">6–9</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">3</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">9–12</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">4</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">12–15</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">5</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">15–18</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">6</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">18–21</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">7</td></tr>
            <tr class="border-b border-matte-100 dark:border-matte-800"><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">21–24</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">8</td></tr>
            <tr><td class="py-2 px-2 text-left text-matte-600 dark:text-matte-300">24+</td><td class="py-2 px-2 text-matte-300 dark:text-matte-600">—</td><td class="py-2 px-2 text-matte-800 dark:text-white font-bold">10</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-2xs text-matte-400" data-i18n="pesangon.table_range_note">Rentang: batas bawah inklusif, batas atas eksklusif — “7–8” berarti 7 tahun sampai kurang dari 8 tahun. UPMK dikali 1× untuk semua alasan; faktor pengali hanya mengubah UP.</p>
      <p class="mt-1 text-2xs text-matte-400" data-i18n="pesangon.table_foot">Sumber: PP 35/2021 jo. UU Cipta Kerja — Pasal 157–159 UU 13/2003 sebagaimana diubah (tabel UP &amp; UPMK + faktor pengali 0,5–2×).</p>
    </div>

    <!-- INFO -->
    <div class="card-base p-6 animate-fade-in">
      <h3 class="text-xl font-bold text-matte-800 dark:text-white mb-4 flex items-center gap-3">
        <div class="w-10 h-10 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 rounded-xl flex items-center justify-center shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        </div>
        <span data-i18n="pesangon.info_title">Cara kerja hitungan</span>
      </h3>
      <ol class="space-y-3 text-sm text-matte-600 dark:text-matte-300 list-none">
        <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 text-2xs font-black flex items-center justify-center">1</span><span data-i18n="pesangon.info_1">Besaran hak = masa kerja (dalam bulan upah) × upah bulanan × faktor pengali alasan PHK. UPMK selalu dikali 1× — faktor pengali hanya mengubah uang pesangon.</span></li>
        <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 text-2xs font-black flex items-center justify-center">2</span><span data-i18n="pesangon.info_2">PP 35/2021 tidak membedakan pesangon menurut ukuran/kategori perusahaan — penentunya hanya masa kerja, alasan PHK, dan dasar upah. Kategori usaha hanya berperan lewat upah minimum: bila upah pekerja &lt; UMK/UMP, dasar hitung dinaikkan ke upah minimum domisili perusahaan.</span></li>
        <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 text-2xs font-black flex items-center justify-center">3</span><span data-i18n="pesangon.info_3">Dasar upah = upah pokok + tunjangan tetap. Upah harian → bulanan = 30 × upah harian; upah satuan hasil = rata-rata penghasilan 12 bulan terakhir (Pasal 81 UU Cipta Kerja).</span></li>
        <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 text-2xs font-black flex items-center justify-center">4</span><span data-i18n="pesangon.info_4">PHK tanpa pesangon (resign, mangkir, ditahan) tetap berhak UPH dan — bila tidak diatur PK/PP/PKB — uang pisah senilai UPMK.</span></li>
        <li class="flex gap-3"><span class="shrink-0 w-6 h-6 rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 text-2xs font-black flex items-center justify-center">5</span><span data-i18n="pesangon.info_5">Pajak: UP &amp; UPMK kena PPh 21 final 5% (PP 68/2009) bila dibayar sekaligus; bila dicicil lebih dari 2 tahun kena tarif UU HPP. Konfirmasikan ke bagian pajak/HRD.</span></li>
      </ol>
      <p class="mt-4 text-2xs leading-relaxed text-matte-400" data-i18n="pesangon.disclaimer">Simulasi edukatif — bukan nasihat hukum. Angka resmi mengikuti perjanjian kerja, peraturan perusahaan, perjanjian kerja bersama, dan putusan yang berlaku.</p>
    </div>

  </div>
</BaseLayout>

<script>
const __page = (location.pathname.replace(/\/+$/, '') || '/');

  // Faktor pengali alasan PHK — PP 35/2021 (UPMK selalu 1×, dihitung terpisah).
  // up = pengali uang pesangon; 0 = alasan tanpa pesangon (hanya uang pisah & UPH).
  const REASONS: Record<string, { up: number }> = {
    resign: { up: 0 }, mangkir: { up: 0 }, ditahan: { up: 0 },
    urgent_violation: { up: 0 }, no_fault: { up: 0 },
    sp3_violation: { up: 0.5 }, eff_loss: { up: 0.5 }, close_loss: { up: 0.5 },
    fm_close: { up: 0.5 }, debt_loss: { up: 0.5 }, bankrupt: { up: 0.5 },
    takeover_terms: { up: 0.5 },
    fm_noclose: { up: 0.75 },
    merger: { up: 1 }, takeover: { up: 1 }, eff_prevent: { up: 1 },
    close_noloss: { up: 1 }, debt_noloss: { up: 1 }, misconduct: { up: 1 },
    retire: { up: 1.75 },
    illness: { up: 2 }, death: { up: 2 },
  };

  // Tabel masa kerja → bulan upah (PP 35/2021 jo. Pasal 157–159 UU 13/2003):
  // UP: <1 th → 1; tiap tahun +1 sampai 8 th; ≥8 th → 9 bulan.
  const upMonths = (y: number) => (y < 1 ? 1 : y < 8 ? y + 1 : 9);
  // UPMK: mulai 3 th (2 bln), tiap 3 tahun +1; ≥24 th → 10 bulan.
  const upmkMonths = (y: number) => {
    if (y < 3) return 0;
    if (y < 6) return 2;
    if (y < 9) return 3;
    if (y < 12) return 4;
    if (y < 15) return 5;
    if (y < 18) return 6;
    if (y < 21) return 7;
    if (y < 24) return 8;
    return 10;
  };

  const fmtRp = (n: number) => 'Rp' + new Intl.NumberFormat('id-ID').format(Math.round(n));
  const fmtMult = (m: number) => String(m).replace('.', ',');

  function init() {
    const $ = (id: string) => document.getElementById(id);
    const wageEl = $('pg-wage') as HTMLInputElement | null;
    const umkEl = $('pg-umk') as HTMLInputElement | null;
    const yearsEl = $('pg-years') as HTMLInputElement | null;
    const monthsEl = $('pg-months') as HTMLInputElement | null;
    const reasonEl = $('pg-reason') as HTMLSelectElement | null;
    const cutiEl = $('pg-cuti') as HTMLInputElement | null;
    const divEl = $('pg-divider') as HTMLSelectElement | null;
    const ongkosEl = $('pg-ongkos') as HTMLInputElement | null;
    const lainEl = $('pg-lain') as HTMLInputElement | null;
    const taxEl = $('pg-tax') as HTMLInputElement | null;
    const emptyEl = $('pg-empty');
    const resultsEl = $('pg-results');
    const copyBtn = $('pg-copy');
    if (!wageEl || !reasonEl || !resultsEl) return;

    const parseRp = (el: HTMLInputElement | null | undefined) => {
      const n = parseInt((el?.value || '').replace(/\D/g, ''), 10);
      return isNaN(n) ? 0 : n;
    };
    const set = (id: string, val: string) => { const el = $(id); if (el) el.textContent = val; };
    const show = (id: string, on: boolean) => { const el = $(id); if (el) el.classList.toggle('hidden', !on); };

    let lastSummary = '';

    function compute() {
      const wageRaw = parseRp(wageEl);
      const reasonKey = reasonEl!.value;
      const info = REASONS[reasonKey] || { up: 1 };
      const noSev = info.up === 0;

      const multiEl = $('pg-multiplier');
      if (multiEl) multiEl.textContent = fmtMult(info.up) + '×';

      if (wageRaw <= 0) {
        emptyEl?.classList.remove('hidden');
        resultsEl.classList.add('hidden');
        lastSummary = '';
        return;
      }
      emptyEl?.classList.add('hidden');
      resultsEl.classList.remove('hidden');

      const umk = parseRp(umkEl);
      const useUmk = umk > 0 && wageRaw < umk;
      const wage = useUmk ? umk : wageRaw;
      show('pg-basis-note', useUmk);

      const y = Math.min(60, Math.max(0, parseInt(yearsEl?.value || '0', 10) || 0));
      const mth = Math.min(11, Math.max(0, parseInt(monthsEl?.value || '0', 10) || 0));
      const uM = upMonths(y);
      const kM = upmkMonths(y);

      const up = noSev ? 0 : uM * wage * info.up;
      const upmk = kM * wage; // pengali UPMK selalu 1×
      const isPisah = noSev;

      // Kartu 1 — UP
      set('pg-up-val', fmtRp(up));
      show('pg-up-none', noSev);
      show('pg-up-formula', !noSev);
      if (!noSev) set('pg-up-formula', `${uM} × ${fmtRp(wage)} × ${fmtMult(info.up)}`);

      // Kartu 2 — UPMK / uang pisah
      set('pg-upmk-val', fmtRp(upmk));
      show('pg-upmk-none', kM === 0);
      show('pg-upmk-pisah', isPisah && kM > 0);
      show('pg-upmk-formula', kM > 0);
      if (kM > 0) set('pg-upmk-formula', `${kM} × ${fmtRp(wage)} × 1`);

      // Kartu 3 — UPH
      const days = Math.min(120, Math.max(0, parseInt(cutiEl?.value || '0', 10) || 0));
      const div = parseInt(divEl?.value || '21', 10) || 21;
      const cutiVal = days * (wage / div);
      const ongkos = parseRp(ongkosEl);
      const lain = parseRp(lainEl);
      const uph = cutiVal + ongkos + lain;
      set('pg-uph-val', fmtRp(uph));
      set('pg-uph-formula', `${fmtRp(cutiVal)} + ${fmtRp(ongkos)} + ${fmtRp(lain)}`);

      // Total
      const gross = up + upmk + uph;
      const withTax = !!taxEl?.checked;
      const tax = withTax ? (up + upmk) * 0.05 : 0;
      const net = gross - tax;
      set('pg-gross', fmtRp(gross));
      show('pg-tax-row', withTax);
      set('pg-tax-val', '−' + fmtRp(tax));
      set('pg-net', fmtRp(net));

      const reasonLabel = reasonEl!.options[reasonEl!.selectedIndex]?.textContent?.trim() || '';
      lastSummary = [
        'Rincian Pesangon PHK (PP 35/2021)',
        `Alasan: ${reasonLabel} — pengali UP ${fmtMult(info.up)}×`,
        `Masa kerja: ${y} tahun ${mth} bulan | Dasar upah: ${fmtRp(wage)}${useUmk ? ' (dinaikkan ke UMK)' : ''}`,
        noSev
          ? `Uang Pesangon: Rp0 (alasan tanpa pesangon)`
          : `Uang Pesangon: ${uM} × ${fmtRp(wage)} × ${fmtMult(info.up)} = ${fmtRp(up)}`,
        `UPMK${isPisah ? ' (uang pisah)' : ''}: ${kM} × ${fmtRp(wage)} × 1 = ${fmtRp(upmk)}`,
        `UPH: cuti ${days} hari (${fmtRp(cutiVal)}) + ongkos pulang ${fmtRp(ongkos)} + hak lain ${fmtRp(lain)} = ${fmtRp(uph)}`,
        `Jumlah bruto: ${fmtRp(gross)}`,
        withTax ? `PPh 21 final (5%): −${fmtRp(tax)}` : '',
        `Total diterima: ${fmtRp(net)}`,
      ].filter(Boolean).join('\n');
    }

    // Format ribuan live utk input rupiah
    [wageEl, umkEl, ongkosEl, lainEl].forEach((el) => {
      el?.addEventListener('input', () => {
        const digits = el.value.replace(/\D/g, '');
        el.value = digits ? new Intl.NumberFormat('id-ID').format(parseInt(digits, 10)) : '';
        compute();
      });
    });
    [yearsEl, monthsEl, cutiEl].forEach((el) => el?.addEventListener('input', compute));
    reasonEl.addEventListener('change', compute);
    divEl?.addEventListener('change', compute);
    taxEl?.addEventListener('change', compute);

    copyBtn?.addEventListener('click', async () => {
      if (!lastSummary) {
        window.showToast?.(window._tToast ? window._tToast('Lengkapi data dulu!') : 'Lengkapi data dulu!', 'error');
        return;
      }
      try {
        await navigator.clipboard.writeText(`${lastSummary}\n— ${window.location.href}`);
        window.showToast?.(window._tToast ? window._tToast('Hasil disalin!') : 'Hasil disalin!', 'success');
      } catch {
        window.showToast?.(window._tToast ? window._tToast('Gagal menyalin') : 'Gagal menyalin', 'error');
      }
    });

    compute();
  }

  // SPA boot (#14): guard path + guard dobel-bind — pola rumah W6.
  document.addEventListener('astro:page-load', () => {
    const path = (location.pathname.replace(/\/+$/, '') || '/');
    if (path !== __page) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });
</script>
