---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="Split Bill — Patungan Makan & Pajak | MasAul Tools" description="Hitung patungan dengan pajak dan service charge otomatis. 100% client-side." category="Calc" toolHref="/calc/split-bill">
  <ToolPageHeader title="Split Bill Calculator" description="Patungan hemat: hitung per-orang + pajak & service" icon='<path d="M6 2v20M18 2v20M2 6h20M2 18h20"/><circle cx="8" cy="8" r="2"/><circle cx="16" cy="8" r="2"/><circle cx="8" cy="16" r="2"/><circle cx="16" cy="16" r="2"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="total-bill" class="block text-sm text-matte-500 mb-1 font-medium" data-i18n="splitbill.total_label">Total Tagihan (Rp)</label>
        <input id="total-bill" type="number" min="0" value="350000" class="input-field w-full" placeholder="350000">
      </div>
      <div>
        <label for="person-count" class="block text-sm text-matte-500 mb-1 font-medium" data-i18n="splitbill.persons">Jumlah Orang</label>
        <div class="flex gap-2 items-center">
          <button id="minus-person" class="btn-secondary px-3 py-2 text-lg leading-none" aria-label="-">−</button>
          <input id="person-count" type="number" min="1" value="4" class="input-field w-20 text-center text-sm [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" readonly>
          <button id="plus-person" class="btn-secondary px-3 py-2 text-lg leading-none" aria-label="+">+</button>
        </div>
      </div>
      <div>
        <label for="tax" class="block text-sm text-matte-500 mb-1 font-medium" data-i18n="splitbill.tax">Pajak (%)</label>
        <input id="tax" type="number" min="0" step="0.1" value="11" class="input-field w-full" placeholder="11">
      </div>
      <div>
        <label for="service" class="block text-sm text-matte-500 mb-1 font-medium" data-i18n="splitbill.service">Service Charge (%)</label>
        <input id="service" type="number" min="0" step="0.1" value="5" class="input-field w-full" placeholder="5">
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      <div class="card-base p-3 text-center bg-gradient-to-br from-accent-blue/5 to-transparent">
        <p class="text-xs text-matte-400" data-i18n="splitbill.subtotal">Subtotal</p>
        <p class="text-xl font-bold text-accent-blue" id="subtotal">-</p>
      </div>
      <div class="card-base p-3 text-center bg-gradient-to-br from-accent-amber/5 to-transparent">
        <p class="text-xs text-matte-400" data-i18n="splitbill.extra">Pajak + Service</p>
        <p class="text-xl font-bold text-accent-amber" id="extra-cost">-</p>
      </div>
      <div class="card-base p-3 text-center bg-gradient-to-br from-accent-green/5 to-transparent col-span-2 sm:col-span-1">
        <p class="text-xs text-matte-400" data-i18n="splitbill.grand">Grand Total</p>
        <p class="text-xl font-bold text-accent-green" id="grand-total">-</p>
      </div>
      <div class="card-base p-4 text-center bg-gradient-to-br from-accent-purple/10 to-accent-purple/5 border-2 border-accent-purple/20 col-span-2 sm:col-span-3">
        <p class="text-sm text-matte-500 font-medium" data-i18n="splitbill.per_person">Per Orang</p>
        <p class="text-4xl font-bold text-accent-purple" id="per-person">-</p>
        <p class="text-xs text-matte-400 mt-1" id="per-person-detail"></p>
        <button id="copy-btn" class="btn-secondary text-xs mt-3" data-i18n="common.copy">📋 Copy</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { t } from '../../i18n/translations';

  const toast = (msg, type = 'success') => window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  let __splitBillRender: (() => void) | null = null;
  window.addEventListener('langchange', () => { __splitBillRender?.(); });

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const fmt = (n) => n.toLocaleString('id-ID', { maximumFractionDigits: 0 });

  function calc() {
    const total = +(document.getElementById('total-bill').value) || 0;
    const persons = Math.max(1, +(document.getElementById('person-count').value) || 1);
    const tax = Math.max(0, +(document.getElementById('tax').value) || 0);
    const service = Math.max(0, +(document.getElementById('service').value) || 0);

    const taxAmt = total * tax / 100;
    const svcAmt = total * service / 100;
    const grand = total + taxAmt + svcAmt;
    const perPerson = grand / persons;

    document.getElementById('subtotal').textContent = 'Rp ' + fmt(total);
    document.getElementById('extra-cost').textContent = 'Rp ' + fmt(taxAmt + svcAmt);
    document.getElementById('grand-total').textContent = 'Rp ' + fmt(grand);
    document.getElementById('per-person').textContent = 'Rp ' + fmt(perPerson);
    document.getElementById('per-person-detail').textContent =
      fmt(total / persons) + ' ' + t('splitbill.detail_food', '(makan)') + ' + ' + fmt((taxAmt + svcAmt) / persons) + ' ' + t('splitbill.detail_tax', '(pajak+SC)');
  }

  ['total-bill', 'tax', 'service'].forEach((id) => {
    document.getElementById(id).addEventListener('input', calc);
  });

  const personsEl = document.getElementById('person-count');
  document.getElementById('minus-person').addEventListener('click', () => {
    personsEl.value = String(Math.max(1, +personsEl.value - 1));
    calc();
  });
  document.getElementById('plus-person').addEventListener('click', () => {
    personsEl.value = String(Math.min(99, +personsEl.value + 1));
    calc();
  });

  document.getElementById('copy-btn').addEventListener('click', async () => {
    const per = document.getElementById('per-person').textContent || '';
    if (per === '-') { toast('Input kosong!', 'error'); return; }
    const summary = per + ' — ' + document.getElementById('per-person-detail').textContent;
    try { await navigator.clipboard.writeText(summary); toast('Disalin!'); }
    catch { toast('Gagal menyalin', 'error'); }
  });

  calc();

  // langchange: rincian per-orang ikut bahasa
  __splitBillRender = calc;
  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __calcSplitBillPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __calcSplitBillPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });
</script>
