---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Work Hours Calculator">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh] py-10">
    <ToolPageHeader
      title="Kalkulator Jam Kerja"
      titleKey="header.work_hours"
      desc="Hitung jam kerja harian, mingguan, dan lembur dengan cepat."
      descKey="header.work_hours_desc"
      icon='<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>'
      gradient="from-cyan-500 to-blue-600"
    />

    <div class="grid gap-8 animate-fade-in">
      <div class="card-base p-8">
        <h3 class="text-xl font-bold text-matte-800 dark:text-white mb-6" data-i18n="workh.daily_title">Jam Kerja Harian</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          <div><label for="start" class="text-xs text-matte-500 mb-1 block" data-i18n="calc.wh.start">Masuk</label><input id="start" type="time" value="08:00" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold" /></div>
          <div><label for="break-start" class="text-xs text-matte-500 mb-1 block" data-i18n="calc.wh.break_start">Istirahat Mulai</label><input id="break-start" type="time" value="12:00" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold" /></div>
          <div><label for="break-end" class="text-xs text-matte-500 mb-1 block" data-i18n="calc.wh.break_end">Istirahat Selesai</label><input id="break-end" type="time" value="13:00" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold" /></div>
          <div><label for="end" class="text-xs text-matte-500 mb-1 block" data-i18n="calc.wh.end">Pulang</label><input id="end" type="time" value="17:00" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold" /></div>
        </div>
        <button id="calc-daily" class="w-full py-3 bg-cyan-600 text-white rounded-xl font-bold hover:bg-cyan-700 transition-colors" data-i18n="calc.wh.calc_daily">Hitung Jam Kerja</button>
        <div id="result-daily" class="mt-6 p-4 bg-matte-50 dark:bg-surface-hover rounded-xl border border-matte-200 dark:border-surface-border hidden"></div>
      </div>

      <div class="card-base p-8">
        <h3 class="text-xl font-bold text-matte-800 dark:text-white mb-6" data-i18n="workh.weekly_title">Lembur Mingguan</h3>
        <div class="grid grid-cols-7 gap-2 mb-4">
          <input type="number" id="h-mon" aria-label="Senin" data-i18n-attr="aria-label" data-i18n="calc.wh.mon" placeholder="Sen" class="p-2 border rounded-lg text-center text-sm dark:bg-surface-hover dark:border-surface-border" value="8" />
          <input type="number" id="h-tue" aria-label="Selasa" data-i18n-attr="aria-label" data-i18n="calc.wh.tue" placeholder="Sel" class="p-2 border rounded-lg text-center text-sm dark:bg-surface-hover dark:border-surface-border" value="8" />
          <input type="number" id="h-wed" aria-label="Rabu" data-i18n-attr="aria-label" data-i18n="calc.wh.wed" placeholder="Rab" class="p-2 border rounded-lg text-center text-sm dark:bg-surface-hover dark:border-surface-border" value="8" />
          <input type="number" id="h-thu" aria-label="Kamis" data-i18n-attr="aria-label" data-i18n="calc.wh.thu" placeholder="Kam" class="p-2 border rounded-lg text-center text-sm dark:bg-surface-hover dark:border-surface-border" value="8" />
          <input type="number" id="h-fri" aria-label="Jumat" data-i18n-attr="aria-label" data-i18n="calc.wh.fri" placeholder="Jum" class="p-2 border rounded-lg text-center text-sm dark:bg-surface-hover dark:border-surface-border" value="8" />
          <input type="number" id="h-sat" aria-label="Sabtu" data-i18n-attr="aria-label" data-i18n="calc.wh.sat" placeholder="Sab" class="p-2 border rounded-lg text-center text-sm dark:bg-surface-hover dark:border-surface-border" value="0" />
          <input type="number" id="h-sun" aria-label="Minggu" data-i18n-attr="aria-label" data-i18n="calc.wh.sun" placeholder="Min" class="p-2 border rounded-lg text-center text-sm dark:bg-surface-hover dark:border-surface-border" value="0" />
        </div>
        <div class="flex items-center gap-4 mb-4">
          <label class="text-sm text-matte-500" data-i18n="calc.wh.normal">Jam kerja normal/minggu: <input id="normal-hrs" type="number" value="40" class="w-16 p-2 border rounded-lg text-center dark:bg-surface-hover dark:border-surface-border" /></label>
          <label class="text-sm text-matte-500" data-i18n="calc.wh.rate">Upah/jam (Rp): <input id="rate" type="number" value="50000" class="w-32 p-2 border rounded-lg text-center dark:bg-surface-hover dark:border-surface-border" /></label>
        </div>
        <button id="calc-weekly" class="w-full py-3 bg-cyan-600 text-white rounded-xl font-bold hover:bg-cyan-700 transition-colors" data-i18n="calc.wh.calc_weekly">Hitung Mingguan</button>
        <div id="result-weekly" class="mt-6 p-4 bg-matte-50 dark:bg-surface-hover rounded-xl border border-matte-200 dark:border-surface-border hidden"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { t } from '../../i18n/translations';

  const toast = (msg, type = 'success') => window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  let __workHoursRender: (() => void) | null = null;
  window.addEventListener('langchange', () => { __workHoursRender?.(); });

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  function toMin(ts) {
    const m = /^(\d{1,2}):(\d{2})$/.exec(ts || '');
    if (!m) return null;
    return +m[1] * 60 + +m[2];
  }
  function fmtDur(min) {
    const h = Math.floor(min / 60), mm = min % 60;
    return h + 'j ' + mm + 'm';
  }
  function fmtRp(n) { return 'Rp ' + n.toLocaleString('id-ID'); }

  let lastDaily = null;
  let lastWeekly = null;

  function statCell(value, label, color) {
    const wrap = document.createElement('div');
    const v = document.createElement('span');
    v.className = 'text-2xl font-black ' + color;
    v.textContent = value;
    const l = document.createElement('span');
    l.className = 'text-xs text-matte-500 block mt-1';
    l.textContent = label;
    wrap.appendChild(v);
    wrap.appendChild(l);
    return wrap;
  }

  function renderDaily() {
    if (!lastDaily) return;
    const el = document.getElementById('result-daily');
    el.textContent = '';
    const grid = document.createElement('div');
    grid.className = 'grid grid-cols-2 md:grid-cols-4 gap-4 text-center';
    grid.appendChild(statCell(fmtDur(lastDaily.total), t('workh.r_total', 'Total di kantor'), 'text-cyan-600'));
    grid.appendChild(statCell(fmtDur(lastDaily.brk), t('workh.r_break', 'Istirahat'), 'text-amber-500'));
    grid.appendChild(statCell(fmtDur(lastDaily.work), t('workh.r_effective', 'Jam kerja efektif'), 'text-emerald-500'));
    grid.appendChild(statCell((lastDaily.work / 60).toFixed(1) + 'h', t('workh.r_decimal', 'Dalam jam desimal'), 'text-blue-500'));
    el.appendChild(grid);
  }

  function renderWeekly() {
    if (!lastWeekly) return;
    const el = document.getElementById('result-weekly');
    el.textContent = '';
    const grid = document.createElement('div');
    grid.className = 'grid grid-cols-2 md:grid-cols-4 gap-4 text-center';
    grid.appendChild(statCell(lastWeekly.total + 'h', t('workh.r_week_total', 'Total jam minggu ini'), 'text-cyan-600'));
    grid.appendChild(statCell(lastWeekly.ot + 'h', t('workh.r_ot', 'Lembur') + ' (> ' + lastWeekly.normal + 'h)', 'text-amber-500'));
    grid.appendChild(statCell(fmtRp(lastWeekly.normalPay), t('workh.r_normal_pay', 'Gaji normal'), 'text-emerald-500'));
    grid.appendChild(statCell(fmtRp(lastWeekly.otPay), t('workh.r_ot_pay', 'Upah lembur (×1.5)'), 'text-violet-500'));
    el.appendChild(grid);
  }

  document.getElementById('calc-daily').addEventListener('click', () => {
    const s = toMin(document.getElementById('start').value);
    const bs = toMin(document.getElementById('break-start').value);
    const be = toMin(document.getElementById('break-end').value);
    const e = toMin(document.getElementById('end').value);
    if (s === null || bs === null || be === null || e === null || e <= s) {
      toast('Format waktu tidak valid!', 'error');
      return;
    }
    const total = e - s;
    const brk = Math.max(0, be - bs);
    if (brk >= total) {
      toast('Format waktu tidak valid!', 'error');
      return;
    }
    const work = total - brk;
    lastDaily = { total, brk, work };
    document.getElementById('result-daily').classList.remove('hidden');
    renderDaily();
  });

  document.getElementById('calc-weekly').addEventListener('click', () => {
    const ids = ['h-mon', 'h-tue', 'h-wed', 'h-thu', 'h-fri', 'h-sat', 'h-sun'];
    const hrs = ids.map((id) => Math.max(0, parseFloat(document.getElementById(id).value) || 0));
    const total = hrs.reduce((a, b) => a + b, 0);
    const normal = Math.max(1, parseFloat(document.getElementById('normal-hrs').value) || 40);
    const ot = Math.max(0, total - normal);
    const rate = Math.max(0, parseFloat(document.getElementById('rate').value) || 0);
    const normalPay = Math.min(total, normal) * rate;
    const otPay = ot * rate * 1.5;
    lastWeekly = { total, ot, normal, normalPay, otPay };
    document.getElementById('result-weekly').classList.remove('hidden');
    renderWeekly();
  });

  // langchange: hasil terakhir ikut bahasa
  __workHoursRender = () => { renderDaily(); renderWeekly(); };
  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __calcWorkHoursPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __calcWorkHoursPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });
</script>
