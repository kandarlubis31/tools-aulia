---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="Fuel Cost Calculator — Hitung Biaya Bensin | ToolsAulia" description="Estimasi biaya bahan bakar perjalanan. 100% client-side di browser." category="Calc" toolHref="/calc/fuel-cost">
  <ToolPageHeader title="Fuel Cost Calculator" description="Estimasi biaya bensin untuk perjalanan kamu" icon='<path d="M7 20h10M17 4H7l-3 8 3 8h10l3-8-3-8z"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm text-matte-500 mb-1 font-medium">Jarak Perjalanan (km)</label>
        <input id="distance" type="number" min="1" value="300" class="input-field w-full" placeholder="300">
      </div>
      <div>
        <label class="block text-sm text-matte-500 mb-1 font-medium">Konsumsi BBM (km/L)</label>
        <input id="consumption" type="number" min="1" step="0.1" value="12" class="input-field w-full" placeholder="12">
        <p class="text-xs text-matte-400 mt-1">Rata-rata mobil 10-15 km/L, motor 35-60 km/L</p>
      </div>
      <div>
        <label class="block text-sm text-matte-500 mb-1 font-medium">Harga BBM per Liter (Rp)</label>
        <input id="fuel-price" type="number" min="100" value="13000" class="input-field w-full" placeholder="13000">
      </div>
      <div>
        <label class="block text-sm text-matte-500 mb-1 font-medium">Jumlah Penumpang (opsional)</label>
        <input id="passengers" type="number" min="1" value="1" class="input-field w-full" placeholder="1">
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="card-base p-3 text-center bg-gradient-to-br from-accent-blue/5 to-transparent">
        <p class="text-xs text-matte-400">BBM Dibutuhkan</p>
        <p class="text-xl font-bold text-accent-blue" id="fuel-needed">-</p>
        <p class="text-xs text-matte-400">Liter</p>
      </div>
      <div class="card-base p-3 text-center bg-gradient-to-br from-accent-green/5 to-transparent">
        <p class="text-xs text-matte-400">Total Biaya</p>
        <p class="text-xl font-bold text-accent-green" id="total-cost">-</p>
        <p class="text-xs text-matte-400">Rupiah</p>
      </div>
      <div class="card-base p-3 text-center bg-gradient-to-br from-accent-cyan/5 to-transparent">
        <p class="text-xs text-matte-400">Biaya per km</p>
        <p class="text-xl font-bold text-accent-cyan" id="cost-per-km">-</p>
        <p class="text-xs text-matte-400">Rp/km</p>
      </div>
      <div class="card-base p-3 text-center bg-gradient-to-br from-accent-purple/5 to-transparent">
        <p class="text-xs text-matte-400">Per Orang</p>
        <p class="text-xl font-bold text-accent-purple" id="cost-per-person">-</p>
        <p class="text-xs text-matte-400">Rupiah</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const fmt = (n: number) => n.toLocaleString('id-ID', { maximumFractionDigits: 0 });

  function calc() {
    const dist = +(document.getElementById('distance') as HTMLInputElement).value;
    const cons = +(document.getElementById('consumption') as HTMLInputElement).value;
    const price = +(document.getElementById('fuel-price') as HTMLInputElement).value;
    const pass = +(document.getElementById('passengers') as HTMLInputElement).value || 1;

    if (!dist || !cons || !price) return;
    const fuelL = dist / cons;
    const total = fuelL * price;
    const perKm = total / dist;
    const perPerson = total / pass;

    document.getElementById('fuel-needed')!.textContent = fuelL.toFixed(1);
    document.getElementById('total-cost')!.textContent = 'Rp ' + fmt(total);
    document.getElementById('cost-per-km')!.textContent = 'Rp ' + fmt(perKm);
    document.getElementById('cost-per-person')!.textContent = 'Rp ' + fmt(perPerson);
  }

  ['distance','consumption','fuel-price','passengers'].forEach(id => {
    document.getElementById(id)!.addEventListener('input', calc);
  });
  calc();
</script>
