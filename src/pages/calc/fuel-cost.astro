---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="Fuel Cost Calculator" description="Estimasi biaya bahan bakar perjalanan. 100% client-side di browser.">
  <ToolPageHeader title="Fuel Cost Calculator" desc="Estimasi biaya bensin untuk perjalanan kamu" icon='<path d="M7 20h10M17 4H7l-3 8 3 8h10l3-8-3-8z"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="distance" class="block text-sm text-matte-500 mb-1 font-medium" data-i18n="label.distance">Jarak Perjalanan (km)</label>
        <input id="distance" type="number" min="1" value="300" class="input-field w-full" placeholder="300">
      </div>
      <div>
        <label for="consumption" class="block text-sm text-matte-500 mb-1 font-medium" data-i18n="label.consumption">Konsumsi BBM (km/L)</label>
        <input id="consumption" type="number" min="1" step="0.1" value="12" class="input-field w-full" placeholder="12">
        <p class="text-xs text-matte-400 mt-1" data-i18n="hint.consumption">Rata-rata mobil 10-15 km/L, motor 35-60 km/L</p>
      </div>
      <div>
        <label for="fuel-price" class="block text-sm text-matte-500 mb-1 font-medium" data-i18n="label.fuel_price">Harga BBM per Liter (Rp)</label>
        <input id="fuel-price" type="number" min="100" value="13000" class="input-field w-full" placeholder="13000">
      </div>
      <div>
        <label for="passengers" class="block text-sm text-matte-500 mb-1 font-medium" data-i18n="label.passengers">Jumlah Penumpang (opsional)</label>
        <input id="passengers" type="number" min="1" value="1" class="input-field w-full" placeholder="1">
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="card-base p-3 text-center bg-gradient-to-br from-accent-blue/5 to-transparent">
        <p class="text-xs text-matte-400" data-i18n="stat.fuel_needed">BBM Dibutuhkan</p>
        <p class="text-xl font-bold text-accent-blue" id="fuel-needed">-</p>
        <p class="text-xs text-matte-400" data-i18n="unit.liter">Liter</p>
      </div>
      <div class="card-base p-3 text-center bg-gradient-to-br from-accent-green/5 to-transparent">
        <p class="text-xs text-matte-400" data-i18n="stat.total_cost">Total Biaya</p>
        <p class="text-xl font-bold text-accent-green" id="total-cost">-</p>
        <p class="text-xs text-matte-400" data-i18n="unit.rupiah">Rupiah</p>
      </div>
      <div class="card-base p-3 text-center bg-gradient-to-br from-accent-cyan/5 to-transparent">
        <p class="text-xs text-matte-400" data-i18n="stat.cost_per_km">Biaya per km</p>
        <p class="text-xl font-bold text-accent-cyan" id="cost-per-km">-</p>
        <p class="text-xs text-matte-400" data-i18n="unit.rp_per_km">Rp/km</p>
      </div>
      <div class="card-base p-3 text-center bg-gradient-to-br from-accent-purple/5 to-transparent">
        <p class="text-xs text-matte-400" data-i18n="stat.per_person">Per Orang</p>
        <p class="text-xl font-bold text-accent-purple" id="cost-per-person">-</p>
        <p class="text-xs text-matte-400" data-i18n="unit.rupiah">Rupiah</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function init() {
    const get = (id: string) => document.getElementById(id) as HTMLInputElement;
    const fmt = (n: number) => n.toLocaleString('id-ID', { maximumFractionDigits: 0 });
    const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
      window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

    const STAT_IDS = ['fuel-needed', 'total-cost', 'cost-per-km', 'cost-per-person'];
    let lastValid = false;

    function readInputs() {
      return {
        dist: +get('distance').value,
        cons: +get('consumption').value,
        price: +get('fuel-price').value,
        pass: Math.max(1, +get('passengers').value || 1),
      };
    }

    function clearStats() {
      STAT_IDS.forEach(id => { (document.getElementById(id) as HTMLElement).textContent = '-'; });
    }

    function calc() {
      const { dist, cons, price, pass } = readInputs();
      if (!(dist > 0) || !(cons > 0) || !(price > 0)) { clearStats(); return; }
      const fuelL = dist / cons;
      const total = fuelL * price;
      (document.getElementById('fuel-needed') as HTMLElement).textContent = fuelL.toFixed(1);
      (document.getElementById('total-cost') as HTMLElement).textContent = 'Rp ' + fmt(total);
      (document.getElementById('cost-per-km') as HTMLElement).textContent = 'Rp ' + fmt(total / dist);
      (document.getElementById('cost-per-person') as HTMLElement).textContent = 'Rp ' + fmt(total / pass);
      lastValid = true;
    }

    // Toast error hanya saat transisi valid → invalid, biar gak spam tiap keystroke
    function onInput() {
      const { dist, cons, price } = readInputs();
      const invalid = !(dist > 0) || !(cons > 0) || !(price > 0);
      if (invalid && lastValid) { lastValid = false; toast('Input tidak valid!', 'error'); }
      calc();
    }

    ['distance', 'consumption', 'fuel-price', 'passengers'].forEach(id => get(id).addEventListener('input', onInput));
    calc();
  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __calcFuelCostPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __calcFuelCostPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });
</script>
