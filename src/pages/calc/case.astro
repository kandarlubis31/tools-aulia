---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Case Converter">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh]">
        <ToolPageHeader
      title="Case Converter"
      desc="Ubah format huruf teks Anda dengan satu klik."
      descKey="header.case_desc"
      icon='<path d="M4 20h16"/><path d="M4 10l4-8 4 8"/><path d="m14 10 4 8 4-8"/><path d="M4 16h16"/>'
      gradient="from-sky-500 to-blue-600"
    />

    <div class="flex flex-wrap justify-center gap-2 mb-6 animate-fade-in">
       <button class="case-btn bg-matte-100 dark:bg-surface-elevated hover:bg-violet-100 dark:hover:bg-violet-900/20 text-matte-500 dark:text-matte-300 hover:text-violet-600 dark:hover:text-violet-400 px-4 py-2 rounded-lg font-bold text-sm transition border border-transparent hover:border-violet-200 dark:hover:border-violet-800" data-case="upper">🔠 UPPERCASE</button>
       <button class="case-btn bg-matte-100 dark:bg-surface-elevated hover:bg-violet-100 dark:hover:bg-violet-900/20 text-matte-500 dark:text-matte-300 hover:text-violet-600 dark:hover:text-violet-400 px-4 py-2 rounded-lg font-bold text-sm transition border border-transparent hover:border-violet-200 dark:hover:border-violet-800" data-case="lower">🔡 lowercase</button>
       <button class="case-btn bg-matte-100 dark:bg-surface-elevated hover:bg-violet-100 dark:hover:bg-violet-900/20 text-matte-500 dark:text-matte-300 hover:text-violet-600 dark:hover:text-violet-400 px-4 py-2 rounded-lg font-bold text-sm transition border border-transparent hover:border-violet-200 dark:hover:border-violet-800" data-case="title">📝 Title Case</button>
       <button class="case-btn bg-matte-100 dark:bg-surface-elevated hover:bg-violet-100 dark:hover:bg-violet-900/20 text-matte-500 dark:text-matte-300 hover:text-violet-600 dark:hover:text-violet-400 px-4 py-2 rounded-lg font-bold text-sm transition border border-transparent hover:border-violet-200 dark:hover:border-violet-800" data-case="sentence">📄 Sentence case</button>
       <button class="case-btn bg-matte-100 dark:bg-surface-elevated hover:bg-violet-100 dark:hover:bg-violet-900/20 text-matte-500 dark:text-matte-300 hover:text-violet-600 dark:hover:text-violet-400 px-4 py-2 rounded-lg font-bold text-sm transition border border-transparent hover:border-violet-200 dark:hover:border-violet-800" data-case="camel">🐪 camelCase</button>
       <button class="case-btn bg-matte-100 dark:bg-surface-elevated hover:bg-violet-100 dark:hover:bg-violet-900/20 text-matte-500 dark:text-matte-300 hover:text-violet-600 dark:hover:text-violet-400 px-4 py-2 rounded-lg font-bold text-sm transition border border-transparent hover:border-violet-200 dark:hover:border-violet-800" data-case="snake">🐍 snake_case</button>
       <button class="case-btn bg-matte-100 dark:bg-surface-elevated hover:bg-violet-100 dark:hover:bg-violet-900/20 text-matte-500 dark:text-matte-300 hover:text-violet-600 dark:hover:text-violet-400 px-4 py-2 rounded-lg font-bold text-sm transition border border-transparent hover:border-violet-200 dark:hover:border-violet-800" data-case="kebab">🍢 kebab-case</button>
       <button class="case-btn bg-matte-100 dark:bg-surface-elevated hover:bg-violet-100 dark:hover:bg-violet-900/20 text-matte-500 dark:text-matte-300 hover:text-violet-600 dark:hover:text-violet-400 px-4 py-2 rounded-lg font-bold text-sm transition border border-transparent hover:border-violet-200 dark:hover:border-violet-800" data-case="swap">🔄 sWAP cASE</button>
       <button class="case-btn bg-matte-100 dark:bg-surface-elevated hover:bg-violet-100 dark:hover:bg-violet-900/20 text-matte-500 dark:text-matte-300 hover:text-violet-600 dark:hover:text-violet-400 px-4 py-2 rounded-lg font-bold text-sm transition border border-transparent hover:border-violet-200 dark:hover:border-violet-800" data-case="alternate">🎭 aLtErNaTe</button>
    </div>

    <div class="flex flex-col h-96 card-base overflow-hidden animate-fade-in">
       <div class="bg-matte-100 dark:bg-surface-hover px-4 py-2 border-b border-matte-200 dark:border-surface-border flex justify-between items-center">
          <span class="section-title" data-i18n="text.case_editor">Text Editor</span>
          <div class="flex gap-3">
             <button id="copy-btn" class="text-xs font-bold text-violet-500 hover:text-violet-600 transition-colors">📋 Copy</button>
             <button id="clear-btn" class="text-xs font-bold text-rose-500 hover:text-rose-600 transition-colors">🗑 Clear</button>
          </div>
       </div>
       <textarea id="text-input" class="flex-1 w-full p-6 font-sans text-lg bg-transparent text-matte-800 dark:text-white outline-none resize-none" placeholder="Ketik atau tempel teks di sini..." data-i18n-attr="placeholder" data-i18n="ph.type_or_paste"></textarea>
       
       <div class="bg-matte-100 dark:bg-surface-hover px-4 py-2 border-t border-matte-200 dark:border-surface-border text-xs text-matte-400 flex flex-wrap justify-between gap-x-4">
          <span><span id="char-count-num">0</span> <span data-i18n="text.characters">karakter</span></span>
          <span><span id="word-count-num">0</span> <span data-i18n="text.words">kata</span></span>
          <span><span id="line-count-num">0</span> baris</span>
       </div>
    </div>

    <!-- Live Preview Strip -->
    <div id="preview-strip" class="hidden mt-6 space-y-2 animate-fade-in">
      <h3 class="text-xs font-bold uppercase tracking-wider text-matte-400 mb-2">📋 Preview Semua Format</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-2" id="preview-grid"></div>
    </div>

  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
  const input = document.getElementById('text-input') as HTMLTextAreaElement;
  const copyBtn = document.getElementById('copy-btn');
  const clearBtn = document.getElementById('clear-btn');
  const charCountNum = document.getElementById('char-count-num');
  const wordCountNum = document.getElementById('word-count-num');
  const lineCountNum = document.getElementById('line-count-num');
  const btns = document.querySelectorAll('.case-btn');
  const previewStrip = document.getElementById('preview-strip');
  const previewGrid = document.getElementById('preview-grid');

  function updateCounts() {
    const val = input.value;
    if (charCountNum) charCountNum.textContent = String(val.length);
    const words = val.trim().split(/\s+/).filter(w => w).length;
    if (wordCountNum) wordCountNum.textContent = String(words);
    const lines = val ? val.split('\n').length : 0;
    if (lineCountNum) lineCountNum.textContent = String(lines);
  }

  const caseLabels: Record<string, [string, string]> = {
    upper: ['🔠', 'UPPERCASE'],
    lower: ['🔡', 'lowercase'],
    title: ['📝', 'Title Case'],
    sentence: ['📄', 'Sentence case'],
    camel: ['🐪', 'camelCase'],
    snake: ['🐍', 'snake_case'],
    kebab: ['🍢', 'kebab-case'],
    swap: ['🔄', 'sWAP cASE'],
    alternate: ['🎭', 'aLtErNaTe'],
  };

  function convert(type: string, source?: string): string {
    let val = source ?? input.value;
    if(!val) return val;

    switch(type) {
        case 'upper': return val.toUpperCase();
        case 'lower': return val.toLowerCase();
        case 'title': return val.toLowerCase().replace(/(?:^|\s)\S/g, a => a.toUpperCase());
        case 'sentence': return val.toLowerCase().replace(/(^\w|\.\s+\w)/gm, a => a.toUpperCase());
        case 'camel':
            return val.toLowerCase().replace(/[^a-zA-Z0-9]+(.)/g, (_, chr: string) => chr.toUpperCase());
        case 'snake':
            return (val.match(/[A-Z]{2,}(?=[A-Z][a-z]+[0-9]*|\b)|[A-Z]?[a-z]+[0-9]*|[A-Z]|[0-9]+/g) || [])
                      .map(x => x.toLowerCase()).join('_');
        case 'kebab':
            return (val.match(/[A-Z]{2,}(?=[A-Z][a-z]+[0-9]*|\b)|[A-Z]?[a-z]+[0-9]*|[A-Z]|[0-9]+/g) || [])
                      .map(x => x.toLowerCase()).join('-');
        case 'swap':
            return val.split('').map(c => c === c.toUpperCase() ? c.toLowerCase() : c.toUpperCase()).join('');
        case 'alternate':
            return val.split('').map((c, i) => i % 2 === 0 ? c.toLowerCase() : c.toUpperCase()).join('');
    }
    return val;
  }

  function updatePreviewStrip(val: string) {
    if (!val.trim()) {
      previewStrip?.classList.add('hidden');
      return;
    }
    previewStrip?.classList.remove('hidden');
    if (!previewGrid) return;

    const types = ['upper', 'lower', 'title', 'camel', 'snake', 'kebab', 'swap', 'alternate', 'sentence'];
    previewGrid.innerHTML = types.map(t => {
      const [icon, label] = caseLabels[t] || ['', t];
      const result = convert(t, val);
      const truncated = result.length > 50 ? result.slice(0, 47) + '...' : result;
      return `
        <div class="preview-card bg-matte-100 dark:bg-surface-elevated rounded-lg p-3 border border-matte-200 dark:border-surface-border hover:border-violet-300 dark:hover:border-violet-700 transition cursor-pointer group" data-case="${t}" title="Klik untuk terapkan ${label}">
          <div class="flex items-center gap-1.5 mb-1">
            <span class="text-xs">${icon}</span>
            <span class="text-2xs font-bold uppercase tracking-wider text-matte-400 group-hover:text-violet-500 transition">${label}</span>
          </div>
          <p class="text-xs text-matte-600 dark:text-matte-300 font-mono truncate group-hover:text-violet-600 dark:group-hover:text-violet-400 transition">${escapeHtml(truncated)}</p>
        </div>
      `;
    }).join('');

    // Click preview card to apply that case
    previewGrid.querySelectorAll('.preview-card').forEach(card => {
      card.addEventListener('click', () => {
        const caseType = (card as HTMLElement).dataset.case;
        if (caseType) {
          input.value = convert(caseType);
          updateCounts();
        }
      });
    });
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
  }

  btns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const caseType = (e.currentTarget as HTMLElement).dataset.case;
      if (caseType) {
        input.value = convert(caseType);
        updateCounts();
      }
    });
  });

  let previewTimer: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => {
    updateCounts();
    clearTimeout(previewTimer);
    previewTimer = setTimeout(() => updatePreviewStrip(input.value), 200);
  });
  
  copyBtn?.addEventListener('click', () => {
    if (!input.value) return;
    navigator.clipboard.writeText(input.value);
    const orig = copyBtn.innerHTML;
    copyBtn.innerHTML = '✅ Copied!';
    setTimeout(() => { copyBtn.innerHTML = orig; }, 1500);
    window.showToast(window._tToast ? window._tToast('Teks disalin!') : 'Teks disalin!', "success");
  });

  clearBtn?.addEventListener('click', () => {
    input.value = '';
    updateCounts();
    input.focus();
  });

  // Keyboard shortcut: Ctrl+Enter to apply title case
  input.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      input.value = convert('title');
      updateCounts();
    }
  });
  });
</script>
