---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Fraction Calculator — Kalkulator Pecahan">
  <div class="max-w-3xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Fraction Calculator"
      titleKey="header.fraction_calc"
      desc="Kalkulator pecahan: tambah, kurang, kali, bagi, sederhanakan."
      descKey="header.fraction_calc_desc"
      icon='<line x1="8" y1="4" x2="16" y2="4"/><line x1="12" y1="4" x2="12" y2="20"/><line x1="8" y1="20" x2="16" y2="20"/>'
      gradient="from-purple-500 to-violet-600"
    />

    <div class="card-base p-6 animate-fade-in">
      <!-- Fraction 1 -->
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="text-center">
          <input id="num1" type="number" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-purple-500 transition-colors text-sm text-center" placeholder="Pembilang" value="1" />
          <div class="w-full h-0.5 bg-matte-300 dark:bg-surface-border my-2"></div>
          <input id="den1" type="number" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-purple-500 transition-colors text-sm text-center" placeholder="Penyebut" value="2" />
        </div>
        <div class="text-center">
          <input id="num2" type="number" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-purple-500 transition-colors text-sm text-center" placeholder="Pembilang" value="1" />
          <div class="w-full h-0.5 bg-matte-300 dark:bg-surface-border my-2"></div>
          <input id="den2" type="number" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-purple-500 transition-colors text-sm text-center" placeholder="Penyebut" value="3" />
        </div>
      </div>

      <!-- Operation buttons -->
      <div class="flex justify-center gap-2 mb-6">
        <button class="op-btn px-4 py-2 rounded-xl text-sm font-bold bg-purple-500 text-white shadow-md transition-all" data-op="+">+</button>
        <button class="op-btn px-4 py-2 rounded-xl text-sm font-medium text-matte-500 hover:bg-matte-100 dark:hover:bg-surface-elevated transition-all" data-op="-">−</button>
        <button class="op-btn px-4 py-2 rounded-xl text-sm font-medium text-matte-500 hover:bg-matte-100 dark:hover:bg-surface-elevated transition-all" data-op="*">×</button>
        <button class="op-btn px-4 py-2 rounded-xl text-sm font-medium text-matte-500 hover:bg-matte-100 dark:hover:bg-surface-elevated transition-all" data-op="/">÷</button>
      </div>

      <button id="calc-btn" class="w-full gradient-brand py-3 rounded-xl font-bold text-sm" data-i18n="frac.simplify">Hitung & Sederhanakan</button>

      <!-- Result -->
      <div id="result" class="hidden mt-6 text-center p-6 bg-matte-50 dark:bg-matte-900 rounded-xl border border-matte-200 dark:border-surface-border">
        <p class="text-2xs text-matte-400 mb-2" data-i18n="frac.result">Hasil</p>
        <div class="flex items-center justify-center gap-4">
          <div class="text-center">
            <p id="result-num" class="text-4xl font-bold text-purple-600 dark:text-purple-400">5</p>
            <div class="w-16 h-0.5 bg-purple-500 my-1"></div>
            <p id="result-den" class="text-4xl font-bold text-purple-600 dark:text-purple-400">6</p>
          </div>
          <div class="text-left">
            <p class="text-sm text-matte-500">=</p>
            <p id="result-decimal" class="text-lg font-mono text-matte-600 dark:text-matte-400">0.8333</p>
            <p id="result-mixed" class="text-sm text-matte-500"></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
const __page = (location.pathname.replace(/\/+$/, '') || '/');

    document.addEventListener('astro:page-load', () => {if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;

      let operation = '+';

      function gcd(a: number, b: number): number {
        a = Math.abs(a);
        b = Math.abs(b);
        while (b) {
          [a, b] = [b, a % b];
        }
        return a;
      }

      function calculate() {
        const n1 = parseInt((document.getElementById('num1') as HTMLInputElement).value) || 0;
        const d1 = parseInt((document.getElementById('den1') as HTMLInputElement).value) || 1;
        const n2 = parseInt((document.getElementById('num2') as HTMLInputElement).value) || 0;
        const d2 = parseInt((document.getElementById('den2') as HTMLInputElement).value) || 1;

        if (d1 === 0 || d2 === 0) {
          showToast('Penyebut tidak boleh 0!', 'error');
          return;
        }

        let resultNum: number, resultDen: number;

        switch (operation) {
          case '+':
            resultNum = n1 * d2 + n2 * d1;
            resultDen = d1 * d2;
            break;
          case '-':
            resultNum = n1 * d2 - n2 * d1;
            resultDen = d1 * d2;
            break;
          case '*':
            resultNum = n1 * n2;
            resultDen = d1 * d2;
            break;
          case '/':
            resultNum = n1 * d2;
            resultDen = d1 * n2;
            break;
          default:
            return;
        }

        // Simplify
        const divisor = gcd(resultNum, resultDen);
        resultNum /= divisor;
        resultDen /= divisor;

        // Handle negative
        if (resultDen < 0) {
          resultNum = -resultNum;
          resultDen = -resultDen;
        }

        document.getElementById('result-num')!.textContent = resultNum.toString();
        document.getElementById('result-den')!.textContent = resultDen.toString();
        document.getElementById('result-decimal')!.textContent = (resultNum / resultDen).toFixed(4);

        // Mixed number
        if (Math.abs(resultNum) > resultDen) {
          const whole = Math.floor(Math.abs(resultNum) / resultDen);
          const remainder = Math.abs(resultNum) % resultDen;
          document.getElementById('result-mixed')!.textContent = `${resultNum < 0 ? '-' : ''}${whole} ${remainder}/${resultDen}`;
        } else {
          document.getElementById('result-mixed')!.textContent = '';
        }

        document.getElementById('result')?.classList.remove('hidden');
      }

      // Operation buttons
      document.querySelectorAll('.op-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.op-btn').forEach(b => {
            b.className = 'px-4 py-2 rounded-xl text-sm font-medium text-matte-500 hover:bg-matte-100 dark:hover:bg-surface-elevated transition-all';
          });
          btn.className = 'px-4 py-2 rounded-xl text-sm font-bold bg-purple-500 text-white shadow-md transition-all';
          operation = (btn as HTMLElement).dataset.op!;
        });
      });

      document.getElementById('calc-btn')?.addEventListener('click', calculate);
    });
  </script>
</BaseLayout>
