---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Currency Converter">
  <div class="max-w-2xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Konversi Mata Uang"
      titleKey="header.currency"
      desc="Kurs live real-time dengan smart caching."
      descKey="header.currency_desc"
      icon='<path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>'
      gradient="from-emerald-500 to-teal-600"
    />

    <div class="card-base p-6 md:p-8 animate-fade-in-up relative overflow-hidden">
      
      <!-- Loading overlay -->
      <div id="loading" class="absolute inset-0 bg-white/90 dark:bg-matte-900/90 z-20 flex items-center justify-center backdrop-blur-sm transition-opacity duration-500">
        <div class="flex flex-col items-center gap-3">
            <svg class="animate-spin h-8 w-8 text-emerald-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            <span class="text-sm font-bold text-emerald-600" data-i18n="msg.syncing">Sinkronisasi Data...</span>
        </div>
      </div>

      <div class="space-y-6">
        
        <!-- Amount Input -->
        <div>
            <label class="section-title mb-2 block" data-i18n="label.amount_money">Jumlah Uang</label>
            <input type="number" id="amount" value="1" min="0" 
              class="no-spinner w-full p-4 text-2xl font-bold rounded-xl bg-matte-100 dark:bg-surface-hover border-2 border-matte-200 dark:border-surface-border focus:border-emerald-500 dark:focus:border-emerald-400 outline-none transition-all text-matte-800 dark:text-white placeholder-matte-400" 
              placeholder="0" />

            <div class="flex flex-wrap gap-2 mt-3">
                <button class="shortcut-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-matte-200 dark:bg-matte-700 text-matte-600 dark:text-matte-300 hover:bg-emerald-100 hover:text-emerald-700 dark:hover:bg-emerald-900/50 dark:hover:text-emerald-300 transition-all duration-150" data-multiply="100">
                    + Ratus
                </button>
                <button class="shortcut-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-matte-200 dark:bg-matte-700 text-matte-600 dark:text-matte-300 hover:bg-emerald-100 hover:text-emerald-700 dark:hover:bg-emerald-900/50 dark:hover:text-emerald-300 transition-all duration-150" data-multiply="1000">
                    + Ribu
                </button>
                <button class="shortcut-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-matte-200 dark:bg-matte-700 text-matte-600 dark:text-matte-300 hover:bg-emerald-100 hover:text-emerald-700 dark:hover:bg-emerald-900/50 dark:hover:text-emerald-300 transition-all duration-150" data-multiply="1000000">
                    + Juta
                </button>
                <button id="reset-amount" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-rose-100 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400 hover:bg-rose-200 dark:hover:bg-rose-800/30 transition-all duration-150 ml-auto">
                    ↺ Reset
                </button>
            </div>
        </div>

        <!-- Currency Selectors -->
        <div class="flex items-end gap-3">
            <!-- From -->
            <div class="flex-1">
                <label class="section-title mb-2 block" data-i18n="label.from">Dari</label>
                <div class="relative">
                    <select id="from-currency" class="w-full p-3 pr-10 rounded-xl bg-matte-100 dark:bg-surface-hover border-2 border-matte-200 dark:border-surface-border hover:border-emerald-300 dark:hover:border-emerald-700 focus:border-emerald-500 font-bold text-matte-700 dark:text-matte-200 cursor-pointer outline-none appearance-none transition-all duration-150">
                        <option value="USD">🇺🇸  USD — US Dollar</option>
                        <option value="IDR">🇮🇩  IDR — Rupiah</option>
                        <option value="EUR">🇪🇺  EUR — Euro</option>
                        <option value="SGD">🇸🇬  SGD — Singapore Dollar</option>
                        <option value="MYR">🇲🇾  MYR — Ringgit</option>
                        <option value="JPY">🇯🇵  JPY — Yen</option>
                        <option value="GBP">🇬🇧  GBP — Pound Sterling</option>
                        <option value="AUD">🇦🇺  AUD — Australian Dollar</option>
                        <option value="CNY">🇨🇳  CNY — Yuan</option>
                        <option value="KRW">🇰🇷  KRW — Won</option>
                        <option value="SAR">🇸🇦  SAR — Riyal</option>
                        <option value="THB">🇹🇭  THB — Baht</option>
                    </select>
                    <!-- Custom chevron -->
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-matte-400">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </div>
                </div>
            </div>

            <!-- Swap Button -->
            <button id="swap-btn" class="p-3 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-200 dark:hover:bg-emerald-800/40 hover:scale-110 active:scale-95 transition-all shadow-sm group shrink-0" title="Tukar mata uang" aria-label="Tukar mata uang">
                <svg id="swap-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-500"><path d="M7.5 14.25L2.25 9l5.25-5.25"/><path d="M2.25 9h19.5"/><path d="M16.5 9.75L21.75 15l-5.25 5.25"/><path d="M21.75 15H2.25"/></svg>
            </button>

            <!-- To -->
            <div class="flex-1">
                <label class="section-title mb-2 block" data-i18n="label.to">Ke</label>
                <div class="relative">
                    <select id="to-currency" class="w-full p-3 pr-10 rounded-xl bg-matte-100 dark:bg-surface-hover border-2 border-matte-200 dark:border-surface-border hover:border-emerald-300 dark:hover:border-emerald-700 focus:border-emerald-500 font-bold text-matte-700 dark:text-matte-200 cursor-pointer outline-none appearance-none transition-all duration-150">
                        <option value="IDR" selected>🇮🇩  IDR — Rupiah</option>
                        <option value="USD">🇺🇸  USD — US Dollar</option>
                        <option value="EUR">🇪🇺  EUR — Euro</option>
                        <option value="SGD">🇸🇬  SGD — Singapore Dollar</option>
                        <option value="MYR">🇲🇾  MYR — Ringgit</option>
                        <option value="JPY">🇯🇵  JPY — Yen</option>
                        <option value="GBP">🇬🇧  GBP — Pound Sterling</option>
                        <option value="AUD">🇦🇺  AUD — Australian Dollar</option>
                        <option value="CNY">🇨🇳  CNY — Yuan</option>
                        <option value="KRW">🇰🇷  KRW — Won</option>
                        <option value="SAR">🇸🇦  SAR — Riyal</option>
                        <option value="THB">🇹🇭  THB — Baht</option>
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-matte-400">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Result Card -->
        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-emerald-900/20 dark:to-teal-900/20 border-2 border-emerald-200 dark:border-emerald-800 p-6 text-center transition-all">
            <div class="absolute -top-10 -right-10 w-24 h-24 bg-emerald-300/20 dark:bg-emerald-500/10 rounded-full blur-2xl"></div>
            <p class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold uppercase tracking-wider mb-2" data-i18n="msg.conversion_result">Hasil Konversi</p>
            <div id="result" class="text-3xl md:text-4xl font-extrabold text-matte-800 dark:text-white break-words tracking-tight relative z-10">
                ...
            </div>
            <p id="rate-info" class="text-xs text-matte-500 dark:text-matte-400 mt-2 font-mono bg-white/50 dark:bg-black/20 rounded-lg px-3 py-1.5 inline-block">1 USD = ... IDR</p>
        </div>

        <!-- Footer info -->
        <div class="flex items-center justify-between text-[10px] text-matte-400">
            <span data-i18n="msg.data_source">Sumber: open.er-api.com</span>
            <span id="last-updated" class="font-medium text-matte-500">Memperbarui...</span>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Hide number input spinners */
  .no-spinner::-webkit-inner-spin-button,
  .no-spinner::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .no-spinner {
    -moz-appearance: textfield;
  }
</style>

<script is:inline>
  document.addEventListener('astro:page-load', () => {if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;

    
    const amountEl = document.getElementById('amount');
    const fromEl = document.getElementById('from-currency');
    const toEl = document.getElementById('to-currency');
    const resultEl = document.getElementById('result');
    const rateInfoEl = document.getElementById('rate-info');
    const swapBtn = document.getElementById('swap-btn');
    const swapIcon = document.getElementById('swap-icon');
    const loadingEl = document.getElementById('loading');
    const shortcutBtns = document.querySelectorAll('.shortcut-btn');
    const resetAmountBtn = document.getElementById('reset-amount');

    if (!amountEl || !fromEl || !toEl || !resultEl) return;

    const fallbackRates = {
        "USD": 1, "IDR": 16400, "EUR": 0.92, "SGD": 1.35, "MYR": 4.71,
        "JPY": 157.8, "GBP": 0.78, "AUD": 1.50, "CNY": 7.25, "KRW": 1380,
        "SAR": 3.75, "THB": 36.5
    };
    
    let rates = fallbackRates;

    function formatCurrency(num, currency) {
        try {
            return new Intl.NumberFormat('id-ID', { 
                style: 'currency', 
                currency: currency, 
                maximumFractionDigits: 2 
            }).format(num);
        } catch (e) {
            return num.toLocaleString();
        }
    }

    function calculate() {
        let val = parseFloat(amountEl.value);
        if (isNaN(val) || val < 0) val = 0;

        const from = fromEl.value;
        const to = toEl.value;

        if (!rates[from] || !rates[to]) return;

        const rateFrom = rates[from];
        const rateTo = rates[to];
        
        const converted = (val / rateFrom) * rateTo;
        const singleUnit = (1 / rateFrom) * rateTo;

        resultEl.innerText = formatCurrency(converted, to);
        rateInfoEl.innerText = `1 ${from} = ${formatCurrency(singleUnit, to)}`;
        
        // Animate result
        resultEl.classList.add('scale-105');
        setTimeout(() => resultEl.classList.remove('scale-105'), 150);
    }

    async function initCurrency() {
        const cached = localStorage.getItem('simpleRates');
        let usedCache = false;
        let cachedTimestamp = 0;

        if (cached) {
            try {
                const parsed = JSON.parse(cached);
                if (Date.now() - parsed.timestamp < 24 * 60 * 60 * 1000) {
                    rates = parsed.rates;
                    cachedTimestamp = parsed.timestamp;
                    calculate();
                    usedCache = true;
                    if (loadingEl) {
                        loadingEl.style.opacity = '0';
                        setTimeout(() => loadingEl.classList.add('hidden'), 300);
                    }
                }
            } catch (e) {}
        }

        if (!usedCache) calculate();
        
        if (usedCache) {
          const cachedTime = new Date(cachedTimestamp);
          const timeStr = cachedTime.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
          const minsAgo = Math.floor((Date.now() - cachedTimestamp) / 60000);
          const lastUpdated = document.getElementById('last-updated');
          if (lastUpdated) {
            lastUpdated.textContent = '🕐 ' + timeStr + ' · ' + minsAgo + ' menit lalu';
          }
        }

        try {
            const response = await fetch('https://open.er-api.com/v6/latest/USD');
            const data = await response.json();
            
            if (data && data.rates) {
                rates = data.rates;
                calculate();
                
                const now = new Date();
                const timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                localStorage.setItem('simpleRates', JSON.stringify({
                    rates: data.rates,
                    timestamp: Date.now()
                }));
                const lastUpdated = document.getElementById('last-updated');
                if (lastUpdated) {
                  lastUpdated.textContent = '🟢 Live · ' + timeStr + ' WIB';
                }
            }
        } catch (error) {
        } finally {
            if (loadingEl) {
                loadingEl.style.opacity = '0';
                setTimeout(() => loadingEl.classList.add('hidden'), 500);
            }
        }
    }

    // Event listeners
    amountEl.addEventListener('input', calculate);
    fromEl.addEventListener('change', calculate);
    toEl.addEventListener('change', calculate);

    swapBtn.addEventListener('click', () => {
        swapIcon.classList.add('rotate-180');
        setTimeout(() => swapIcon.classList.remove('rotate-180'), 500);

        const temp = fromEl.value;
        fromEl.value = toEl.value;
        toEl.value = temp;
        calculate();
    });

    shortcutBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            let currentVal = parseFloat(amountEl.value) || 0;
            if(currentVal === 0) currentVal = 1; 

            const multiplier = parseFloat(btn.dataset.multiply);
            amountEl.value = currentVal * multiplier;

            amountEl.classList.add('!bg-emerald-100', 'dark:!bg-emerald-900/30');
            setTimeout(() => amountEl.classList.remove('!bg-emerald-100', 'dark:!bg-emerald-900/30'), 200);

            calculate();
        });
    });

    resetAmountBtn?.addEventListener('click', () => {
        amountEl.value = "1";
        calculate();
        amountEl.focus();
    });

    initCurrency();
  });
</script>
