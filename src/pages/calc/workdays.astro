---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Kalkulator Hari Kerja Efektif — Prorata Gaji, Cuti & Kontrak">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh] py-10">
    <ToolPageHeader
      title="Hari Kerja Efektif"
      desc="Hitung hari kerja antara dua tanggal: exclude akhir pekan & libur nasional/custom. Lengkap prorata gaji & sisa cuti tahunan. 100% offline."
      icon='<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M9 16l2 2 4-4"/>'
      gradient="from-cyan-500 to-blue-600"
    />

    <div class="grid gap-8 animate-fade-in">
      <!-- Card 1: Rentang & pengaturan -->
      <div class="card-base p-8">
        <h3 class="text-xl font-bold text-matte-800 dark:text-white mb-6">Rentang Tanggal</h3>
        <div class="grid md:grid-cols-2 gap-4 mb-6">
          <div><label class="text-xs text-matte-500 mb-1 block" for="wd-start">Tanggal Mulai</label><input id="wd-start" type="date" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold" /></div>
          <div><label class="text-xs text-matte-500 mb-1 block" for="wd-end">Tanggal Selesai</label><input id="wd-end" type="date" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold" /></div>
        </div>
        <div class="grid md:grid-cols-2 gap-4 mb-6">
          <div>
            <label class="text-xs text-matte-500 mb-1 block" for="wd-weekend">Akhir Peka</label>
            <select id="wd-weekend" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border">
              <option value="sat-sun" selected>Sabtu & Minggu</option>
              <option value="sun">Minggu saja</option>
              <option value="fri-sat">Jumat & Sabtu</option>
              <option value="none">Tidak ada (7 hari kerja)</option>
            </select>
          </div>
          <div>
            <label class="text-xs text-matte-500 mb-1 block" for="wd-mode">Cara Hitung Ujung</label>
            <select id="wd-mode" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border">
              <option value="inclusive" selected>Kedua tanggal termasuk</option>
              <option value="end-exclusive">Tanggal selesai tidak termasuk</option>
            </select>
          </div>
        </div>
        <div class="mb-6">
          <label class="text-xs text-matte-500 mb-1 block" for="wd-holidays">Hari Libur (satu per baris — tanggal ISO atau tanggal+nama)</label>
          <textarea id="wd-holidays" rows="4" placeholder="2026-01-01&#10;2026-03-20 Nyepi&#10;2026-05-01 Hari Buruh" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border text-sm"></textarea>
          <div class="flex flex-wrap items-center gap-3 mt-2">
            <button id="wd-fill-libur" type="button" class="text-xs font-bold text-cyan-600 dark:text-cyan-400 underline">Isi libur nasional umum (contoh)</button>
            <span id="wd-holiday-count" class="text-xs text-matte-400"></span>
          </div>
        </div>
        <button id="calc-wd" class="w-full py-3 bg-cyan-600 text-white rounded-xl font-bold hover:bg-cyan-700 transition-colors">Hitung</button>
        <div id="result-wd" class="mt-6 hidden"></div>
      </div>

      <!-- Card 2: Prorata gaji & cuti -->
      <div class="card-base p-8">
        <h3 class="text-xl font-bold text-matte-800 dark:text-white mb-2">Prorata Gaji & Cuti</h3>
        <p class="text-sm text-matte-500 mb-6">Otomatis pakai hasil hitungan hari kerja di atas — untuk karyawan masuk/resign di tengah bulan atau sisa cuti.</p>
        <div class="grid md:grid-cols-2 gap-4 mb-6">
          <div>
            <label class="text-xs text-matte-500 mb-1 block" for="pr-salary">Gaji Pokok Sebulan (Rp)</label>
            <input id="pr-salary" type="number" min="0" data-i18n-attr="placeholder" data-i18n="ph.cth_angka" placeholder="cth: 5000000" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold" />
            <p class="text-[11px] text-matte-400 mt-1">Dipakai juga oleh <a href="/pdf/slip-gaji" class="text-cyan-600 dark:text-cyan-400 underline">Slip Gaji</a> (basis ÷ 22 hari kerja).</p>
          </div>
          <div>
            <label class="text-xs text-matte-500 mb-1 block" for="pr-quot">Kuota Cuti Setahun (hari, umumnya 12)</label>
            <input id="pr-quot" type="number" min="0" max="365" value="12" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold" />
          </div>
          <div>
            <label class="text-xs text-matte-500 mb-1 block" for="pr-used">Cuti Terpakai (hari)</label>
            <input id="pr-used" type="number" min="0" max="365" value="0" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border" />
          </div>
          <div>
            <label class="text-xs text-matte-500 mb-1 block" for="pr-basis">Basis Hari Kerja per Bulan</label>
            <select id="pr-basis" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border">
              <option value="22" selected>22 hari (konvensi payroll umum)</option>
              <option value="21">21 hari</option>
              <option value="auto">Hasil hitung hari kerja (rentang 1 bulan)</option>
            </select>
          </div>
        </div>
        <button id="calc-pr" class="w-full py-3 bg-blue-600 text-white rounded-xl font-bold hover:bg-blue-700 transition-colors">Hitung Prorata</button>
        <div id="result-pr" class="mt-6 hidden"></div>
      </div>

      <div class="card-base p-8" id="history-card">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-xl font-bold text-matte-800 dark:text-white" data-i18n="hist.title">Riwayat Perhitungan</h3>
          <button id="wd-history-clear" class="text-xs text-matte-400 hover:text-red-500 font-medium" data-i18n="common.clear_history">Hapus Riwayat</button>
        </div>
        <div id="wd-history-list" class="space-y-2 max-h-60 overflow-y-auto custom-scrollbar">
          <p class="text-sm text-matte-400 text-center py-4" data-i18n="common.no_history">Belum ada riwayat</p>
        </div>
      </div>

      <div class="text-xs text-matte-400 bg-matte-100 dark:bg-surface-hover rounded-xl p-4 leading-relaxed">
        <p class="font-bold text-matte-600 dark:text-matte-300 mb-1">Catatan</p>
        <ul class="list-disc list-inside space-y-0.5">
          <li>Cuti tahunan: pasal 79 UU 13/2003 — 12 hari kerja setelah 12 bulan terus-menerus; proporsional untuk masa kerja < 1 tahun.</li>
          <li>Prorata gaji = gaji ÷ basis hari kerja × jumlah hari kerja dalam periode kerja.</li>
          <li>Daftar libur diisi manual (contoh tombol "isi libur nasional" hanya template — sesuaikan SKB 3 Menteri tahun berjalan).</li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { useLocalHistory } from '../../composables/useLocalHistory';

  const escHtml = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));

  // Riwayat form-snapshot (konvensi riwayat lokal, maks 10)
  const wdHistory = useLocalHistory<{ id: number; date: string; snapshot: Record<string, string> }>('hist:workdays', 10);

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const fmtRp = (n: number) => 'Rp ' + Math.round(n).toLocaleString('id-ID');
  const toISO = (d: Date) => d.toISOString().slice(0, 10);
  const fmtID = (iso: string) => {
    const d = new Date(iso);
    return isNaN(d.getTime()) ? iso : d.toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
  };

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  ($('wd-start') as HTMLInputElement).value = toISO(new Date(new Date().getFullYear(), new Date().getMonth(), 1));
  ($('wd-end') as HTMLInputElement).value = toISO(new Date());

  // ===== Libur nasional umum (template — SKB 3 Menteri resmi mungkin berbeda)
  $('wd-fill-libur').onclick = () => {
    const y = new Date().getFullYear();
    ($('wd-holidays') as HTMLTextAreaElement).value = [
      `${y}-01-01 Tahun Baru`,
      `${y}-01-29 Tahun Baru Imlek (perkiraan)`,
      `${y}-03-20 Nyepi (perkiraan)`,
      `${y}-05-01 Hari Buruh`,
      `${y}-05-14 Kenaikan Isa Almasih (perkiraan)`,
      `${y}-06-01 Hari Lahir Pancasila`,
      `${y}-06-26 Idulfitri 1447 H (perkiraan)`,
      `${y}-08-17 Kemerdekaan RI`,
      `${y}-09-04 Maulid Nabi (perkiraan)`,
      `${y}-12-25 Natal`,
    ].join('\n');
    updateCount();
  };

  function parseHolidays(): { dates: Set<string>; items: [string, string][] } {
    const dates = new Set<string>();
    const items: [string, string][] = [];
    ($('wd-holidays') as HTMLTextAreaElement).value.split('\n').forEach(line => {
      const m = line.trim().match(/(\d{4}-\d{2}-\d{2})(?:\s+(.*))?/);
      if (m) { dates.add(m[1]); items.push([m[1], m[2] || '']); }
    });
    return { dates, items };
  }
  function updateCount() { $('wd-holiday-count').textContent = parseHolidays().dates.size + ' libur terdaftar'; }
  $('wd-holidays').addEventListener('input', updateCount);
  updateCount();

  interface WDResult { total: number; weekend: number; holiday: number; working: number; from: string; to: string; }
  function computeWorkdays(): WDResult | null {
    const startV = ($('wd-start') as HTMLInputElement).value;
    const endV = ($('wd-end') as HTMLInputElement).value;
    if (!startV || !endV) return null;
    let start = new Date(startV), end = new Date(endV);
    if (isNaN(start.getTime()) || isNaN(end.getTime())) return null;
    if (end < start) [start, end] = [end, start];

    const weekendMode = ($('wd-weekend') as HTMLSelectElement).value;
    const endIncluded = ($('wd-mode') as HTMLSelectElement).value === 'inclusive';
    const { dates: holidays } = parseHolidays();

    const isWeekend = (d: Date) => {
      const dow = d.getDay(); // 0=Min
      if (weekendMode === 'none') return false;
      if (weekendMode === 'sun') return dow === 0;
      if (weekendMode === 'fri-sat') return dow === 5 || dow === 6;
      return dow === 0 || dow === 6; // sat-sun
    };

    const endCursor = endIncluded ? end : new Date(end.getTime() - 86400000);
    let total = 0, weekend = 0, holiday = 0, working = 0;
    const cursor = new Date(start);
    while (cursor <= endCursor) {
      total++;
      const iso = toISO(cursor);
      if (isWeekend(cursor)) weekend++;
      else if (holidays.has(iso)) holiday++;
      else working++;
      cursor.setDate(cursor.getDate() + 1);
    }
    return { total, weekend, holiday, working, from: toISO(start), to: toISO(end) };
  }

  const statBox = (label: string, value: string, cls: string) =>
    `<div class="p-3 rounded-xl ${cls}"><p class="text-[11px] font-bold uppercase opacity-70">${label}</p><p class="font-bold text-lg mt-1">${value}</p></div>`;

  let lastResult: WDResult | null = null;

  $('calc-wd').onclick = () => {
    const r = computeWorkdays();
    const el = $('result-wd')!;
    if (!r) {
      el.className = 'mt-6 p-4 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-sm text-red-500';
      el.textContent = 'Isi kedua tanggal dengan benar.';
      el.classList.remove('hidden');
      return;
    }
    lastResult = r;
    const pct = r.total > 0 ? Math.round(r.working / r.total * 100) : 0;
    el.className = 'mt-6 p-5 bg-matte-50 dark:bg-surface-hover rounded-xl border border-cyan-300 dark:border-cyan-800';
    el.innerHTML = `
      <p class="text-xs text-matte-500 mb-3">${fmtID(r.from)} → ${fmtID(r.to)}</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-center">
        ${statBox('Hari Kerja Efektif', String(r.working), 'bg-cyan-50 dark:bg-cyan-900/20 border border-cyan-200 dark:border-cyan-800 text-cyan-600')}
        ${statBox('Total Kalender', String(r.total), 'bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border text-matte-800 dark:text-white')}
        ${statBox('Akhir Peka', String(r.weekend), 'bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border text-matte-800 dark:text-white')}
        ${statBox('Hari Libur', String(r.holiday), 'bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border text-matte-800 dark:text-white')}
      </div>
      <div class="mt-3 h-2.5 rounded-full bg-matte-200 dark:bg-surface-elevated overflow-hidden">
        <div class="h-full bg-cyan-500" style="width:${pct}%"></div>
      </div>
      <p class="text-[11px] text-matte-400 mt-2">${pct}% dari rentang adalah hari kerja.</p>`;
    el.classList.remove('hidden');
    addWdHistory();
  };

  $('calc-pr').onclick = () => {
    const salary = parseFloat(($('pr-salary') as HTMLInputElement).value) || 0;
    const quot = parseFloat(($('pr-quot') as HTMLInputElement).value) || 0;
    const used = parseFloat(($('pr-used') as HTMLInputElement).value) || 0;
    const basisMode = ($('pr-basis') as HTMLSelectElement).value;
    const el = $('result-pr')!;
    if (salary <= 0) {
      el.className = 'mt-6 p-4 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-sm text-red-500';
      el.textContent = 'Isi gaji pokok dengan angka yang valid.';
      el.classList.remove('hidden');
      return;
    }

    let basis: number;
    let basisNote: string;
    if (basisMode === 'auto') {
      const span = computeWorkdays();
      if (!span || span.from.slice(0, 7) !== span.to.slice(0, 7)) {
        el.className = 'mt-6 p-4 rounded-xl bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 text-sm text-amber-600';
        el.textContent = 'Mode "hasil hitung" butuh rentang dalam satu bulan kalender yang sama — hitung dulu di Card 1 dengan rentang 1 bulan.';
        el.classList.remove('hidden');
        return;
      }
      basis = span.working;
      basisNote = `${basis} hari kerja (dihitung dari rentang di atas)`;
    } else {
      basis = parseFloat(basisMode);
      basisNote = `${basis} hari (konvensi payroll)`;
    }

    // Prorata gaji pakai seluruh rentang sebagai periode kerja
    const r = lastResult;
    const workedDays = r ? r.working : basis;
    const earned = Math.round(salary / basis * workedDays);
    const cutiSisa = Math.max(0, quot - used);
    const cutiPct = quot > 0 ? Math.round(used / quot * 100) : 0;

    el.className = 'mt-6 p-5 bg-matte-50 dark:bg-surface-hover rounded-xl border border-blue-300 dark:border-blue-800';
    el.innerHTML = `
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 text-center">
        ${statBox('Periode Dihitung', r ? `${r.working} hari kerja` : '—', 'bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border text-matte-800 dark:text-white')}
        ${statBox('Gaji Diperoleh', fmtRp(earned), 'bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 text-blue-600')}
        ${statBox('Rasio', `${workedDays}/${basis} hari`, 'bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border text-matte-800 dark:text-white')}
      </div>
      <div class="grid grid-cols-2 gap-3 mt-3">
        ${statBox('Sisa Cuti', `${cutiSisa} hari`, cutiSisa <= 3 ? 'bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-500' : 'bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-600')}
        ${statBox('Cuti Terpakai', `${used}/${quot} hari (${cutiPct}%)`, 'bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border text-matte-800 dark:text-white')}
      </div>
      <p class="text-[11px] text-matte-400 mt-3">Rumus gaji: ${fmtRp(salary)} ÷ ${basis} hari × ${workedDays} hari kerja = ${fmtRp(earned)} · basis: ${basisNote}. Tanpa rentang di Card 1, dianggap periode penuh (${basis} hari).</p>`;
    el.classList.remove('hidden');
    addWdHistory();
  };

  // ===== Riwayat form-snapshot =====
  const WD_FIELDS = ['wd-start', 'wd-end', 'wd-weekend', 'wd-mode', 'wd-holidays', 'pr-salary', 'pr-quot', 'pr-used', 'pr-basis'];
  function snapshot(): Record<string, string> {
    const o: Record<string, string> = {};
    WD_FIELDS.forEach(id => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
      if (el) o[id] = el.value;
    });
    return o;
  }

  function restore(o: Record<string, string>) {
    Object.entries(o).forEach(([id, val]) => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
      if (el) el.value = val;
    });
    updateCount();
  }

  function renderWdHistory() {
    const list = document.getElementById('wd-history-list');
    if (!list) return;
    const items = wdHistory.getAll();
    if (items.length === 0) {
      list.innerHTML = '<p class="text-sm text-matte-400 text-center py-4" data-i18n="common.no_history">Belum ada riwayat</p>';
      return;
    }
    list.innerHTML = items.map(it => {
      const from = it.snapshot['wd-start'] || '—', to = it.snapshot['wd-end'] || '—';
      return `
      <div class="flex items-center justify-between gap-2 p-3 rounded-lg bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border">
        <div class="min-w-0">
          <p class="text-sm font-semibold text-matte-700 dark:text-white truncate">${escHtml(from)} → ${escHtml(to)}</p>
          <p class="text-[10px] text-matte-400">${escHtml(it.date)}</p>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button data-load="${it.id}" class="text-xs font-bold text-cyan-600 dark:text-cyan-400 hover:underline px-2 py-1" data-i18n="hist.load">Muat</button>
          <button data-del="${it.id}" aria-label="Hapus dari riwayat" class="text-matte-400 hover:text-red-500 p-1 font-bold">×</button>
        </div>
      </div>`;
    }).join('');
    list.querySelectorAll<HTMLButtonElement>('[data-load]').forEach(b => b.addEventListener('click', () => {
      const it = wdHistory.getAll().find(x => x.id === +(b.dataset.load || 0));
      if (it) { restore(it.snapshot); window.showToast?.(window._tToast ? window._tToast('Form dimuat dari riwayat.') : 'Form loaded from history.', 'info'); }
    }));
    list.querySelectorAll<HTMLButtonElement>('[data-del]').forEach(b => b.addEventListener('click', () => {
      wdHistory.remove(x => x.id === +(b.dataset.del || 0));
      renderWdHistory();
    }));
  }

  function addWdHistory() {
    const snap = snapshot();
    try {
      const items = wdHistory.getAll();
      const top = items[0];
      if (top && JSON.stringify(top.snapshot) === JSON.stringify(snap)) return; // duplikat setelan sama, skip
      wdHistory.add({ id: Date.now(), date: new Date().toLocaleString('id-ID'), snapshot: snap });
    } catch { /* kuota localStorage penuh — riwayat skip, jangan ganggu alur utama */ }
    renderWdHistory();
  }

  document.getElementById('wd-history-clear')?.addEventListener('click', () => {
    wdHistory.clear();
    renderWdHistory();
    window.showToast?.(window._tToast ? window._tToast('Riwayat dihapus!') : 'History cleared!', 'success');
  });

  renderWdHistory();
  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __wdPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __wdPage) return;
    const btn = document.getElementById('calc-wd');
    if (!btn || btn.dataset.wdBound === 'true') return;
    btn.dataset.wdBound = 'true';
    init();
  });
</script>
