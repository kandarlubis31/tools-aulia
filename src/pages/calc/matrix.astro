---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Matrix Calculator">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh] py-10">
    <ToolPageHeader
      title="Kalkulator Matriks"
      titleKey="header.matrix_calc"
      desc="Hitung operasi matriks: tambah, kurang, kali, invers, dan determinan."
      descKey="header.matrix_calc_desc"
      icon='<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/>'
      gradient="from-indigo-500 to-violet-600"
    />

    <div class="grid gap-8 animate-fade-in">
      <div class="card-base p-6">
        <h3 class="text-lg font-bold text-matte-800 dark:text-white mb-4">Matriks A</h3>
        <div class="flex gap-4 mb-4">
          <label class="text-sm text-matte-500">Baris: <input id="rows-a" type="number" value="2" min="1" max="5" class="w-16 p-2 border rounded-lg dark:bg-surface-hover dark:border-surface-border text-center" /></label>
          <label class="text-sm text-matte-500">Kolom: <input id="cols-a" type="number" value="2" min="1" max="5" class="w-16 p-2 border rounded-lg dark:bg-surface-hover dark:border-surface-border text-center" /></label>
          <button id="gen-a" class="px-3 py-1 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 rounded-lg text-sm font-bold hover:bg-indigo-200">Generate</button>
        </div>
        <div id="matrix-a" class="grid gap-1"></div>
      </div>

      <div class="card-base p-6">
        <h3 class="text-lg font-bold text-matte-800 dark:text-white mb-4">Matriks B</h3>
        <div class="flex gap-4 mb-4">
          <label class="text-sm text-matte-500">Baris: <input id="rows-b" type="number" value="2" min="1" max="5" class="w-16 p-2 border rounded-lg dark:bg-surface-hover dark:border-surface-border text-center" /></label>
          <label class="text-sm text-matte-500">Kolom: <input id="cols-b" type="number" value="2" min="1" max="5" class="w-16 p-2 border rounded-lg dark:bg-surface-hover dark:border-surface-border text-center" /></label>
          <button id="gen-b" class="px-3 py-1 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 rounded-lg text-sm font-bold hover:bg-indigo-200">Generate</button>
        </div>
        <div id="matrix-b" class="grid gap-1"></div>
      </div>

      <div class="card-base p-6">
        <div class="flex flex-wrap gap-2 mb-6">
          <button data-op="add" class="op-btn px-4 py-2 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 transition-colors">A + B</button>
          <button data-op="sub" class="op-btn px-4 py-2 bg-matte-200 dark:bg-matte-700 text-matte-700 dark:text-matte-300 rounded-xl font-bold hover:bg-indigo-600 hover:text-white transition-colors">A − B</button>
          <button data-op="mul" class="op-btn px-4 py-2 bg-matte-200 dark:bg-matte-700 text-matte-700 dark:text-matte-300 rounded-xl font-bold hover:bg-indigo-600 hover:text-white transition-colors">A × B</button>
          <button data-op="scale" class="op-btn px-4 py-2 bg-matte-200 dark:bg-matte-700 text-matte-700 dark:text-matte-300 rounded-xl font-bold hover:bg-indigo-600 hover:text-white transition-colors">k × A</button>
          <button data-op="det-a" class="op-btn px-4 py-2 bg-matte-200 dark:bg-matte-700 text-matte-700 dark:text-matte-300 rounded-xl font-bold hover:bg-indigo-600 hover:text-white transition-colors">det(A)</button>
          <button data-op="det-b" class="op-btn px-4 py-2 bg-matte-200 dark:bg-matte-700 text-matte-700 dark:text-matte-300 rounded-xl font-bold hover:bg-indigo-600 hover:text-white transition-colors">det(B)</button>
          <button data-op="inv-a" class="op-btn px-4 py-2 bg-matte-200 dark:bg-matte-700 text-matte-700 dark:text-matte-300 rounded-xl font-bold hover:bg-indigo-600 hover:text-white transition-colors">A⁻¹</button>
          <button data-op="inv-b" class="op-btn px-4 py-2 bg-matte-200 dark:bg-matte-700 text-matte-700 dark:text-matte-300 rounded-xl font-bold hover:bg-indigo-600 hover:text-white transition-colors">B⁻¹</button>
          <button data-op="transpose-a" class="op-btn px-4 py-2 bg-matte-200 dark:bg-matte-700 text-matte-700 dark:text-matte-300 rounded-xl font-bold hover:bg-indigo-600 hover:text-white transition-colors">Aᵀ</button>
        </div>
        <label id="scale-label" class="text-sm text-matte-500 hidden">Skalar k: <input id="scale-val" type="number" value="2" class="w-20 p-2 border rounded-lg dark:bg-surface-hover dark:border-surface-border text-center" /></label>
        <div id="result" class="mt-4 p-4 bg-matte-50 dark:bg-surface-hover rounded-xl border border-matte-200 dark:border-surface-border">
          <p class="text-matte-400 text-sm italic">Pilih operasi di atas untuk melihat hasil</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function getMatrix(id) {
    const rows = parseInt(document.getElementById(id === 'a' ? 'rows-a' : 'rows-b').value);
    const cols = parseInt(document.getElementById(id === 'a' ? 'cols-a' : 'cols-b').value);
    const mat = [];
    for (let r = 0; r < rows; r++) {
      mat[r] = [];
      for (let c = 0; c < cols; c++) {
        mat[r][c] = parseFloat(document.getElementById(id + '-' + r + '-' + c).value) || 0;
      }
    }
    return mat;
  }
  function genGrid(id) {
    const rows = parseInt(document.getElementById('rows-' + id).value);
    const cols = parseInt(document.getElementById('cols-' + id).value);
    const el = document.getElementById('matrix-' + id);
    el.style.gridTemplateColumns = 'repeat(' + cols + ', minmax(0, 1fr))';
    el.innerHTML = '';
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const inp = document.createElement('input');
        inp.type = 'number';
        inp.id = id + '-' + r + '-' + c;
        inp.className = 'p-2 text-center border rounded-lg dark:bg-surface-hover dark:border-surface-border text-sm font-bold w-full';
        inp.value = Math.floor(Math.random() * 10);
        el.appendChild(inp);
      }
    }
  }
  function fmtMat(m) {
    return m.map(function(r) { return '[ ' + r.map(function(v) { return String(v).padStart(8); }).join(' ') + ' ]'; }).join('\n');
  }
  function det2(m) { return m[0][0]*m[1][1] - m[0][1]*m[1][0]; }
  function det3(m) {
    return m[0][0]*(m[1][1]*m[2][2]-m[1][2]*m[2][1]) - m[0][1]*(m[1][0]*m[2][2]-m[1][2]*m[2][0]) + m[0][2]*(m[1][0]*m[2][1]-m[1][1]*m[2][0]);
  }
  function inv2(m) {
    var d = det2(m);
    if (Math.abs(d) < 1e-10) return null;
    return [[m[1][1]/d, -m[0][1]/d],[-m[1][0]/d, m[0][0]/d]];
  }
  function transpose(m) {
    return m[0].map(function(_, c) { return m.map(function(r) { return r[c]; }); });
  }
  function mulMat(a, b) {
    var res = [];
    for (var r = 0; r < a.length; r++) {
      res[r] = [];
      for (var c = 0; c < b[0].length; c++) {
        var sum = 0;
        for (var k = 0; k < a[0].length; k++) sum += a[r][k] * b[k][c];
        res[r][c] = Math.round(sum * 1e10) / 1e10;
      }
    }
    return res;
  }
  document.getElementById('gen-a').onclick = function() { genGrid('a'); };
  document.getElementById('gen-b').onclick = function() { genGrid('b'); };
  document.querySelectorAll('.op-btn').forEach(function(btn) {
    btn.onclick = function() {
      var op = btn.dataset.op;
      var resultEl = document.getElementById('result');
      var scaleLabel = document.getElementById('scale-label');
      var a = getMatrix('a');
      var b = getMatrix('b');
      var res;
      try {
        switch(op) {
          case 'add':
            if (a.length!==b.length || a[0].length!==b[0].length) throw 'Ukuran tidak cocok';
            res = a.map(function(r,i) { return r.map(function(v,j) { return v + b[i][j]; }); });
            break;
          case 'sub':
            if (a.length!==b.length || a[0].length!==b[0].length) throw 'Ukuran tidak cocok';
            res = a.map(function(r,i) { return r.map(function(v,j) { return v - b[i][j]; }); });
            break;
          case 'mul':
            if (a[0].length !== b.length) throw 'Kolom A != Baris B';
            res = mulMat(a, b);
            break;
          case 'scale':
            scaleLabel.classList.toggle('hidden');
            var k = parseFloat(document.getElementById('scale-val').value) || 0;
            res = a.map(function(r) { return r.map(function(v) { return v * k; }); });
            break;
          case 'det-a':
            if (a.length === 2) res = det2(a);
            else if (a.length === 3) res = det3(a);
            else throw 'Maksimal 3x3';
            resultEl.innerHTML = '<p class="text-2xl font-black text-indigo-600">det(A) = ' + res + '</p>';
            return;
          case 'det-b':
            if (b.length === 2) res = det2(b);
            else if (b.length === 3) res = det3(b);
            else throw 'Maksimal 3x3';
            resultEl.innerHTML = '<p class="text-2xl font-black text-indigo-600">det(B) = ' + res + '</p>';
            return;
          case 'inv-a':
            if (a.length === 2) res = inv2(a);
            else throw 'Hanya mendukung 2x2';
            if (!res) throw 'det(A) = 0, tidak bisa di-inverse';
            break;
          case 'inv-b':
            if (b.length === 2) res = inv2(b);
            else throw 'Hanya mendukung 2x2';
            if (!res) throw 'det(B) = 0, tidak bisa di-inverse';
            break;
          case 'transpose-a':
            res = transpose(a);
            break;
          default:
            return;
        }
        resultEl.innerHTML = '<pre class="text-sm font-mono text-matte-800 dark:text-matte-200 whitespace-pre">' + fmtMat(res) + '</pre>';
      } catch(e) {
        resultEl.innerHTML = '<p class="text-red-500 font-bold">Error: ' + e + '</p>';
      }
    };
  });
  genGrid('a'); genGrid('b');
</script>
