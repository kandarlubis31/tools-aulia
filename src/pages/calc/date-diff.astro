---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Date Diff Calculator — Selisih Tanggal">
  <div class="max-w-3xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Date Diff Calculator"
      titleKey="header.date_diff"
      desc="Hitung selisih hari/bulan/tahun antara 2 tanggal. Termasuk hari kerja."
      descKey="header.date_diff_desc"
      icon='<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>'
      gradient="from-teal-500 to-cyan-600"
    />

    <div class="card-base p-6 animate-fade-in">
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label class="section-title mb-2 block" for="start-date" data-i18n="diff.start_date">Tanggal mulai</label>
          <input id="start-date" type="date" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-teal-500 transition-colors text-sm" />
        </div>
        <div>
          <label class="section-title mb-2 block" for="end-date" data-i18n="diff.end_date">Tanggal akhir</label>
          <input id="end-date" type="date" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-teal-500 transition-colors text-sm" />
        </div>
      </div>

      <label class="flex items-center gap-2 mb-4 cursor-pointer">
        <input id="business-days" type="checkbox" class="w-4 h-4 accent-teal-500" />
        <span class="text-sm text-matte-600 dark:text-matte-400" data-i18n="diff.business_days">Hari kerja saja</span>
      </label>

      <button id="calc-btn" class="w-full gradient-brand py-3 rounded-xl font-bold text-sm" data-i18n="diff.result">Hitung Selisih</button>

      <div id="result" class="hidden mt-6">
        <div class="grid grid-cols-3 gap-3 text-center">
          <div class="p-4 bg-matte-50 dark:bg-matte-900 rounded-xl border border-matte-200 dark:border-surface-border">
            <p class="text-2xs text-matte-400">Hari</p>
            <p id="days" class="text-2xl font-bold text-teal-600 dark:text-teal-400">0</p>
          </div>
          <div class="p-4 bg-matte-50 dark:bg-matte-900 rounded-xl border border-matte-200 dark:border-surface-border">
            <p class="text-2xs text-matte-400">Bulan</p>
            <p id="months" class="text-2xl font-bold text-teal-600 dark:text-teal-400">0</p>
          </div>
          <div class="p-4 bg-matte-50 dark:bg-matte-900 rounded-xl border border-matte-200 dark:border-surface-border">
            <p class="text-2xs text-matte-400">Tahun</p>
            <p id="years" class="text-2xl font-bold text-teal-600 dark:text-teal-400">0</p>
          </div>
        </div>
        <div id="business-result" class="hidden mt-3 p-3 bg-teal-50 dark:bg-teal-900/20 rounded-xl text-center">
          <p class="text-sm text-teal-600 dark:text-teal-400"><span id="business-days-count">0</span> hari kerja</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      const toast = (msg: string, type?: string) => (window as any).showToast?.((window as any)._tToast ? (window as any)._tToast(msg) : msg, type);

      // Set default dates
      const today = new Date();
      const lastMonth = new Date(today);
      lastMonth.setMonth(lastMonth.getMonth() - 1);
      
      const startInput = document.getElementById('start-date') as HTMLInputElement;
      const endInput = document.getElementById('end-date') as HTMLInputElement;
      startInput.value = lastMonth.toISOString().split('T')[0];
      endInput.value = today.toISOString().split('T')[0];

      function isBusinessDay(date: Date): boolean {
        const day = date.getDay();
        return day !== 0 && day !== 6;
      }

      function countBusinessDays(start: Date, end: Date): number {
        let count = 0;
        const current = new Date(start);
        while (current <= end) {
          if (isBusinessDay(current)) count++;
          current.setDate(current.getDate() + 1);
        }
        return count;
      }

      document.getElementById('calc-btn')?.addEventListener('click', () => {
        const start = new Date(startInput.value);
        const end = new Date(endInput.value);
        const businessOnly = (document.getElementById('business-days') as HTMLInputElement).checked;

        if (!startInput.value || !endInput.value) {
          toast('Pilih kedua tanggal!', 'error');
          return;
        }

        const diffMs = Math.abs(end.getTime() - start.getTime());
        const diffDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
        const diffMonths = Math.floor(diffDays / 30);
        const diffYears = Math.floor(diffDays / 365);

        document.getElementById('days')!.textContent = diffDays.toString();
        document.getElementById('months')!.textContent = diffMonths.toString();
        document.getElementById('years')!.textContent = diffYears.toString();

        if (businessOnly) {
          const bizDays = countBusinessDays(start < end ? start : end, start < end ? end : start);
          document.getElementById('business-days-count')!.textContent = bizDays.toString();
          document.getElementById('business-result')?.classList.remove('hidden');
        } else {
          document.getElementById('business-result')?.classList.add('hidden');
        }

        document.getElementById('result')?.classList.remove('hidden');
        toast('Selisih dihitung!', 'success');
      });
    });
  </script>
</BaseLayout>
