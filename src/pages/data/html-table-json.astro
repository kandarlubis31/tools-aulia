---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="HTML Table to JSON" description="Ekstrak tabel HTML ke data JSON. 100% client-side DOMParser.">
  <ToolPageHeader title="HTML Table to JSON" titleKey="header.html_table_json" desc="Ekstrak tabel HTML jadi JSON array — otomatis" descKey="header.html_table_json_desc" icon='<path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/>' />

  <div class="card-base p-5 space-y-4">
    <label for="html-input" class="block text-sm text-matte-500 font-medium" data-i18n="label.html_input">Input HTML tabel</label>
    <textarea id="html-input" class="input-field w-full h-32 font-mono text-sm" placeholder='Paste HTML tabel di sini...&#10;<table>&#10;  <tr><th>Nama</th><th>Usia</th></tr>&#10;  <tr><td>Alice</td><td>25</td></tr>&#10;</table>' data-i18n-attr="placeholder" data-i18n="ph.paste_html_table"></textarea>

    <p class="text-xs text-matte-400" data-i18n="htmltable.hint">Baris pertama &lt;th&gt; dipakai sebagai key JSON; tanpa &lt;th&gt; semua baris jadi data.</p>

    <button id="parse-btn" class="btn-primary" data-i18n="btn.parse_json">Parse ke JSON</button>

    <div class="flex justify-between items-center">
      <label class="text-sm text-matte-500 font-medium" data-i18n="label.output_json">Output JSON</label>
      <div class="flex gap-2">
        <button id="copy-btn" class="btn-secondary text-xs" data-i18n="btn.copy_emoji">📋 Copy</button>
        <button id="download-btn" class="btn-secondary text-xs" data-i18n="btn.download_json">⬇️ JSON</button>
      </div>
    </div>
    <pre id="output" class="bg-matte-900 text-green-400 rounded-lg p-3 h-40 overflow-auto text-sm font-mono whitespace-pre-wrap"></pre>
  </div>
</BaseLayout>

<script>
import { t } from '../../i18n/translations';

  // Re-render toast/teks dinamis saat ganti bahasa tidak diperlukan (event-based),
  // tapi parse result dihasilkan via t() → cukup dipanggil ulang saat render berikutnya.

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  document.getElementById('parse-btn')!.addEventListener('click', () => {
    const html = (document.getElementById('html-input') as HTMLTextAreaElement).value;
    if (!html.trim()) { toast('Paste HTML tabel dulu', 'error'); return; }

    const parser = new DOMParser();
    const doc = parser.parseFromString(html, 'text/html');
    const table = doc.querySelector('table');
    if (!table) { toast('Tabel tidak ditemukan di HTML', 'error'); return; }

    const rows = table.querySelectorAll('tr');
    const data: Record<string, string>[] = [];
    let headers: string[] = [];

    rows.forEach((row, idx) => {
      const cells = row.querySelectorAll('th, td');
      const vals = Array.from(cells).map(c => c.textContent.trim());
      if (idx === 0) {
        headers = vals;
        // if first row has th, use as header; otherwise treat as data
        const hasTh = row.querySelectorAll('th').length > 0;
        if (!hasTh) { headers = vals; data.push(toObj(headers, vals)); }
      } else {
        data.push(toObj(headers, vals));
      }
    });

    (document.getElementById('output') as HTMLPreElement).textContent = JSON.stringify(data, null, 2);
    toast(t('htmltable.parsed', '{n} baris diparsing!').replace('{n}', String(data.length)));
  });

  function toObj(keys: string[], vals: string[]) {
    const obj: Record<string, string> = {};
    keys.forEach((k, i) => { obj[k || 'col' + (i + 1)] = vals[i] || ''; });
    return obj;
  }

  document.getElementById('copy-btn')!.addEventListener('click', async () => {
    try {
      const out = (document.getElementById('output') as HTMLPreElement).textContent || '';
      if (!out) { toast('Belum ada hasil.', 'info'); return; }
      await navigator.clipboard.writeText(out);
      toast('Disalin!');
    } catch { toast('Gagal menyalin', 'error'); }
  });

  document.getElementById('download-btn')!.addEventListener('click', () => {
    try {
      const out = (document.getElementById('output') as HTMLPreElement).textContent || '';
      if (!out) { toast('Belum ada hasil.', 'info'); return; }
      const blob = new Blob([out], { type: 'application/json' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'table-data.json'; a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    } catch { toast('Gagal membuat file', 'error'); }
  });

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __dataHtmlTableJsonPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __dataHtmlTableJsonPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
