---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="HTML Table to JSON — Ekstrak Tabel ke JSON | ToolsAulia" description="Ekstrak tabel HTML ke data JSON. 100% client-side DOMParser." category="Data" toolHref="/data/html-table-json">
  <ToolPageHeader title="HTML Table to JSON" description="Ekstrak tabel HTML jadi JSON array — otomatis" icon='<path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/>' />

  <div class="card-base p-5 space-y-4">
    <textarea id="html-input" class="input-field w-full h-32 font-mono text-sm" placeholder='Paste HTML tabel di sini...&#10;<table>&#10;  <tr><th>Nama</th><th>Usia</th></tr>&#10;  <tr><td>Alice</td><td>25</td></tr>&#10;</table>'></textarea>

    <button id="parse-btn" class="btn-primary">Parse ke JSON</button>

    <div class="flex justify-between items-center">
      <label class="text-sm text-matte-500 font-medium">Output JSON</label>
      <div class="flex gap-2">
        <button id="copy-btn" class="btn-secondary text-xs">📋 Copy</button>
        <button id="download-btn" class="btn-secondary text-xs">⬇️ JSON</button>
      </div>
    </div>
    <pre id="output" class="bg-matte-900 text-green-400 rounded-lg p-3 h-40 overflow-auto text-sm font-mono whitespace-pre-wrap"></pre>
  </div>
</BaseLayout>

<script>
  document.getElementById('parse-btn').addEventListener('click', () => {
    const html = document.getElementById('html-input').value;
    if (!html.trim()) { showToast?.(_tToast?.('Paste HTML tabel dulu','Paste HTML table first'),'error'); return; }

    const parser = new DOMParser();
    const doc = parser.parseFromString(html, 'text/html');
    const table = doc.querySelector('table');
    if (!table) { showToast?.(_tToast?.('Tabel tidak ditemukan di HTML','No table found in HTML'),'error'); return; }

    const rows = table.querySelectorAll('tr');
    const data = [];
    let headers = [];

    rows.forEach((row, idx) => {
      const cells = row.querySelectorAll('th, td');
      const vals = Array.from(cells).map(c => c.textContent.trim());
      if (idx === 0) {
        headers = vals;
        // if first row has th, use as header; otherwise treat as data
        const hasTh = row.querySelectorAll('th').length > 0;
        if (!hasTh) { headers = vals; data.push(toObj(headers, vals)); }
      } else {
        data.push(toObj(headers, vals));
      }
    });

    document.getElementById('output').textContent = JSON.stringify(data, null, 2);
    showToast?.(_tToast?.(data.length+' baris diparsing!',data.length+' rows parsed!'),'success');
  });

  function toObj(keys, vals) {
    const obj = {};
    keys.forEach((k,i) => { obj[k || 'col'+(i+1)] = vals[i] || ''; });
    return obj;
  }

  document.getElementById('copy-btn').addEventListener('click', () => {
    navigator.clipboard.writeText(document.getElementById('output').textContent).then(() => showToast?.(_tToast?.('Disalin!','Copied!'),'success'));
  });

  document.getElementById('download-btn').addEventListener('click', () => {
    const blob = new Blob([document.getElementById('output').textContent], { type: 'application/json' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'table-data.json'; a.click();
  });
</script>
