---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="GeoJSON Viewer — Preview Peta GeoJSON Online">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="GeoJSON Viewer"
      titleKey="header.geojson"
      desc="Preview GeoJSON di peta interaktif. Upload file atau paste. Powered by Leaflet."
      descKey="header.geojson_desc"
      icon='<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>'
      gradient="from-blue-500 to-sky-600"
    />

    <div class="animate-fade-in space-y-4">
      <div class="card-base p-5">
        <div class="flex gap-2 mb-3">
          <button id="upload-btn" class="px-4 py-2 rounded-lg text-sm font-bold bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 hover:bg-blue-200 transition-all">
            📁 Upload GeoJSON
          </button>
          <input type="file" id="file-input" accept=".json,.geojson" class="hidden" />
          <button id="paste-btn" class="px-4 py-2 rounded-lg text-sm font-bold bg-matte-100 dark:bg-surface-elevated text-matte-600 dark:text-matte-300 hover:bg-matte-200 transition-all">
            📋 Paste
          </button>
          <button id="sample-btn" class="px-4 py-2 rounded-lg text-sm font-bold bg-matte-100 dark:bg-surface-elevated text-matte-600 dark:text-matte-300 hover:bg-matte-200 transition-all" data-i18n="data.sample">📦 Sample Data</button>
          <div class="ml-auto flex items-center gap-1.5">
            <select id="fmt-select" class="px-2 py-2 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-2xs font-bold outline-none" aria-label="Format" data-i18n-attr="aria-label" data-i18n="dev.codeimg.format">
              <option value="pretty" data-i18n="data.pretty">Pretty</option>
              <option value="minify" data-i18n="data.minify">Minify</option>
            </select>
            <button id="copy-btn" class="px-3 py-2 rounded-lg text-xs font-bold bg-matte-100 dark:bg-surface-hover text-matte-600 dark:text-matte-200 hover:bg-matte-200 dark:hover:bg-matte-600 transition-colors" data-i18n="common.copy">📋 Copy</button>
          </div>
        </div>
        <textarea id="geojson-input" rows="6" placeholder='{"type": "FeatureCollection", "features": [...]}'
          class="w-full px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-xs font-mono outline-none focus:ring-2 focus:ring-blue-500/40 resize-y hidden"></textarea>
        <p id="geojson-info" class="text-2xs text-matte-400 mt-1 hidden"></p>
      </div>

      <div class="card-base p-0 overflow-hidden">
        <div id="map" class="w-full rounded-lg" style="height: 400px; background: #e5e7eb;"></div>
      </div>

      <p class="text-center text-xs text-matte-400">
        ℹ️ Powered by Leaflet + OpenStreetMap. GeoJSON diproses 100% di browser.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
const __page = (location.pathname.replace(/\/+$/, '') || '/');

  document.addEventListener('astro:page-load', () => {if ((location.pathname.replace(/\/+$/, '') || '/') !== __page) return;

    const uploadBtn = document.getElementById('upload-btn') as HTMLButtonElement;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const pasteBtn = document.getElementById('paste-btn') as HTMLButtonElement;
    const geojsonInput = document.getElementById('geojson-input') as HTMLTextAreaElement;
    const geojsonInfo = document.getElementById('geojson-info')!;
    const mapDiv = document.getElementById('map')!;

    let map: any = null;
    let geoLayer: any = null;
    let lastValid: any = null;

    const toast = (m: string, t: 'success' | 'error' = 'success') =>
      window.showToast?.(window._tToast ? window._tToast(m) : m, t);

    // Multi-CDN fallback (pola sama seperti qrious): kalau CDN utama gagal/blokir,
    // coba CDN cadangan. CSS ikut dari CDN yang sama dengan JS yang berhasil.
    const LEAFLET_CDNS = [
      { js: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js', css: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css' },
      { js: 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.js', css: 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.css' },
      { js: 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js', css: 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css' },
    ];

    async function loadLeaflet(): Promise<any> {
      if ((window as any).L) return (window as any).L;
      for (const cdn of LEAFLET_CDNS) {
        if ((window as any).L) return (window as any).L;
        // CSS best-effort — ikut CDN yang sama dengan JS biar versinya konsisten.
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = cdn.css;
        document.head.appendChild(link);
        const s = document.createElement('script');
        s.src = cdn.js;
        const ok = await new Promise((resolve) => {
          s.onload = () => resolve(true);
          s.onerror = () => { if (s.parentNode) s.remove(); resolve(false); };
          document.head.appendChild(s);
        });
        if (ok && (window as any).L) return (window as any).L;
      }
      return (window as any).L || null;
    }

    function initMap() {
      if (map) return;
      const L = (window as any).L;
      if (!L) return;
      map = L.map(mapDiv).setView([-2.5, 118], 5);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors',
        maxZoom: 19,
      }).addTo(map);
    }

    function renderGeoJSON(data: any) {
      const L = (window as any).L;
      if (!L || !map) return;

      if (geoLayer) map.removeLayer(geoLayer);

      try {
        geoLayer = L.geoJSON(data, {
          style: { color: '#3b82f6', weight: 2, fillOpacity: 0.3 },
        }).addTo(map);

        const bounds = geoLayer.getBounds();
        if (bounds.isValid()) map.fitBounds(bounds, { padding: [20, 20] });

        const features = data.type === 'FeatureCollection' ? data.features : [data];
        geojsonInfo.textContent = `${features.length} feature(s)`;
        geojsonInfo.classList.remove('hidden');
        lastValid = data;
        toast('GeoJSON ditampilkan!');
      } catch (e: any) {
        toast('GeoJSON tidak valid: ' + (e.message || 'unknown'), 'error');
      }
    }

    async function handleGeoJSON(text: string) {
      try {
        const data = JSON.parse(text);
        // Validasi spesifik (DoD Data): cek struktur GeoJSON
        if (!data.type) throw new Error('missing "type" property');
        const types = ['FeatureCollection', 'Feature', 'Point', 'LineString', 'Polygon', 'MultiPoint', 'MultiLineString', 'MultiPolygon', 'GeometryCollection'];
        if (!types.includes(data.type)) throw new Error(`unknown type "${data.type}"`);
        if (data.type === 'FeatureCollection' && !Array.isArray(data.features)) {
          throw new Error('FeatureCollection needs "features" array');
        }
        if (data.type === 'Feature' && !data.geometry) {
          throw new Error('Feature needs "geometry" property');
        }
        await loadLeaflet();
        initMap();
        renderGeoJSON(data);
        geojsonInput.value = text;
        geojsonInput.classList.remove('hidden');
      } catch (e: any) {
        // Pesan error spesifik: JSON parse error + posisi line/column dari V8
        const m = e instanceof SyntaxError ? String(e.message).replace(/\n/g, ' ') : e.message || 'Invalid JSON';
        toast('Error: ' + m, 'error');
      }
    }

    const SAMPLE = { type: 'FeatureCollection', features: [
      { type: 'Feature', properties: { name: 'Monas' }, geometry: { type: 'Point', coordinates: [106.8272, -6.1754] } },
      { type: 'Feature', properties: { name: 'Bandung' }, geometry: { type: 'Point', coordinates: [107.6098, -6.9147] } },
      { type: 'Feature', properties: { name: 'Surabaya' }, geometry: { type: 'Point', coordinates: [112.7521, -7.2575] } },
    ] };

    uploadBtn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => handleGeoJSON(reader.result as string);
      reader.readAsText(file);
    });

    pasteBtn.addEventListener('click', () => {
      if (geojsonInput.classList.contains('hidden')) {
        geojsonInput.classList.remove('hidden');
        geojsonInput.focus();
      } else {
        handleGeoJSON(geojsonInput.value.trim());
      }
    });

    document.getElementById('sample-btn')?.addEventListener('click', () => {
      const fmt = (document.getElementById('fmt-select') as HTMLSelectElement).value;
      geojsonInput.classList.remove('hidden');
      geojsonInput.value = fmt === 'minify' ? JSON.stringify(SAMPLE) : JSON.stringify(SAMPLE, null, 2);
      handleGeoJSON(geojsonInput.value);
    });

    document.getElementById('copy-btn')?.addEventListener('click', async () => {
      if (!lastValid) { toast('Belum ada data valid.', 'error'); return; }
      try {
        const fmt = (document.getElementById('fmt-select') as HTMLSelectElement).value;
        await navigator.clipboard.writeText(fmt === 'minify' ? JSON.stringify(lastValid) : JSON.stringify(lastValid, null, 2));
        toast('Disalin!');
      } catch {
        toast('Gagal menyalin.', 'error');
      }
    });

    // Try autoload map
    loadLeaflet().then(() => initMap());
  });
</script>
