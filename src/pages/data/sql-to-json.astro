---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="SQL to JSON — Konversi INSERT ke JSON | ToolsAulia" description="Konversi SQL INSERT statements ke JSON array. 100% client-side." category="Data" toolHref="/data/sql-to-json">
  <ToolPageHeader title="SQL to JSON" description="Konversi SQL INSERT statements ke JSON array" icon='<path d="M4 6h16M4 12h16M4 18h7"/>' />

  <div class="card-base p-5 space-y-4">
    <textarea id="sql-input" class="input-field w-full h-40 font-mono text-sm" placeholder="Paste SQL INSERT di sini...&#10;INSERT INTO users (name, age, city) VALUES ('Alice', 25, 'Jakarta'), ('Bob', 30, 'Bandung');"></textarea>
    <button id="convert-btn" class="btn-primary">Konversi ke JSON</button>

    <div class="flex justify-between items-center"><label class="text-sm text-matte-500 font-medium">Output JSON</label><button id="copy-btn" class="btn-secondary text-xs">📋 Copy</button></div>
    <pre id="output" class="bg-matte-900 text-green-400 rounded-lg p-3 h-40 overflow-auto text-sm font-mono whitespace-pre-wrap"></pre>
  </div>
</BaseLayout>

<script>
  const { showToast, _tToast } = window as any;

  document.getElementById('convert-btn').addEventListener('click', () => {
    const sql = document.getElementById('sql-input').value.trim();
    if (!sql) return;
    try {
      const result = parseSQL(sql);
      document.getElementById('output').textContent = JSON.stringify(result, null, 2);
      showToast?.(_tToast?.(result.length+' row diparsing!',result.length+' rows parsed!'),'success');
    } catch (e) {
      document.getElementById('output').textContent = 'Error: ' + e.message;
    }
  });

  function parseSQL(sql) {
    const m = sql.match(/INSERT\s+INTO\s+\w+\s*\(([^)]+)\)\s*VALUES\s*(.+)/is);
    if (!m) throw new Error('Format INSERT tidak dikenali');
    const cols = m[1].split(',').map(c => c.trim().replace(/`/g,''));
    const valStr = m[2].replace(/;\s*$/,'');
    const rows = [];
    // parse (val1, val2), (val3, val4)...
    let i = 0;
    while (i < valStr.length) {
      if (valStr[i] === '(') {
        const end = valStr.indexOf(')', i);
        if (end === -1) break;
        const vals = parseVals(valStr.substring(i+1, end));
        const obj = {};
        cols.forEach((c,j) => obj[c] = vals[j] !== undefined ? vals[j] : null);
        rows.push(obj);
        i = end + 1;
      } else i++;
    }
    return rows;
  }

  function parseVals(s) {
    const vals = [];
    let cur = '', inQuote = false, esc = false;
    for (const ch of s) {
      if (esc) { cur += ch; esc = false; continue; }
      if (ch === '\\') { esc = true; continue; }
      if (ch === "'" || ch === '"') { inQuote = !inQuote; continue; }
      if (ch === ',' && !inQuote) {
        let v = cur.trim();
        if (v === 'NULL' || v === 'null') v = null;
        else if (/^-?\d+(\.\d+)?$/.test(v)) v = parseFloat(v);
        else if (v === 'true' || v === 'TRUE') v = true;
        else if (v === 'false' || v === 'FALSE') v = false;
        vals.push(v);
        cur = '';
        continue;
      }
      cur += ch;
    }
    let v = cur.trim();
    if (v === 'NULL' || v === 'null') v = null;
    else if (/^-?\d+(\.\d+)?$/.test(v)) v = parseFloat(v);
    vals.push(v);
    return vals;
  }

  document.getElementById('copy-btn').addEventListener('click', () => {
    navigator.clipboard.writeText(document.getElementById('output').textContent).then(() => showToast?.(_tToast?.('Disalin!','Copied!'),'success'));
  });
</script>
