---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="SQL to JSON" description="Konversi SQL INSERT statements ke JSON array. 100% client-side.">
  <ToolPageHeader title="SQL to JSON" titleKey="header.sql_to_json" desc="Konversi SQL INSERT statements ke JSON array" descKey="header.sql_to_json_desc" icon='<path d="M4 6h16M4 12h16M4 18h7"/>' />

  <div class="card-base p-5 space-y-4">
    <label for="sql-input" class="block text-sm text-matte-500 font-medium" data-i18n="label.sql_input">Input SQL</label>
    <textarea id="sql-input" class="input-field w-full h-40 font-mono text-sm" placeholder="Paste SQL INSERT di sini..." data-i18n-attr="placeholder" data-i18n="ph.paste_sql"></textarea>
    <p class="text-xs text-matte-400" data-i18n="sqljson.hint">Mendukung INSERT INTO … VALUES (…) multi-row. Nilai NULL/angka/boolean di-coerce ke tipe JSON aslinya.</p>
    <button id="convert-btn" class="btn-primary" data-i18n="btn.convert_json">Konversi ke JSON</button>

    <div class="flex justify-between items-center">
      <label for="output" class="text-sm text-matte-500 font-medium" data-i18n="label.json_output">Output JSON</label>
      <div class="flex gap-2">
        <button id="copy-btn" class="btn-secondary text-xs" data-i18n="btn.copy_emoji">📋 Copy</button>
        <button id="download-btn" class="btn-secondary text-xs" data-i18n="btn.download_json">⬇️ JSON</button>
      </div>
    </div>
    <pre id="output" class="bg-matte-900 text-green-400 rounded-lg p-3 h-40 overflow-auto text-sm font-mono whitespace-pre-wrap"></pre>
  </div>
</BaseLayout>

<script>
import { t } from '../../i18n/translations';

  function init() {
    const sqlInp = document.getElementById('sql-input') as HTMLTextAreaElement;
    const output = document.getElementById('output') as HTMLElement;

    const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
      window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

    document.getElementById('convert-btn')?.addEventListener('click', () => {
      const sql = sqlInp.value.trim();
      if (!sql) { toast('Input kosong!', 'info'); return; }
      try {
        const rows = parseSQL(sql);
        output.textContent = JSON.stringify(rows, null, 2);
        toast(t('sqljson.parsed', '{n} baris diparsing!').replace('{n}', String(rows.length)));
      } catch (e) {
        output.textContent = 'Error: ' + (e instanceof Error ? e.message : String(e));
        toast('Format INSERT tidak dikenali', 'error');
      }
    });

    function parseSQL(sql: string): Array<Record<string, unknown>> {
      const m = sql.match(/INSERT\s+INTO\s+\w+\s*\(([^)]+)\)\s*VALUES\s*(.+)/is);
      if (!m) throw new Error('Format INSERT tidak dikenali');
      const cols = m[1].split(',').map(c => c.trim().replace(/`/g, ''));
      const valStr = m[2].replace(/;\s*$/, '');
      const rows: Array<Record<string, unknown>> = [];
      // parse (val1, val2), (val3, val4)...
      let i = 0;
      while (i < valStr.length) {
        if (valStr[i] === '(') {
          const end = valStr.indexOf(')', i);
          if (end === -1) break;
          const vals = parseVals(valStr.substring(i + 1, end));
          const obj: Record<string, unknown> = {};
          cols.forEach((c, j) => { obj[c] = vals[j] !== undefined ? vals[j] : null; });
          rows.push(obj);
          i = end + 1;
        } else i++;
      }
      if (!rows.length) throw new Error('Format INSERT tidak dikenali');
      return rows;
    }

    function parseVals(s: string): Array<unknown> {
      const vals: Array<unknown> = [];
      let cur = '', inQuote = false, esc = false;
      for (const ch of s) {
        if (esc) { cur += ch; esc = false; continue; }
        if (ch === '\\') { esc = true; continue; }
        if (ch === "'" || ch === '"') { inQuote = !inQuote; continue; }
        if (ch === ',' && !inQuote) {
          vals.push(coerce(cur.trim()));
          cur = '';
          continue;
        }
        cur += ch;
      }
      vals.push(coerce(cur.trim()));
      return vals;
    }

    function coerce(v: string): unknown {
      if (v === 'NULL' || v === 'null') return null;
      if (/^-?\d+(\.\d+)?$/.test(v)) return parseFloat(v);
      if (v === 'true' || v === 'TRUE') return true;
      if (v === 'false' || v === 'FALSE') return false;
      return v;
    }

    document.getElementById('copy-btn')?.addEventListener('click', async () => {
      const text = output.textContent || '';
      if (!text) { toast('Belum ada hasil.', 'info'); return; }
      try { await navigator.clipboard.writeText(text); toast('Disalin!'); }
      catch { toast('Gagal menyalin', 'error'); }
    });

    document.getElementById('download-btn')?.addEventListener('click', () => {
      const text = output.textContent || '';
      if (!text) { toast('Belum ada hasil.', 'info'); return; }
      try {
        const blob = new Blob([text], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'query-result.json';
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 2000);
        toast('Diunduh!');
      } catch { toast('Gagal membuat file', 'error'); }
    });
  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __dataSqlToJsonPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __dataSqlToJsonPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });
</script>
