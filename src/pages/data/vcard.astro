---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="vCard Generator — Buat File .vcf">
  <div class="max-w-3xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="vCard Generator"
      titleKey="header.vcard_gen"
      desc="Buat file vCard (.vcf) kontak: nama, telepon, email, alamat."
      descKey="header.vcard_gen_desc"
      icon='<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>'
      gradient="from-sky-500 to-blue-600"
    />

    <div class="card-base p-6 animate-fade-in">
      <div class="space-y-4">
        <div>
          <label class="section-title mb-2 block" for="vcard-name" data-i18n="vcard.name">Nama Lengkap</label>
          <input id="vcard-name" type="text" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-sky-500 transition-colors text-sm" placeholder="John Doe" autocomplete="off" />
        </div>
        <div>
          <label class="section-title mb-2 block" for="vcard-phone" data-i18n="vcard.phone">Telepon</label>
          <input id="vcard-phone" type="tel" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-sky-500 transition-colors text-sm" placeholder="+6281234567890" autocomplete="off" />
        </div>
        <div>
          <label class="section-title mb-2 block" for="vcard-email" data-i18n="vcard.email">Email</label>
          <input id="vcard-email" type="email" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-sky-500 transition-colors text-sm" placeholder="john@example.com" autocomplete="off" />
        </div>
        <div>
          <label class="section-title mb-2 block" for="vcard-org" data-i18n="vcard.org">Organisasi</label>
          <input id="vcard-org" type="text" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-sky-500 transition-colors text-sm" placeholder="PT Contoh" autocomplete="off" />
        </div>
        <div>
          <label class="section-title mb-2 block" for="vcard-title" data-i18n="vcard.title">Jabatan</label>
          <input id="vcard-title" type="text" class="w-full px-4 py-3 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-sky-500 transition-colors text-sm" placeholder="Software Engineer" autocomplete="off" />
        </div>
        <div>
          <label class="section-title mb-2 block" for="vcard-address" data-i18n="vcard.address">Alamat</label>
          <textarea id="vcard-address" rows="2" class="w-full p-4 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-sky-500 transition-colors text-sm resize-y" placeholder="Jl. Contoh No. 123, Jakarta" data-i18n-attr="placeholder"></textarea>
        </div>
      </div>

      <button id="generate-btn" class="mt-4 w-full gradient-brand py-3 rounded-xl font-bold text-sm" data-i18n="vcard.generate">Generate vCard</button>

      <div id="result" class="hidden mt-6">
        <div class="flex items-center justify-between mb-2">
          <span class="section-title">vCard Preview</span>
          <button id="download-btn" class="text-xs font-bold px-3 py-1.5 bg-sky-100 dark:bg-sky-900/30 text-sky-600 dark:text-sky-400 rounded-lg hover:bg-sky-200 dark:hover:bg-sky-900/50 transition" data-i18n="vcard.download">Download .vcf</button>
        </div>
        <pre id="vcard-output" class="w-full p-4 bg-matte-50 dark:bg-matte-900 rounded-xl text-xs font-mono text-sky-600 dark:text-sky-400 border border-matte-200 dark:border-surface-border overflow-x-auto whitespace-pre"></pre>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      let vcardContent = '';

      document.getElementById('generate-btn')?.addEventListener('click', () => {
        const name = (document.getElementById('vcard-name') as HTMLInputElement)?.value;
        const phone = (document.getElementById('vcard-phone') as HTMLInputElement)?.value;
        const email = (document.getElementById('vcard-email') as HTMLInputElement)?.value;
        const org = (document.getElementById('vcard-org') as HTMLInputElement)?.value;
        const title = (document.getElementById('vcard-title') as HTMLInputElement)?.value;
        const address = (document.getElementById('vcard-address') as HTMLTextAreaElement)?.value;

        if (!name) {
          showToast('Masukkan nama!', 'error');
          return;
        }

        const nameParts = name.split(' ');
        const firstName = nameParts[0] || '';
        const lastName = nameParts.slice(1).join(' ') || '';

        vcardContent = `BEGIN:VCARD
VERSION:3.0
N:${lastName};${firstName};;;
FN:${name}
${phone ? `TEL;TYPE=CELL:${phone}` : ''}
${email ? `EMAIL:${email}` : ''}
${org ? `ORG:${org}` : ''}
${title ? `TITLE:${title}` : ''}
${address ? `ADR;TYPE=HOME:;;${address};;;;` : ''}
END:VCARD`;

        document.getElementById('vcard-output')!.textContent = vcardContent;
        document.getElementById('result')?.classList.remove('hidden');
        showToast('vCard digenerate!', 'success');
      });

      document.getElementById('download-btn')?.addEventListener('click', () => {
        if (!vcardContent) return;
        const blob = new Blob([vcardContent], { type: 'text/vcard;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'contact.vcf';
        link.click();
        URL.revokeObjectURL(url);
        showToast('vCard didownload!', 'success');
      });
    });
  </script>
</BaseLayout>
