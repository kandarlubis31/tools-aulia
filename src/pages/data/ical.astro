---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="iCal Generator — Buat File .ics Online">
  <div class="max-w-3xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="iCal Generator"
      titleKey="header.ical_generator"
      desc="Buat file kalender .ics dengan pengingat, bisa diimport ke Google/Apple Calendar."
      descKey="header.ical_generator_desc"
      icon='<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/><path d="M9 16l2 2 4-4"/>'
      gradient="from-rose-500 to-pink-600"
    />

    <div class="card-base p-6 animate-fade-in">
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="sm:col-span-2">
          <label for="ev-title" class="block text-xs font-bold text-matte-500 dark:text-matte-300 mb-1.5">📌 <span data-i18n="ical.title">Judul Event</span></label>
          <input id="ev-title" type="text" placeholder="Meeting Proyek" class="w-full px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm focus:ring-2 focus:ring-rose-500/40 outline-none" />
        </div>
        <div>
          <label for="ev-loc" class="block text-xs font-bold text-matte-500 dark:text-matte-300 mb-1.5">📍 <span data-i18n="ical.location">Lokasi</span> <span class="text-matte-400">(opsional)</span></label>
          <input id="ev-loc" type="text" placeholder="Ruang Rapat / URL Meet" class="w-full px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm focus:ring-2 focus:ring-rose-500/40 outline-none" />
        </div>
        <div>
          <label class="flex items-center gap-2 text-xs font-bold text-matte-500 dark:text-matte-300 mb-1.5 mt-1">
            <input id="ev-allday" type="checkbox" class="accent-rose-500" />
            <span data-i18n="ical.allday">Sepanjang hari (all-day)</span>
          </label>
        </div>
        <div id="start-group">
          <label for="ev-start-date" class="block text-xs font-bold text-matte-500 dark:text-matte-300 mb-1.5">🟢 <span data-i18n="ical.start">Mulai</span></label>
          <div class="flex gap-2">
            <input id="ev-start-date" type="date" class="flex-1 px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm focus:ring-2 focus:ring-rose-500/40 outline-none" />
            <input id="ev-start-time" type="time" value="09:00" class="flex-1 px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm focus:ring-2 focus:ring-rose-500/40 outline-none" />
          </div>
        </div>
        <div id="end-group">
          <label for="ev-end-date" class="block text-xs font-bold text-matte-500 dark:text-matte-300 mb-1.5">🔴 <span data-i18n="ical.end">Selesai</span></label>
          <div class="flex gap-2">
            <input id="ev-end-date" type="date" class="flex-1 px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm focus:ring-2 focus:ring-rose-500/40 outline-none" />
            <input id="ev-end-time" type="time" value="10:00" class="flex-1 px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm focus:ring-2 focus:ring-rose-500/40 outline-none" />
          </div>
        </div>
        <div class="sm:col-span-2">
          <label for="ev-reminder" class="block text-xs font-bold text-matte-500 dark:text-matte-300 mb-1.5">⏰ <span data-i18n="ical.reminder">Pengingat</span></label>
          <select id="ev-reminder" class="w-full px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm focus:ring-2 focus:ring-rose-500/40 outline-none">
            <option value="0">Tidak ada</option>
            <option value="5">5 menit sebelumnya</option>
            <option value="10">10 menit sebelumnya</option>
            <option value="30" selected>30 menit sebelumnya</option>
            <option value="60">1 jam sebelumnya</option>
            <option value="1440">1 hari sebelumnya</option>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="ev-desc" class="block text-xs font-bold text-matte-500 dark:text-matte-300 mb-1.5">📝 <span data-i18n="ical.desc">Deskripsi</span> <span class="text-matte-400">(opsional)</span></label>
          <textarea id="ev-desc" rows="3" placeholder="Agenda & catatan…" class="w-full px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm focus:ring-2 focus:ring-rose-500/40 outline-none resize-y"></textarea>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3 mt-6">
        <button id="gen-btn" class="gradient-brand px-8 py-3 rounded-xl font-bold text-sm">📅 <span data-i18n="ical.generate">Generate .ics & Download</span></button>
        <button id="copy-btn" class="px-5 py-3 rounded-xl text-sm font-bold bg-matte-100 dark:bg-surface-elevated text-matte-600 dark:text-matte-300 hover:bg-matte-200 dark:hover:bg-surface-hover transition-all" data-i18n="ical.copy">Salin teks .ics</button>
      </div>
    </div>

    <div class="card-base p-4 mt-6 hidden animate-fade-in" id="preview-box">
      <h2 class="text-2xs font-bold text-matte-400 uppercase tracking-wider mb-2" data-i18n="ical.preview">Preview .ics</h2>
      <pre id="preview" class="text-xs font-mono leading-relaxed bg-matte-50 dark:bg-surface-elevated rounded-lg p-3 overflow-x-auto whitespace-pre-wrap"></pre>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const genBtn = document.getElementById('gen-btn');
    const copyBtn = document.getElementById('copy-btn');
    const previewBox = document.getElementById('preview-box');
    const preview = document.getElementById('preview');
    const alldayInput = document.getElementById('ev-allday') as HTMLInputElement;
    const startTime = document.getElementById('ev-start-time') as HTMLInputElement;
    const endTime = document.getElementById('ev-end-time') as HTMLInputElement;

    const toast = (msg: string, type: 'success' | 'error' = 'success') =>
      window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

    function esc(s: string): string {
      return s.replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\n/g, '\\n');
    }

    function toIcsDate(dateStr: string, timeStr: string | null): string {
      if (!dateStr) return '';
      if (!timeStr) return dateStr.replace(/-/g, ''); // all-day: YYYYMMDD
      const d = new Date(`${dateStr}T${timeStr}:00`);
      if (isNaN(d.getTime())) return '';
      return d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    }

    function setDefaultDates() {
      const today = new Date();
      const fmt = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const sDate = document.getElementById('ev-start-date') as HTMLInputElement;
      const eDate = document.getElementById('ev-end-date') as HTMLInputElement;
      if (!sDate.value) sDate.value = fmt(today);
      if (!eDate.value) {
        const end = new Date(today);
        end.setHours(end.getHours() + 1);
        eDate.value = fmt(end);
      }
    }

    function generate(): string {
      const title = (document.getElementById('ev-title') as HTMLInputElement).value.trim();
      if (!title) { toast('Judul event wajib diisi', 'error'); return ''; }
      const loc = (document.getElementById('ev-loc') as HTMLInputElement).value.trim();
      const desc = (document.getElementById('ev-desc') as HTMLTextAreaElement).value.trim();
      const reminder = parseInt((document.getElementById('ev-reminder') as HTMLSelectElement).value) || 0;
      const allday = alldayInput.checked;
      const startDate = (document.getElementById('ev-start-date') as HTMLInputElement).value;
      const endDate = (document.getElementById('ev-end-date') as HTMLInputElement).value;

      let dtStart = toIcsDate(startDate, allday ? null : startTime.value);
      let dtEnd = toIcsDate(endDate, allday ? null : endTime.value);
      if (!dtStart || !dtEnd) { toast('Tanggal tidak valid', 'error'); return ''; }
      if (allday && dtStart === dtEnd) {
        // RFC 5545: DTEND all-day bersifat exclusive (+1 hari)
        const d = new Date(endDate + 'T00:00:00');
        d.setDate(d.getDate() + 1);
        dtEnd = `${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getDate()).padStart(2, '0')}`;
      }

      const uid = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}@toolsaulia`;
      const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
      const alarm = reminder > 0
        ? `BEGIN:VALARM\nTRIGGER:-PT${reminder}M\nACTION:DISPLAY\nDESCRIPTION:${esc(title)}\nEND:VALARM\n`
        : '';

      return [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//ToolsAulia//iCal Generator//ID',
        'CALSCALE:GREGORIAN',
        'METHOD:PUBLISH',
        'BEGIN:VEVENT',
        `UID:${uid}`,
        `DTSTAMP:${stamp}`,
        `DTSTART:${dtStart}`,
        `DTEND:${dtEnd}`,
        `SUMMARY:${esc(title)}`,
        loc ? `LOCATION:${esc(loc)}` : '',
        desc ? `DESCRIPTION:${esc(desc)}` : '',
        allday ? 'X-MICROSOFT-CDO-ALLDAYEVENT:TRUE' : '',
        alarm ? alarm.trimEnd() : '',
        'END:VEVENT',
        'END:VCALENDAR',
      ].filter((l) => l !== '').join('\r\n');
    }

    alldayInput?.addEventListener('change', () => {
      startTime.disabled = alldayInput.checked;
      endTime.disabled = alldayInput.checked;
    });

    genBtn?.addEventListener('click', () => {
      const ics = generate();
      if (!ics) return;
      preview!.textContent = ics;
      previewBox?.classList.remove('hidden');
      const title = (document.getElementById('ev-title') as HTMLInputElement).value.trim();
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([ics], { type: 'text/calendar;charset=utf-8' }));
      a.download = title.replace(/[^\w\- ]+/g, '').trim().replace(/\s+/g, '-') + '.ics';
      a.click();
      toast('File .ics berhasil di-download!');
    });

    copyBtn?.addEventListener('click', async () => {
      const ics = generate();
      if (!ics) return;
      try {
        await navigator.clipboard.writeText(ics);
        toast('Teks .ics tersalin!');
      } catch {
        toast('Gagal menyalin', 'error');
      }
    });

    setDefaultDates();
  });
</script>
