---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout title="JSON to CSV — Konversi JSON ke CSV | ToolsAulia" description="Konversi JSON array ke CSV dengan header inference. 100% client-side." category="Data" toolHref="/data/json-to-csv">
  <ToolPageHeader title="JSON to CSV" description="Konversi JSON array ke CSV — otomatis detect header" icon='<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M8 13h2"/><path d="M8 17h2"/><path d="M14 13h2"/><path d="M14 17h2"/>' />

  <div class="card-base p-5 space-y-4">
    <textarea id="json-input" class="input-field w-full h-40 font-mono text-sm" placeholder='Paste JSON array di sini...&#10;[&#10;  {"name": "Alice", "age": 25, "city": "Jakarta"},&#10;  {"name": "Bob", "age": 30, "city": "Bandung"}&#10;]'></textarea>
    <div class="flex gap-2">
      <button id="convert-btn" class="btn-primary">Konversi ke CSV</button>
      <select id="delimiter" class="input-field text-sm w-20">
        <option value="," selected>,</option>
        <option value=";">;</option>
        <option value="\t">TAB</option>
      </select>
      <label class="flex items-center gap-1 text-sm text-matte-500"><input type="checkbox" id="wrap" checked> "Quote"</label>
    </div>

    <div class="flex justify-between">
      <label class="text-sm text-matte-500 font-medium">Output CSV</label>
      <div class="flex gap-2">
        <button id="copy-btn" class="btn-secondary text-xs">📋 Copy</button>
        <button id="download-btn" class="btn-secondary text-xs">⬇️ .csv</button>
        <button id="preview-btn" class="btn-secondary text-xs">👁️ Preview Table</button>
      </div>
    </div>
    <textarea id="csv-output" class="input-field w-full h-32 font-mono text-sm bg-matte-50 dark:bg-matte-800" readonly></textarea>
    <div id="preview-table" class="hidden overflow-x-auto"></div>
  </div>
</BaseLayout>

<script>
  const { showToast, _tToast } = window as any;
  const jsonInp = document.getElementById('json-input');
  const csvOut = document.getElementById('csv-output');

  document.getElementById('convert-btn').addEventListener('click', () => {
    try {
      const data = JSON.parse(jsonInp.value);
      const arr = Array.isArray(data) ? data : [data];
      if (!arr.length) { csvOut.value = ''; return; }

      const keys = Object.keys(arr[0]);
      const delim = document.getElementById('delimiter').value === '\t' ? '\t' : document.getElementById('delimiter').value;
      const wrap = document.getElementById('wrap').checked;
      const q = wrap ? '"' : '';
      const esc = (s) => wrap ? String(s||'').replace(/"/g,'""') : String(s||'');

      const lines = [keys.map(k => q + k + q).join(delim)];
      arr.forEach(row => lines.push(keys.map(k => q + esc(row[k]) + q).join(delim)));
      csvOut.value = lines.join('\n');
    } catch (e) {
      showToast?.(_tToast?.('JSON tidak valid: '+(e.message||''), 'Invalid JSON'), 'error');
    }
  });

  document.getElementById('copy-btn').addEventListener('click', () => {
    navigator.clipboard.writeText(csvOut.value).then(() => showToast?.(_tToast?.('Disalin!','Copied!'),'success'));
  });

  document.getElementById('download-btn').addEventListener('click', () => {
    const blob = new Blob([csvOut.value], { type: 'text/csv' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'data.csv'; a.click();
  });

  document.getElementById('preview-btn').addEventListener('click', () => {
    const lines = csvOut.value.split('\n').filter(Boolean);
    if (!lines.length) return;
    const table = document.getElementById('preview-table');
    table.classList.remove('hidden');
    const headers = lines[0].split(document.getElementById('delimiter').value);
    table.innerHTML = '<table class="text-sm border-collapse w-full"><thead><tr class="bg-matte-100 dark:bg-matte-700">'+
      headers.map(h => '<th class="p-2 border border-matte-200 dark:border-matte-600 text-left">'+escHtml(h)+'</th>').join('') +
      '</tr></thead><tbody>'+
      lines.slice(1).map(l => '<tr>'+l.split(document.getElementById('delimiter').value).map(c => '<td class="p-2 border border-matte-200 dark:border-matte-600">'+escHtml(c)+'</td>').join('')+'</tr>').join('') +
      '</tbody></table>';
  });

  function escHtml(s) { return String(s||'').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
</script>
