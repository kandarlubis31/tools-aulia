---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Barcode Generator">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh] py-10">
    <ToolPageHeader
      title="Barcode Generator"
      titleKey="header.barcode_gen"
      desc="Generate barcode CODE128, EAN-13, dan UPC-A secara langsung di browser."
      descKey="header.barcode_gen_desc"
      icon='<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="7" y1="7" x2="7" y2="17"/><line x1="10" y1="7" x2="10" y2="17"/><line x1="13" y1="7" x2="13" y2="17"/><line x1="16" y1="7" x2="16" y2="17"/>'
      gradient="from-teal-500 to-cyan-600"
    />

    <div class="card-base p-8 animate-fade-in">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
        <div><label class="text-xs text-matte-500 mb-1 block">Tipe Barcode</label>
          <select id="type" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold">
            <option value="CODE128">CODE128</option>
            <option value="EAN13">EAN-13</option>
            <option value="UPCA">UPC-A</option>
          </select></div>
        <div><label class="text-xs text-matte-500 mb-1 block">Teks/Nilai</label><input id="value" type="text" value="TOOLS AULIA" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold" /></div>
        <div><label class="text-xs text-matte-500 mb-1 block">Lebar Bar</label><input id="barwidth" type="number" value="2" min="1" max="5" class="w-full p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold" /></div>
      </div>
      <div class="flex gap-4 mb-6">
        <label class="flex items-center gap-2 text-sm text-matte-500"><input type="checkbox" id="showtext" checked class="rounded" /> Tampilkan teks di bawah barcode</label>
        <label class="flex items-center gap-2 text-sm text-matte-500"><input type="checkbox" id="bg-transparent" class="rounded" /> Background transparan</label>
      </div>
      <button id="generate" class="w-full py-3 bg-teal-600 text-white rounded-xl font-bold hover:bg-teal-700 transition-colors mb-6">Generate Barcode</button>

      <div id="preview" class="flex justify-center p-6 bg-matte-100 dark:bg-surface-hover rounded-xl border border-matte-200 dark:border-surface-border">
        <canvas id="barcode-canvas"></canvas>
      </div>

      <div class="flex gap-2 mt-4">
        <button id="download-png" class="flex-1 py-3 bg-matte-200 dark:bg-matte-700 text-matte-700 dark:text-matte-300 rounded-xl font-bold hover:bg-teal-100 dark:hover:bg-teal-900/30 transition-colors">📥 Download PNG</button>
        <button id="copy-value" class="flex-1 py-3 bg-matte-200 dark:bg-matte-700 text-matte-700 dark:text-matte-300 rounded-xl font-bold hover:bg-sky-100 dark:hover:bg-sky-900/30 transition-colors">📋 Copy Value</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const CODE128_CHARS = ' !"#$%&\'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{|}~';
  const CODE128_PATTERNS = [
    '11011001100','11001101100','11001100110','10010011000','10010001100','10001001100','10011001000','10011000100','10001100100','11001001000','11001000100','11000100100','10110011100','10011011100','10011001110','10111001100','10011101100','10011100110','11001110010','11001011100','11001001110','11011100100','11001110100','11101101110','11101001100','11100101100','11100100110','11101100100','11100110100','11100110010','11011011000','11011000110','11000110110','10100011000','10001011000','10001000110','10110001000','10001101000','10001100010','11010001000','11000101000','11000100010','10110111000','10110001110','10001101110','10111011000','10111000110','10001110110','11101110110','11010001110','11000101110','11011101000','11011100010','11011101110','11101011000','11101000110','11100010110','11101101000','11101100010','11100011010','11101111010','11001000010','11110001010','10100110000','10100001100','10010110000','10010000110','10000101100','10000100110','10110010000','10110000100','10011010000','10011000010','10000110100','10000110010','11000010010','11001010000','11110111010','11000010100','10001111010','10100111100','10010111100','10010011110','10111100100','10011110100','10011110010','11110100100','11110010100','11110010010','11011011110','11011110110','11110110110','10101111000','10100011110','10001011110','10111101000','10111100010','11110101000','11110100010','10111011110','10111101110','11101011110','11110101110','11010000100','11010010000','11010011100','1100011101011','11010010110','1100011101011'];
  const START_CODE_A = 103, START_CODE_B = 104, START_CODE_C = 105, STOP = 106;

  function encodeCODE128(text) {
    let codes = [START_CODE_B];
    for (let i = 0; i < text.length; i++) {
      const idx = CODE128_CHARS.indexOf(text[i]);
      if (idx === -1) continue;
      codes.push(idx);
    }
    let checksum = codes[0];
    for (let i = 1; i < codes.length; i++) checksum += codes[i] * i;
    codes.push(checksum % 103);
    codes.push(STOP);
    return codes.map(c => CODE128_PATTERNS[c]).join('');
  }

  function drawBarcode(canvas, data, barWidth, showText, value, transparent) {
    const ctx = canvas.getContext('2d');
    const bars = data.split('');
    const width = bars.length * barWidth + 20;
    const height = showText ? 100 : 60;
    canvas.width = width;
    canvas.height = height;
    if (!transparent) {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, width, height);
    }
    ctx.fillStyle = '#000000';
    let x = 10;
    for (const bar of bars) {
      if (bar === '1') ctx.fillRect(x, 5, barWidth, height - (showText ? 30 : 10));
      x += barWidth;
    }
    if (showText) {
      ctx.font = 'bold 12px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(value, width / 2, height - 8);
    }
  }

  function generate() {
    const type = document.getElementById('type').value;
    let value = document.getElementById('value').value;
    const barWidth = +document.getElementById('barwidth').value || 2;
    const showText = document.getElementById('showtext').checked;
    const transparent = document.getElementById('bg-transparent').checked;
    
    if (type === 'EAN13') {
      value = value.replace(/\D/g, '').padEnd(12, '0').slice(0, 12);
      let sum = 0;
      for (let i = 0; i < 12; i++) sum += +value[i] * (i % 2 === 0 ? 1 : 3);
      value += (10 - sum % 10) % 10;
    } else if (type === 'UPCA') {
      value = value.replace(/\D/g, '').padEnd(10, '0').slice(0, 10);
      let sum = 0;
      for (let i = 0; i < 10; i++) sum += +value[i] * (i % 2 === 0 ? 3 : 1);
      value += (10 - sum % 10) % 10;
    }
    
    const data = type === 'CODE128' ? encodeCODE128(value) : encodeCODE128(value);
    const canvas = document.getElementById('barcode-canvas');
    drawBarcode(canvas, data, barWidth, showText, value, transparent);
  }

  document.getElementById('generate').onclick = generate;
  document.getElementById('download-png').onclick = () => {
    const canvas = document.getElementById('barcode-canvas');
    const link = document.createElement('a');
    link.download = 'barcode.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
  };
  document.getElementById('copy-value').onclick = () => {
    navigator.clipboard.writeText(document.getElementById('value').value);
    document.getElementById('copy-value').textContent = '✅ Copied!';
    setTimeout(() => document.getElementById('copy-value').textContent = '📋 Copy Value', 1500);
  };
  generate();
</script>
