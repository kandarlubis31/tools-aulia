---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Fancy Text Generator — Teks Fancy Unicode">
  <div class="max-w-3xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Fancy Text Generator"
      titleKey="header.fancy_text"
      desc="Generate teks fancy: bold, italic, strikethrough, unicode styles."
      descKey="header.fancy_text_desc"
      icon='<path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/>'
      gradient="from-pink-500 to-rose-600"
    />

    <div class="card-base p-6 animate-fade-in">
      <label class="section-title mb-2 block" for="text-input" data-i18n="label.fancy_input">Masukkan Teks</label>
      <input id="text-input" type="text" class="w-full px-4 py-4 bg-matte-100 dark:bg-surface-hover border border-matte-200 dark:border-surface-border rounded-xl outline-none focus:border-pink-500 transition-colors text-sm" placeholder="Ketik teks di sini..." autocomplete="off" data-i18n-attr="placeholder" data-i18n="ph.type_here" />

      <div class="flex justify-between items-center mt-6">
        <p class="text-xs text-matte-400" data-i18n="fancy.hint">Klik Copy untuk salin satu style.</p>
        <button id="copy-all" class="text-xs font-bold px-3 py-1.5 bg-pink-100 dark:bg-pink-900/30 text-pink-600 dark:text-pink-400 rounded-lg hover:bg-pink-200 dark:hover:bg-pink-900/50 transition" data-i18n="btn.copy_all">Copy Semua</button>
      </div>

      <div id="styles-container" class="mt-3 space-y-3"></div>
    </div>
  </div>
</BaseLayout>

<script>
import { t } from '../../i18n/translations';

  let __render: (() => void) | null = null;
  window.addEventListener('langchange', () => __render?.());

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const charMaps: Record<string, Record<string, string>> = {
    bold: { 'a': '𝐚', 'b': '𝐛', 'c': '𝐜', 'd': '𝐝', 'e': '𝐞', 'f': '𝐟', 'g': '𝐠', 'h': '𝐡', 'i': '𝐢', 'j': '𝐣', 'k': '𝐤', 'l': '𝐥', 'm': '𝐦', 'n': '𝐧', 'o': '𝐨', 'p': '𝐩', 'q': '𝐪', 'r': '𝐫', 's': '𝐬', 't': '𝐭', 'u': '𝐮', 'v': '𝐯', 'w': '𝐰', 'x': '𝐱', 'y': '𝐲', 'z': '𝐳', 'A': '𝐀', 'B': '𝐁', 'C': '𝐂', 'D': '𝐃', 'E': '𝐄', 'F': '𝐅', 'G': '𝐆', 'H': '𝐇', 'I': '𝐈', 'J': '𝐉', 'K': '𝐊', 'L': '𝐋', 'M': '𝐌', 'N': '𝐍', 'O': '𝐎', 'P': '𝐏', 'Q': '𝐐', 'R': '𝐑', 'S': '𝐒', 'T': '𝐓', 'U': '𝐔', 'V': '𝐕', 'W': '𝐖', 'X': '𝐗', 'Y': '𝐘', 'Z': '𝐙' },
    italic: { 'a': '𝑎', 'b': '𝑏', 'c': '𝑐', 'd': '𝑑', 'e': '𝑒', 'f': '𝑓', 'g': '𝑔', 'h': 'ℎ', 'i': '𝑖', 'j': '𝑗', 'k': '𝑘', 'l': '𝑙', 'm': '𝑚', 'n': '𝑛', 'o': '𝑜', 'p': '𝑝', 'q': '𝑞', 'r': '𝑟', 's': '𝑠', 't': '𝑡', 'u': '𝑢', 'v': '𝑣', 'w': '𝑤', 'x': '𝑥', 'y': '𝑦', 'z': '𝑧', 'A': '𝐴', 'B': '𝐵', 'C': '𝐶', 'D': '𝐷', 'E': '𝐸', 'F': '𝐹', 'G': '𝐺', 'H': '𝐻', 'I': '𝐼', 'J': '𝐽', 'K': '𝐾', 'L': '𝐿', 'M': '𝑀', 'N': '𝑁', 'O': '𝑂', 'P': '𝑃', 'Q': '𝑄', 'R': '𝑅', 'S': '𝑆', 'T': '𝑇', 'U': '𝑈', 'V': '𝑉', 'W': '𝑊', 'X': '𝑋', 'Y': '𝑌', 'Z': '𝑍' },
    strike: { 'a': 'a̶', 'b': 'b̶', 'c': 'c̶', 'd': 'd̶', 'e': 'e̶', 'f': 'f̶', 'g': 'g̶', 'h': 'h̶', 'i': 'i̶', 'j': 'j̶', 'k': 'k̶', 'l': 'l̶', 'm': 'm̶', 'n': 'n̶', 'o': 'o̶', 'p': 'p̶', 'q': 'q̶', 'r': 'r̶', 's': 's̶', 't': 't̶', 'u': 'u̶', 'v': 'v̶', 'w': 'w̶', 'x': 'x̶', 'y': 'y̶', 'z': 'z̶', 'A': 'A̶', 'B': 'B̶', 'C': 'C̶', 'D': 'D̶', 'E': 'E̶', 'F': 'F̶', 'G': 'G̶', 'H': 'H̶', 'I': 'I̶', 'J': 'J̶', 'K': 'K̶', 'L': 'L̶', 'M': 'M̶', 'N': 'N̶', 'O': 'O̶', 'P': 'P̶', 'Q': 'Q̶', 'R': 'R̶', 'S': 'S̶', 'T': 'T̶', 'U': 'U̶', 'V': 'V̶', 'W': 'W̶', 'X': 'X̶', 'Y': 'Y̶', 'Z': 'Z̶' },
    double: { 'a': '𝕒', 'b': '𝕓', 'c': '𝕔', 'd': '𝕕', 'e': '𝕖', 'f': '𝕗', 'g': '𝕘', 'h': '𝕙', 'i': '𝕚', 'j': '𝕛', 'k': '𝕜', 'l': '𝕝', 'm': '𝕞', 'n': '𝕟', 'o': '𝕠', 'p': '𝕡', 'q': '𝕢', 'r': '𝕣', 's': '𝕤', 't': '𝕥', 'u': '𝕦', 'v': '𝕧', 'w': '𝕨', 'x': '𝕩', 'y': '𝕪', 'z': '𝕫', 'A': '𝔸', 'B': '𝔹', 'C': 'ℂ', 'D': '𝔻', 'E': '𝔼', 'F': '𝔽', 'G': '𝔾', 'H': 'ℍ', 'I': '𝕀', 'J': '𝕁', 'K': '𝕂', 'L': '𝕃', 'M': '𝕄', 'N': 'ℕ', 'O': '𝕆', 'P': 'ℙ', 'Q': 'ℚ', 'R': 'ℝ', 'S': '𝕊', 'T': '𝕋', 'U': '𝕌', 'V': '𝕍', 'W': '𝕎', 'X': '𝕏', 'Y': '𝕐', 'Z': 'ℤ' }
  };

  const textInput = document.getElementById('text-input') as HTMLInputElement;
  const container = document.getElementById('styles-container')!;
  const copyAllBtn = document.getElementById('copy-all') as HTMLButtonElement;
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);
  let lastText = '';

  function convertText(text: string, style: string): string {
    const map = charMaps[style];
    if (!map) return text;
    return text.split('').map(c => map[c] || c).join('');
  }

  function buildRow(styleKey: string, converted: string) {
    const row = document.createElement('div');
    row.className = 'flex items-center gap-3 p-3 bg-matte-50 dark:bg-matte-900 rounded-xl border border-matte-200 dark:border-surface-border';
    const name = document.createElement('span');
    name.className = 'text-xs text-matte-400 w-24 shrink-0';
    name.textContent = t('fancy.style_' + styleKey, styleKey);
    const preview = document.createElement('div');
    preview.className = 'flex-1 text-sm font-mono truncate';
    preview.textContent = converted;
    const btn = document.createElement('button');
    btn.className = 'copy-style text-xs font-bold px-3 py-1.5 bg-pink-100 dark:bg-pink-900/30 text-pink-600 dark:text-pink-400 rounded-lg hover:bg-pink-200 dark:hover:bg-pink-900/50 transition shrink-0';
    btn.textContent = t('btn.copy', 'Copy');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(converted);
        toast('Disalin!');
      } catch { toast('Gagal menyalin', 'error'); }
    });
    row.append(name, preview, btn);
    return row;
  }

  function renderStyles(text: string) {
    if (!text.trim()) {
      container.innerHTML = `<p class="text-sm text-matte-400 text-center py-4">${t('fancy.empty', 'Ketik teks di atas untuk melihat hasil')}</p>`;
      return;
    }
    container.innerHTML = '';
    (['bold', 'italic', 'strike', 'double'] as const).forEach(key => {
      container.appendChild(buildRow(key, convertText(text, key)));
    });
  }

  textInput.addEventListener('input', () => {
    lastText = textInput.value;
    renderStyles(lastText);
  });

  copyAllBtn.addEventListener('click', async () => {
    if (!lastText.trim()) { toast('Ketik teks dulu!', 'info'); return; }
    try {
      const all = (['bold', 'italic', 'strike', 'double'] as const)
        .map(key => t('fancy.style_' + key, key) + ': ' + convertText(lastText, key))
        .join('\n');
      await navigator.clipboard.writeText(all);
      toast('Teks disalin!');
    } catch { toast('Gagal menyalin', 'error'); }
  });

  renderStyles('');
  __render = () => renderStyles(lastText);

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __textFancyPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __textFancyPage) { __render = null; return; }
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
