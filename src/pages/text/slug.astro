---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Slug Generator — Generate URL Slug Online">
  <div class="max-w-2xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader title="Slug Generator" titleKey="header.slug_gen"
      desc="Generate URL slug dari teks. Otomatis lowercase, hapus karakter khusus."
      descKey="header.slug_gen_desc"
      icon='<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>'
      gradient="from-sky-500 to-blue-600" />

    <div class="card-base p-5 animate-fade-in">
      <div class="flex gap-2 mb-3">
        <input id="text-input" type="text" placeholder="Judul artikel atau teks apa pun…" class="flex-1 px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-elevated border border-matte-200 dark:border-matte-700 text-sm outline-none focus:ring-2 focus:ring-sky-500/40" />
      </div>
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <label class="text-2xs text-matte-400 font-bold">Separator:</label>
        <button class="sep-btn px-3 py-1 rounded text-xs font-bold font-mono bg-sky-100 dark:bg-sky-900/40 text-sky-700 dark:text-sky-300" data-sep="-">-</button>
        <button class="sep-btn px-3 py-1 rounded text-xs font-bold font-mono bg-matte-50 dark:bg-surface-elevated text-matte-500 dark:text-matte-300" data-sep="_">_</button>
        <button class="sep-btn px-3 py-1 rounded text-xs font-bold font-mono bg-matte-50 dark:bg-surface-elevated text-matte-500 dark:text-matte-300" data-sep="~">~</button>
      </div>
      <div class="relative mb-3">
        <label class="text-2xs text-matte-400 font-bold block mb-1">Hasil Slug</label>
        <input id="slug-output" type="text" readonly class="w-full px-3 py-2.5 rounded-lg bg-sky-50 dark:bg-sky-900/20 border border-sky-200 dark:border-sky-800 text-sm font-mono font-bold text-sky-700 dark:text-sky-300 outline-none" />
        <button id="copy-btn" class="absolute top-6 right-2 px-3 py-1 rounded-lg text-2xs font-bold bg-sky-100 dark:bg-sky-800/40 text-sky-700 dark:text-sky-300 hover:bg-sky-200 transition-all">📋 Copy</button>
      </div>
      <div class="flex items-center gap-2">
        <input id="lowercase-check" type="checkbox" class="rounded" checked />
        <label class="text-2xs text-matte-400">Lowercase</label>
        <span id="char-count" class="ml-auto text-2xs text-matte-400 font-mono"></span>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load',()=>{
    const textInput=document.getElementById('text-input') as HTMLInputElement;
    const slugOutput=document.getElementById('slug-output') as HTMLInputElement;
    const charCount=document.getElementById('char-count')!;
    const lowercaseCheck=document.getElementById('lowercase-check') as HTMLInputElement;
    const toast=(m:string)=>window.showToast?.(window._tToast?window._tToast(m):m);
    let separator='-';

    function slugify(text:string):string{
      let s=text.normalize('NFD').replace(/[\u0300-\u036f]/g,'');
      s=s.replace(/[^a-zA-Z0-9\s_-]/g,'').trim().replace(/[\s_]+/g,separator).replace(new RegExp(separator+'+','g'),separator);
      if(lowercaseCheck.checked)s=s.toLowerCase();return s;
    }

    function update(){const slug=slugify(textInput.value);slugOutput.value=slug;charCount.textContent=slug.length+' char';}

    textInput.addEventListener('input',update);lowercaseCheck.addEventListener('change',update);
    document.querySelectorAll('.sep-btn').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.sep-btn').forEach(x=>x.className='sep-btn px-3 py-1 rounded text-xs font-bold font-mono bg-matte-50 dark:bg-surface-elevated text-matte-500 dark:text-matte-300');
      (b as HTMLElement).className='sep-btn px-3 py-1 rounded text-xs font-bold font-mono bg-sky-100 dark:bg-sky-900/40 text-sky-700 dark:text-sky-300';separator=(b as HTMLElement).dataset.sep!;update();}));

    document.getElementById('copy-btn')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(slugOutput.value);toast('Slug tersalin!');}catch{toast('Gagal');}});

    textInput.value='Cara Membuat Website dengan Astro JS';update();
  });
</script>
