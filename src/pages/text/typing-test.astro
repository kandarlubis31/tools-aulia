---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Typing Test — Ukur Kecepatan Ketik">
  <div class="max-w-3xl mx-auto px-4 min-h-[60vh]">
    <ToolPageHeader
      title="Typing Test"
      titleKey="header.typing_test"
      desc="Ukur kecepatan ketik (WPM), akurasi, dan error. Per-karakter highlight, spasi dihitung."
      descKey="header.typing_test_desc"
      icon='<rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M6 14h.01M18 14h.01"/><path d="M10 14h4"/>'
      gradient="from-sky-500 to-blue-600"
    />

    <!-- Controls -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-6 animate-fade-in">
      <div class="bg-white dark:bg-matte-800 p-1 rounded-xl inline-flex border border-matte-200 dark:border-matte-700">
        <button data-duration="15" class="mode-btn px-5 py-2 rounded-lg text-sm font-bold bg-sky-500 text-white shadow-md transition-all">15s</button>
        <button data-duration="30" class="mode-btn px-5 py-2 rounded-lg text-sm font-medium text-matte-500 dark:text-matte-400 hover:text-matte-700 dark:hover:text-matte-200 transition-all">30s</button>
        <button data-duration="60" class="mode-btn px-5 py-2 rounded-lg text-sm font-medium text-matte-500 dark:text-matte-400 hover:text-matte-700 dark:hover:text-matte-200 transition-all">60s</button>
      </div>
      <button id="lang-toggle" class="px-5 py-2.5 rounded-xl text-sm font-bold bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300 hover:bg-matte-200 dark:hover:bg-surface-hover transition-all">🇮🇩 ID</button>
      <button id="sound-toggle" class="px-5 py-2.5 rounded-xl text-sm font-bold bg-matte-100 dark:bg-surface-elevated text-matte-500 dark:text-matte-300 hover:bg-matte-200 dark:hover:bg-surface-hover transition-all" title="Suara klik mekanikal">🔇 Suara</button>
      <button id="restart-btn" class="px-5 py-2.5 rounded-xl text-sm font-bold bg-sky-100 dark:bg-sky-900/40 text-sky-600 dark:text-sky-400 hover:bg-sky-200 dark:hover:bg-sky-900/60 transition-all">🔄 Ulang</button>
    </div>

    <!-- Timer + Live stats -->
    <div class="card-base p-5 mb-6 animate-fade-in overflow-hidden">
      <!-- Progress Bar -->
      <div class="-mx-5 -mt-5 mb-4 h-1 bg-matte-100 dark:bg-matte-800">
        <div id="progress-bar" class="h-full bg-gradient-to-r from-sky-400 to-blue-500 rounded-r-full transition-all duration-300 ease-linear" style="width:100%"></div>
      </div>

      <div class="flex items-center justify-between mb-3 flex-wrap gap-3">
        <div class="flex items-center gap-3">
          <span class="text-3xl font-extrabold font-mono tabular-nums text-matte-800 dark:text-white" id="timer">0s</span>
          <span id="pb-badge" class="hidden px-2 py-0.5 rounded-full text-2xs font-bold bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-400 animate-bounce-in">🏆 PB!</span>
          <span class="text-2xs text-matte-400 hidden sm:inline">Ketik untuk mulai</span>
        </div>
        <div class="flex gap-2 text-center">
          <div class="stat-pill-default"><span class="font-bold text-lg tabular-nums" id="stat-wpm">0</span> <span class="text-matte-400 text-2xs">WPM</span></div>
          <div class="stat-pill-default"><span class="font-bold text-lg tabular-nums" id="stat-acc">—</span> <span class="text-matte-400 text-2xs">Akurasi</span></div>
          <div class="stat-pill-default"><span class="font-bold text-lg tabular-nums" id="stat-cpm">0</span> <span class="text-matte-400 text-2xs">CPM</span></div>
        </div>
      </div>

      <!-- Sparkline Chart -->
      <div id="sparkline-wrap" class="mb-3 hidden">
        <canvas id="sparkline-canvas" class="w-full h-8 rounded-md bg-matte-50 dark:bg-matte-900/50" aria-label="Grafik WPM 10 detik terakhir"></canvas>
      </div>

      <!-- Text Display — per-character rendering -->
      <div id="text-display" class="relative rounded-xl border-2 border-matte-200 dark:border-surface-border bg-matte-50 dark:bg-matte-900 p-5 text-lg md:text-xl leading-relaxed font-mono tracking-wide select-none min-h-[120px] cursor-text overflow-hidden transition-colors duration-200 focus-within:border-sky-400 dark:focus-within:border-sky-500" tabindex="0" aria-label="Area mengetik">
        <div id="chars-container" class="flex flex-wrap"></div>
        <!-- Cursor -->
        <div id="cursor" class="absolute w-0.5 bg-sky-500 rounded-full transition-all duration-100 ease-out" style="height:1.5em; top:1.25rem; left:1.25rem;"></div>
        <!-- Ghost text: expected char at cursor -->
        <div id="ghost-char" class="absolute text-sky-300 dark:text-sky-700 font-mono tracking-wide select-none pointer-events-none opacity-60 transition-all duration-100 ease-out" style="top:1.25rem; left:1.25rem; font-size:inherit; line-height:inherit;"></div>
      </div>

      <!-- Result -->
      <div id="result-card" class="hidden mt-5 rounded-xl border border-emerald-200 dark:border-emerald-800/50 bg-emerald-50 dark:bg-emerald-900/20 p-6 text-center animate-fade-in-up">
        <div class="text-3xl mb-2">🎉</div>
        <h3 class="text-xl font-extrabold text-matte-800 dark:text-white mb-1">Hasil Tes — <span id="res-duration">30s</span></h3>
        <div class="flex justify-center gap-4 mt-4 flex-wrap">
          <div class="bg-white dark:bg-matte-800 rounded-xl p-4 min-w-[80px]"><p class="text-3xl font-extrabold text-sky-600 dark:text-sky-400 tabular-nums" id="res-wpm">0</p><p class="text-2xs text-matte-400 uppercase font-bold mt-1">WPM</p></div>
          <div class="bg-white dark:bg-matte-800 rounded-xl p-4 min-w-[80px]"><p class="text-3xl font-extrabold text-violet-600 dark:text-violet-400 tabular-nums" id="res-cpm">0</p><p class="text-2xs text-matte-400 uppercase font-bold mt-1">CPM</p></div>
          <div class="bg-white dark:bg-matte-800 rounded-xl p-4 min-w-[80px]"><p class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 tabular-nums" id="res-acc">0%</p><p class="text-2xs text-matte-400 uppercase font-bold mt-1">Akurasi</p></div>
          <div class="bg-white dark:bg-matte-800 rounded-xl p-4 min-w-[80px]"><p class="text-3xl font-extrabold text-rose-600 dark:text-rose-400 tabular-nums" id="res-err">0</p><p class="text-2xs text-matte-400 uppercase font-bold mt-1">Error</p></div>
        </div>
        <p id="res-rating" class="text-sm font-bold mt-4 text-matte-600 dark:text-matte-300"></p>
        <button id="try-again" class="mt-4 px-6 py-2.5 bg-emerald-500 text-white rounded-xl font-bold text-sm hover:bg-emerald-600 transition-colors">🔄 Coba Lagi</button>
      </div>
    </div>

    <p class="text-center text-2xs text-matte-400 animate-fade-in">Spasi juga dihitung. Salah ketik tetap lanjut — akurasi dihitung dari karakter benar.</p>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const timerEl = document.getElementById('timer')!;
    const charsContainer = document.getElementById('chars-container')!;
    const cursorEl = document.getElementById('cursor')!;
    const textDisplay = document.getElementById('text-display')!;
    const statWpm = document.getElementById('stat-wpm')!;
    const statAcc = document.getElementById('stat-acc')!;
    const statCpm = document.getElementById('stat-cpm')!;
    const resultCard = document.getElementById('result-card')!;
    const restartBtn = document.getElementById('restart-btn')!;
    const tryAgain = document.getElementById('try-again')!;
    const langToggle = document.getElementById('lang-toggle')!;
    const soundToggle = document.getElementById('sound-toggle')!;
    const sparklineWrap = document.getElementById('sparkline-wrap')!;
    const sparklineCanvas = document.getElementById('sparkline-canvas') as HTMLCanvasElement;
    const modeBtns = document.querySelectorAll('.mode-btn');

    const ID_TEXTS = [
      'semua file diproses langsung di browser kamu tanpa dikirim ke server mana pun',
      'kualitas hasil selalu jadi prioritas utama dalam setiap pekerjaan yang serius',
      'berlatih mengetik setiap hari akan meningkatkan kecepatan dan akurasi secara signifikan',
      'teknologi terbaik adalah teknologi yang membuat hidup manusia menjadi lebih sederhana',
      'jangan pernah berhenti belajar karena hidup tidak pernah berhenti mengajarkan',
      'kopi hangat di pagi hari selalu menemani sesi coding yang produktif dan menyenangkan',
      'data pribadi adalah aset berharga yang wajib kita lindungi dengan baik dan aman',
      'kerja keras tanpa henti adalah kunci menuju hasil yang membanggakan dan berarti',
      'aplikasi yang ringan dan cepat akan disukai oleh banyak pengguna di seluruh dunia',
      'kebiasaan kecil yang dilakukan secara konsisten akan menghasilkan perubahan yang besar',
      'setiap orang punya jalannya masing masing tidak perlu membandingkan diri dengan orang lain',
      'membaca buku adalah cara terbaik untuk memperluas wawasan dan pengetahuan kita',
    ];
    const EN_TEXTS = [
      'the quick brown fox jumps over the lazy dog while the sun sets slowly',
      'practice typing every day to dramatically improve your speed and accuracy',
      'great software is built by small teams with big dreams and strong coffee',
      'all your files are processed locally in your browser never uploaded anywhere',
      'consistency beats intensity when it comes to building lasting new habits',
      'the best time to start was yesterday the next best time is right now',
      'clean code is simple and direct it reads like well written prose',
      'technology should serve people not the other way around it is a tool',
      'success is the sum of small efforts repeated day in and day out',
      'a journey of a thousand miles begins with a single step forward today',
      'every expert was once a beginner who refused to give up on their dreams',
      'the only way to do great work is to love what you do every single day',
    ];

    // ---- STATE ----
    let text = '';               // full text string (includes spaces)
    let charStates: ('untyped' | 'correct' | 'incorrect')[] = [];
    let cursorIdx = 0;
    let duration = 30;
    let lang: 'id' | 'en' = 'id';
    let startTime = 0;
    let timerId: ReturnType<typeof setInterval> | null = null;
    let totalKeystrokes = 0;
    let correctKeystrokes = 0;
    let finished = false;

    // ---- SOUND ENGINE (Web Audio API) ----
    let audioCtx: AudioContext | null = null;
    let soundOn: boolean;
    try { soundOn = localStorage.getItem('tt-sound') === 'on'; } catch { soundOn = false; }

    function getAudioCtx(): AudioContext {
      if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }

    function playKeySound(correct: boolean) {
      if (!soundOn) return;
      try {
        const ctx = getAudioCtx();
        const now = ctx.currentTime;
        const vol = ctx.createGain();
        vol.connect(ctx.destination);
        vol.gain.setValueAtTime(0.08, now);
        vol.gain.exponentialRampToValueAtTime(0.001, now + 0.04);

        if (correct) {
          // Bright click: high freq snap
          const osc = ctx.createOscillator();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(1800, now);
          osc.frequency.exponentialRampToValueAtTime(600, now + 0.03);
          osc.connect(vol);
          osc.start(now);
          osc.stop(now + 0.03);
        } else {
          // Dull thud: low freq bump
          const osc = ctx.createOscillator();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(120, now);
          osc.frequency.exponentialRampToValueAtTime(60, now + 0.05);
          osc.connect(vol);
          osc.start(now);
          osc.stop(now + 0.05);
        }
      } catch { /* Audio not available */ }
    }

    function updateSoundButton() {
      const btn = document.getElementById('sound-toggle')!;
      btn.innerHTML = soundOn ? '🔊 Suara' : '🔇 Suara';
      btn.classList.toggle('bg-sky-100', soundOn);
      btn.classList.toggle('dark:bg-sky-900/40', soundOn);
      btn.classList.toggle('text-sky-600', soundOn);
      btn.classList.toggle('dark:text-sky-400', soundOn);
      btn.classList.toggle('bg-matte-100', !soundOn);
      btn.classList.toggle('dark:bg-surface-elevated', !soundOn);
      btn.classList.toggle('text-matte-500', !soundOn);
      btn.classList.toggle('dark:text-matte-300', !soundOn);
    }

    const PB_KEY = (d: number) => `tt-pb-${d}`;
    function getPB(d: number): number {
      try { return parseInt(localStorage.getItem(PB_KEY(d)) || '0', 10) || 0; }
      catch { return 0; }
    }
    function setPB(d: number, wpm: number) {
      try { localStorage.setItem(PB_KEY(d), String(wpm)); }
      catch {}
    }

    function pickText() {
      const pool = lang === 'id' ? ID_TEXTS : EN_TEXTS;
      return pool[Math.floor(Math.random() * pool.length)];
    }

    function buildCharSpans() {
      charsContainer.innerHTML = '';
      charStates = new Array(text.length).fill('untyped');
      for (let i = 0; i < text.length; i++) {
        const span = document.createElement('span');
        span.textContent = text[i];
        span.className = 'char-cell text-matte-300 dark:text-matte-500 transition-colors duration-75';
        span.dataset.idx = String(i);
        charsContainer.appendChild(span);
      }
    }

    function positionCursor() {
      if (cursorIdx >= text.length) {
        cursorEl.style.display = 'none';
        return;
      }
      cursorEl.style.display = 'block';
      const span = charsContainer.children[cursorIdx] as HTMLElement | undefined;
      if (span) {
        const rect = span.getBoundingClientRect();
        const containerRect = charsContainer.getBoundingClientRect();
        cursorEl.style.left = (rect.left - containerRect.left) + 'px';
        cursorEl.style.top = (rect.top - containerRect.top) + 'px';
        cursorEl.style.height = rect.height + 'px';
      }
    }

    function updateCharColors() {
      for (let i = 0; i < text.length; i++) {
        const span = charsContainer.children[i] as HTMLElement;
        if (!span) continue;
        span.classList.remove('text-matte-800', 'dark:text-white', 'text-emerald-600', 'dark:text-emerald-400', 'text-rose-500', 'dark:text-rose-400', 'text-matte-300', 'dark:text-matte-500', 'bg-emerald-100', 'dark:bg-emerald-900/30', 'bg-rose-100', 'dark:bg-rose-900/30');
        if (charStates[i] === 'correct') {
          span.classList.add('text-emerald-600', 'dark:text-emerald-400');
        } else if (charStates[i] === 'incorrect') {
          span.classList.add('text-rose-500', 'dark:text-rose-400', 'bg-rose-100', 'dark:bg-rose-900/30');
        } else {
          span.classList.add('text-matte-300', 'dark:text-matte-500');
        }
        // Current position highlight
        if (i === cursorIdx && !finished) {
          span.classList.add('bg-sky-100', 'dark:bg-sky-900/40', 'rounded-sm');
        }
      }
      // Update ghost character
      if (!finished && cursorIdx < text.length) {
        const targetSpan = charsContainer.children[cursorIdx] as HTMLElement | undefined;
        if (targetSpan) {
          const rect = targetSpan.getBoundingClientRect();
          const containerRect = charsContainer.getBoundingClientRect();
          const ghost = document.getElementById('ghost-char')!;
          ghost.style.left = (rect.left - containerRect.left) + 'px';
          ghost.style.top = (rect.top - containerRect.top) + 'px';
          ghost.style.height = rect.height + 'px';
          ghost.style.lineHeight = rect.height + 'px';
          ghost.textContent = text[cursorIdx];
          ghost.style.display = 'block';
        }
      } else {
        (document.getElementById('ghost-char')!).style.display = 'none';
      }
    }

    function computeWpm(): number {
      if (!startTime) return 0;
      const mins = ((Date.now() - startTime) / 1000) / 60;
      return mins > 0 ? Math.round((correctKeystrokes / 5) / mins) : 0;
    }

    function updateLiveStats() {
      if (!startTime) return;
      const elapsed = (Date.now() - startTime) / 1000;
      const remaining = Math.max(0, duration - elapsed);
      const mins = elapsed / 60;
      const wpm = computeWpm();
      const cpm = mins > 0 ? Math.round(correctKeystrokes / mins) : 0;
      const acc = totalKeystrokes > 0 ? Math.round((correctKeystrokes / totalKeystrokes) * 100) : 100;
      statWpm.textContent = String(wpm);
      statAcc.textContent = acc + '%';
      statCpm.textContent = String(cpm);
      // Progress bar
      const pct = (remaining / duration) * 100;
      (document.getElementById('progress-bar')!).style.width = pct + '%';
    }

    // ---- SPARKLINE ENGINE ----
    const SPARK_MAX = 20;
    let wpmHistory: number[] = [];
    let sparkTimer: ReturnType<typeof setInterval> | null = null;

    function resetSparkline() {
      wpmHistory = [];
      sparklineWrap.classList.add('hidden');
      drawSparkline();
    }

    function startSparkline() {
      sparklineWrap.classList.remove('hidden');
      if (sparkTimer) clearInterval(sparkTimer);
      sparkTimer = setInterval(() => {
        if (finished) { stopSparkline(); return; }
        wpmHistory.push(computeWpm());
        if (wpmHistory.length > SPARK_MAX) wpmHistory.shift();
        drawSparkline();
      }, 500);
    }

    function stopSparkline() {
      if (sparkTimer) { clearInterval(sparkTimer); sparkTimer = null; }
    }

    function drawSparkline() {
      const canvas = sparklineCanvas;
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      const W = rect.width * dpr;
      const H = rect.height * dpr;
      if (canvas.width !== W) canvas.width = W;
      if (canvas.height !== H) canvas.height = H;

      const ctx = canvas.getContext('2d')!;
      ctx.clearRect(0, 0, W, H);

      const pts = wpmHistory;
      if (pts.length < 2) return;

      const padX = dpr * 2;
      const padY = dpr * 2;
      const maxWpm = Math.max(...pts, 10);
      const minWpm = 0;
      const stepX = (W - padX * 2) / (SPARK_MAX - 1);

      // Build polyline points
      const points: [number, number][] = [];
      for (let i = 0; i < pts.length; i++) {
        const x = padX + i * stepX;
        const y = padY + (H - padY * 2) * (1 - (pts[i] - minWpm) / (maxWpm - minWpm || 1));
        points.push([x, y]);
      }

      // Gradient fill
      const grad = ctx.createLinearGradient(0, 0, 0, H);
      grad.addColorStop(0, 'rgba(14, 165, 233, 0.35)');   // sky-500 35%
      grad.addColorStop(1, 'rgba(14, 165, 233, 0.02)');

      ctx.beginPath();
      ctx.moveTo(points[0][0], H - padY);
      for (const [x, y] of points) ctx.lineTo(x, y);
      ctx.lineTo(points[pts.length - 1][0], H - padY);
      ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();

      // Polylines
      ctx.beginPath();
      ctx.moveTo(points[0][0], points[0][1]);
      for (let i = 1; i < pts.length; i++) ctx.lineTo(points[i][0], points[i][1]);
      ctx.strokeStyle = 'rgba(14, 165, 233, 0.9)';
      ctx.lineWidth = dpr * 1.8;
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';
      ctx.stroke();

      // Dot at latest
      const last = points[pts.length - 1];
      ctx.beginPath();
      ctx.arc(last[0], last[1], dpr * 2.5, 0, Math.PI * 2);
      ctx.fillStyle = '#0ea5e9';
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = dpr * 1.2;
      ctx.stroke();
    }

    function finish() {
      if (finished) return;
      finished = true;
      if (timerId) { clearInterval(timerId); timerId = null; }
      cursorEl.style.display = 'none';

      const elapsed = (Date.now() - startTime) / 1000;
      const mins = elapsed / 60;
      const wpm = mins > 0 ? Math.round((correctKeystrokes / 5) / mins) : 0;
      const cpm = mins > 0 ? Math.round(correctKeystrokes / mins) : 0;
      const acc = totalKeystrokes > 0 ? Math.round((correctKeystrokes / totalKeystrokes) * 100) : 100;
      const errors = totalKeystrokes - correctKeystrokes;

      (document.getElementById('res-duration')!).textContent = duration + 's';
      (document.getElementById('res-wpm')!).textContent = String(wpm);
      (document.getElementById('res-cpm')!).textContent = String(cpm);
      (document.getElementById('res-acc')!).textContent = acc + '%';
      (document.getElementById('res-err')!).textContent = String(errors);

      const rating = document.getElementById('res-rating')!;
      if (wpm >= 80) rating.textContent = '🏆 Luar biasa! Kamu typist profesional!';
      else if (wpm >= 60) rating.textContent = '🚀 Hebat! Di atas rata-rata!';
      else if (wpm >= 40) rating.textContent = '👍 Bagus! Terus latihan!';
      else if (wpm >= 20) rating.textContent = '💪 Lumayan, tingkatkan lagi!';
      else rating.textContent = '🌱 Ayo latihan lebih sering!';

      // Personal best check
      const prevPB = getPB(duration);
      if (wpm > prevPB) {
        setPB(duration, wpm);
        (document.getElementById('pb-badge')!).classList.remove('hidden');
      }

      resultCard.classList.remove('hidden');
    }

    function reset() {
      if (timerId) { clearInterval(timerId); timerId = null; }
      startTime = 0; finished = false;
      totalKeystrokes = 0; correctKeystrokes = 0;
      cursorIdx = 0;
      timerEl.textContent = '0s';
      timerEl.classList.remove('text-rose-500', 'dark:text-rose-400');
      statWpm.textContent = '0'; statAcc.textContent = '—'; statCpm.textContent = '0';
      resultCard.classList.add('hidden');
      (document.getElementById('pb-badge')!).classList.add('hidden');
      (document.getElementById('progress-bar')!).style.width = '100%';
      (document.getElementById('ghost-char')!).style.display = 'none';
      resetSparkline();
      text = pickText();
      buildCharSpans();
      positionCursor();
      updateCharColors();
      setTimeout(() => textDisplay.focus(), 100);
    }

    function handleKey(key: string) {
      if (finished) return;
      if (cursorIdx >= text.length) return;

      // Start timer on first keystroke
      if (!startTime) {
        startTime = Date.now();
        startSparkline();
        timerId = setInterval(() => {
          const elapsed = Math.floor((Date.now() - startTime) / 1000);
          const remaining = Math.max(0, duration - elapsed);
          timerEl.textContent = remaining + 's';
          if (remaining <= 10) timerEl.classList.add('text-rose-500', 'dark:text-rose-400');
          updateLiveStats();
          if (remaining <= 0) finish();
        }, 100);
      }

      totalKeystrokes++;
      const expected = text[cursorIdx];

      if (key === expected) {
        charStates[cursorIdx] = 'correct';
        correctKeystrokes++;
      } else {
        charStates[cursorIdx] = 'incorrect';
      }

      cursorIdx++;
      // Play sound BEFORE updating colors (for correct/incorrect feedback)
      playKeySound(key === text[cursorIdx - 1]);
      updateCharColors();
      positionCursor();
      updateLiveStats();

      // Finish if all chars typed
      if (cursorIdx >= text.length) finish();
    }

    textDisplay.addEventListener('keydown', (e) => {
      if (finished) return;

      if (e.key === 'Backspace') {
        e.preventDefault();
        if (cursorIdx > 0) {
          cursorIdx--;
          charStates[cursorIdx] = 'untyped';
          // Don't decrement keystrokes but do recalc
          updateCharColors();
          positionCursor();
        }
        return;
      }

      // Only handle printable characters (including space)
      if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
        e.preventDefault();
        handleKey(e.key);
      }
    });

    // Tab → restart
    textDisplay.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        e.preventDefault();
        reset();
      }
    });

    textDisplay.addEventListener('click', () => textDisplay.focus());

    // Resize observer for cursor repositioning
    const ro = new ResizeObserver(() => { if (!finished) positionCursor(); });
    ro.observe(charsContainer);

    modeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        duration = parseInt((btn as HTMLElement).dataset.duration || '30');
        modeBtns.forEach(b => {
          b.className = 'mode-btn px-5 py-2 rounded-lg text-sm font-medium text-matte-500 dark:text-matte-400 hover:text-matte-700 dark:hover:text-matte-200 transition-all';
        });
        btn.className = 'mode-btn px-5 py-2 rounded-lg text-sm font-bold bg-sky-500 text-white shadow-md transition-all';
        reset();
      });
    });

    restartBtn.addEventListener('click', reset);
    tryAgain.addEventListener('click', reset);

    langToggle.addEventListener('click', () => {
      lang = lang === 'id' ? 'en' : 'id';
      langToggle.textContent = lang === 'id' ? '🇮🇩 ID' : '🇬🇧 EN';
      reset();
    });

    soundToggle.addEventListener('click', () => {
      soundOn = !soundOn;
      try { localStorage.setItem('tt-sound', soundOn ? 'on' : 'off'); } catch {}
      updateSoundButton();
      // Warm up AudioContext on first enable
      if (soundOn) { try { getAudioCtx(); } catch {} }
      textDisplay.focus();
    });
    updateSoundButton();

    reset();
  });
</script>
