---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---
<BaseLayout pageTitle="Find & Replace" description="Cari dan ganti teks dengan regex, case-sensitive, dan highlight. 100% client-side.">
  <ToolPageHeader title="Find & Replace" description="Cari & ganti teks: regex, highlight, batch" icon='<circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>' />

  <div class="card-base p-5 space-y-4">
    <div class="flex flex-wrap gap-2">
      <input id="find" type="text" class="input-field flex-1 text-sm" placeholder="Cari..." data-i18n-attr="placeholder" data-i18n="ph.find">
      <input id="replace" type="text" class="input-field flex-1 text-sm" placeholder="Ganti dengan..." data-i18n-attr="placeholder" data-i18n="ph.replace_with">
    </div>
    <div class="flex flex-wrap gap-2 text-sm items-center">
      <label class="flex items-center gap-1 text-matte-500"><input type="checkbox" id="regex" class="rounded"> <span data-i18n="label.regex">Regex</span></label>
      <label class="flex items-center gap-1 text-matte-500"><input type="checkbox" id="case-sensitive" class="rounded"> <span data-i18n="label.case_sensitive">Case-sensitive</span></label>
      <label class="flex items-center gap-1 text-matte-500"><input type="checkbox" id="global" class="rounded" checked> <span data-i18n="label.global">Global</span></label>
      <span id="match-count" class="text-xs text-matte-400"></span>
      <button id="do-replace" class="btn-primary text-sm ml-auto" data-i18n="btn.replace_all">Replace All</button>
    </div>

    <textarea id="input" class="input-field w-full h-32 font-mono text-sm" placeholder="Teks input di sini..." data-i18n-attr="placeholder" data-i18n="ph.input_text"></textarea>
    <textarea id="output" class="input-field w-full h-32 font-mono text-sm bg-matte-50 dark:bg-matte-800" readonly placeholder="Hasil replace..." data-i18n-attr="placeholder" data-i18n="ph.replace_result"></textarea>
    <button id="copy-btn" class="btn-secondary text-sm" data-i18n="btn.copy_emoji">📋 Copy Hasil</button>
  </div>
</BaseLayout>

<script>
  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const input = document.getElementById('input') as HTMLTextAreaElement;
  const output = document.getElementById('output') as HTMLTextAreaElement;
  const matchCount = document.getElementById('match-count')!;
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'success') =>
    window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  function run() {
    const find = (document.getElementById('find') as HTMLInputElement).value;
    const rep = (document.getElementById('replace') as HTMLInputElement).value;
    const text = input.value;
    if (!find) { output.value = text; matchCount.textContent = ''; return; }
    let flags = '';
    if (!(document.getElementById('case-sensitive') as HTMLInputElement).checked) flags += 'i';
    if ((document.getElementById('global') as HTMLInputElement).checked) flags += 'g';
    let pattern: RegExp;
    try {
      pattern = (document.getElementById('regex') as HTMLInputElement).checked
        ? new RegExp(find, flags)
        : new RegExp(find.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), flags);
    } catch {
      matchCount.textContent = window._tToast ? window._tToast('Regex tidak valid') : 'Invalid regex';
      output.value = '';
      return;
    }
    const matches = text.match(pattern);
    matchCount.textContent = matches
      ? matches.length + (window._tToast ? window._tToast(' match') : ' match') + (matches.length > 1 ? 'es' : '')
      : '0' + (window._tToast ? window._tToast(' match') : ' match');
    output.value = text.replace(pattern, rep);
  }

  ['find', 'replace', 'input'].forEach(id => document.getElementById(id)!.addEventListener('input', run));
  ['regex', 'case-sensitive', 'global'].forEach(id => document.getElementById(id)!.addEventListener('change', run));

  document.getElementById('do-replace')!.addEventListener('click', () => {
    if (!output.value || output.value === input.value) { toast('Belum ada perubahan untuk diterapkan.', 'info'); return; }
    input.value = output.value;
    run();
    toast('Teks diganti!');
  });

  document.getElementById('copy-btn')!.addEventListener('click', async () => {
    try {
      if (!output.value) { toast('Belum ada hasil untuk disalin.', 'info'); return; }
      await navigator.clipboard.writeText(output.value);
      toast('Disalin!');
    } catch { toast('Gagal menyalin', 'error'); }
  });

  }

  // SPA boot (#14): guard path + guard dobel-bind
  const __textFindReplacePage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __textFindReplacePage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
