---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="Speech to Text">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh] py-10">
    <ToolPageHeader
      title="Speech to Text"
      titleKey="header.speech_to_text"
      desc="Transkripsi suara ke teks secara real-time menggunakan Web Speech API."
      descKey="header.speech_to_text_desc"
      icon='<path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/>'
      gradient="from-orange-500 to-red-600"
    />

    <div class="card-base p-8 animate-fade-in">
      <div class="flex items-center gap-4 mb-6">
        <select id="lang" class="p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold">
          <option value="id-ID">🇮🇩 Indonesia</option>
          <option value="en-US">🇺🇸 English</option>
        </select>
        <button id="start-btn" class="flex items-center gap-2 px-6 py-3 bg-orange-600 text-white rounded-xl font-bold hover:bg-orange-700 transition-colors">
          <span id="mic-icon">🎙️</span> <span id="btn-text">Mulai Rekam</span>
        </button>
        <button id="clear-btn" class="px-4 py-3 bg-matte-200 dark:bg-matte-700 text-matte-600 dark:text-matte-300 rounded-xl font-bold hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors">🗑️</button>
        <button id="copy-btn" class="px-4 py-3 bg-matte-200 dark:bg-matte-700 text-matte-600 dark:text-matte-300 rounded-xl font-bold hover:bg-lime-100 dark:hover:bg-lime-900/30 transition-colors">📋</button>
      </div>
      <div id="status" class="text-sm text-matte-400 mb-4" data-i18n="stt.hint">Klik tombol di atas untuk mulai transkripsi suara</div>
      <textarea id="output" rows="12" class="w-full p-4 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-mono text-sm resize-y focus:border-orange-500 transition-colors" placeholder="Hasil transkripsi akan muncul di sini..." data-i18n-attr="placeholder" data-i18n="stt.out_ph"></textarea>
      <div class="flex justify-between items-center mt-2">
        <span id="word-count" class="text-xs text-matte-400">0 kata · 0 karakter</span>
        <span class="text-xs text-matte-400" data-i18n="stt.editable">Teks bisa diedit manual setelah transkripsi</span>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { t } from '../../i18n/translations';
  const toast = (msg, type = 'success') => window.showToast?.(window._tToast ? window._tToast(msg) : msg, type);

  let __speechRender: (() => void) | null = null;
  window.addEventListener('langchange', () => { __speechRender?.(); });

  // Semua binding DOM dibungkus init() — dipanggil via astro:page-load dengan
  // guard path (#14), soalnya script top-level mati begitu navigasi SPA balik.
  function init() {
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  let recognition = null;
  let isRecording = false;
  // finalTranscript HARUS di scope init: dulu di dalam blok `else` sehingga tombol
  // Clear tidak bisa mengosongkannya → transkrip lama muncul lagi pada hasil berikutnya.
  let finalTranscript = '';
  const output = document.getElementById('output');
  const status = document.getElementById('status');
  const btnText = document.getElementById('btn-text');
  const micIcon = document.getElementById('mic-icon');
  function updateCount() {
    const text = output.value.trim();
    const words = text ? text.split(/\s+/).length : 0;
    document.getElementById('word-count').textContent = `${words} ${t('stt.words', 'kata')} · ${text.length} ${t('stt.chars', 'karakter')}`;
  }
  output.addEventListener('input', updateCount);
  if (!SpeechRecognition) {
    status.textContent = t('stt.unsupported', '⚠️ Browser tidak mendukung Web Speech API. Gunakan Chrome/Edge.');
    document.getElementById('start-btn').disabled = true;
  } else {
    recognition = new SpeechRecognition();
    recognition.continuous = true;
    recognition.interimResults = true;
    recognition.lang = 'id-ID';
    recognition.onresult = (e) => {
      let interim = '';
      for (let i = e.resultIndex; i < e.results.length; i++) {
        if (e.results[i].isFinal) finalTranscript += e.results[i][0].transcript + ' ';
        else interim += e.results[i][0].transcript;
      }
      output.value = finalTranscript + interim;
      updateCount();
    };
    recognition.onend = () => {
      // Auto-restart hanya selama masih merekam DAN halaman masih aktif.
      if (isRecording) { try { recognition.start(); } catch { isRecording = false; } }
    };
    recognition.onerror = (e) => {
      // 'no-speech' / 'aborted' itu normal (jeda bicara / stop manual) — jangan bikin panik.
      if (e.error === 'no-speech' || e.error === 'aborted') return;
      status.textContent = `Error: ${e.error}`;
      toast(`Error: ${e.error}`, 'error');
    };
  }
  document.getElementById('lang').onchange = (e) => { if (recognition) recognition.lang = e.target.value; };
  document.getElementById('start-btn').onclick = () => {
    if (!recognition) return;
    isRecording = !isRecording;
    if (isRecording) {
      recognition.start();
      micIcon.textContent = '🔴';
      btnText.textContent = t('stt.stop', 'Stop');
      status.textContent = t('stt.recording', '🎙️ Sedang merekam... bicara sekarang');
      document.getElementById('start-btn').className = 'flex items-center gap-2 px-6 py-3 bg-red-600 text-white rounded-xl font-bold hover:bg-red-700 transition-colors';
    } else {
      recognition.stop();
      micIcon.textContent = '🎙️';
      btnText.textContent = t('stt.start', 'Mulai Rekam');
      status.textContent = t('stt.stopped', '⏹️ Rekaman dihentikan');
      document.getElementById('start-btn').className = 'flex items-center gap-2 px-6 py-3 bg-orange-600 text-white rounded-xl font-bold hover:bg-orange-700 transition-colors';
    }
  };
  document.getElementById('clear-btn').onclick = () => {
    output.value = '';
    finalTranscript = ''; // reset juga state transkrip, bukan cuma isi textarea
    updateCount();
  };
  document.getElementById('copy-btn').onclick = async () => {
    const btn = document.getElementById('copy-btn');
    const text = output.value.trim();
    if (!text) { toast(t('stt.no_text', 'Belum ada teks untuk disalin.'), 'info'); return; }
    try {
      await navigator.clipboard.writeText(output.value);
      btn.textContent = '✅';
      toast(t('stt.copied', 'Transkrip disalin!'));
    } catch {
      toast(t('stt.copy_fail', 'Gagal menyalin.'), 'error');
    } finally {
      setTimeout(() => { btn.textContent = '📋'; }, 1500);
    }
  };

  __speechRender = () => {
    if (!isRecording) btnText.textContent = t('stt.start', 'Mulai Rekam');
    updateCount();
  };

  // Bersihkan saat meninggalkan halaman: tanpa ini recognition tetap hidup +
  // onend auto-restart terus berjalan padahal halaman sudah ditinggalkan.
  __speechStop = () => {
    isRecording = false;
    try { recognition?.stop(); } catch { /* belum jalan */ }
  };

  }

  // Cleanup lintas-navigasi (module scope, lihat CONTEXT #14): matikan recognition.
  let __speechStop = null;
  document.addEventListener('astro:before-swap', () => {
    if (__speechStop) { __speechStop(); __speechStop = null; }
  });

  // SPA boot (#14): guard path + guard dobel-bind
  const __textSpeechToTextPage = (location.pathname.replace(/\/+$/, '') || '/');
  document.addEventListener('astro:page-load', () => {
    if ((location.pathname.replace(/\/+$/, '') || '/') !== __textSpeechToTextPage) return;
    const anchor = document.querySelector('main button, main input, main select, main textarea');
    if (!anchor || anchor.dataset.autoBound === 'true') return;
    anchor.dataset.autoBound = 'true';
    init();
  });

</script>
