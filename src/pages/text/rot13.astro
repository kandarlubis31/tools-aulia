---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolPageHeader from '../../components/ToolPageHeader.astro';
---

<BaseLayout pageTitle="ROT13 Cipher">
  <div class="max-w-4xl mx-auto px-4 min-h-[60vh] py-10">
    <ToolPageHeader title="ROT13 & Caesar Cipher" titleKey="header.rot13" desc="Enkripsi dan dekripsi dengan ROT13 atau Caesar cipher." descKey="header.rot13_desc" icon='<path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>' gradient="from-lime-500 to-green-600" />
    <div class="card-base p-8 animate-fade-in">
      <div class="flex gap-4 mb-4 items-center">
        <select id="mode" class="p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold"><option value="13">ROT13</option><option value="custom">Caesar (custom shift)</option></select>
        <input id="shift" type="number" value="13" min="1" max="25" class="w-20 p-3 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-bold text-center hidden" />
      </div>
      <textarea id="input" rows="5" class="w-full p-4 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-mono text-sm resize-y mb-4" placeholder="Masukkan teks..."></textarea>
      <div class="flex gap-2 mb-4">
        <button id="encode" class="flex-1 py-3 bg-lime-600 text-white rounded-xl font-bold hover:bg-lime-700 transition-colors">🔒 Encode</button>
        <button id="decode" class="flex-1 py-3 bg-matte-200 dark:bg-matte-700 text-matte-600 dark:text-matte-300 rounded-xl font-bold hover:bg-lime-100 transition-colors">🔓 Decode</button>
      </div>
      <textarea id="output" rows="5" class="w-full p-4 border rounded-xl dark:bg-surface-hover dark:border-surface-border font-mono text-sm resize-y mb-4" placeholder="Hasil..." readonly></textarea>
      <button id="copy-btn" class="w-full py-3 bg-matte-200 dark:bg-matte-700 text-matte-600 dark:text-matte-300 rounded-xl font-bold hover:bg-lime-100 transition-colors">📋 Copy</button>
    </div>
  </div>
</BaseLayout>
<script>
  document.getElementById('mode').onchange = e => { document.getElementById('shift').classList.toggle('hidden', e.target.value !== 'custom'); };
  function caesar(text, shift, decode) {
    if (decode) shift = 26 - shift;
    return text.split('').map(c => {
      if (c >= 'A' && c <= 'Z') return String.fromCharCode(((c.charCodeAt(0) - 65 + shift) % 26) + 65);
      if (c >= 'a' && c <= 'z') return String.fromCharCode(((c.charCodeAt(0) - 97 + shift) % 26) + 97);
      return c;
    }).join('');
  }
  document.getElementById('encode').onclick = () => {
    const shift = document.getElementById('mode').value === '13' ? 13 : parseInt(document.getElementById('shift').value);
    document.getElementById('output').value = caesar(document.getElementById('input').value, shift, false);
  };
  document.getElementById('decode').onclick = () => {
    const shift = document.getElementById('mode').value === '13' ? 13 : parseInt(document.getElementById('shift').value);
    document.getElementById('output').value = caesar(document.getElementById('input').value, shift, true);
  };
  document.getElementById('copy-btn').onclick = () => { navigator.clipboard.writeText(document.getElementById('output').value); };
</script>
