---
interface Props {
  title: string;
  desc?: string;
  icon?: string;      // SVG path data
  titleKey?: string;
  descKey?: string;
}

const { title, desc = '', icon = '', titleKey, descKey } = Astro.props;
---

<!-- Header tool — clean Oct 2026 (senada hero landing):
     - ikon line-art netral di tile hairline (.icon-mono), BUKAN tile gradient + shadow
     - tipografi rata kiri, judul satu tone (tanpa gradient text)
     - prop `gradient` dihapus: dulu 199 halaman mengirim salah satu dari 18 palet warna,
       jadi tiap halaman terasa beda tema dari landing. -->
<header class="mb-8 pt-4 text-left animate-on-scroll">
  <div class="flex items-start gap-3.5">
    {icon && (
      <div class="icon-mono w-10 h-10 shrink-0 mt-0.5 rounded-xl border border-matte-200 dark:border-surface-border bg-matte-50 dark:bg-surface-elevated">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
      </div>
    )}
    <div class="min-w-0">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight leading-tight text-matte-900 dark:text-white" data-i18n={titleKey || undefined}>
        {title}
      </h1>
      {desc && (
        <p class="mt-1.5 text-sm text-matte-500 dark:text-matte-300 max-w-2xl leading-relaxed" data-i18n={descKey || undefined}>
          {desc}
        </p>
      )}
      <!-- Share button (E2): Web Share API + clipboard fallback, di semua tool page -->
      <button
        id="tool-share-btn"
        type="button"
        class="mt-3 inline-flex items-center gap-1.5 text-xs font-medium text-matte-500 dark:text-matte-400 hover:text-matte-900 dark:hover:text-white transition-colors"
        aria-label="Share this tool"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        <span data-i18n="common.share">Bagikan</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { shareContent } from '../composables/useShare';

  document.addEventListener('astro:page-load', () => {
    const shareBtn = document.getElementById('tool-share-btn');
    if (!shareBtn || shareBtn.dataset.bound === 'true') return;
    shareBtn.dataset.bound = 'true';

    shareBtn.addEventListener('click', async () => {
      const title = (document.querySelector('h1')?.textContent || document.title).trim();
      const text = `Coba "${title}" — gratis & 100% di browser, tanpa upload.`;
      (window as any).umami?.track?.('share', { tool: window.location.pathname });
      await shareContent(text, title, 'Link berhasil disalin!', 'Gagal membagikan!', window.location.href);
    });
  });
</script>
