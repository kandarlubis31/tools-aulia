---
interface Props {
  title: string;
  desc: string;
  href: string;
  icon: string;
  isSoon?: boolean;
  titleKey?: string;
  descKey?: string;
}

const { title, desc, href, icon, isSoon = false, titleKey, descKey } = Astro.props;
---

<a href={isSoon ? "#" : href}
   class={`tilt-card card-base group relative flex flex-col h-full p-5 rounded-xl overflow-hidden
           ${isSoon ? 'opacity-60 cursor-not-allowed' : 'active:scale-[0.98]'}`}>
  
  {isSoon && (
    <div class="absolute top-3 right-3 badge-muted z-10">
      Soon
    </div>
  )}

  <!-- Icon with subtle color ring on hover -->
  <div class="icon-mono w-10 h-10 mb-3.5 relative">
    <div class="absolute inset-0 rounded-xl ring-1 ring-transparent group-hover:ring-accent-blue/20 transition-all duration-300"></div>
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
  </div>
  
  <!-- Title with accent dot -->
  <div class="flex items-center gap-2 mb-1.5">
    <span class="w-1.5 h-1.5 rounded-full bg-accent-blue opacity-0 group-hover:opacity-100 transition-opacity duration-300 shrink-0"></span>
    <h3 class="text-sm font-semibold text-matte-800 dark:text-white transition-colors duration-150 group-hover:text-accent-blue leading-snug" data-i18n={titleKey || undefined}>
      {title}
    </h3>
  </div>
  
  <!-- Description -->
  <p class="text-xs text-matte-400 dark:text-matte-300 leading-relaxed flex-1 tracking-wide" data-i18n={descKey || undefined}>
    {desc}
  </p>

  <!-- Hover accent line + gradient at bottom -->
  <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-gradient-to-r from-accent-blue to-sky-400 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>

  <!-- Gloss overlay for 3D tilt shine effect -->
  <div class="tilt-card-gloss"></div>
</a>