---
interface Props {
  id?: string;            // root drop zone id (page JS references this)
  inputId?: string;       // hidden file input id (page JS references this)
  accept?: string;
  multiple?: boolean;
  label?: string;
  labelKey?: string;      // i18n key for label
  subLabel?: string;
  subLabelKey?: string;   // i18n key for subLabel
  hint?: string;          // small muted line under subLabel
  icon?: string;          // SVG path data
  overlay?: boolean;      // input = absolute overlay full-area (click tanpa JS wiring)
  extraInputId?: string;  // second hidden input (e.g. remove-bg background image)
  extraInputAccept?: string;
  className?: string;     // extra layout classes (max-w, mx-auto, animate-on-scroll, ...)
}

// Clean Oct 2026: prop `gradient` + `hoverClass` dihapus. Dulu tiap halaman kirim
// palet warna sendiri (emerald/teal/sky/…) → dropzone jadi blok warna paling menonjol
// di halaman, padahal cuma area upload. Sekarang netral: hairline dashed + tile ikon
// hairline; aksen indigo hanya muncul saat fokus keyboard.
const {
  id = 'drop-zone',
  inputId = 'file-input',
  accept,
  multiple = false,
  label = 'Pilih atau tarik file ke sini',
  labelKey,
  subLabel,
  subLabelKey,
  hint,
  icon = '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>',
  overlay = false,
  extraInputId,
  extraInputAccept = accept,
  className = '',
} = Astro.props;
---

<div
  id={id}
  data-dropzone-role
  role="button"
  tabindex={overlay ? undefined : 0}
  aria-label={label}
  class={`group relative cursor-pointer border border-dashed border-matte-300 dark:border-matte-600 rounded-xl p-10 sm:p-12 text-center transition-colors duration-150 hover:border-matte-400 dark:hover:border-matte-500 hover:bg-matte-50/60 dark:hover:bg-surface-hover/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-blue focus-visible:ring-offset-2 ${className}`}
>
  <div class={overlay ? 'pointer-events-none' : undefined}>
    {icon && (
      <div class="icon-mono mx-auto mb-4 w-12 h-12 rounded-xl border border-matte-200 dark:border-surface-border bg-matte-50 dark:bg-surface-elevated">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
      </div>
    )}
    <h3 class="text-base font-semibold text-matte-800 dark:text-matte-200 mb-1" data-i18n={labelKey || undefined}>{label}</h3>
    {subLabel && (
      <p class="text-sm text-matte-500 dark:text-matte-400" data-i18n={subLabelKey || undefined}>{subLabel}</p>
    )}
    {hint && (
      <p class="text-xs text-matte-400 dark:text-matte-500 mt-2">{hint}</p>
    )}
    <slot />
  </div>
  <input
    type="file"
    id={inputId}
    accept={accept}
    multiple={multiple}
    class={overlay ? 'absolute inset-0 w-full h-full opacity-0 cursor-pointer' : 'hidden'}
  />
  {extraInputId && (
    <input type="file" id={extraInputId} accept={extraInputAccept} class="hidden" />
  )}
</div>

<script>
  // A11y: Enter/Space membuka file dialog untuk mode hidden-input
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-dropzone-role]').forEach((zone) => {
      if (zone.dataset.dzWired) return;
      zone.dataset.dzWired = '1';
      zone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const input = zone.querySelector('input[type="file"]');
          if (input) (input as HTMLInputElement).click();
        }
      });
    });
  });
</script>
