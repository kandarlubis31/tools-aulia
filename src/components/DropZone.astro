---
interface Props {
  id?: string;            // root drop zone id (page JS references this)
  inputId?: string;       // hidden file input id (page JS references this)
  accept?: string;
  multiple?: boolean;
  label?: string;
  labelKey?: string;      // i18n key for label
  subLabel?: string;
  subLabelKey?: string;   // i18n key for subLabel
  hint?: string;          // small muted line under subLabel
  icon?: string;          // SVG path data
  gradient?: string;      // icon tile gradient stops, e.g. 'from-emerald-500 to-teal-600'
  hoverClass?: string;    // hover border/bg, e.g. 'hover:border-emerald-500 hover:bg-emerald-50 dark:hover:bg-matte-800/50'
  overlay?: boolean;      // input = absolute overlay full-area (click tanpa JS wiring)
  extraInputId?: string;  // second hidden input (e.g. remove-bg background image)
  extraInputAccept?: string;
  className?: string;     // extra layout classes (max-w, mx-auto, animate-on-scroll, ...)
}

const {
  id = 'drop-zone',
  inputId = 'file-input',
  accept,
  multiple = false,
  label = 'Pilih atau tarik file ke sini',
  labelKey,
  subLabel,
  subLabelKey,
  hint,
  icon = '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>',
  gradient = 'from-sky-500 to-blue-600',
  hoverClass = 'hover:border-sky-400 hover:bg-sky-50 dark:hover:bg-sky-950/20',
  overlay = false,
  extraInputId,
  extraInputAccept = accept,
  className = '',
} = Astro.props;
---

<div
  id={id}
  data-dropzone-role
  role="button"
  tabindex={overlay ? undefined : 0}
  aria-label={label}
  class={`group relative cursor-pointer border-2 border-dashed border-matte-300 dark:border-matte-600 rounded-2xl p-10 sm:p-12 text-center transition-all duration-200 hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-blue focus-visible:ring-offset-2 ${hoverClass} ${className}`}
>
  <div class={overlay ? 'pointer-events-none' : undefined}>
    {icon && (
      <div class={`icon-tile mx-auto mb-5 w-16 h-16 rounded-2xl bg-gradient-to-br ${gradient} text-white flex items-center justify-center shadow-sm transition-transform duration-200 group-hover:scale-110`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
      </div>
    )}
    <h3 class="text-lg font-bold text-matte-800 dark:text-matte-200 mb-1" data-i18n={labelKey || undefined}>{label}</h3>
    {subLabel && (
      <p class="text-sm text-matte-500 dark:text-matte-400" data-i18n={subLabelKey || undefined}>{subLabel}</p>
    )}
    {hint && (
      <p class="text-xs text-matte-400 dark:text-matte-500 mt-2">{hint}</p>
    )}
    <slot />
  </div>
  <input
    type="file"
    id={inputId}
    accept={accept}
    multiple={multiple}
    class={overlay ? 'absolute inset-0 w-full h-full opacity-0 cursor-pointer' : 'hidden'}
  />
  {extraInputId && (
    <input type="file" id={extraInputId} accept={extraInputAccept} class="hidden" />
  )}
</div>

<script>
  // A11y: Enter/Space membuka file dialog untuk mode hidden-input
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-dropzone-role]').forEach((zone) => {
      if (zone.dataset.dzWired) return;
      zone.dataset.dzWired = '1';
      zone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const input = zone.querySelector('input[type="file"]');
          if (input) (input as HTMLInputElement).click();
        }
      });
    });
  });
</script>
