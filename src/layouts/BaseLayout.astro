---
import { ClientRouter } from 'astro:transitions';
import { tools, getToolByHref } from '../data/tools';
import '../styles/global.css';

// Derive search-friendly tool list from shared data
const searchTools = tools.map(t => ({
  name: t.title,
  url: t.href,
  category: t.category,
  descKey: t.descKey,
  descFallback: t.desc,
}));

interface Props {
  pageTitle: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
  pdfJs?: boolean;
}

const { 
  pageTitle, 
  description: propDescription,
  ogImage: ogImageProp = '',
  canonicalUrl,
  noIndex = false,
  pdfJs = false
} = Astro.props;

const pathname = Astro.url.pathname;
const currentPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

// OG image (E1): dynamic per-page PNG from /og/[slug].png (e.g. /pdf/merge → /og/pdf-merge.png)
// Pages can still override via the `ogImage` prop.
const ogImage = ogImageProp || (currentPath === '/' ? '/og/home.png' : `/og/${currentPath.slice(1).replace(/\//g, '-')}.png`);

// --- Analytics (D2): Umami, privacy-first ---
// Website ID aktif (ToolsAulia). Override kapan pun via env var PUBLIC_UMAMI_WEBSITE_ID di Vercel.
const UMAMI_WEBSITE_ID = (import.meta.env.PUBLIC_UMAMI_WEBSITE_ID as string | undefined) || 'e52b94c6-d2fc-41bd-a258-d6f9db81a9ec';
const UMAMI_SRC = (import.meta.env.PUBLIC_UMAMI_SRC as string | undefined) || 'https://cloud.umami.is/script.js';

const isHome = currentPath === '/';
const isPdfRoot = currentPath === '/pdf';
const isPdfTool = currentPath.startsWith('/pdf/');

// Auto-derive SEO title & description from tools.ts for the current page
const matchedTool = getToolByHref(currentPath);
const seoTitle = matchedTool?.seoTitle;
const seoDesc = matchedTool?.seoDesc;
const defaultDescription = `${pageTitle} — gunakan gratis, 100% di browser tanpa upload data. Cepat, aman, dan tanpa iklan.`;
const description = propDescription ?? seoDesc ?? defaultDescription;
const titleSuffix = isHome ? `Koleksi ${tools.length}+ Tools Developer & Produktivitas Gratis | ToolsAulia` : 'Gratis & Offline | ToolsAulia';
const fullTitle = isHome ? titleSuffix : (seoTitle ?? `${pageTitle} — ${titleSuffix}`);

// hreflang alternates — self-referencing since site uses client-side i18n (same URL, localStorage-based language toggle)
const pageUrl = Astro.url.href;

// --- Breadcrumb (P3-4): Home / [Kategori atau hub] / [Tool] ---
const catMeta: Record<string, { label: string; key?: string }> = {
  pdf: { label: 'PDF Tools', key: 'nav.pdf_tools' },
  image: { label: 'Image', key: 'nav.category_image' },
  dev: { label: 'Dev', key: 'nav.category_dev' },
  calc: { label: 'Calc', key: 'nav.category_calc' },
  security: { label: 'Security', key: 'nav.category_security' },
  utils: { label: 'Utils', key: 'nav.category_utils' },
  file: { label: 'File', key: 'nav.category_file' },
  text: { label: 'Text', key: 'nav.category_text' },
  data: { label: 'Data', key: 'nav.category_data' },
  media: { label: 'Media', key: 'nav.category_media' },
  network: { label: 'Network', key: 'nav.category_network' },
};

let crumbMiddle: { href: string; label: string; key?: string } | null = null;
let crumbCurrent: string | null = null;
let crumbCurrentKey: string | undefined;

if (isPdfRoot) {
  // Hub itu sendiri = halaman aktif, bukan link
  crumbCurrent = 'PDF Tools';
  crumbCurrentKey = 'nav.pdf_tools';
} else if (isPdfTool && matchedTool) {
  crumbMiddle = { href: '/pdf', label: 'PDF Tools', key: 'nav.pdf_tools' };
  crumbCurrent = matchedTool.title;
  crumbCurrentKey = matchedTool.titleKey;
} else if (matchedTool) {
  const meta = catMeta[matchedTool.cat] || { label: matchedTool.category };
  crumbMiddle = { href: `/?cat=${matchedTool.cat}`, label: meta.label, key: meta.key };
  crumbCurrent = matchedTool.title;
  crumbCurrentKey = matchedTool.titleKey;
}
---

<!doctype html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5" />
  <title>{fullTitle}</title>
  <meta name="original-title" content={pageTitle} />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <link rel="canonical" href={canonicalUrl || Astro.url.href} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.url.origin).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="id_ID" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.url.origin).href} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}
  
  <!-- hreflang tags for multilingual SEO (self-referencing — client-side i18n via localStorage) -->
  <link rel="alternate" hreflang="id" href={pageUrl} />
  <link rel="alternate" hreflang="en" href={pageUrl} />
  <link rel="alternate" hreflang="x-default" href={pageUrl} />
  
  <!-- Structured Data: WebApplication (Homepage only) -->
  {isHome && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "ToolsAulia",
      "url": "https://tools.paklubis.my.id",
      "description": `Koleksi ${tools.length}+ tools developer & produktivitas gratis. Semua tools berjalan 100% offline di browser — tidak ada data yang dikirim ke server.`,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "author": { "@type": "Person", "name": "Aulia Iskandar Lubis", "url": "https://paklubis.my.id" },
      "browserRequirements": "Requires JavaScript"
    })} />
  )}
  
  <!-- Structured Data: SoftwareApplication (Tool pages only) -->
  {matchedTool && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": matchedTool.seoTitle || `${matchedTool.title} — Gratis & Offline | ToolsAulia`,
      "url": canonicalUrl || Astro.url.href,
      "description": matchedTool.seoDesc || matchedTool.desc,
      "applicationCategory": "WebApplication",
      "operatingSystem": "Any",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "author": { "@type": "Person", "name": "Aulia Iskandar Lubis", "url": "https://paklubis.my.id" },
      "browserRequirements": "Requires JavaScript"
    })} />
  )}

  <!-- Structured Data: BreadcrumbList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL('/', Astro.url.origin).href },
      ...((isPdfTool || isPdfRoot) && !isHome ? [{ "@type": "ListItem", "position": 2, "name": "PDF Tools", "item": new URL('/pdf', Astro.url.origin).href }] : []),
      ...(!isHome && !isPdfRoot ? [{ "@type": "ListItem", "position": isPdfTool ? 3 : 2, "name": pageTitle, "item": Astro.url.href }] : [])
    ]
  })} />
  
  <!-- Performance: Preconnect to critical origins -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://unpkg.com" crossorigin>
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
  <link rel="dns-prefetch" href="https://unpkg.com">
  
  <!-- Performance: Preload critical fonts (non-blocking) -->
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" as="style" crossorigin="anonymous" fetchpriority="high">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" crossorigin="anonymous">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" crossorigin="anonymous"></noscript>
  
  <ClientRouter />

  <!-- Analytics (D2): Umami — rendered only when PUBLIC_UMAMI_WEBSITE_ID is configured -->
  {UMAMI_WEBSITE_ID && (
    <script is:inline async defer src={UMAMI_SRC} data-website-id={UMAMI_WEBSITE_ID} data-domains="tools.paklubis.my.id"></script>
  )}

  <script is:inline>
    // Flag JS aktif — scroll reveal (.animate-on-scroll) hanya tersembunyi saat JS jalan
    document.documentElement.classList.add('js');
    const setDarkMode = () => {
      const theme = localStorage.getItem('theme');
      const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (theme === 'dark' || (!theme && systemDark)) {
        document.documentElement.classList.add("dark");
        var metaTC = document.querySelector('meta[name="theme-color"]'); if (metaTC) metaTC.setAttribute('content', '#0f172a');
      } else {
        document.documentElement.classList.remove("dark");
        var metaTC = document.querySelector('meta[name="theme-color"]'); if (metaTC) metaTC.setAttribute('content', '#ffffff');
      }
    };
    setDarkMode();
    document.addEventListener('astro:after-swap', setDarkMode);
  </script>

  <!-- PWA & Theme -->
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#ffffff" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#2563eb" />
  
  <!-- PWA registration handled automatically by @vite-pwa/astro with registerType: autoUpdate -->
</head>  <body class="antialiased bg-[#fafafa] dark:bg-matte-950 text-matte-800 dark:text-white min-h-screen flex flex-col font-sans">
  
  <!-- Skip to content -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] focus:px-4 focus:py-2 focus:bg-accent-blue focus:text-white focus:rounded-lg focus:text-sm focus:font-bold focus:shadow-lg focus:outline-none">
    Lewati ke konten
  </a>

  <div id="toast-container" class="fixed top-24 right-5 z-[100] flex flex-col gap-3 pointer-events-none"></div>
  <!-- Scroll Progress Bar -->
  <div id="scroll-progress" aria-hidden="true">
    <div id="scroll-progress-bar"></div>
  </div>

  <!-- Back to Top Button -->
  <button id="back-to-top" aria-label="Back to top" class="fixed bottom-6 right-6 z-[90] w-12 h-12 rounded-lg bg-matte-900 dark:bg-white text-white dark:text-matte-900 shadow-md flex items-center justify-center opacity-0 translate-y-4 pointer-events-none transition-all duration-150 hover:opacity-90">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>
  </button>

  <!-- Feedback Widget (E3): "🐛 Lapor Bug" button → modal → GitHub Issues -->
  <button id="feedback-btn" aria-label="Lapor Bug" class="fixed bottom-6 left-6 z-[85] flex items-center gap-2 px-3.5 py-2.5 rounded-full bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border shadow-lg hover:shadow-xl hover:border-amber-400/60 dark:hover:border-amber-500/30 hover:-translate-y-0.5 transition-all duration-200 text-xs font-semibold text-matte-600 dark:text-matte-300">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500 shrink-0"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01L12 2z"/><line x1="12" y1="13" x2="12" y2="17"/><line x1="12" y1="9" x2="12.01" y2="9"/></svg>
    <span class="hidden sm:inline" data-i18n="feedback.button">🐛 Lapor Bug</span>
  </button>

  <!-- Feedback Modal -->
  <div id="feedback-modal" class="hidden fixed inset-0 z-[110] flex items-center justify-center p-4 bg-black/50 opacity-0 transition-opacity duration-200" role="dialog" aria-modal="true" aria-label="Lapor Bug">
    <div class="bg-white dark:bg-surface-elevated rounded-2xl border border-matte-200 dark:border-surface-border shadow-2xl w-full max-w-md max-h-[90vh] overflow-y-auto transform scale-95 transition-transform duration-200">
      <!-- Header -->
      <div class="flex items-center justify-between p-5 border-b border-matte-100 dark:border-surface-border">
        <div>
          <h2 class="text-base font-bold text-matte-800 dark:text-white" data-i18n="feedback.title">Lapor Bug</h2>
          <p class="text-xs text-matte-400 mt-0.5" data-i18n="feedback.subtitle">Bantu kami memperbaiki ToolsAulia</p>
        </div>
        <button id="feedback-close" aria-label="Tutup" class="w-8 h-8 flex items-center justify-center rounded-lg text-matte-400 hover:text-matte-600 dark:hover:text-matte-300 hover:bg-matte-100 dark:hover:bg-surface-hover transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <!-- Form -->
      <div class="p-5 space-y-4">
        <div>
          <label for="feedback-desc" class="block text-xs font-semibold text-matte-500 dark:text-matte-400 mb-1.5" data-i18n="feedback.desc_label">Deskripsi Bug</label>
          <textarea id="feedback-desc" rows="4" class="w-full px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-hover border border-matte-200 dark:border-surface-border focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400/20 text-sm text-matte-800 dark:text-white placeholder-matte-400 resize-none transition-colors" data-i18n-attr="placeholder" data-i18n="feedback.desc_placeholder" placeholder="Jelaskan bug yang kamu temui…" required></textarea>
        </div>
        <div>
          <label for="feedback-steps" class="block text-xs font-semibold text-matte-500 dark:text-matte-400 mb-1.5" data-i18n="feedback.steps_label">Langkah Reproduksi (opsional)</label>
          <textarea id="feedback-steps" rows="3" class="w-full px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-hover border border-matte-200 dark:border-surface-border focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400/20 text-sm text-matte-800 dark:text-white placeholder-matte-400 resize-none transition-colors" data-i18n-attr="placeholder" data-i18n="feedback.steps_placeholder" placeholder="1. Buka halaman…&#10;2. Klik…&#10;3. …"></textarea>
        </div>
        <div>
          <label for="feedback-contact" class="block text-xs font-semibold text-matte-500 dark:text-matte-400 mb-1.5" data-i18n="feedback.contact_label">Kontak (opsional)</label>
          <input type="text" id="feedback-contact" class="w-full px-3 py-2.5 rounded-lg bg-matte-50 dark:bg-surface-hover border border-matte-200 dark:border-surface-border focus:outline-none focus:border-amber-400 focus:ring-1 focus:ring-amber-400/20 text-sm text-matte-800 dark:text-white placeholder-matte-400 transition-colors" data-i18n-attr="placeholder" data-i18n="feedback.contact_placeholder" placeholder="Email atau username GitHub…" />
        </div>
      </div>
      <!-- Footer -->
      <div class="flex items-center gap-3 p-5 pt-0">
        <button id="feedback-cancel" class="flex-1 py-2.5 px-4 rounded-lg border border-matte-200 dark:border-surface-border text-matte-500 dark:text-matte-400 font-semibold text-sm hover:bg-matte-50 dark:hover:bg-surface-hover transition-colors" data-i18n="common.cancel">Batal</button>
        <button id="feedback-submit" class="flex-1 py-2.5 px-4 rounded-lg bg-matte-900 dark:bg-white text-white dark:text-matte-900 font-semibold text-sm hover:opacity-90 transition-opacity flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          <span data-i18n="feedback.submit">Buka di GitHub</span>
        </button>
      </div>
    </div>
  </div>

  <div id="offline-indicator" class="hidden fixed bottom-0 left-0 w-full bg-matte-800 dark:bg-matte-700 text-white text-center py-2 text-sm font-medium z-[100] shadow-lg animate-slide-up">
    <span data-i18n="offline.msg">⚠️ Koneksi terputus. Anda sedang offline.</span>
  </div>
  <div id="navigation-loading" class="fixed top-0 left-0 w-full h-0.5 bg-matte-200 dark:bg-surface-border z-[100] overflow-hidden hidden">
    <div class="h-full bg-accent-blue w-0 transform origin-left transition-all duration-150"></div>
  </div>

  <div id="pwa-custom-modal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-black/80 opacity-0 transition-opacity duration-150">
    <div class="bg-white dark:bg-surface-elevated rounded-xl border border-matte-200 dark:border-surface-border shadow-xl w-full max-w-sm overflow-hidden transform scale-95 transition-transform duration-150">
        <div class="h-20 bg-matte-100 dark:bg-surface-hover flex items-center justify-center">
             <div class="w-14 h-14 bg-white dark:bg-matte-800 rounded-xl shadow-md flex items-center justify-center">
                 <img src="/favicon.svg" alt="App Icon" class="w-8 h-8" loading="lazy" />
             </div>
        </div>
        
        <div class="p-5 text-center">
            <h3 class="text-base font-semibold text-matte-800 dark:text-white mb-2" data-i18n="pwa.install_title">Install ToolsAulia</h3>
            <p class="text-xs text-matte-400 dark:text-matte-300 mb-5" data-i18n="pwa.install_desc">
                Akses semua tools secara offline, lebih cepat, dan langsung dari layar utama.
            </p>
            
            <div class="space-y-2">
                <button id="pwa-confirm-install" class="w-full py-2.5 px-4 bg-matte-900 dark:bg-white text-white dark:text-matte-900 font-semibold text-sm rounded-lg transition-all duration-150 hover:opacity-90" data-i18n="pwa.install_now">
                    Install Sekarang
                </button>
                <button id="pwa-cancel-install" class="w-full py-2.5 px-4 bg-matte-100 dark:bg-surface-hover text-matte-500 dark:text-matte-300 font-medium text-sm rounded-lg transition-all duration-150" data-i18n="pwa.later">
                    Nanti Saja
                </button>
            </div>
        </div>
    </div>
  </div>

  <header class="sticky top-0 z-50 w-full border-b border-matte-200 dark:border-surface-border bg-white dark:bg-matte-950 md:bg-white/80 md:dark:bg-matte-950/80 md:backdrop-blur-lg" data-astro-transition-persist="navbar">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2 font-bold text-base tracking-tight z-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-blue/40 rounded-md p-1">
        <span class="w-8 h-8 rounded-lg bg-gradient-to-br from-sky-500 via-indigo-500 to-violet-500 flex items-center justify-center shadow-md shadow-indigo-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </span>
        <span class="text-matte-800 dark:text-white">
          Tools<span class="gradient-text">Aulia</span>
        </span>
      </a>
      
      <nav class="hidden md:flex items-center gap-1" role="navigation" aria-label="Main navigation">
        <a href="/" class={`nav-item ${isHome ? 'nav-item-active' : 'nav-item-inactive'}`} data-i18n="nav.home">Home</a>
        
        <!-- Tools Dropdown -->
        <div class="relative group">
          <button class="nav-item nav-item-inactive cursor-pointer flex items-center gap-1" aria-haspopup="true" aria-expanded="false">
            <span data-i18n="nav.tools">Tools</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-150 group-hover:rotate-180"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="absolute top-full left-0 mt-1 w-52 bg-white dark:bg-surface-elevated border border-matte-200 dark:border-surface-border rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50 py-1.5 origin-top-left">
            <a href="/pdf" class="flex items-center gap-2.5 px-3.5 py-2.5 text-xs font-medium text-matte-700 dark:text-white hover:bg-matte-100 dark:hover:bg-surface-hover transition-colors duration-150">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-matte-400 shrink-0"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
