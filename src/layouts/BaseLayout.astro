  <script>
    import { showToast } from '../composables/useToast';

    const REPO = 'kandarlubis31/tools-aulia';

    function openFeedbackModal() {
      const modal = document.getElementById('feedback-modal');
      const card = modal?.querySelector('div');
      if (!modal || !card) return;
      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
        modal.classList.add('opacity-100');
        modal.classList.remove('opacity-0');
        card.classList.remove('scale-95');
      });
      document.getElementById('feedback-desc')?.focus();
    }

    function closeFeedbackModal() {
      const modal = document.getElementById('feedback-modal');
      const card = modal?.querySelector('div');
      if (!modal || !card) return;
      modal.classList.add('opacity-0');
      modal.classList.remove('opacity-100');
      card.classList.add('scale-95');
      setTimeout(() => modal.classList.add('hidden'), 200);
    }

    function buildFeedbackUrl() {
      const desc = document.getElementById('feedback-desc')?.value?.trim();
      if (!desc) return null;

      const steps = document.getElementById('feedback-steps')?.value?.trim() || '';
      const contact = document.getElementById('feedback-contact')?.value?.trim() || '';

      const title = `[Bug] ${desc.slice(0, 80)}${desc.length > 80 ? '…' : ''}`;
      const body = [
        `**Deskripsi Bug:**`,
        desc,
        '',
        steps ? `**Langkah Reproduksi:**\n${steps}\n` : '',
        contact ? `**Kontak:** ${contact}\n` : '',
        `---`,
        `**Halaman:** ${window.location.href}`,
        `**User Agent:** ${navigator.userAgent}`,
        `**Timestamp:** ${new Date().toISOString()}`,
      ].filter(Boolean).join('\n');

      const params = new URLSearchParams({ title, body, labels: 'bug' });
      return `https://github.com/${REPO}/issues/new?${params.toString()}`;
    }

    function handleFeedbackSubmit() {
      const url = buildFeedbackUrl();
      if (!url) {
        showToast(
          window._tToast?.('Mohon isi deskripsi bug terlebih dahulu.') || 'Mohon isi deskripsi bug terlebih dahulu.',
          'warning',
        );
        document.getElementById('feedback-desc')?.focus();
        return;
      }
      window.umami?.track?.('feedback', { tool: window.location.pathname });
      window.open(url, '_blank', 'noopener');
      showToast(
        window._tToast?.('Terima kasih! GitHub Issues akan terbuka di tab baru.') || 'Terima kasih! GitHub Issues akan terbuka di tab baru.',
        'success',
        5000,
      );
      closeFeedbackModal();
    }

    document.addEventListener('astro:page-load', () => {
      const btn = document.getElementById('feedback-btn');
      if (btn && !btn.dataset.bound) {
        btn.dataset.bound = 'true';
        btn.addEventListener('click', openFeedbackModal);
      }

      const closeBtn = document.getElementById('feedback-close');
      const cancelBtn = document.getElementById('feedback-cancel');
      const submitBtn = document.getElementById('feedback-submit');
      const modal = document.getElementById('feedback-modal');

      closeBtn?.addEventListener('click', closeFeedbackModal);
      cancelBtn?.addEventListener('click', closeFeedbackModal);
      submitBtn?.addEventListener('click', handleFeedbackSubmit);

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeFeedbackModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
          closeFeedbackModal();
        }
      });
    });
  </script>

  {pdfJs && (
    <>
      <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js" async></script>
      <script is:inline async>
        (function waitForPdfjs() {
          if (window.pdfjsLib) {
            pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
          } else {
            setTimeout(waitForPdfjs, 50);
          }
        })();
      </script>
    </>
  )}
</body>
</html>