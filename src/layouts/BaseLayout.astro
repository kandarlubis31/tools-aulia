  <!-- Performance: Load i18n phrases async to not block rendering -->
  <script src="/i18n-phrases.js" defer></script>
  
  <script is:inline>
    // Translation helper - handles case where phrases not yet loaded
    window._tToast = (msg) => {
      const lang = (typeof window !== 'undefined' && localStorage.getItem('lang')) || 'id';
      if (lang === 'id') return msg;
      // Check if phrases loaded, if not return original
      if (!window._i18nPhrases) return msg;
      // exact match
      if (window._i18nPhrases[msg]) return window._i18nPhrases[msg];
      // fallback: replace known phrases inside the message
      let result = msg;
      for (const [id, en] of Object.entries(window._i18nPhrases)) {
        if (result.includes(id)) result = result.split(id).join(en);
      }
      return result;
    };
    // window.showToast dipasang oleh module script dari composables
    // Lihat bagian <script> di bawah import useToast

    document.addEventListener('astro:page-load', () => {
      // ── Scroll reveal (P3-3): animasi global untuk .animate-on-scroll ──
      const revealEls = document.querySelectorAll('.animate-on-scroll');
      if (revealEls.length) {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!('IntersectionObserver' in window) || reducedMotion) {
          revealEls.forEach(el => el.classList.add('is-visible'));
        } else {
          // Reuse satu observer per SPA session (cegah akumulasi saat view transition)
          if (window._revealObserver) window._revealObserver.disconnect();
          const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1, rootMargin: '0px 0px -32px 0px' });
          window._revealObserver = revealObserver;
          revealEls.forEach(el => revealObserver.observe(el));
        }
      }

      const pwaModal = document.getElementById('pwa-custom-modal');
      const pwaConfirmBtn = document.getElementById('pwa-confirm-install');
      const pwaCancelBtn = document.getElementById('pwa-cancel-install');

      window.installPWA = () => {
        if (!window.deferredPrompt) {
            window.showToast(window._tToast ? window._tToast('Aplikasi mungkin sudah terinstall') : 'Aplikasi mungkin sudah terinstall', 'success');
            return;
        }
        if (pwaModal) pwaModal.classList.remove('hidden');
        setTimeout(() => {
            if (pwaModal) pwaModal.classList.remove('opacity-0');
            var pwaDiv = pwaModal && pwaModal.querySelector('div'); if (pwaDiv) pwaDiv.classList.remove('scale-95');
            var pwaDiv = pwaModal && pwaModal.querySelector('div'); if (pwaDiv) pwaDiv.classList.add('scale-100');
        }, 10);
      };

      if (pwaConfirmBtn) pwaConfirmBtn.addEventListener('click', async () => {
        if (window.deferredPrompt) {
            window.deferredPrompt.prompt();
            const { outcome } = await window.deferredPrompt.userChoice;
            // Silent - user choice recorded
            window.deferredPrompt = null;
        }
        closePwaModal();
      });

      const closePwaModal = () => {
        if (pwaModal) pwaModal.classList.add('opacity-0');
        var pwaDiv2 = pwaModal && pwaModal.querySelector('div'); if (pwaDiv2) pwaDiv2.classList.add('scale-95');
        var pwaDiv2 = pwaModal && pwaModal.querySelector('div'); if (pwaDiv2) pwaDiv2.classList.remove('scale-100');
        setTimeout(function() { if (pwaModal) pwaModal.classList.add('hidden'); }, 300);
      };

      if (pwaCancelBtn) pwaCancelBtn.addEventListener('click', closePwaModal);
      if (pwaModal) pwaModal.addEventListener('click', (e) => {
        if(e.target === pwaModal) closePwaModal();
      });

      // PWA install: delay prompt until user has interacted 3+ times
      let _pwaInteractions = 0;
      const _pwaTrackInteraction = () => {
        _pwaInteractions++;
        if (_pwaInteractions >= 3) {
          document.removeEventListener('click', _pwaTrackInteraction);
          document.removeEventListener('scroll', _pwaTrackInteraction);
        }
      };
      document.addEventListener('click', _pwaTrackInteraction);
      document.addEventListener('scroll', _pwaTrackInteraction, { once: true });

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        window.deferredPrompt = e;
        // Only show install button after 3+ interactions (or after 30s)
        const showInstallBtn = () => {
          var installBtn = document.getElementById('install-pwa-btn'); if (installBtn) installBtn.classList.remove('hidden');
          var installMobile = document.getElementById('install-pwa-mobile'); if (installMobile) installMobile.classList.remove('hidden');
        };
        if (_pwaInteractions >= 3) {
          showInstallBtn();
        } else {
          setTimeout(showInstallBtn, 30000);
        }
      });

      const backBtn = document.getElementById('back-btn');
      const backBtnText = document.getElementById('back-btn-text');
      const urlParams = new URLSearchParams(window.location.search);
      const fromCat = urlParams.get('from_cat');
      if (backBtn && fromCat && fromCat !== 'popular' && fromCat !== 'all') {
         backBtn.href = `/?cat=${fromCat}`;
         // Breadcrumb mode: middle crumb = nama kategori, bukan "Kembali ke X"
         const catNames = {'pdf': 'PDF Tools', 'dev': 'Dev', 'image': 'Image', 'calc': 'Calc', 'file': 'File', 'security': 'Security', 'utils': 'Utils', 'text': 'Text', 'data': 'Data', 'media': 'Media'};
         if (backBtnText) {
           backBtnText.textContent = catNames[fromCat] || 'Kategori';
         }
      }

      const updateOnlineStatus = () => {
        const indicator = document.getElementById('offline-indicator');
        if (!navigator.onLine) {
            if (indicator) indicator.classList.remove('hidden');
            window.showToast(window._tToast ? window._tToast('Koneksi terputus.') : 'Koneksi terputus.', 'error');
        } else {
            if(!(indicator && indicator.classList.contains('hidden'))) {
                if (indicator) indicator.classList.add('hidden');
                const hasSW = !!(navigator.serviceWorker && navigator.serviceWorker.controller);
                const msg = hasSW
                  ? (window._tToast ? window._tToast('📦 Kembali Online! Konten dari cache, data terbaru sedang dimuat...') : '📦 Kembali Online! Konten dari cache, data terbaru sedang dimuat...')
                  : (window._tToast ? window._tToast('Kembali Online!') : 'Kembali Online!');
                window.showToast(msg, 'success');
            }
        }
      };
      window.addEventListener('online', updateOnlineStatus);
      window.addEventListener('offline', updateOnlineStatus);
      if(!navigator.onLine) { var offlineInd = document.getElementById('offline-indicator'); if (offlineInd) offlineInd.classList.remove('hidden'); }

      // ── First-cache notification: toast "⚡ Siap untuk offline!" once per SW install ──
      if (!localStorage.getItem('_sw_cached') && navigator.serviceWorker) {
        navigator.serviceWorker.ready.then(() => {
          localStorage.setItem('_sw_cached', '1');
          window.showToast(
            window._tToast ? window._tToast('⚡ Siap untuk offline! ToolsAulia tetap bisa diakses tanpa internet.') : '⚡ Siap untuk offline! ToolsAulia tetap bisa diakses tanpa internet.',
            'success'
          );
          // Show offline-ready badge in footer
          var badge = document.getElementById('offline-ready-badge');
          if (badge) badge.classList.remove('hidden');
        }).catch(() => {});
      } else if (navigator.serviceWorker && navigator.serviceWorker.controller) {
        // SW already active from previous visit — show badge silently
        var badge = document.getElementById('offline-ready-badge');
        if (badge) badge.classList.remove('hidden');
      }

      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileLinks = document.querySelectorAll('.mobile-link');
      if (menuBtn && mobileMenu && !menuBtn.dataset.hasListener) {
        menuBtn.dataset.hasListener = 'true';
        menuBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          const isOpen = !mobileMenu.classList.contains('flex');
          mobileMenu.classList.toggle('hidden');
          mobileMenu.classList.toggle('flex');
          menuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          menuBtn.setAttribute('aria-label', isOpen ? 'Close menu' : 'Toggle menu');
        });
        if (!window._menuDocHandler) {
          window._menuDocHandler = function(e) {
            var mb = document.getElementById('mobile-menu');
            var btn = document.getElementById('mobile-menu-btn');
            if (mb && btn && !btn.contains(e.target) && !mb.contains(e.target)) {
              mb.classList.add('hidden');
              mb.classList.remove('flex');
              btn.setAttribute('aria-expanded', 'false');
              btn.setAttribute('aria-label', 'Toggle menu');
            }
          };
          document.addEventListener('click', window._menuDocHandler);
        }          mobileLinks.forEach(function(link) {
          if (!link.dataset.hasCloseListener) {
            link.dataset.hasCloseListener = 'true';
            link.addEventListener('click', function() {
              mobileMenu.classList.add('hidden');
              mobileMenu.classList.remove('flex');
              menuBtn.setAttribute('aria-expanded', 'false');
              menuBtn.setAttribute('aria-label', 'Toggle menu');
            });
          }
        });
      }
      
      const handleThemeToggle = () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        var metaTC2 = document.querySelector('meta[name="theme-color"]'); if (metaTC2) metaTC2.setAttribute('content', isDark ? '#0f172a' : '#ffffff');
      };
      
      const desktopToggle = document.getElementById('theme-toggle-desktop');
      if(desktopToggle && !desktopToggle.dataset.hasListener) {
          desktopToggle.dataset.hasListener = 'true';
          desktopToggle.addEventListener('click', handleThemeToggle);
      }
      
      const mobileToggle = document.getElementById('theme-toggle-mobile');
      if(mobileToggle && !mobileToggle.dataset.hasListener) {
          mobileToggle.dataset.hasListener = 'true';
          mobileToggle.addEventListener('click', handleThemeToggle);
      }

      const searchBtn = document.getElementById('search-btn');
      const searchModal = document.getElementById('search-modal');
      const searchInput = document.getElementById('search-modal-input');
      const closeSearch = document.getElementById('close-search');
      
      const openSearch = () => {
        const modal = document.getElementById('search-modal');
        const input = document.getElementById('search-modal-input');
        const btn = document.getElementById('search-btn');
        if (modal) modal.classList.remove('hidden');
        if (input) input.focus();
        if (btn) btn.setAttribute('aria-expanded', 'true');
      };
      const closeSearchModal = () => {
        const modal = document.getElementById('search-modal');
        const input = document.getElementById('search-modal-input');
        const btn = document.getElementById('search-btn');
        if (modal) modal.classList.add('hidden');
        if (input) input.value = '';
        if (btn) btn.setAttribute('aria-expanded', 'false');
      };
      
      if(searchBtn && !searchBtn.dataset.hasListener) {
          searchBtn.dataset.hasListener = 'true';
          searchBtn.addEventListener('click', openSearch);
      }
      
      if (closeSearch) closeSearch.addEventListener('click', closeSearchModal);
      if (searchModal) searchModal.addEventListener('click', (e) => {
        if (e.target === searchModal) closeSearchModal();
      });
      // Guard: register keyboard shortcuts only once (prevent SPA navigation leak)
      if (!window._shortcutsRegistered) {
        window._shortcutsRegistered = true;
        document.addEventListener('keydown', (e) => {
          const tag = document.activeElement?.tagName;
          const isInput = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || !!document.activeElement?.isContentEditable;
          if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            openSearch();
          }
          if (e.key === '/' && !isInput) {
            e.preventDefault();
            openSearch();
          }
          if ((e.ctrlKey || e.metaKey) && e.key === 'd') {
            e.preventDefault();
            document.getElementById('theme-toggle-desktop')?.click();
          }
          if (e.key === '?' && !isInput) {
            e.preventDefault();
            window.showToast(window._tToast ? window._tToast('⌨️ Shortcuts: / atau Ctrl+K = Cari, Ctrl+D = Ganti tema, Esc = Tutup') : '⌨️ Shortcuts: / atau Ctrl+K = Cari, Ctrl+D = Ganti tema, Esc = Tutup', 'info');
          }
          if (e.key === 'Escape') closeSearchModal();
        });
      }

      // Cache clear handlers
      var cacheClearHandler = function() {
        var confirmMsg = (window.i18n && window.i18n.t) ? window.i18n.t('confirm.clear_cache', 'Bersihkan cache dan reload halaman?') : 'Bersihkan cache dan reload halaman?';
        if (!confirm(confirmMsg)) return;
        // Clear localStorage
        try { localStorage.clear(); } catch(e) { console.debug('localStorage.clear gagal:', e); }
        // Unregister service workers + clear caches, then reload
        var promises = [];
        if (navigator.serviceWorker) {
          promises.push(navigator.serviceWorker.getRegistrations().then(function(regs) {
            return Promise.all(regs.map(function(r) { return r.unregister(); }));
          }).catch(function(err) { console.debug('Service worker unregister gagal:', err); }));
        }
        if (window.caches) {
          promises.push(caches.keys().then(function(names) {
            return Promise.all(names.map(function(n) { return caches.delete(n); }));
          }).catch(function(err) { console.debug('Cache delete gagal:', err); }));
        }
        Promise.all(promises).then(function() {
          window.location.reload();
        }).catch(function() {
          window.location.reload();
        });
      };
      var cacheClearBtn = document.getElementById('cache-clear-btn');
      if (cacheClearBtn && !cacheClearBtn.dataset.hasListener) {
        cacheClearBtn.dataset.hasListener = 'true';
        cacheClearBtn.addEventListener('click', cacheClearHandler);
      }
      var cacheClearMobile = document.getElementById('cache-clear-mobile');
      if (cacheClearMobile && !cacheClearMobile.dataset.hasListener) {
        cacheClearMobile.dataset.hasListener = 'true';
        cacheClearMobile.addEventListener('click', cacheClearHandler);
      }

      const toolsList = JSON.parse(document.getElementById('search-tools-json')?.textContent || '[]');
      
      const searchInputEl = document.getElementById('search-modal-input');
      const searchResultsEl = document.getElementById('search-results');
      
      if (searchInputEl && searchResultsEl && !searchInputEl.dataset.hasListener) {
        searchInputEl.dataset.hasListener = 'true';
        
        var searchDebounceTimer;

        // --- Command palette: keyboard navigation ---
        var palIndex = -1;
        var palItems = [];

        var highlightPal = function() {
          palItems.forEach(function(el, i) {
            el.classList.toggle('bg-matte-100', i === palIndex);
            el.classList.toggle('dark:bg-surface-hover', i === palIndex);
          });
        };

        var movePal = function(delta) {
          if (palItems.length === 0) return;
          palIndex = (palIndex + delta + palItems.length) % palItems.length;
          highlightPal();
          if (palItems[palIndex]) palItems[palIndex].scrollIntoView({ block: 'nearest' });
        };

        searchInputEl.addEventListener('keydown', function(e) {
          if (e.key === 'ArrowDown') { e.preventDefault(); movePal(1); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); movePal(-1); }
          else if (e.key === 'Enter') {
            if (palIndex >= 0 && palItems[palIndex]) {
              e.preventDefault();
              palItems[palIndex].click(); // .click() → tetap pakai Astro view transition + click handler
            }
          }
          else if (e.key === 'Escape') {
            closeSearchModal();
          }
        });

        searchInputEl.addEventListener('input', function(e) {
          clearTimeout(searchDebounceTimer);
          searchDebounceTimer = setTimeout(() => {
            const query = e.target.value.toLowerCase().trim();
            if (!query) {
              searchResultsEl.innerHTML = '<div class="text-center py-8 text-matte-500 dark:text-matte-400"><p data-i18n="search.empty">Ketik untuk mencari tools</p></div>';
              if (window.i18n && window.i18n.translateNode) window.i18n.translateNode(searchResultsEl);
              palItems = []; palIndex = -1;
              return;
            }

            const filtered = toolsList.filter(t => {
              const enDesc = (window.i18n && window.i18n.t) ? window.i18n.t(t.descKey, '') : '';
              return t.name.toLowerCase().includes(query) ||
                     t.descFallback.toLowerCase().includes(query) ||
                     t.category.toLowerCase().includes(query) ||
                     enDesc.toLowerCase().includes(query);
            });

            if (filtered.length === 0) {
              searchResultsEl.innerHTML = '<div class="text-center py-8 text-matte-500 dark:text-matte-400"><p data-i18n="search.no_results">Tidak ada hasil untuk</p><p class="font-bold mt-1">"' + query + '"</p></div>';
              if (window.i18n && window.i18n.translateNode) window.i18n.translateNode(searchResultsEl);
              palItems = []; palIndex = -1;
              return;
            }

            searchResultsEl.innerHTML = filtered.map(t => {
              const descText = (window.i18n && window.i18n.t) ? window.i18n.t(t.descKey, t.descFallback) : t.descFallback;
              return `
              <a href="${t.url}" class="flex items-center gap-3 p-2.5 rounded-lg hover:bg-matte-100 dark:hover:bg-surface-hover transition-colors duration-150 group">
                <div class="w-9 h-9 rounded-lg bg-matte-100 dark:bg-surface-hover flex items-center justify-center text-matte-400 group-hover:text-accent-blue transition-colors duration-150 shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l7.81-9.24a1 1 0 0 1 1.54 0l7.81 9.24A1 1 0 0 1 20 14h-7v7h-2v-7z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-xs font-semibold text-matte-800 dark:text-white group-hover:text-accent-blue transition-colors duration-150 truncate">${t.name}</p>
                  <p class="text-2xs text-matte-400 truncate">${descText}</p>
                </div>
                <span class="shrink-0 text-2xs font-medium uppercase tracking-wide-2 text-matte-400 bg-matte-100 dark:bg-surface-hover px-2 py-0.5 rounded">${t.category}</span>
              </a>
            `;
            }).join('');

            palItems = Array.from(searchResultsEl.querySelectorAll('a'));
            palIndex = -1;
            highlightPal();
          }, 150);
        });
      }

      const navLoad = document.getElementById('navigation-loading');
      var navBar = navLoad && navLoad.querySelector('div');
      
      // Back to Top Button
      const backToTopBtn = document.getElementById('back-to-top');
      if (backToTopBtn) {
        const toggleBackToTop = () => {
          if (window.scrollY > 400) {
            backToTopBtn.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
          } else {
            backToTopBtn.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          }
        };
        window.addEventListener('scroll', toggleBackToTop, { passive: true });
        backToTopBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        document.addEventListener('astro:after-swap', toggleBackToTop);
        setTimeout(toggleBackToTop, 200);
      }

      // Scroll Progress Bar
      const updateScrollProgress = () => {
        const bar = document.getElementById('scroll-progress-bar');
        if (!bar) return;
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (docHeight > 0) {
          const progress = Math.min((scrollTop / docHeight) * 100, 100);
          bar.style.width = progress + '%';
        } else {
          bar.style.width = '0%';
        }
      };
      window.addEventListener('scroll', updateScrollProgress, { passive: true });
      window.addEventListener('resize', updateScrollProgress, { passive: true });
      document.addEventListener('astro:after-swap', () => setTimeout(updateScrollProgress, 100));
      setTimeout(updateScrollProgress, 200);

      document.addEventListener('astro:after-preparation', () => {
        if (navLoad) navLoad.classList.remove('hidden');
        if(navBar) navBar.style.width = '30%';
      });
      document.addEventListener('astro:after-swap', () => {
        if(navBar) {
          navBar.style.width = '100%';
          setTimeout(() => {
            navBar.style.width = '0%';
            if (navLoad) navLoad.classList.add('hidden');
          }, 300);
        }
      });
    });

    // ── Global Error Boundary ──
    // Prevent JS errors from blanking the SPA. Shows a toast + reload button.
    if (!window._errorBoundarySet) {
      window._errorBoundarySet = true;

      const showErrorOverlay = (message) => {
        // Avoid stacking multiple error toasts
        if (document.getElementById('error-boundary-toast')) return;

        const toast = document.createElement('div');
        toast.id = 'error-boundary-toast';
        toast.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 z-[200] bg-rose-600 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3 text-sm font-medium animate-fade-in-up max-w-lg';
        toast.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span class="flex-1">${message}</span>
          <button id="error-reload-btn" class="px-3 py-1 bg-white/20 hover:bg-white/30 rounded-lg text-xs font-bold transition-colors whitespace-nowrap">Reload</button>
          <button id="error-dismiss-btn" class="text-white/60 hover:text-white transition-colors" aria-label="Tutup">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        `;
        document.body.appendChild(toast);

        document.getElementById('error-reload-btn')?.addEventListener('click', () => {
          window.location.reload();
        });
        document.getElementById('error-dismiss-btn')?.addEventListener('click', () => {
          toast.remove();
        });

        // Auto-dismiss after 15s
        setTimeout(() => { if (toast.parentNode) toast.remove(); }, 15000);
      };

      window.onerror = (msg, _source, _lineno, _colno, _error) => {
        const text = window._tToast
          ? window._tToast('⚠️ Terjadi error. Coba reload halaman.')
          : '⚠️ Terjadi error. Coba reload halaman.';
        showErrorOverlay(text);
        console.error('[ErrorBoundary]', msg);
        return false; // Let console still log
      };

      window.addEventListener('unhandledrejection', (event) => {
        const text = window._tToast
          ? window._tToast('⚠️ Operasi gagal. Coba reload halaman.')
          : '⚠️ Operasi gagal. Coba reload halaman.';
        showErrorOverlay(text);
        console.error('[ErrorBoundary] Unhandled rejection:', event.reason);
        event.preventDefault();
      });
    }
  </script>

